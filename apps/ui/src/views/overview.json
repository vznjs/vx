{
  "data": {
    "stats": "cacheStats",
    "savings": "cacheSavings",
    "topTasks": "topTasks",
    "failures": "failures",
    "projects": "projects",
    "invocations": "invocations",
    "trends": "trends"
  },
  "spec": {
    "type": "Page",
    "children": [
      {
        "type": "Grid",
        "props": {
          "variant": "metrics-4"
        },
        "visible": {
          "$state": "/statsStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "Metric",
            "props": {
              "label": "Time saved",
              "value": {
                "$computed": "fmtDuration",
                "args": {
                  "ms": {
                    "$state": "/savings/estimatedTimeSavedTotalMs"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{n} cache hits",
                  "n": {
                    "$computed": "agg",
                    "args": {
                      "arr": {
                        "$state": "/projects"
                      },
                      "field": "hits",
                      "op": "sum"
                    }
                  }
                }
              },
              "tone": {
                "$computed": "gt",
                "args": {
                  "v": {
                    "$state": "/savings/estimatedTimeSavedTotalMs"
                  },
                  "n": 0,
                  "then": "good",
                  "else": "default"
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Hit rate",
              "value": {
                "$computed": "ratioFmt",
                "args": {
                  "arr": {
                    "$state": "/projects"
                  },
                  "a": "hits",
                  "b": "runs",
                  "fmt": "percent0"
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{a} / {b} runs",
                  "a": {
                    "$computed": "agg",
                    "args": {
                      "arr": {
                        "$state": "/projects"
                      },
                      "field": "hits",
                      "op": "sum"
                    }
                  },
                  "b": {
                    "$computed": "agg",
                    "args": {
                      "arr": {
                        "$state": "/projects"
                      },
                      "field": "runs",
                      "op": "sum"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Total runs",
              "value": {
                "$computed": "aggFmt",
                "args": {
                  "arr": {
                    "$state": "/projects"
                  },
                  "field": "runs",
                  "op": "sum",
                  "fmt": "number"
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{n} failed",
                  "n": {
                    "$computed": "agg",
                    "args": {
                      "arr": {
                        "$state": "/projects"
                      },
                      "field": "failures",
                      "op": "sum"
                    }
                  }
                }
              },
              "tone": {
                "$computed": "aggTone",
                "args": {
                  "arr": {
                    "$state": "/projects"
                  },
                  "field": "failures",
                  "op": "sum",
                  "gt": 0,
                  "then": "bad",
                  "else": "good"
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Cache footprint",
              "value": {
                "$computed": "fmtBytes",
                "args": {
                  "b": {
                    "$state": "/stats/totalBytes"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{n} entries",
                  "n": {
                    "$state": "/stats/entryCount"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "Grid",
        "props": {
          "variant": "main-280"
        },
        "children": [
          {
            "type": "Card",
            "props": {
              "title": "Activity — last 30 days",
              "actionText": "runs · failures"
            },
            "children": [
              {
                "type": "LineChart",
                "props": {
                  "rows": {
                    "$state": "/trends"
                  },
                  "xKey": "t",
                  "xFormat": "date",
                  "yFormat": "count",
                  "height": 300,
                  "series": [
                    {
                      "name": "runs",
                      "yKey": "runs",
                      "strokeClass": "stroke-accent",
                      "areaClass": "fill-accent/10"
                    },
                    {
                      "name": "failures",
                      "yKey": "failures",
                      "strokeClass": "stroke-danger"
                    }
                  ]
                }
              }
            ]
          },
          {
            "type": "Card",
            "props": {
              "title": "Live activity",
              "actionText": "SSE"
            },
            "children": [
              {
                "type": "LiveActivity",
                "props": {}
              }
            ]
          }
        ]
      },
      {
        "type": "Grid",
        "props": {
          "variant": "cols-2"
        },
        "children": [
          {
            "type": "Card",
            "props": {
              "title": "Top time-burners",
              "actionHref": "/tasks",
              "actionLabel": "all tasks",
              "noPad": true
            },
            "children": [
              {
                "type": "RankList",
                "props": {
                  "items": {
                    "$state": "/topTasks"
                  },
                  "labelKey": "id",
                  "valueKey": "totalDurationMs",
                  "valueFormat": "duration",
                  "indexed": true,
                  "metaKey": "runs",
                  "metaSuffix": "×",
                  "rowHref": "/tasks/{id}",
                  "emptyTitle": "Nothing executed yet",
                  "emptyCmd": "vx run <task>"
                }
              }
            ]
          },
          {
            "type": "Card",
            "props": {
              "title": "Recent failures",
              "actionHref": "/tasks",
              "actionLabel": "all tasks",
              "noPad": true
            },
            "children": [
              {
                "type": "RankList",
                "props": {
                  "items": {
                    "$state": "/failures"
                  },
                  "labelTemplate": "{project}#{task}",
                  "valueKey": "startedAt",
                  "valueFormat": "relativeTime",
                  "metaKey": "exitCode",
                  "metaPrefix": "exit ",
                  "rowTaskRef": {},
                  "emptyTitle": "No failures 🎉"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Grid",
        "props": {
          "variant": "main-320"
        },
        "children": [
          {
            "type": "Card",
            "props": {
              "title": "Cache footprint by project",
              "actionHref": "/cache",
              "actionLabel": "cache"
            },
            "children": [
              {
                "type": "Treemap",
                "props": {
                  "rows": {
                    "$state": "/projects"
                  },
                  "labelKey": "project",
                  "valueKey": "cacheBytes",
                  "valueFormat": "bytes",
                  "height": 240
                }
              }
            ]
          },
          {
            "type": "Card",
            "props": {
              "title": "Project leaderboard",
              "actionHref": "/projects",
              "actionLabel": "all",
              "noPad": true
            },
            "children": [
              {
                "type": "RankList",
                "props": {
                  "items": {
                    "$state": "/projects"
                  },
                  "labelKey": "project",
                  "valueKey": "totalDurationMs",
                  "valueFormat": "duration",
                  "metaKey": "runs",
                  "metaSuffix": "×",
                  "barFrom": "totalDurationMs",
                  "colorFrom": "project",
                  "rowHref": "/projects/{project}",
                  "limit": 6,
                  "emptyTitle": "No projects discovered"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Recent invocations",
          "noPad": true
        },
        "children": [
          {
            "type": "DataTable",
            "props": {
              "rows": {
                "$state": "/invocations"
              },
              "rowHref": "/runs/{runId}",
              "emptyTitle": "No invocations yet",
              "emptyCmd": "vx run <task>",
              "columns": [
                {
                  "key": "runId",
                  "label": "Run",
                  "kind": "shorthash",
                  "len": 8
                },
                {
                  "key": "startedAt",
                  "label": "Started",
                  "align": "right",
                  "kind": "relativeTime",
                  "baseTone": "faint"
                },
                {
                  "key": "totalDurationMs",
                  "label": "Duration",
                  "align": "right",
                  "kind": "duration"
                },
                {
                  "key": "taskCount",
                  "label": "Tasks",
                  "align": "right"
                },
                {
                  "key": "failedCount",
                  "label": "Failed",
                  "align": "right",
                  "tone": {
                    "gt": 0,
                    "tone": "danger"
                  }
                },
                {
                  "key": "hitCount",
                  "label": "Hits",
                  "align": "right",
                  "baseTone": "cache"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
