{
  "data": {
    "trends": "trends",
    "storage": "storage",
    "heatmap": "heatmap",
    "parallelism": "parallelism"
  },
  "spec": {
    "type": "Page",
    "props": {
      "title": "Trends",
      "subtitle": "Patterns over time — when builds happen, how the cache grows, how parallel you run."
    },
    "children": [
      {
        "type": "Card",
        "props": {
          "title": "Runs per day (last 30d)"
        },
        "children": [
          {
            "type": "LineChart",
            "props": {
              "rows": {
                "$state": "/trends"
              },
              "xKey": "t",
              "xFormat": "date",
              "yFormat": "count",
              "height": 320,
              "series": [
                {
                  "name": "runs",
                  "yKey": "runs",
                  "strokeClass": "stroke-accent",
                  "areaClass": "fill-accent/10"
                },
                {
                  "name": "hits",
                  "yKey": "hits",
                  "strokeClass": "stroke-cache-local"
                },
                {
                  "name": "failures",
                  "yKey": "failures",
                  "strokeClass": "stroke-danger"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Grid",
        "props": {
          "variant": "main-320"
        },
        "children": [
          {
            "type": "Card",
            "props": {
              "title": "Total duration per day (last 30d)"
            },
            "children": [
              {
                "type": "LineChart",
                "props": {
                  "rows": {
                    "$state": "/trends"
                  },
                  "xKey": "t",
                  "xFormat": "date",
                  "yFormat": "duration",
                  "height": 320,
                  "series": [
                    {
                      "name": "duration",
                      "yKey": "totalDurationMs",
                      "strokeClass": "stroke-info",
                      "areaClass": "fill-info/10"
                    }
                  ]
                }
              }
            ]
          },
          {
            "type": "Card",
            "props": {
              "title": "When you build",
              "actionText": "last 30d"
            },
            "children": [
              {
                "type": "Heatmap",
                "props": {
                  "rows": {
                    "$state": "/heatmap"
                  },
                  "valueKey": "runs",
                  "cellSize": 14
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Cache storage growth (entries added per day)"
        },
        "children": [
          {
            "type": "LineChart",
            "props": {
              "rows": {
                "$state": "/storage"
              },
              "xKey": "t",
              "xFormat": "date",
              "yFormat": "bytes",
              "height": 280,
              "series": [
                {
                  "name": "bytes",
                  "yKey": "bytesAdded",
                  "strokeClass": "stroke-accent-2",
                  "areaClass": "fill-accent-2/10"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Parallelism factor per invocation",
          "actionText": "cpu sum / wall time — 1.0 = serial"
        },
        "children": [
          {
            "type": "Stack",
            "props": {
              "gap": "4"
            },
            "children": [
              {
                "type": "Grid",
                "props": {
                  "variant": "cols-3"
                },
                "children": [
                  {
                    "type": "Metric",
                    "props": {
                      "label": "Avg parallelism",
                      "value": {
                        "$computed": "aggFmt",
                        "args": {
                          "arr": {
                            "$state": "/parallelism"
                          },
                          "field": "factor",
                          "op": "avg",
                          "fmt": "multiplier"
                        }
                      },
                      "sub": "across recent runs"
                    }
                  },
                  {
                    "type": "Metric",
                    "props": {
                      "label": "Best invocation",
                      "value": {
                        "$computed": "aggFmt",
                        "args": {
                          "arr": {
                            "$state": "/parallelism"
                          },
                          "field": "factor",
                          "op": "max",
                          "fmt": "multiplier"
                        }
                      }
                    }
                  },
                  {
                    "type": "Metric",
                    "props": {
                      "label": "Total CPU time",
                      "value": {
                        "$computed": "aggFmt",
                        "args": {
                          "arr": {
                            "$state": "/parallelism"
                          },
                          "field": "cpuSumMs",
                          "op": "sum",
                          "fmt": "duration"
                        }
                      }
                    }
                  }
                ]
              },
              {
                "type": "LineChart",
                "props": {
                  "rows": {
                    "$state": "/parallelism"
                  },
                  "reverse": true,
                  "xKey": "startedAt",
                  "xFormat": "date",
                  "yFormat": "multiplier",
                  "height": 240,
                  "series": [
                    {
                      "name": "parallelism",
                      "yKey": "factor",
                      "strokeClass": "stroke-chart-3",
                      "areaClass": "fill-chart-3/10"
                    }
                  ]
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
