{
  "data": {
    "run": "run"
  },
  "spec": {
    "type": "Page",
    "props": {
      "backHref": "/",
      "backLabel": "runs",
      "title": {
        "$computed": "text",
        "args": {
          "tpl": "Run {id}",
          "id": {
            "$state": "/params/id"
          }
        }
      },
      "mono": true
    },
    "children": [
      {
        "type": "Text",
        "props": {
          "text": "Loading…",
          "tone": "faint"
        },
        "visible": {
          "$state": "/runStatus",
          "eq": "loading"
        }
      },
      {
        "type": "Empty",
        "props": {
          "title": "Run not found"
        },
        "visible": {
          "$state": "/runStatus",
          "eq": "missing"
        }
      },
      {
        "type": "Grid",
        "props": {
          "variant": "metrics-5"
        },
        "visible": {
          "$state": "/runStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "Metric",
            "props": {
              "label": "Tasks",
              "value": {
                "$computed": "fmtNumber",
                "args": {
                  "n": {
                    "$computed": "agg",
                    "args": {
                      "arr": {
                        "$state": "/run/tasks"
                      },
                      "op": "count"
                    }
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{a} ok · {b} fail · {c} hits",
                  "a": {
                    "$computed": "countWhere",
                    "args": {
                      "arr": {
                        "$state": "/run/tasks"
                      },
                      "field": "status",
                      "eq": "success"
                    }
                  },
                  "b": {
                    "$computed": "countWhere",
                    "args": {
                      "arr": {
                        "$state": "/run/tasks"
                      },
                      "field": "status",
                      "eq": "failed"
                    }
                  },
                  "c": {
                    "$computed": "countWhere",
                    "args": {
                      "arr": {
                        "$state": "/run/tasks"
                      },
                      "field": "cacheHit",
                      "eq": true
                    }
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Wall time",
              "value": {
                "$computed": "fmtDuration",
                "args": {
                  "ms": {
                    "$computed": "span",
                    "args": {
                      "arr": {
                        "$state": "/run/tasks"
                      },
                      "start": "startedAt",
                      "end": "endedAt"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Total task time",
              "value": {
                "$computed": "aggFmt",
                "args": {
                  "arr": {
                    "$state": "/run/tasks"
                  },
                  "field": "durationMs",
                  "op": "sum",
                  "fmt": "duration"
                }
              },
              "sub": "sum across all tasks"
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "CPU time",
              "value": {
                "$computed": "aggFmt",
                "args": {
                  "arr": {
                    "$state": "/run/tasks"
                  },
                  "field": "cpuMs",
                  "op": "sum",
                  "fmt": "duration"
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Outcome",
              "value": {
                "$computed": "gt",
                "args": {
                  "v": {
                    "$computed": "countWhere",
                    "args": {
                      "arr": {
                        "$state": "/run/tasks"
                      },
                      "field": "status",
                      "eq": "failed"
                    }
                  },
                  "n": 0,
                  "then": "failed",
                  "else": "success"
                }
              },
              "tone": {
                "$computed": "gt",
                "args": {
                  "v": {
                    "$computed": "countWhere",
                    "args": {
                      "arr": {
                        "$state": "/run/tasks"
                      },
                      "field": "status",
                      "eq": "failed"
                    }
                  },
                  "n": 0,
                  "then": "bad",
                  "else": "good"
                }
              }
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Timeline"
        },
        "visible": {
          "$state": "/runStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "Flamegraph",
            "props": {
              "rows": {
                "$state": "/run/tasks"
              }
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": {
            "$computed": "text",
            "args": {
              "tpl": "Tasks ({n})",
              "n": {
                "$computed": "agg",
                "args": {
                  "arr": {
                    "$state": "/run/tasks"
                  },
                  "op": "count"
                }
              }
            }
          },
          "noPad": true
        },
        "visible": {
          "$state": "/runStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "DataTable",
            "props": {
              "rows": {
                "$state": "/run/tasks"
              },
              "rowTaskRef": {},
              "emptyTitle": "No tasks",
              "columns": [
                {
                  "key": "task",
                  "label": "Task",
                  "kind": "projtask"
                },
                {
                  "key": "status",
                  "label": "Status",
                  "kind": "status"
                },
                {
                  "key": "durationMs",
                  "label": "Duration",
                  "align": "right",
                  "kind": "duration"
                },
                {
                  "key": "cpuMs",
                  "label": "CPU",
                  "align": "right",
                  "kind": "duration",
                  "baseTone": "faint"
                },
                {
                  "key": "peakRssBytes",
                  "label": "Peak RSS",
                  "align": "right",
                  "kind": "bytes",
                  "baseTone": "faint"
                },
                {
                  "key": "cacheHit",
                  "label": "Cache",
                  "align": "right",
                  "kind": "cache"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
