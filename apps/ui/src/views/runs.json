{
  "data": { "runs": "invocationsAll" },
  "spec": {
    "type": "Page",
    "props": { "title": "Runs" },
    "children": [
      {
        "type": "Grid",
        "props": { "variant": "metrics-4" },
        "visible": { "$state": "/runsStatus", "eq": "ok" },
        "children": [
          {
            "type": "Metric",
            "props": {
              "label": "Recent runs",
              "value": { "$computed": "aggFmt", "args": { "arr": { "$state": "/runs" }, "op": "count", "fmt": "count" } }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Tasks run",
              "value": { "$computed": "aggFmt", "args": { "arr": { "$state": "/runs" }, "field": "taskCount", "op": "sum", "fmt": "count" } }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Failed",
              "value": { "$computed": "aggFmt", "args": { "arr": { "$state": "/runs" }, "field": "failedCount", "op": "sum", "fmt": "count" } },
              "tone": { "$computed": "aggTone", "args": { "arr": { "$state": "/runs" }, "field": "failedCount", "op": "sum", "gt": 0, "then": "bad", "else": "good" } }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Cache hits",
              "value": { "$computed": "aggFmt", "args": { "arr": { "$state": "/runs" }, "field": "hitCount", "op": "sum", "fmt": "count" } }
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": { "title": "All runs", "noPad": true },
        "children": [
          {
            "type": "DataTable",
            "props": {
              "rows": { "$state": "/runs" },
              "rowHref": "/runs/{runId}",
              "filter": true,
              "filterFrom": ["runId"],
              "filterPlaceholder": "filter by run id…",
              "initialSort": { "key": "startedAt", "desc": true },
              "emptyTitle": "No invocations yet",
              "emptyCmd": "vx run <task>",
              "columns": [
                { "key": "runId", "label": "Run", "kind": "shorthash", "len": 8 },
                { "key": "startedAt", "label": "Started", "align": "right", "kind": "relativeTime", "baseTone": "faint", "sortable": true },
                { "key": "totalDurationMs", "label": "Duration", "align": "right", "kind": "duration", "sortable": true },
                { "key": "taskCount", "label": "Tasks", "align": "right", "sortable": true },
                { "key": "failedCount", "label": "Failed", "align": "right", "tone": { "gt": 0, "tone": "danger" }, "sortable": true },
                { "key": "hitCount", "label": "Hits", "align": "right", "baseTone": "cache", "sortable": true }
              ]
            }
          }
        ]
      }
    ]
  }
}
