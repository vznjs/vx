---
// vx landing page — standalone marketing homepage.
//
// Ported from the Vx Design System website UI kit
// (claude.ai/design handoff bundle). This is a full custom page that
// REPLACES the Starlight splash homepage: it ships its own nav, footer
// and dark "phosphor-on-ink" theme. Docs pages stay Starlight-themed.
import '../styles/landing.css'

const base = import.meta.env.BASE_URL // '/vx/' on Pages, '/' on a custom domain
const href = (p: string) => `${base}${p}`
const GH = 'https://github.com/vznjs/vx'

// Terminal meters (▰ filled / ▱ empty) — faithful to real `vx run` output.
const meter = (on: number, total = 50) => ({
  on: '▰'.repeat(on),
  off: '▱'.repeat(Math.max(total - on, 0)),
})
const projects = meter(25) // round(1 affected / 2 total · 50)
const tasks = meter(50)
const cache = meter(50)
const dashes = '─'.repeat(80)

// Real `vx run` rows. The id paints as project-hue `@vzn/vx` + dim `#` +
// pink task, exactly like the CLI's identity coloring.
const termTasks = [
  { time: '241ms', proj: '@vzn/vx', task: 'build.bun.darwin-x64' },
  { time: '243ms', proj: '@vzn/vx', task: 'build.bun.linux-arm64' },
  { time: '242ms', proj: '@vzn/vx', task: 'build.bun.darwin-arm64' },
  { time: '245ms', proj: '@vzn/vx', task: 'build.bun.linux-x64' },
]

// Differentiators only — the things Turbo and Nx can't do. Every claim
// traces to README.md / docs (no table-stakes like "affected graph",
// which both competitors already ship).
const features = [
  {
    icon: 'cache',
    tone: 'var(--phosphor)',
    title: 'The cache understands your config',
    body: 'vx.config.ts is evaluated before hashing, so imports, shared presets and computed values all participate in the cache key. Change a preset and exactly the right tasks re-run. Turbo and Nx hash static JSON — they can’t see this.',
  },
  {
    icon: 'box',
    tone: 'var(--plasma)',
    title: 'Outputs are owned',
    body: 'Declared outputs are wiped before every run and every restore, so your tree ends bit-identical to the cache — stale files cannot survive. Turbo and Nx are additive: leftovers linger.',
  },
  {
    icon: 'bolt',
    tone: 'var(--amber)',
    title: 'No daemon to babysit',
    body: 'One binary, no Node, nothing long-lived. On a clean tree, every cache key comes from the git index with zero file reads — 3.2× faster warm at 15k files. Nx needs a daemon for this; vx doesn’t.',
  },
  {
    icon: 'shield',
    tone: 'var(--phosphor)',
    title: 'Per-task kernel sandbox',
    body: 'Run any task under an OS-level file + network allow-list with sandbox: {}. An undeclared read or a phone-home fails the build instead of hiding it. No other runner has it.',
  },
  {
    icon: 'lock',
    tone: 'var(--plasma)',
    title: 'A cache you can interrogate — and prove',
    body: 'vx why names the exact file, env var or upstream that moved a task’s key instead of “miss”. vx run --verify re-runs a task and compares outputs byte for byte; --verify=inputs runs it under the sandbox so an undeclared read is a reported failure. No other runner can tell you why it re-ran.',
  },
  {
    icon: 'graph',
    tone: 'var(--amber)',
    title: 'Reproducible when you want',
    body: 'vx lock freezes the fully-resolved task graph into vx-lock.json; --frozen runs skip evaluation entirely and run exactly that graph. No other runner has an equivalent.',
  },
]

// The pipeline — what plugins can decide. Every claim traces to
// docs/design/pipeline-2026-09.md and the plugin guide.
const platform = [
  {
    icon: 'plug',
    tone: 'var(--amber)',
    title: 'A pipeline with a hook at every stage',
    body: 'One VxPlugin object, Vite-style: project() adds or rewrites a package’s tasks (keyed exactly like yours), graph() edits the edges, key() folds extra material into the cache key, schedule() decides which ready task runs first, commands adds verbs to vx. Declaration order is the order; core re-validates what a stage produced.',
  },
  {
    icon: 'wire',
    tone: 'var(--phosphor)',
    title: 'Nothing applied by default',
    body: 'Core is only the pipeline — fully offline, no account, no service. Where a task runs (executor), where artifacts live (cache) and where run records go (telemetry) are plugins you declare in vx.workspace.ts. Even vx’s own local executor and cache are plugins, so “replace any part” is pinned, not promised.',
  },
  {
    icon: 'cloud',
    tone: 'var(--plasma)',
    title: 'Bazel-compatible remote cache and execution',
    body: '@vzn/vx-reapi speaks the Bazel Remote Execution API: NativeLink, BuildBuddy, Buildbarn and bazel-remote work as a shared cache, and NativeLink’s workers run your tasks remotely — the executor seam, filled by a plugin, with nothing distributed shipped in core.',
  },
  {
    icon: 'spark',
    tone: 'var(--phosphor)',
    title: 'MCP for AI agents',
    body: '@vzn/vx-mcp adds vx mcp: a read-only Model Context Protocol server over stdio, so Claude Code, Cursor and Continue.dev query cache stats, run history and rebuild causes through the standard agent-tool protocol. No SDK, no service — a plugin on the commands seam.',
  },
  {
    icon: 'brain',
    tone: 'var(--amber)',
    title: 'Scheduling that learns — as a plugin',
    body: '@vzn/vx/plugins/schedule-history orders ready tasks by the expected remaining critical path learned from your own run history. It is the reference schedule() plugin: a policy core exposes a hook for, not a flag core carries.',
  },
]

const featIcons: Record<string, string> = {
  cache:
    '<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.66 3.58 3 8 3s8-1.34 8-3V6"/><path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/>',
  graph:
    '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="M7.7 7.8L10.5 16M16.3 7.8L13.5 16"/>',
  shield: '<path d="M12 2l8 3v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V5l8-3z"/><path d="M9 12l2 2 4-4"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/>',
  box: '<path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3.5 8l8.5 5 8.5-5M12 13v8"/>',
  lock: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>',
  // Platform icons
  spark: '<path d="M12 2v6M12 16v6M2 12h6M16 12h6M5 5l3 3M16 16l3 3M5 19l3-3M16 8l3-3"/>',
  mesh: '<circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/><circle cx="12" cy="12" r="2"/><path d="M8 7l3 4M16 7l-3 4M11 13l-3 3M13 13l3 3"/>',
  plug: '<path d="M9 2v6M15 2v6M7 8h10v4a5 5 0 01-10 0V8zM12 17v5"/>',
  wire: '<path d="M3 8h6l3 8h6M3 16h6l3-8h6"/>',
  cloud: '<path d="M17.5 19a4.5 4.5 0 100-9 6 6 0 00-11.5 1.5A4.5 4.5 0 006.5 19h11z"/>',
  brain: '<path d="M9 3a3 3 0 00-3 3v1a3 3 0 00-3 3v2a3 3 0 003 3v1a3 3 0 003 3M15 3a3 3 0 013 3v1a3 3 0 013 3v2a3 3 0 01-3 3v1a3 3 0 01-3 3M9 12h6M9 7h6M9 17h6"/>',
}

const benchRows = [
  {
    task: 'Cold build · from scratch',
    bars: [
      { name: 'baseline', val: 218000, disp: '3m 38s', c: 'var(--c-baseline)' },
      { name: 'vx', val: 225708, disp: '3m 46s', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 313463, disp: '5m 13s', c: 'var(--c-turbo)' },
      { name: 'nx', val: 2084171, disp: '34m 44s', c: 'var(--c-nx)' },
    ],
  },
  {
    task: 'Fully cached · nothing to rebuild',
    bars: [
      { name: 'baseline', val: 66, disp: '66ms', c: 'var(--c-baseline)' },
      { name: 'vx', val: 549, disp: '549ms', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 760, disp: '760ms', c: 'var(--c-turbo)' },
      { name: 'nx', val: 3594, disp: '3.59s', c: 'var(--c-nx)' },
    ],
  },
  {
    task: 'Restoring outputs · cache → disk',
    bars: [
      { name: 'baseline', val: 364, disp: '364ms', c: 'var(--c-baseline)' },
      { name: 'vx', val: 844, disp: '844ms', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 1174, disp: '1.17s', c: 'var(--c-turbo)' },
      { name: 'nx', val: 4149, disp: '4.15s', c: 'var(--c-nx)' },
    ],
  },
  {
    task: 'CPU burned · cold build, user + system',
    bars: [
      { name: 'baseline', val: 33933, disp: '33.93s', c: 'var(--c-baseline)' },
      { name: 'vx', val: 30787, disp: '30.79s', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 73079, disp: '1m 13s', c: 'var(--c-turbo)' },
      { name: 'nx', val: 6846039, disp: '114m 06s', c: 'var(--c-nx)' },
    ],
  },
]

const footCols = {
  product: [
    { t: 'Benchmarks', h: href('benchmarks/') },
    { t: 'Quickstart', h: href('quickstart/') },
    { t: 'Architecture', h: href('architecture/') },
    { t: 'Comparison', h: href('comparison/') },
  ],
  docs: [
    { t: 'Quickstart', h: href('quickstart/') },
    { t: 'Config', h: href('schema/') },
    { t: 'CLI reference', h: href('cli/') },
    { t: 'Sandboxing', h: href('guides/sandboxing/') },
  ],
  migrate: [
    { t: 'From package.json scripts (vx init)', h: href('cli/') + '#vx-init' },
    { t: 'From Turborepo', h: href('migrate/from-turborepo/') },
    { t: 'From Nx', h: href('migrate/from-nx/') },
  ],
  community: [{ t: 'GitHub', h: GH }],
}
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>vx — End the Nx-or-Turbo compromise</title>
    <meta
      name="description"
      content="vx is a Bun-native task runner and build cache for JavaScript monorepos. Nx-scale power, Turbo-grade simplicity — faster than both, with the tradeoffs of neither."
    />
    <link rel="icon" href={href('logo-mark.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap"
    />
    <style is:global>
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class="vx-landing">
      <!-- ===================== Nav ===================== -->
      <header class="nav">
        <div class="nav-left">
          <a class="brand" href={base}>
            <img src={href('logo-mark.svg')} width="26" height="26" alt="vx" />
            <span class="word">vx</span>
          </a>
          <nav class="nav-links">
            <a href={href('quickstart/')}>docs</a>
            <a href={href('benchmarks/')}>benchmarks</a>
            <a href={href('migrate/from-turborepo/')}>migrate</a>
            <a href={href('concepts/why-vx-is-fast/')}>concepts</a>
          </nav>
        </div>
        <div class="nav-right">
          <a class="btn-github" href={GH}>
            <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"
              ><path
                d="M8 0C3.58 0 0 3.58 0 8a8 8 0 005.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.49-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.81.06 1.24.83 1.24.83.71 1.23 1.87.87 2.33.67.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.01.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 014 0c1.53-1.03 2.2-.82 2.2-.82.44 1.11.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            >
            GitHub
          </a>
          <a class="btn btn-primary btn-sm" href={href('quickstart/')}
            >Get started <span class="arr">→</span></a
          >
        </div>
      </header>

      <!-- ===================== Hero ===================== -->
      <section class="hero vx-grid-bg">
        <div class="bloom"></div>
        <div class="fade"></div>
        <div class="hero-grid container">
          <div>
            <div class="badges">
              <span class="badge badge-phosphor"><span class="dot"></span>Bun-native</span>
              <span class="badge">No daemon</span>
              <span class="badge">MIT licensed</span>
            </div>
            <h1>The monorepo orchestrator<br /><span class="phosphor">you were waiting for</span></h1>
            <p class="lede">
              A build tool shouldn't make you choose between fast and flexible, or between powerful
              and free. vx is fast and simple from the first task, fully extensible in real
              TypeScript as you scale, and yours to keep — no daemon, no proprietary cloud, nothing
              to lock you in.
            </p>
            <div class="actions">
              <a class="btn btn-primary btn-lg" href={href('quickstart/')}
                >Get started <span class="arr">→</span></a
              >
              <button class="install-pill" data-copy="bun add -d @vzn/vx" type="button">
                <span class="dollar">$</span>
                <span class="cmd">bun add -d @vzn/vx</span>
                <span class="copy">
                  <svg
                    class="icon-copy"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    ><rect x="9" y="9" width="11" height="11" rx="2"></rect><path
                      d="M5 15V5a2 2 0 012-2h10"></path></svg
                  >
                  <svg
                    class="icon-check"
                    width="15"
                    height="15"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"><path d="M20 6L9 17l-5-5"></path></svg
                  >
                </span>
              </button>
            </div>
            <div class="stats">
              <div class="stat">
                <span class="val"><span class="num">559</span><span class="unit">ms</span></span>
                <span class="label">Full cache replay</span>
                <span class="sub">3,270 tasks · 1,090 packages</span>
              </div>
              <div class="stat plasma">
                <span class="val"><span class="num">2.1</span><span class="unit">×</span></span>
                <span class="label">Less CPU burned</span>
                <span class="sub">vs Turborepo 2.10</span>
              </div>
              <div class="stat amber">
                <span class="val"><span class="num">6.4</span><span class="unit">×</span></span>
                <span class="label">Faster warm runs</span>
                <span class="sub">vs Nx 23</span>
              </div>
            </div>
          </div>

          <!-- Terminal -->
          <div class="term">
            <div class="term-bar-top">
              <span class="tdot" style="background:#ff5f57"></span>
              <span class="tdot" style="background:#febc2e"></span>
              <span class="tdot" style="background:#28c840"></span>
              <span class="ttitle">zsh — vx</span>
            </div>
            <div class="term-body">
              <div class="term-prompt">
                <span class="caret">❯ </span><span class="cmd">vx run build --affected</span>
              </div>
              {
                termTasks.map((t) => (
                  <div class="term-task">
                    <span class="glyph">⏺ </span>
                    <span class="time">{t.time}</span>
                    <span class="ok">success</span>
                    <span class="cache">miss</span>
                    <span class="target">
                      <span class="t-proj">{t.proj}</span><span class="t-dim">#</span><span
                        class="t-pink">{t.task}</span
                      >
                    </span>
                  </div>
                ))
              }
              <div class="term-gap"></div>
              <div class="term-rule">
                <span class="t-dim">─ </span><span class="mark">vx 0.0.0</span><span class="t-dim"
                  > </span
                ><span class="fill">{dashes}</span>
              </div>
              <div style="height:4px"></div>
              <div class="term-row">
                <span class="lbl">projects</span>
                <span class="v"
                  ><span class="term-meter"
                    ><span class="t-yellow">{projects.on}</span><span class="off"
                      >{projects.off}</span
                    ></span
                  ></span
                >
              </div>
              <div class="term-row">
                <span class="lbl"></span><span class="v"
                  ><span class="t-yellow">1 affected</span><span class="t-dim"> · 2 total</span></span
                >
              </div>
              <div style="height:6px"></div>
              <div class="term-row">
                <span class="lbl">tasks</span>
                <span class="v"
                  ><span class="term-meter"
                    ><span class="t-green">{tasks.on}</span><span class="off">{tasks.off}</span></span
                  ></span
                >
              </div>
              <div class="term-row">
                <span class="lbl"></span><span class="v"
                  ><span class="t-green">4 success</span><span class="t-dim"> · 4 total</span></span
                >
              </div>
              <div style="height:6px"></div>
              <div class="term-row">
                <span class="lbl">cache</span>
                <span class="v"
                  ><span class="term-meter"
                    ><span class="t-red">{cache.on}</span><span class="off">{cache.off}</span></span
                  ></span
                >
              </div>
              <div class="term-row">
                <span class="lbl"></span><span class="v"><span class="t-red">4 miss</span></span>
              </div>
              <div class="term-gap"></div>
              <div class="term-row">
                <span class="lbl">info</span><span class="v t-dim">10 workers · local cache</span>
              </div>
              <div class="term-row">
                <span class="lbl">time</span>
                <span class="v"
                  ><span class="term-time">252ms</span><span class="term-time-rest"
                    > · max 245ms · avg 243ms · min 241ms</span
                  ></span
                >
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ===================== Features ===================== -->
      <section class="section container">
        <div class="section-head">
          <p class="vx-kicker">// only in vx</p>
          <h2>What sets vx apart.</h2>
        </div>
        <div class="feat-grid">
          {
            features.map((f) => (
              <div class="feat-card" style={`--c:${f.tone}`}>
                <span class="ico">
                  <svg
                    width="21"
                    height="21"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={featIcons[f.icon]}
                  />
                </span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </div>
            ))
          }
        </div>
      </section>

      <!-- ===================== Platform layer ===================== -->
      <section class="section container">
        <div class="section-head">
          <p class="vx-kicker">// beyond a task runner</p>
          <h2>The open platform layer.</h2>
          <p class="vx-sub">
            One binary. Eight surfaces. Every contract is documented; every wire
            is JSON-RPC 2.0. Subscribe, query, drive, extend — your stack, your
            tools, your data.
          </p>
        </div>
        <div class="feat-grid">
          {
            platform.map((f) => (
              <a
                class="feat-card platform-card"
                style={`--c:${f.tone}`}
                href={
                  f.icon === 'spark'
                    ? href('guides/mcp/')
                    : f.icon === 'plug'
                      ? href('guides/plugins/')
                      : f.icon === 'wire'
                        ? href('guides/extensibility/')
                        : f.icon === 'cloud'
                          ? href('guides/remote-caching/')
                          : href('guides/plugins/') + '#keys-and-order'
                }
              >
                <span class="ico">
                  <svg
                    width="21"
                    height="21"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={featIcons[f.icon]}
                  />
                </span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
                <span class="learn">Learn more →</span>
              </a>
            ))
          }
        </div>
      </section>

      <!-- ===================== Benchmark ===================== -->
      <section class="bench">
        <div class="bench-panel container vx-scanlines">
          <div class="bench-head">
            <div>
              <p class="vx-kicker">// 3,270 tasks · 1,090 packages</p>
              <h2>Lower is better. We checked.</h2>
            </div>
            <div class="bench-legend">
              <span class="legend"><span class="sw" style="background:var(--phosphor)"></span>vx</span>
              <span class="legend"
                ><span class="sw" style="background:var(--c-turbo)"></span>turborepo</span
              >
              <span class="legend"><span class="sw" style="background:var(--c-nx)"></span>nx</span>
            </div>
          </div>
          <div class="bench-rows">
            {
              benchRows.map((r) => {
                const rowMax = Math.max(...r.bars.map((b) => b.val))
                return (
                  <div class="bench-row">
                    <p class="task">{r.task}</p>
                    {r.bars.map((b) => {
                      const pct = Math.max((b.val / rowMax) * 100, 3)
                      return (
                        <div
                          class={`bench-bar${b.best ? ' best' : ''}${b.name === 'baseline' ? ' baseline' : ''}`}
                          style={`--c:${b.c};--w:${pct}%`}
                        >
                          <span class="name">{b.name}</span>
                          <span class="track">
                            <span class="fill" />
                          </span>
                          <span class="disp">{b.disp}</span>
                        </div>
                      )
                    })}
                  </div>
                )
              })
            }
          </div>
          <div class="bench-note">
            <p>
              1,090 packages, 3,270 tasks, 100 dependency layers, identical commands, every runner
              pinned to the same concurrency, daemons on for the others, measured one at a time
              (2026-09-03, Turborepo 2.10.12, Nx 23.2.0, Apple silicon, 10 cores). The tasks are
              <code>sleep 1</code>, so the clock measures the runner and CPU measures its overhead:
              vx burned 34 s to build the whole graph cold, Turborepo 73 s, Nx 114 minutes. Warm,
              vx replays 3,270 tasks in 559 ms; Turborepo 760 ms; Nx 3.6 s. Reproduce with
              <code>bun bench/compare.ts 100 11 1</code>; the committed results are this run. The dashed <em>baseline</em> bar is the theoretical best case: cold is the tasks' own 3m 38s on 10 perfectly parallel workers along the dependency graph, warm is one <code>git status</code> walk (66ms), restore adds a raw copy of every output file, and CPU is the tasks' own shells under <code>xargs</code> (33.93s) — what is left above it is the runner. At this size the CPU floor and a runner's own CPU each vary by about two seconds between runs, so vx's cold CPU sits within the floor's noise.
            </p>
          </div>
        </div>
      </section>

      <!-- ===================== Config ===================== -->
      <section class="config">
