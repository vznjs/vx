---
// One benchmark group: a label plus a row per runner, driven as a LIVE
// SIMULATION. Every row shares one clock; the fills sweep together in real
// time, each freezing when its run finishes — so the runners race, vx locks
// in (near-instant) while Turbo/Nx keep going. The final time is always
// shown, and bar lengths are relative to the slowest in the group (slowest =
// full width). The clock is sped up so the slowest run plays out over WINDOW
// real seconds.
import BenchBar from './BenchBar.astro'

interface Row {
  name: string
  value: string
  n: number
  hero?: boolean
}
interface Props {
  title: string
  note?: string
  rows: Row[]
}

const { title, note, rows } = Astro.props
const max = Math.max(...rows.map((r) => r.n))
---

<div class="chart" data-max={max}>
  <p class="label">{title}{note ? <span>{note}</span> : null}</p>
  {
    rows.map((r) => {
      const pct = Math.round((r.n / max) * 1000) / 10
      return <BenchBar name={r.name} value={r.value} n={r.n} pct={pct} hero={r.hero ?? false} />
    })
  }
</div>

<style>
  .chart {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.6rem;
  }
  .label {
    margin: 0 0 0.1rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .label span {
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.76rem;
    margin-left: 0.5rem;
    color: var(--vx-pink);
    background: color-mix(in srgb, var(--vx-violet) 15%, transparent);
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
  }
</style>

<script>
  // Live simulation: one shared clock per chart, sped up so the slowest run
  // plays out over WINDOW seconds. Each row's fill sweeps in real time and
  // freezes when its run finishes; the front advances at one speed for all
  // rows (shared timeline), so the fastest finishes first. The final time is
  // always shown (rendered server-side). Replays on scroll into view. CSS owns
  // the final fixed state, so no-JS / reduced-motion shows correct charts.
  const WINDOW = 3.4 // real seconds for the slowest bar in a chart

  interface Lane {
    n: number
    prog: HTMLElement
  }
  function lanesOf(chart: HTMLElement): Lane[] {
    return [...chart.querySelectorAll<HTMLElement>('.lane')].map((el) => ({
      n: Number(el.dataset.n),
      prog: el.querySelector<HTMLElement>('.prog')!,
    }))
  }
  const setWidth = (lanes: Lane[], pct: string) => lanes.forEach((L) => (L.prog.style.width = pct))

  const raf = new WeakMap<HTMLElement, number>()
  function play(chart: HTMLElement) {
    const max = Number(chart.dataset.max)
    const lanes = lanesOf(chart)
    const speed = max / WINDOW // simulated seconds per real second
    const prev = raf.get(chart)
    if (prev) cancelAnimationFrame(prev)
    setWidth(lanes, '0%')
    let start = 0
    const frame = (ts: number) => {
      if (!start) start = ts
      const sim = ((ts - start) / 1000) * speed
      let done = true
      for (const L of lanes) {
        const t = Math.min(sim, L.n)
        L.prog.style.width = `${(t / L.n) * 100}%`
        if (sim < L.n) done = false
      }
      if (!done) raf.set(chart, requestAnimationFrame(frame))
    }
    raf.set(chart, requestAnimationFrame(frame))
  }

  const charts = document.querySelectorAll<HTMLElement>('.chart')
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches

  if (!reduced) {
    // Start collapsed so scrolling a chart into view plays it from zero.
    charts.forEach((c) => setWidth(lanesOf(c), '0%'))
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const c = e.target as HTMLElement
          if (e.isIntersecting) play(c)
          else {
            const id = raf.get(c)
            if (id) cancelAnimationFrame(id)
            setWidth(lanesOf(c), '0%')
          }
        }
      },
      { threshold: 0.4 },
    )
    charts.forEach((c) => io.observe(c))
  }
</script>
