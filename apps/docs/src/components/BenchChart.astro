---
// One benchmark group: a label plus a row per runner.
//
// Bars are normalised to the SLOWEST run in the group (longest = 100%). The
// whole group animates on one shared window: the slowest bar fills over the
// full `window` seconds and every other bar fills proportionally — a real
// relative timeline, so the rows visibly race and the fastest finishes first.
// Reveal durations are derived from each bar's share of that window; nothing
// is hand-tuned per row.
import BenchBar from './BenchBar.astro'

interface Row {
  name: string
  value: string
  n: number
  hero?: boolean
}
interface Props {
  title: string
  note?: string
  rows: Row[]
  window?: number
}

const { title, note, rows, window = 2.6 } = Astro.props
const max = Math.max(...rows.map((r) => r.n))
---

<div class="chart">
  <p class="label">{title}{note ? <span>{note}</span> : null}</p>
  {
    rows.map((r) => {
      const pct = Math.round((r.n / max) * 1000) / 10
      const dur = Math.max(0.2, Math.round((window * pct) / 100 * 100) / 100)
      return <BenchBar name={r.name} value={r.value} pct={pct} dur={dur} hero={r.hero ?? false} />
    })
  }
</div>

<style>
  .chart {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 1.6rem;
  }
  .label {
    margin: 0 0 0.1rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .label span {
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.76rem;
    margin-left: 0.5rem;
    color: var(--vx-pink);
    background: color-mix(in srgb, var(--vx-violet) 15%, transparent);
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
  }
</style>

<script>
  // Drive the realtime fill: collapse each chart to the start line, then run
  // (and replay) the race whenever it scrolls into view. CSS owns the final,
  // fixed state, so charts are fully legible if this never runs.
  const charts = document.querySelectorAll<HTMLElement>('.chart')
  charts.forEach((c) => c.classList.add('ready'))

  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        const c = e.target as HTMLElement
        if (e.isIntersecting) {
          // Restart the animation cleanly on each entry.
          c.classList.remove('run')
          void c.offsetWidth
          c.classList.add('run')
        } else {
          c.classList.remove('run')
        }
      }
    },
    { threshold: 0.4 },
  )
  charts.forEach((c) => io.observe(c))
</script>
