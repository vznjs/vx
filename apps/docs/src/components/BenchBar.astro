---
// One benchmark row: runner name · full-width track · value label.
//
// Every row shares the SAME full-width track (the timeline). The fill grows
// to `pct` of that track over `dur` seconds — and because the whole group
// runs on one shared window (longest run = full window, see BenchChart), the
// rows race against each other in real time: the fastest fills and stops
// while the slow ones keep grinding. A leading edge-glow marks an in-progress
// fill; the value label reveals the moment that row completes. Animation is
// gated on the parent `.chart.run` class so it can replay on scroll.
interface Props {
  name: string
  value: string
  pct: number
  dur: number
  hero?: boolean
}
const { name, value, pct, dur, hero = false } = Astro.props
const style = `--pct:${pct}%;--dur:${dur}s`
---

<div class:list={['lane', { hero }]} style={style}>
  <span class="name">{name}</span>
  <div class="track"><span class="fill"></span></div>
  <span class="value">{value}</span>
</div>

<style>
  .lane {
    display: grid;
    grid-template-columns: 5rem 1fr 4.6rem;
    align-items: center;
    gap: 0.75rem;
  }
  .name {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
  }
  .hero .name {
    color: var(--sl-color-white);
  }
  .value {
    font-family: ui-monospace, 'SFMono-Regular', 'Cascadia Code', monospace;
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    text-align: right;
    white-space: nowrap;
    color: var(--sl-color-gray-3);
  }
  .hero .value {
    color: var(--vx-pink);
    font-weight: 700;
  }

  /* Full-width shared track — the timeline every row is measured against. */
  .track {
    position: relative;
    width: 100%;
    height: 0.7rem;
    border-radius: 999px;
    overflow: hidden;
    background: color-mix(in srgb, var(--sl-color-gray-4) 22%, transparent);
  }
  .hero .track {
    background: color-mix(in srgb, var(--vx-violet) 14%, transparent);
  }

  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--pct);
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-gray-2) 65%, transparent);
  }
  .hero .fill {
    background: var(--vx-grad);
    box-shadow: 0 0 14px color-mix(in srgb, var(--vx-pink) 50%, transparent);
  }
  /* Bright leading edge — reads as "still advancing" while the bar grows. */
  .fill::after {
    content: '';
    position: absolute;
    inset: 0 0 0 auto;
    width: 1.1rem;
    border-radius: 999px;
    opacity: 0;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, #fff 70%, transparent)
    );
  }
  .hero .fill::after {
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--vx-pink) 90%, transparent)
    );
  }

  /* JS-ready: collapse to the start line, waiting for the run to trigger.
     Without JS (or with reduced motion) the defaults above render the final,
     fixed state — fully accessible, no animation required. */
  :global(.chart.ready) .fill {
    width: 0;
  }
  :global(.chart.ready) .value {
    opacity: 0;
  }

  /* Running: grow the fill, sweep the edge glow, reveal the value on finish. */
  :global(.chart.run) .fill {
    animation: grow var(--dur) linear both;
  }
  :global(.chart.run) .fill::after {
    animation: edge var(--dur) linear both;
  }
  :global(.chart.run) .value {
    animation: reveal 0.3s ease both;
    animation-delay: var(--dur);
  }

  @keyframes grow {
    from {
      width: 0;
    }
    to {
      width: var(--pct);
    }
  }
  @keyframes edge {
    0% {
      opacity: 0;
    }
    8%,
    78% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateX(-0.25rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 30rem) {
    .lane {
      grid-template-columns: 3.6rem 1fr 3.6rem;
      gap: 0.5rem;
    }
    .name,
    .value {
      font-size: 0.78rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.chart.ready) .fill {
      width: var(--pct);
    }
    :global(.chart.ready) .value {
      opacity: 1;
    }
    :global(.chart.run) .fill,
    :global(.chart.run) .fill::after,
    :global(.chart.run) .value {
      animation: none;
    }
  }
</style>
