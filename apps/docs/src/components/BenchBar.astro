---
// One benchmark row: runner name · bar (length = pct) · value label.
// The fill animates from `from`% to full over `dur`s; looping rows keep a
// soft sheen so an in-progress run reads as "still working".
interface Props {
  name: string
  value: string
  pct: number
  dur: number
  from?: number
  loop?: boolean
  hero?: boolean
}
const { name, value, pct, dur, from = 0, loop = false, hero = false } = Astro.props
const style = `--pct:${pct}%;--from:${from}%;--dur:${dur}s;--rep:${loop ? 'infinite' : 1}`
---

<div class:list={['lane', { hero }]} style={style}>
  <span class="name">{name}</span>
  <div class="track"><span class:list={['fill', { sheen: loop }]}></span></div>
  <span class="value">{value}</span>
</div>

<style>
  .lane {
    display: grid;
    grid-template-columns: 5rem 1fr 4.4rem;
    align-items: center;
    gap: 0.75rem;
  }
  .name {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
  }
  .hero .name {
    color: var(--sl-color-white);
  }
  .value {
    font-family: ui-monospace, 'SFMono-Regular', 'Cascadia Code', monospace;
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    text-align: right;
    white-space: nowrap;
    color: var(--sl-color-gray-3);
  }
  .hero .value {
    color: var(--vx-pink);
    font-weight: 700;
  }

  .track {
    position: relative;
    width: var(--pct);
    min-width: 0.4rem;
    height: 0.7rem;
    border-radius: 999px;
    overflow: hidden;
    background: color-mix(in srgb, var(--sl-color-gray-4) 20%, transparent);
  }
  /* Glow on the track, not the fill — a fill box-shadow would be clipped by
     the track's overflow:hidden. */
  .hero .track {
    overflow: visible;
    box-shadow: 0 0 12px color-mix(in srgb, var(--vx-pink) 45%, transparent);
  }
  .fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-gray-2) 70%, transparent);
    animation: fill var(--dur) linear var(--rep) both;
  }
  .hero .fill {
    background: var(--vx-grad);
  }
  /* Moving sheen — only on looping (still-running) bars. */
  .sheen::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, #fff 38%, transparent),
      transparent
    );
    transform: translateX(-100%);
    animation: sheen 1.8s ease-in-out infinite;
  }

  @keyframes fill {
    from {
      width: var(--from);
    }
  }
  @keyframes sheen {
    to {
      transform: translateX(100%);
    }
  }

  @media (max-width: 30rem) {
    .lane {
      grid-template-columns: 3.5rem 1fr 3.4rem;
      gap: 0.5rem;
    }
    .name,
    .value {
      font-size: 0.78rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fill {
      animation: none;
    }
    .sheen::after {
      display: none;
    }
  }
</style>
