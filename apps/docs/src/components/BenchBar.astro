---
// One benchmark row: runner name · relative-length bar · final time.
//
// The BAR shows the runner's full relative length (slowest in the group = full
// width) and the final time is always visible. The fill is driven by the live
// simulation in BenchChart — it sweeps in real time and freezes when the run
// finishes. The defaults below render the final fixed state, so it reads fine
// with no JS.
interface Props {
  name: string
  value: string
  n: number
  pct: number
  hero?: boolean
}
const { name, value, n, pct, hero = false } = Astro.props
---

<div class:list={['lane', { hero }]} style={`--pct:${pct}%`} data-n={n}>
  <span class="name">{name}</span>
  <div class="track"><div class="bar"><span class="prog"></span></div></div>
  <span class="value">{value}</span>
</div>

<style>
  .lane {
    display: grid;
    grid-template-columns: 5rem 1fr 4.8rem;
    align-items: center;
    gap: 0.75rem;
  }
  .name {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
  }
  .hero .name {
    color: var(--sl-color-white);
  }
  .value {
    font-family: ui-monospace, 'SFMono-Regular', 'Cascadia Code', monospace;
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    text-align: right;
    white-space: nowrap;
    color: var(--sl-color-gray-3);
  }
  .hero .value {
    color: var(--vx-pink);
    font-weight: 700;
  }

  .track {
    width: 100%;
  }
  /* The bar is the runner's full relative length — always visible, solid. */
  .bar {
    position: relative;
    width: var(--pct);
    min-width: 4px;
    height: 0.8rem;
    border-radius: 999px;
    overflow: hidden;
    background: color-mix(in srgb, var(--sl-color-gray-4) 55%, transparent);
  }
  .hero .bar {
    background: color-mix(in srgb, var(--vx-violet) 30%, transparent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--vx-pink) 40%, transparent);
  }

  /* Brighter progress fill. Width is set live by the simulation; the default
     (100%) is the final fixed state for no-JS / reduced motion. */
  .prog {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    border-radius: 999px;
    background: var(--sl-color-gray-1);
  }
  .hero .prog {
    background: var(--vx-grad);
  }

  @media (max-width: 30rem) {
    .lane {
      grid-template-columns: 3.4rem 1fr 3.8rem;
      gap: 0.5rem;
    }
    .name,
    .value {
      font-size: 0.78rem;
    }
  }
</style>
