---
/**
 * A faithful mock of the GitHub Actions job-summary card vx appends to
 * `$GITHUB_STEP_SUMMARY` — the per-task result table a red build shows on
 * the job page. Styled like GitHub's rendered markdown (always light), so
 * it reads as a screenshot of the real thing.
 */
export interface GhRow {
  task: string
  ok?: boolean // true = ✅ success, false = ❌ failed, undefined = ⏭ skipped
  exit?: number // shown on a failure
  duration: string
  cache: string // "miss" | "hit (local)" | "hit (remote)"
}

interface Props {
  command: string
  passed: boolean
  stats: string // "24 tasks · 1 failed · 8 cache hits · 15 executed · 21.4s"
  hermeticity?: string // "8 proven · 0 unsafe"
  rows: GhRow[]
}

const { command, passed, stats, hermeticity, rows } = Astro.props
---

<div class="gh">
  <div class="gh-chrome">Actions · Job summary</div>
  <div class="gh-body">
    <h3 class="gh-h">
      vx run — <code>{command}</code>
    </h3>
    <p class="gh-verdict">
      {passed ? '✅ passed' : '❌ failed'} · <span set:html={stats.replace(/\*\*/g, '')} />
    </p>
    {hermeticity && <p class="gh-herm">🔒 Hermeticity: {hermeticity}</p>}
    <table class="gh-table">
      <thead>
        <tr>
          <th>Task</th>
          <th>Status</th>
          <th class="gh-r">Duration</th>
          <th>Cache</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <td>
                <code>{r.task}</code>
              </td>
              <td>
                {r.ok === true && '✅ success'}
                {r.ok === false && `❌ failed (exit ${r.exit ?? 1})`}
                {r.ok === undefined && '⏭ skipped'}
              </td>
              <td class="gh-r">{r.duration}</td>
              <td>{r.cache}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</div>

<style>
  .gh {
    margin: 1.25rem 0;
    border: 1px solid #d0d7de;
    border-radius: 10px;
    overflow: hidden;
    background: #ffffff;
    color: #1f2328;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
    font-family:
      -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif;
  }
  .gh-chrome {
    background: #f6f8fa;
    border-bottom: 1px solid #d0d7de;
    padding: 8px 16px;
    font-size: 12px;
    color: #636c76;
    letter-spacing: 0.02em;
  }
  .gh-body {
    padding: 16px 20px 20px;
    overflow-x: auto;
  }
  .gh-h {
    margin: 0 0 6px;
    font-size: 18px;
    font-weight: 600;
    color: #1f2328;
  }
  .gh-h code,
  .gh-table code {
    background: #eff1f3;
    border-radius: 6px;
    padding: 0.15em 0.4em;
    font-size: 0.85em;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    color: #1f2328;
  }
  .gh-verdict {
    margin: 0 0 4px;
    font-size: 14px;
    color: #1f2328;
  }
  .gh-herm {
    margin: 0 0 10px;
    font-size: 14px;
    color: #1f2328;
  }
  .gh-table {
    border-collapse: collapse;
    width: 100%;
    font-size: 13.5px;
    margin: 8px 0 0;
  }
  .gh-table th,
  .gh-table td {
    border: 1px solid #d0d7de;
    padding: 6px 13px;
    text-align: left;
  }
  .gh-table th {
    background: #f6f8fa;
    font-weight: 600;
  }
  .gh-table tbody tr:nth-child(2n) {
    background: #f6f8fa;
  }
  .gh-r {
    text-align: right;
  }
</style>
