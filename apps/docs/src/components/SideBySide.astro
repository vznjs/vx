---
/**
 * Two code panels side by side with a "→" between — a before/after
 * (e.g. turbo.json → vx.config.ts for `vx migrate`). Dark panels that
 * read in both Starlight themes; stacks vertically on narrow screens.
 * `beforeLang`/`afterLang` are accepted for callsite clarity but the
 * panels render as plain preformatted text (no shiki theme dependency).
 */
interface Props {
  beforeTitle: string
  beforeLang?: string
  before: string
  afterTitle: string
  afterLang?: string
  after: string
}

const { beforeTitle, before, afterTitle, after } = Astro.props
---

<div class="sbs">
  <figure class="sbs-pane">
    <figcaption class="sbs-cap">{beforeTitle}</figcaption>
    <pre class="sbs-code"><code>{before}</code></pre>
  </figure>
  <div class="sbs-arrow" aria-hidden="true">→</div>
  <figure class="sbs-pane">
    <figcaption class="sbs-cap sbs-cap-after">{afterTitle}</figcaption>
    <pre class="sbs-code"><code>{after}</code></pre>
  </figure>
</div>

<style>
  .sbs {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: 12px;
    margin: 1.25rem 0;
  }
  .sbs-pane .sbs-code {
    height: calc(100% - 28px);
  }
  .sbs-pane {
    margin: 0;
    min-width: 0;
  }
  .sbs-cap {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12px;
    color: #7d8590;
    padding: 4px 2px 6px;
    letter-spacing: 0.02em;
  }
  .sbs-cap-after {
    color: #34d399;
  }
  .sbs-arrow {
    font-size: 22px;
    color: #a78bfa;
    text-align: center;
    font-weight: 700;
    align-self: center;
  }
  .sbs-code {
    margin: 0;
    background: #0d1117;
    color: #c9d1d9;
    border-radius: 10px;
    padding: 14px 16px;
    font-size: 12.5px;
    line-height: 1.6;
    overflow-x: auto;
    border: 1px solid #232a33;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  }
  .sbs-code code {
    background: none;
    padding: 0;
    color: inherit;
    font-size: inherit;
  }
  @media (max-width: 720px) {
    .sbs {
      grid-template-columns: 1fr;
    }
    .sbs-arrow {
      transform: rotate(90deg);
    }
  }
</style>
