---
/**
 * A faithful, self-contained render of real `vx` terminal output — the
 * same glyphs, palette, and summary meters the CLI prints. Dark chrome
 * that reads well in both Starlight themes.
 *
 * Give it one `state` for a static screenshot, or several for an
 * interactive toggle (e.g. cold → warm cache): a row of tabs swaps which
 * state is shown, entirely client-side.
 *
 * <Terminal title="zsh — vx" states={[
 *   { label: 'First run',  command: 'vx run build --all', tasks: [...], meters: [...], info: '…', time: '623ms' },
 *   { label: 'Run again',  command: 'vx run build --all', tasks: [...], meters: [...], info: '…', time: '17ms'  },
 * ]} />
 */
type Tone = 'green' | 'red' | 'yellow' | 'sky' | 'blue' | 'pink' | 'dim' | 'plain'

export interface TermTask {
  glyph?: string // default "⏺" (miss/ran). "►" up-to-date, "⇢" local, "⇣" remote, "◼" failed, "⊘" skipped
  tone?: Tone // glyph + status-word color
  time: string // "506ms"
  status: string // "success" | "failed" | "skipped"
  cache?: string // "miss" | "up-to-date" | "local" | "remote"
  cacheTone?: Tone // default dim
  proj: string // "@acme/web"
  task: string // "build"
}

export interface TermMeter {
  label?: string // "tasks" (blank continues the previous meter's legend)
  on: number // filled cells
  off?: number // dim cells
  tone?: Tone // fill color
  legend?: string // "4 success"
  legendTone?: Tone
  legendRest?: string // dim tail: " · 4 total"
}

export interface TermFrame {
  id: string // "@acme/web#build"
  tone?: Tone // id + status color (default green; 'red' for a failure)
  header?: string // right of "id > " on the open line, e.g. "$ vitest run"
  body?: { text: string; tone?: Tone }[] // stdout/stderr lines
  section?: string // a titled section inside the frame, e.g. "SANDBOX VIOLATIONS (1)"
  sectionTone?: Tone // default yellow
  sectionLines?: string[] // the section's lines
  duration: string // "309ms"
  status: string // "success" | "failed (exit 1)"
}

export interface TermState {
  label?: string // tab label when interactive
  command?: string // overrides the top-level command for this state
  frames?: TermFrame[] // framed single-task blocks (focused / failure / sandbox)
  tasks?: TermTask[]
  meters?: TermMeter[]
  info?: string // "10 workers · local cache"
  time?: string // "623ms" (shown on the time row, highlighted)
  timeRest?: string // dim tail: " · 506ms · 2ms avg"
}

interface Props {
  title?: string
  command?: string
  states: TermState[]
}

const { title = 'zsh — vx', command, states } = Astro.props
const interactive = states.length > 1
const rule = '─'.repeat(48)
---

<figure class="vx-term" data-interactive={interactive ? 'true' : undefined}>
  <div class="vx-bar">
    <span class="vx-dot" style="background:#ff5f57"></span>
    <span class="vx-dot" style="background:#febc2e"></span>
    <span class="vx-dot" style="background:#28c840"></span>
    <span class="vx-title">{title}</span>
  </div>

  {
    interactive && (
      <div class="vx-tabs" role="tablist">
        {states.map((s, i) => (
          <button class="vx-tab" data-idx={i} data-active={i === 0 ? 'true' : undefined} type="button">
            {s.label ?? `State ${i + 1}`}
          </button>
        ))}
      </div>
    )
  }

  {
    states.map((s, i) => (
      <div class="vx-state" data-idx={i} data-active={i === 0 ? 'true' : undefined}>
        <div class="vx-body">
          <div class="vx-prompt">
            <span class="vx-caret">❯ </span>
            <span class="vx-cmd">{s.command ?? command}</span>
          </div>

          {s.frames?.map((f) => (
            <div class="vx-frame">
              <div class="vx-fopen">
                <span class="t-dim">┌─ </span>
                <span class={`t-${f.tone ?? 'green'}`}>{f.id}</span>
                {f.header && (
                  <>
                    <span class="t-dim"> {'>'} </span>
                    <span class="vx-fcmd">{f.header}</span>
                  </>
                )}
              </div>
              {f.body?.map((b) => (
                <div class={`vx-fbody t-${b.tone ?? 'plain'}`}>{b.text}</div>
              ))}
              {f.section && (
                <>
                  <div class={`vx-fsection t-${f.sectionTone ?? 'yellow'}`}>├─ {f.section}</div>
                  {f.sectionLines?.map((l) => (
                    <div class="vx-fbody t-dim">{l}</div>
                  ))}
                </>
              )}
              <div class="vx-fclose">
                <span class="t-dim">└─ </span>
                <span class={`t-${f.tone ?? 'green'}`}>{f.id}</span>
                <span class="t-dim"> ── ({f.duration}) </span>
                <span class={`t-${f.tone ?? 'green'}`}>{f.status}</span>
              </div>
            </div>
          ))}

          {s.tasks?.map((t) => (
            <div class="vx-task">
              <span class={`vx-glyph t-${t.tone ?? 'green'}`}>{t.glyph ?? '⏺'} </span>
              <span class="vx-time">{t.time}</span>
              <span class={`vx-status t-${t.tone ?? 'green'}`}>{t.status}</span>
              {t.cache && <span class={`vx-cache t-${t.cacheTone ?? 'dim'}`}>{t.cache}</span>}
              <span class="vx-target">
                <span class="t-proj">{t.proj}</span>
                <span class="t-dim">#</span>
                <span class="t-pink">{t.task}</span>
              </span>
            </div>
          ))}

          {(s.meters?.length || s.info || s.time) && <div class="vx-gap" />}

          {(s.meters?.length || s.info || s.time) && (
            <div class="vx-rule">
              <span class="t-dim">─ </span>
              <span class="vx-mark">vx 0.0.0</span>
              <span class="t-dim"> </span>
              <span class="vx-fill">{rule}</span>
            </div>
          )}

          {s.meters?.map((m) => (
            <>
              <div class="vx-row">
                <span class="vx-lbl">{m.label ?? ''}</span>
                <span class="vx-v">
                  <span class="vx-meter">
                    <span class={`t-${m.tone ?? 'green'}`}>{'▰'.repeat(m.on)}</span>
                    <span class="vx-off">{'▱'.repeat(m.off ?? 0)}</span>
                  </span>
                </span>
              </div>
              {m.legend && (
                <div class="vx-row">
                  <span class="vx-lbl" />
                  <span class="vx-v">
                    <span class={`t-${m.legendTone ?? m.tone ?? 'green'}`}>{m.legend}</span>
                    {m.legendRest && <span class="t-dim">{m.legendRest}</span>}
                  </span>
                </div>
              )}
            </>
          ))}

          {(s.info || s.time) && <div class="vx-gap" />}
          {s.info && (
            <div class="vx-row">
              <span class="vx-lbl">info</span>
              <span class="vx-v t-dim">{s.info}</span>
            </div>
          )}
          {s.time && (
            <div class="vx-row">
              <span class="vx-lbl">time</span>
              <span class="vx-v">
                <span class="vx-tm">{s.time}</span>
                {s.timeRest && <span class="t-dim">{s.timeRest}</span>}
              </span>
            </div>
          )}
        </div>
      </div>
    ))
  }
</figure>

<style>
  .vx-term {
    margin: 1.25rem 0;
    background: #0d1117;
    border: 1px solid #232a33;
    border-radius: 12px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.35);
    overflow: hidden;
    font-family: var(--__sl-font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
  }
  .vx-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    background: #161b22;
    border-bottom: 1px solid #232a33;
  }
  .vx-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
  }
  .vx-title {
    margin-left: 10px;
    font-size: 12px;
    color: #7d8590;
    letter-spacing: 0.04em;
  }
  .vx-tabs {
    display: flex;
    gap: 4px;
    padding: 8px 12px 0;
    background: #0d1117;
    border-bottom: 1px solid #1b2028;
  }
  .vx-tab {
    appearance: none;
    border: 1px solid transparent;
    border-bottom: none;
    background: transparent;
    color: #7d8590;
    font: inherit;
    font-size: 12.5px;
    padding: 6px 14px;
    border-radius: 8px 8px 0 0;
    cursor: pointer;
    transition:
      color 0.15s,
      background 0.15s;
  }
  .vx-tab:hover {
    color: #c9d1d9;
  }
  .vx-tab[data-active='true'] {
    color: #a5f3d0;
    background: #161b22;
    border-color: #232a33;
  }
  .vx-state {
    display: none;
  }
  .vx-state[data-active='true'] {
    display: block;
  }
  .vx-body {
    padding: 16px 20px;
    font-size: 13px;
    line-height: 1.85;
    color: #c9d1d9;
    overflow-x: auto;
  }
  .vx-prompt {
    white-space: pre-wrap;
    margin-bottom: 8px;
  }
  .vx-caret {
    color: #34d399;
  }
  .vx-cmd {
    color: #e6edf3;
  }
  .vx-task {
    display: flex;
    white-space: pre;
  }
  .vx-frame {
    margin: 2px 0 10px;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .vx-fcmd {
    color: #e6edf3;
  }
  .vx-fbody {
    white-space: pre-wrap;
    word-break: break-word;
  }
  .vx-fsection {
    margin-top: 4px;
    font-weight: 600;
  }
  .t-green {
    color: #22c55e;
  }
  .t-red {
    color: #ef4444;
  }
  .t-yellow {
    color: #eab308;
  }
  .t-sky {
    color: #38bdf8;
  }
  .t-blue {
    color: #60a5fa;
  }
  .t-pink {
    color: #f472b6;
  }
  .t-proj {
    color: #60a5fa;
  }
  .t-dim {
    color: #6b7280;
  }
  .t-plain {
    color: #e6edf3;
  }
  .vx-glyph {
    display: inline-block;
  }
  .vx-time {
    color: #6b7280;
    display: inline-block;
    width: 62px;
    text-align: right;
  }
  .vx-status {
    margin-left: 14px;
  }
  .vx-cache {
    margin-left: 10px;
  }
  .vx-target {
    margin-left: 14px;
  }
  .vx-gap {
    height: 12px;
  }
  .vx-rule {
    display: flex;
    align-items: center;
    color: #6b7280;
    overflow: hidden;
    white-space: nowrap;
  }
  .vx-mark {
    color: #e6edf3;
    font-weight: 600;
  }
  .vx-fill {
    flex: 1;
    background: linear-gradient(90deg, #a78bfa, #f472b6);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-left: 4px;
  }
  .vx-row {
    display: flex;
  }
  .vx-lbl {
    width: 78px;
    flex-shrink: 0;
    color: #6b7280;
  }
  .vx-v {
    flex: 1;
    min-width: 0;
  }
  .vx-meter {
    white-space: nowrap;
    letter-spacing: -0.5px;
  }
  .vx-off {
    color: #2b323c;
  }
  .vx-tm {
    color: #e6edf3;
  }
</style>

<script>
  // Wire every interactive terminal on the page: clicking a tab swaps the
  // shown state within that terminal only.
  for (const term of document.querySelectorAll<HTMLElement>('.vx-term[data-interactive="true"]')) {
    const tabs = term.querySelectorAll<HTMLButtonElement>('.vx-tab')
    const states = term.querySelectorAll<HTMLElement>('.vx-state')
    for (const tab of tabs) {
      tab.addEventListener('click', () => {
        const idx = tab.dataset.idx
        for (const t of tabs) t.dataset.active = t === tab ? 'true' : ''
        for (const s of states) s.dataset.active = s.dataset.idx === idx ? 'true' : ''
      })
    }
  }
</script>
