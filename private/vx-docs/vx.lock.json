{
  "tasks": {
    "ci": {
      "dependsOn": [
        "lint",
        "build",
        "test"
      ]
    },
    "lint": {
      "dependsOn": [
        "lint.oxlint",
        "lint.oxfmt"
      ]
    },
    "lint.oxlint": {
      "description": "oxlint with tsgolint-backed type-aware checks",
      "exec": {
        "command": "oxlint --type-aware --type-check astro.config.mjs scripts src/bench src/components src/features src/nav src/pages src/plugins tests",
        "sandbox": {
          "allow": {
            "read": [
              "**/*",
              "../../packages/vx/src/**"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "astro.config.mjs",
          "scripts/**",
          "src/env.d.ts",
          "src/bench/**",
          "src/data/bench.json",
          "src/blog/**",
          "src/components/**",
          "src/features/**",
          "src/llms/**",
          "src/nav/**",
          "src/pages/**",
          "src/plugins/**",
          "tests/**",
          "package.json",
          ".oxlintrc.json",
          "tsconfig.json"
        ]
      },
      "cache": {
        "outputs": {
          "files": []
        }
      }
    },
    "lint.oxfmt": {
      "description": "oxfmt --check (no rewrite; CI-safe)",
      "exec": {
        "command": "oxfmt --check .",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "**/*",
          "!src/content/docs/all-features.md",
          "!src/content/docs/api.md",
          "!src/content/docs/architecture.md",
          "!src/content/docs/benchmarks.md",
          "!src/content/docs/caching.md",
          "!src/content/docs/cli.md",
          "!src/content/docs/compare/turbo-nx-support.md",
          "!src/content/docs/comparison.md",
          "!src/content/docs/execution.md",
          "!src/content/docs/flows.md",
          "!src/content/docs/optimizations.md",
          "!src/content/docs/overview.md",
          "!src/content/docs/parity.md",
          "!src/content/docs/patterns.md",
          "!src/content/docs/schema.md",
          "!src/content/docs/security.md",
          "!src/content/docs/switchboard.md",
          "!src/content/docs/upstream-ledger.md",
          "!src/content/docs/modules/**",
          "!src/content/docs/design/**",
          "!src/content/docs/plugins/**",
          "!src/content/docs/cli/**",
          "!src/content/docs/schema/**",
          "!public/_img/**",
          "!dist/**",
          "package.json"
        ]
      },
      "cache": {
        "outputs": {
          "files": []
        }
      }
    },
    "import": {
      "description": "generate src/content/docs from packages/vx/docs, the plugin READMEs and the relay protocol",
      "dependsOn": [
        "install"
      ],
      "exec": {
        "command": "bun scripts/import-docs.ts",
        "sandbox": {
          "allow": {
            "read": [
              "**/*",
              "../../packages/vx/docs/**",
              "../../packages/vx-*/README.md",
              "../../packages/vx-*/package.json",
              "../../packages/vx-dte-server/PROTOCOL.md"
            ],
            "write": [
              "src/content/docs/**"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "inputs": {
        "files": [
          "scripts/import-docs.ts",
          "package.json"
        ],
        "workspaceFiles": [
          "packages/vx/docs/**",
          "packages/vx-*/README.md",
          "packages/vx-*/package.json",
          "packages/vx-dte-server/PROTOCOL.md"
        ]
      },
      "cache": {
        "outputs": {
          "files": [
            "src/content/docs/all-features.md",
            "src/content/docs/api.md",
            "src/content/docs/architecture.md",
            "src/content/docs/benchmarks.md",
            "src/content/docs/caching.md",
            "src/content/docs/cli.md",
            "src/content/docs/compare/turbo-nx-support.md",
            "src/content/docs/comparison.md",
            "src/content/docs/execution.md",
            "src/content/docs/flows.md",
            "src/content/docs/optimizations.md",
            "src/content/docs/overview.md",
            "src/content/docs/parity.md",
            "src/content/docs/patterns.md",
            "src/content/docs/schema.md",
            "src/content/docs/security.md",
            "src/content/docs/switchboard.md",
            "src/content/docs/upstream-ledger.md",
            "src/content/docs/modules/**",
            "src/content/docs/design/**",
            "src/content/docs/plugins/**",
            "src/content/docs/cli/**",
            "src/content/docs/schema/**"
          ]
        }
      }
    },
    "bench.data": {
      "description": "gather the head-to-head rows of @vzn/vx-bench#site.numbers → measured/bench.json",
      "dependsOn": [
        "install",
        "@vzn/vx-bench#site.numbers"
      ],
      "exec": {
        "command": "bun scripts/bench-data.ts",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0"
          }
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*",
              "../vx-bench/site/**"
            ],
            "write": [
              "measured/bench.json"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "inputs": {
        "files": [
          "scripts/bench-data.ts",
          "src/bench/format.ts",
          "package.json"
        ]
      },
      "cache": {
        "outputs": {
          "files": [
            "measured/bench.json"
          ]
        }
      }
    },
    "test": {
      "description": "bun test — the landing, sidebar, redirect, diagram, compare and site-link pins (needs the imported content and dist/)",
      "dependsOn": [
        "install",
        "import",
        "build"
      ],
      "exec": {
        "command": "bun test --only-failures",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0",
            "VX_CACHE_DIR": ".vx/cache"
          }
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*",
              "../../packages/vx/src/**",
              "../../packages/vx-cache/src/**",
              "../../packages/vx-ci/src/**",
              "../../packages/vx-dte/src/**",
              "../../packages/vx-history/src/**",
              "../../packages/vx-lockfile/src/**",
              "../../packages/vx-migrate/src/**",
              "../../packages/vx-otel/src/**",
              "../../packages/vx/tests/config.test.ts",
              "../../packages/vx/tests/sandbox-runtime.unsafe.test.ts",
              "../../packages/vx/tests/task-hash-derive.test.ts",
              "../../packages/vx/tests/plugin-pipeline.test.ts",
              "../../packages/vx/tests/layered-cache.test.ts",
              "../../packages/vx-reapi/tests/exec-e2e.test.ts",
              "../../packages/vx-migrate/tests/turbo.test.ts",
              "../../packages/vx/docs/cli.md",
              "../../packages/vx/docs/schema.md"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "inputs": {
        "files": [
          "tests/**",
          "src/content/docs/**",
          "src/components/demos/model/**",
          "src/bench/**",
          "src/data/bench.json",
          "src/nav/**",
          "src/features/**",
          "src/assets/features/**",
          "src/components/guide/**",
          "src/components/landing/**",
          "src/components/Demo.astro",
          "src/components/demos/widget.css",
          "src/styles/theme.css",
          "astro.config.*",
          ".gitignore",
          "package.json",
          "scripts/**",
          "!src/content/docs/all-features.md",
          "!src/content/docs/api.md",
          "!src/content/docs/architecture.md",
          "!src/content/docs/benchmarks.md",
          "!src/content/docs/caching.md",
          "!src/content/docs/cli.md",
          "!src/content/docs/compare/turbo-nx-support.md",
          "!src/content/docs/comparison.md",
          "!src/content/docs/execution.md",
          "!src/content/docs/flows.md",
          "!src/content/docs/optimizations.md",
          "!src/content/docs/overview.md",
          "!src/content/docs/parity.md",
          "!src/content/docs/patterns.md",
          "!src/content/docs/schema.md",
          "!src/content/docs/security.md",
          "!src/content/docs/switchboard.md",
          "!src/content/docs/upstream-ledger.md",
          "!src/content/docs/modules/**",
          "!src/content/docs/design/**",
          "!src/content/docs/plugins/**",
          "!src/content/docs/cli/**",
          "!src/content/docs/schema/**",
          "!public/_img/**",
          "!dist/**"
        ],
        "workspaceFiles": [
          "packages/vx/tests/config.test.ts",
          "packages/vx/tests/sandbox-runtime.unsafe.test.ts",
          "packages/vx/tests/task-hash-derive.test.ts",
          "packages/vx/tests/plugin-pipeline.test.ts",
          "packages/vx/tests/layered-cache.test.ts",
          "packages/vx-reapi/tests/exec-e2e.test.ts",
          "packages/vx-migrate/tests/turbo.test.ts",
          "packages/vx/docs/cli.md",
          "packages/vx/docs/schema.md"
        ]
      },
      "cache": {
        "outputs": {
          "files": []
        }
      }
    },
    "install": {
      "dependsOn": [
        "^build"
      ]
    },
    "build.images": {
      "description": "resize src/assets/{blog,features} → public/_img/",
      "dependsOn": [
        "install"
      ],
      "exec": {
        "command": "bun scripts/build-images.ts",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "write": [
              "public/_img/**"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "inputs": {
        "files": [
          "scripts/build-images.ts",
          "src/assets/blog/**",
          "src/assets/features/**",
          "package.json"
        ]
      },
      "cache": {
        "outputs": {
          "files": [
            "public/_img/**"
          ]
        }
      }
    },
    "build": {
      "description": "astro build → dist/",
      "dependsOn": [
        "install",
        "import",
        "build.images"
      ],
      "exec": {
        "command": "mkdir -p .astro/bin && ln -sf \"$(command -v bun)\" .astro/bin/node && PATH=\"$PWD/.astro/bin:$PATH\" bun --bun astro build",
        "env": {
          "define": {
            "ASTRO_TELEMETRY_DISABLED": "1"
          }
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "write": [
              "dist/**",
              ".astro/**"
            ],
            "systemInfo": [
              "vfs.disk-space",
              "net.link.addr"
            ],
            "machLookup": [
              "com.apple.SystemConfiguration.DNSConfiguration"
            ]
          }
        }
      },
      "inputs": {
        "files": [
          "**/*",
          "!src/content/docs/all-features.md",
          "!src/content/docs/api.md",
          "!src/content/docs/architecture.md",
          "!src/content/docs/benchmarks.md",
          "!src/content/docs/caching.md",
          "!src/content/docs/cli.md",
          "!src/content/docs/compare/turbo-nx-support.md",
          "!src/content/docs/comparison.md",
          "!src/content/docs/execution.md",
          "!src/content/docs/flows.md",
          "!src/content/docs/optimizations.md",
          "!src/content/docs/overview.md",
          "!src/content/docs/parity.md",
          "!src/content/docs/patterns.md",
          "!src/content/docs/schema.md",
          "!src/content/docs/security.md",
          "!src/content/docs/switchboard.md",
          "!src/content/docs/upstream-ledger.md",
          "!src/content/docs/modules/**",
          "!src/content/docs/design/**",
          "!src/content/docs/plugins/**",
          "!src/content/docs/cli/**",
          "!src/content/docs/schema/**",
          "!public/_img/**",
          "!dist/**",
          "package.json"
        ]
      },
      "cache": {
        "outputs": {
          "files": [
            "dist/**"
          ]
        }
      }
    },
    "deploy.pages": {
      "description": "deploy dist/ to GitHub Pages (GitHub Actions only)",
      "dependsOn": [
        "ci"
      ],
      "exec": {
        "command": "bun scripts/deploy-pages.ts",
        "env": {
          "passThrough": [
            "ACTIONS_RUNTIME_TOKEN",
            "ACTIONS_RESULTS_URL",
            "ACTIONS_ID_TOKEN_REQUEST_URL",
            "ACTIONS_ID_TOKEN_REQUEST_TOKEN",
            "GITHUB_TOKEN",
            "GITHUB_REPOSITORY",
            "GITHUB_SHA",
            "GITHUB_API_URL"
          ],
          "secret": [
            "ACTIONS_RUNTIME_TOKEN",
            "ACTIONS_ID_TOKEN_REQUEST_TOKEN",
            "GITHUB_TOKEN"
          ]
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "network": [
              "*.actions.githubusercontent.com",
              "*.blob.core.windows.net",
              "api.github.com"
            ]
          }
        }
      }
    },
    "dev": {
      "description": "astro dev server (persistent)",
      "dependsOn": [
        "install",
        "build.images"
      ],
      "exec": {
        "command": "bun --bun astro dev",
        "env": {
          "define": {
            "ASTRO_TELEMETRY_DISABLED": "1"
          }
        },
        "persistent": {
          "readyWhen": "Local"
        },
        "timeout": "2m",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "write": [
              ".astro/**"
            ],
            "systemInfo": [
              "vfs.disk-space",
              "net.link.addr"
            ],
            "machLookup": [
              "com.apple.SystemConfiguration.DNSConfiguration"
            ],
            "localBinding": true
          }
        }
      }
    },
    "preview": {
      "description": "serve the built dist/ (persistent)",
      "dependsOn": [
        "build"
      ],
      "exec": {
        "command": "bun --bun astro preview",
        "env": {
          "define": {
            "ASTRO_TELEMETRY_DISABLED": "1"
          }
        },
        "persistent": {
          "readyWhen": "Local"
        },
        "timeout": "2m",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space",
              "net.link.addr"
            ],
            "machLookup": [
              "com.apple.SystemConfiguration.DNSConfiguration"
            ],
            "localBinding": true
          }
        }
      }
    }
  }
}
