{
  "$schema": "../../node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "vx.lock.json",
    "dist",
    "public/_img",
    ".astro",
    "**/*.md",
    "**/*.mdx",
    ".mcp.json",
    ".vscode",
    ".idea",
    ".claude"
  ]
}
