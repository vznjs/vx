---
// vx landing page (2026-11-12, rebuilt from nothing: "epic", "bold", the
// system graph as the hero in 3D over a futuristic grid, scroll-driven,
// speed lines). Top to bottom: the stage (HeroStage: the graph tilted over
// an endless grid, standing up as you scroll and playing one CI run), the
// conformance scoreboard, the benchmark race, Distributed task execution,
// the parts (every plugin and server), agents, and the one command to
// start. Every figure is read from src/data: the bench rows and the
// conformance results. At rest (no script, reduced motion) the page is
// whole and still; the motion is script on top. tests/landing.test.ts holds it.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import Footer from '../components/landing/Footer.astro'
import { SCOPE } from '../components/landing/scope.ts'
import { BURN_ROWS, burnClip, ratioLabel, tailPct } from '../components/landing/race.ts'
import HeroStage from '../components/landing/HeroStage.astro'
import DteRun from '../components/landing/DteRun.astro'
import Voices from '../components/landing/Voices.astro'
import '../styles/landing.css'
import '../styles/stage.css'
import '../styles/voices.css'
import { posts } from '../blog/posts.js'
import { parseDuration } from '../plugins/data-charts.ts'
import { FIGURES, fillBench } from '../bench/data.ts'
import { RESULTS, TOOLS, toolName } from '../conformance/data.ts'

const base = import.meta.env.BASE_URL // '/vx/' on Pages, '/' on a custom domain
const href = (p: string) => `${base}${p}`
const TITLE = 'vx — task orchestration you own'
const DESCRIPTION =
  'Correct, sandboxed, extensible task orchestration. Plugins decide where tasks run and where the cache lives. MIT, no cloud, no account.'

const latest = (await posts('releases'))[0]!

// ---- the scoreboard: bars are passes; a label counts the cases a tool supports but fails ----
const caseCount = RESULTS.cases.length
const vxAll = RESULTS.scores['vx']!.all!
// Highest score first.
const board = TOOLS.map((t) => {
  const all = RESULTS.scores[t]!.all!
  return {
    tool: t,
    name: toolName(t),
    issues: all.can - all.pass,
    h: (all.pass / all.of) * 100,
    s: (all.can / all.of) * 100,
  }
}).sort((x, y) => y.h - x.h)

// ---- the race: what each tool adds over the ideal run, from bench.json ----
const bench = (key: string): string => FIGURES.get(key)!
const RACERS = [
  ['vx', 'vx'],
  ['turbo', 'Turbo'],
  ['nx', 'Nx'],
  ['vt', 'Vite Task'],
] as const
const races = (
  [
    ['warm', 'Nothing changed'],
    ['restore', 'Nothing changed, outputs restored'],
    ['cold', 'Cold build'],
    ['cpu', 'Cold build: CPU the runner burns'],
  ] as const
).map(([k, title]) => {
  const lanes = RACERS.map(([r, name]) => ({ r, name, value: bench(`${r}.${k}`), ms: parseDuration(bench(`${r}.${k}`))! }))
  const max = Math.max(...lanes.map((l) => l.ms))
  const fastest = Math.min(...lanes.map((l) => l.ms))
  // Live, every tool runs the same track in real time: one lap takes the
  // time it measured.
  // CPU is an amount: its lanes are meters, one cell per CPU second.
  const cols = Math.ceil(max / 1000 / BURN_ROWS)
  return {
    k,
    title,
    cols,
    lanes: lanes.map((l) => ({
      ...l,
      w: (l.ms / max) * 100,
      lap: l.ms / 1000,
      cells: Math.round(l.ms / 1000),
      tail: tailPct(l.ms),
      ratio: ratioLabel(l.ms, fastest),
    })),
  }
})
const scope0 = SCOPE[0]!
const scopeOut = [
  ['vx last', 'any past run, task by task', 'features/vx-last/'],
  ['vx why', 'the file, env var or setting that changed', 'features/vx-why/'],
  ['SQLite', 'every task of every run, one query away', 'features/run-analytics/'],
  ['OpenTelemetry', 'the same numbers in your own backend', 'plugins/vx-otel/'],
] as const
const benchFormula = 'Time each tool adds over the ideal run; lower is better.'
const benchWorkload = fillBench(
  'Benchmark workload: a synthetic monorepo of %bench.projects% projects and %bench.tasks% tasks in %bench.levels% dependency levels, five core libraries a quarter of the projects use; build %bench.task.build%, test and typecheck %bench.task.test%, lint %bench.task.lint%, publish %bench.task.publish%; real repos with uneven task times will differ.',
)
const benchRun = bench('provenance')

// ---- the parts: every package beside core, in its colour on the graph ----
const parts = [
  { pkg: 'vx-dte', server: 'vx-dte-server', tone: 'dte', title: 'Distributed task execution', line: 'One run across every worker your CI can start.' },
  { pkg: 'vx-cache', server: 'vx-cache-server', tone: 'remote', title: 'Remote cache', line: 'One bucket. CI writes, everyone reads.' },
  { pkg: 'vx-history', server: 'vx-history-server', tone: 'read', title: 'Shared history', line: 'Every CI run’s timings, so the critical path goes first.' },
  { pkg: 'vx-lockfile', tone: 'read', title: 'Lockfile keys', line: 'pnpm, bun, npm or yarn: each task keyed on its own dependencies.' },
  { pkg: 'vx-otel', tone: 'report', title: 'OpenTelemetry', line: 'Every run and task in any OTLP backend.' },
  { pkg: 'vx-ci', tone: 'report', title: 'CI results', line: 'Every task in the GitHub job summary.' },
  { pkg: 'vx-reapi', tone: 'remote', title: 'Bazel REAPI', line: 'Cache and run on the REAPI server you already have.' },
  { pkg: 'vx-migrate', tone: 'remote', title: 'Migrate', line: 'Bring a Turbo or Nx repo, keep its remote cache.' },
]

const startCommands = [
  ['bunx @vzn/vx init', 'installs vx, writes .vx/workspace.ts'],
  ['vx lock', 'after you declare a task in vx.config.ts'],
  ['vx run build', 'runs it and stores what it writes'],
  ['vx run build', 'again: up to date, from the cache'],
]
---

<!doctype html>
<StarlightPage
  frontmatter={{
    title: TITLE,
    description: DESCRIPTION,
    template: 'splash',
    head: [
      { tag: 'title', content: TITLE },
      { tag: 'meta', attrs: { property: 'og:title', content: TITLE } },
    ],
  }}
  hasSidebar={false}
>
  <div class="not-content vx-landing vx-stage-page">
    <HeroStage base={base} latest={latest} />

    <section class="band" id="proof">
      <div class="band-in">
        <header class="band-head">
          <p class="kicker">Conformance · {caseCount} cases · {TOOLS.length} tools</p>
          <h2>Each tool’s tests,<br /><em>run on all six tools.</em></h2>
          <p class="band-sub">Every test in vx, Turbo, Nx, Vite Task, Nix and moon, turned into one suite and run sandboxed against each tool; an issue is a case a tool supports but gets wrong.</p>
        </header>
        <div class="score">
          <div class="score-big">
            <strong class="count" data-to={vxAll.pass}>{vxAll.pass}</strong>{' '}
            <span>of {vxAll.of} cases pass on vx</span>
          </div>
          <ol class="columns" style={`--n:${board.length}`}>
            {
              board.map((b) => (
                <li class:list={{ vx: b.tool === 'vx' }} data-tool={b.tool} style={`--h:${b.h.toFixed(1)}; --s:${b.s.toFixed(1)}`}>
                  <span class="col-pct">
                    {b.issues}
                    <small> {b.issues === 1 ? 'issue' : 'issues'}</small>
                  </span>
                  <span class="col-bar">
                    <span class="col-can" aria-hidden="true" />
                    <span class="col-pass" aria-hidden="true" />
                  </span>
                  <span class="col-name">{b.name}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <ul class="vows">
          <li id="sandbox"><strong>Sandboxed.</strong> A task cannot read a workspace file it did not declare.</li>
          <li><strong>Keyed on everything.</strong> Every file, setting and env var a task declares is in its cache key.</li>
          <li><strong>Exact replays.</strong> A cache hit leaves the disk as the real run would.</li>
        </ul>
        <a class="band-link" href={href('conformance/')}>Every case, every tool <span class="arr">→</span></a>
      </div>
    </section>

    <section class="band" id="speed">
      <div class="band-in">
        <header class="band-head">
          <p class="kicker">{fillBench('%bench.tasks% tasks · %bench.projects% projects · same commands, same machine')}</p>
          <h2>Blink and<br /><em>it’s done.</em></h2>
        </header>
        <div class="races">
          {
            races.map((race) => (
              <figure class:list={['race', { burn: race.k === 'cpu' }]} style={`--cols:${race.cols}`}>
                <figcaption>{race.title}</figcaption>
                {race.lanes.map((l) => (
                  <div class:list={['lane', { vx: l.r === 'vx', best: l.ratio === '1×' }]} style={`--w:${l.w.toFixed(1)}; --lap:${l.lap.toFixed(3)}s; --tail:${l.tail.toFixed(1)}`}>
                    <span class="lane-name">{l.name}</span>
                    {race.k === 'cpu' ? (
                      <span class="lane-track">
                        <span class="cells" />
                        <span class="cells fire" data-cells={l.cells} style={`clip-path:${burnClip(l.cells, race.cols)}`} />
                      </span>
                    ) : (
                      <span class="lane-track">
                        <span class="streak" />
                        <span class="runner" />
                      </span>
                    )}
                    <span class="lane-value">
                      <b>{l.ratio}</b>
                      {race.k !== 'cpu' && <span class="lane-laps" aria-hidden="true" />}
                    </span>
                  </div>
                ))}
              </figure>
            ))
          }
        </div>
        <p class="fine race-note">The fastest tool in each row is 1×, and a tool at 2× takes twice as long.</p>
        <p class="fine race-note">Every tool runs the same track in real time: one lap takes the time it measured.</p>
        <p class="fine race-note">CPU is an amount, so it fills a meter: one cell per CPU second.</p>
        <p class="fine">{benchFormula}</p>
        <p class="fine">{benchWorkload}</p>
        <p class="fine">{benchRun}</p>
        <a class="band-link" href={href('benchmarks/')}>Benchmarks: tables, method, run it yourself <span class="arr">→</span></a>
      </div>
    </section>

    <section class="band" id="data">
      <div class="band-in">
        <header class="band-head">
          <p class="kicker">Every task, measured · no account</p>
          <h2>Every task’s numbers,<br /><em>kept on your disk.</em></h2>
          <p class="band-sub">Time, CPU, peak memory, output size, the cache result and what changed, recorded for every task in a file on your disk, with no dashboard to buy and no login.</p>
        </header>
        <div class="scope" data-scope={JSON.stringify(SCOPE)}>
          <div class="scope-tasks" role="tablist" aria-label="Example tasks">
            {SCOPE.map((t, i) => (
              <button type="button" role="tab" class:list={{ on: i === 0 }} aria-selected={i === 0 ? 'true' : 'false'} data-task={i}>{t.task}</button>
            ))}
          </div>
          <div class="scope-grid">
            <div class="dial dial-time">
              <span class="dial-k">Time</span>
              <strong data-f="time">{scope0.time}</strong>
              <span class="dial-s"><span data-f="usual">{scope0.usual}</span> · <b data-f="drift">{scope0.drift}</b></span>
            </div>
            <div class="dial dial-cpu">
              <span class="dial-k">CPU</span>
              <strong><span data-f="cores">{scope0.cores}</span><small> cores</small></strong>
              <span class="dial-s">peak <span data-f="peak">{scope0.peak}</span></span>
            </div>
            <div class="dial">
              <span class="dial-k">Peak memory</span>
              <strong data-f="mem">{scope0.mem}</strong>
              <span class="dial-s">packs the next run by it</span>
            </div>
            <div class="dial">
              <span class="dial-k">Outputs</span>
              <strong data-f="out">{scope0.out}</strong>
              <span class="dial-s">stored once, restored exact</span>
            </div>
            <div class="dial dial-wide">
              <span class="dial-k">Cache</span>
              <strong data-f="cache">{scope0.cache}</strong>
              <span class="dial-s" data-f="why">{scope0.why}</span>
            </div>
            <div class="dial dial-wide">
              <span class="dial-k">History</span>
              <strong data-f="rate">{scope0.rate}</strong>
              <span class="dial-s" data-f="blocks">{scope0.blocks}</span>
            </div>
          </div>
        </div>
        <ul class="scope-out">
          {scopeOut.map(([name, line, to]) => (
            <li>
              <a href={href(to)}><strong>{name}</strong> <span>{line}</span></a>
            </li>
          ))}
        </ul>
        <p class="fine">An example run; the fields are the ones vx records for every task.</p>
      </div>
    </section>

    <section class="band" id="dte">
      <div class="band-in">
        <header class="band-head">
          <p class="kicker">Distributed task execution</p>
          <h2>Spread one run<br /><em>over your CI machines.</em></h2>
          <p class="band-sub">Add <code>@vzn/vx-dte</code> and a single <code>vx run</code> on CI starts workers on your own CI, feeds them the critical path first and reports back as one run.</p>
        </header>
        <DteRun />
        <a class="band-link" href={href('plugins/vx-dte/')}>Distributed task execution <span class="arr">→</span></a>
      </div>
    </section>

    <section class="band" id="flaky">
      <div class="band-in">
        <header class="band-head">
          <p class="kicker">Flaky tasks · Distributed task execution</p>
          <h2>A failed task retries<br /><em>on another worker.</em></h2>
          <p class="band-sub">A task that fails and retries runs on another worker than the one it failed on, because the worker, or what ran beside the task, may be the flake.</p>
        </header>
        <div class="hop">
          <div class="hop-worker hop-from">
            <span class="hop-name">worker 1</span>
            <span class="hop-slot"><span class="hop-task"><i />api#test</span></span>
            <span class="hop-mark"><b class="hop-run">running</b><b class="hop-end">failed</b></span>
          </div>
          <div class="hop-arc" aria-hidden="true"><span /></div>
          <div class="hop-worker hop-to">
            <span class="hop-name">worker 2</span>
            <span class="hop-slot"><span class="hop-task"><i />api#test</span></span>
            <span class="hop-mark"><b class="hop-run">running</b><b class="hop-end">passed</b></span>
          </div>
        </div>
        <ul class="vows">
          <li><strong>Flaky by proof.</strong> A task that fails on inputs it already passed on is flaky, and vx says so.</li>
          <li><strong>One retry, on its own.</strong> A task known flaky gets one retry with none set.</li>
          <li><strong>One record.</strong> Every CI machine shares the flaky record through your history server.</li>
        </ul>
        <a class="band-link" href={href('features/flaky-detection/')}>Flaky detection <span class="arr">→</span></a>
      </div>
    </section>

    <section class="band" id="plugins">
      <div class="band-in">
        <header class="band-head">
          <p class="kicker">Plugins</p>
          <h2>Replace any part<br /><em>without forking vx.</em></h2>
          <p class="band-sub">Each part on the graph is its own package on the public plugin API, and every server is yours to host.</p>
        </header>
        <div class="parts">
          {
            parts.map((p) => (
              <a class:list={['part', `tone-${p.tone}`]} href={href(`plugins/${p.pkg}/`)}>
                <span class="part-glow" aria-hidden="true" />
                <code class="part-pkg">@vzn/{p.pkg}</code>
                <strong class="part-title">{p.title}</strong>
                <span class="part-line">{p.line}</span>
                {p.server && <span class="part-server">+ @vzn/{p.server}</span>}
              </a>
            ))
          }
          <a class="part part-own tone-core" id="extensible" href={href('docs/plugins/')}>
            <span class="part-glow" aria-hidden="true" />
            <code class="part-pkg">definePlugin()</code>
            <strong class="part-title">Yours</strong>
            <span class="part-line">Take over any of the 15 stages: where tasks run, where the cache lives, who watches.</span>
          </a>
        </div>
      </div>
    </section>

    <section class="band" id="agents">
      <div class="band-in agents">
        <header class="band-head">
          <p class="kicker">AI first</p>
          <h2>Your agents<br /><em>already speak vx.</em></h2>
          <p class="band-sub">One skill teaches any coding agent the whole CLI, and every report prints JSON with a published schema.</p>
          <button class="install-pill small" data-copy="bunx skills add vznjs/vx" type="button">
            <span class="dollar">$</span><span class="cmd">bunx skills add vznjs/vx</span><span class="copied-note" aria-live="polite"></span>
          </button>
          <a class="band-link" href={href('docs/agents/')}>Built for agents <span class="arr">→</span></a>
        </header>
        <div class="term" role="img" aria-label="vx why names the file that made a task run again">
          <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i></div>
          <pre tabindex="0"><code><span class="t-p">$</span> <span class="t-c">vx why</span> <span class="t-a">@demo/web#build</span>
  <span class="t-d">verdict</span>    <span class="t-w">cache key changed:</span> upstream <span class="t-a">@demo/ui#build</span>
  <span class="t-d">root cause:</span>
    <span class="t-a">@demo/web#build</span> <span class="t-d">←</span> <span class="t-a">@demo/ui#build</span> <span class="t-d">←</span> file <span class="t-f">packages/ui/src/index.ts</span></code></pre>
        </div>
      </div>
    </section>

    <Voices />

    <section class="band" id="start">
      <div class="band-in start">
        <p class="kicker">Start</p>
        <h2>Own it in<br /><em>one command.</em></h2>
        <button class="install-pill big" data-copy="bunx @vzn/vx init" type="button">
          <span class="dollar">$</span><span class="cmd">bunx @vzn/vx init</span><span class="copied-note" aria-live="polite"></span>
        </button>
        <ol class="steps-cmd">
          {
            startCommands.map(([c, note]) => (
              <li>
                <code>{c}</code>
                <span>{note}</span>
              </li>
            ))
          }
        </ol>
        <div class="start-links">
          <a class="btn btn-primary" href={href('quickstart/')}>Quickstart <span class="arr">→</span></a>
          <a class="btn btn-ghost" href={href('guides/migrate/')}>Migrate from Turbo or Nx</a>
          <a class="btn btn-ghost" href={href('features/')}>Every feature</a>
        </div>
      </div>
    </section>

    <Footer />
  </div>

  <script>
    import { burnAt, burnClip, lapAt, lapsLabel, racing, step } from '../components/landing/race.ts'
    import { DRIFT_REST_MS, drift } from '../components/landing/drift.ts'
    import { COUNT_MS, countAt } from '../components/landing/count.ts'

    // Bands play once as they come near: the count runs up, the columns
    // rise, the race starts. Everything already shows at rest; the play
    // class only replays it, and never with reduced motion.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const count = (el: HTMLElement): void => {
        const to = Number(el.dataset['to'])
        const t0 = performance.now()
        const tick = (now: number): void => {
          el.textContent = String(countAt(to, now - t0))
          if (now - t0 < COUNT_MS) requestAnimationFrame(tick)
        }
        requestAnimationFrame(tick)
      }
      const seen = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue
            e.target.classList.add('play')
            e.target.querySelectorAll<HTMLElement>('.count').forEach(count)
            seen.unobserve(e.target)
          }
        },
        { rootMargin: '0px 0px -15% 0px' },
      )
      document.querySelectorAll('.band').forEach((el) => seen.observe(el))
      // The race runs only while it is on screen, and costs nothing off it
      // (tests/motion-budget.test.ts): sixteen runners moved by transform,
      // each lapping in real time, one lap as long as the time it measured.
      // One clock moves the runners and counts the laps (race.ts), and
      // whether it runs is read from where the band is now, never from a
      // queued observer entry, so a fast scroll, a tab switch or a page
      // restored from the back button cannot leave it stopped.
      const speed = document.getElementById('speed')!
      const lanes = [...speed.querySelectorAll<HTMLElement>('.race:not(.burn) .lane')].map((lane) => ({
        ms: parseFloat(lane.style.getPropertyValue('--lap')) * 1000,
        runner: lane.querySelector<HTMLElement>('.runner')!,
        laps: lane.querySelector<HTMLElement>('.lane-laps')!,
        shown: -1,
      }))
      // The CPU meter fills at one rate for every tool, so the one that
      // burns least stops first and the rest keep burning.
      const meter = speed.querySelector<HTMLElement>('.race.burn')!
      const cols = Number(meter.style.getPropertyValue('--cols'))
      const fires = [...meter.querySelectorAll<HTMLElement>('.lane')].map((lane) => ({
        fire: lane.querySelector<HTMLElement>('.fire')!,
        total: Number(lane.querySelector<HTMLElement>('.fire')!.dataset['cells']),
        shown: -1,
      }))
      const most = Math.max(...fires.map((f) => f.total))
      let elapsed = 0
      let last = 0
      let live = false
      const frame = (now: number): void => {
        if (!live) return
        elapsed += step(now, last)
        last = now
        for (const l of lanes) {
          const at = lapAt(elapsed, l.ms)
          l.runner.style.transform = `translateX(${at.x.toFixed(2)}%)`
          if (at.laps !== l.shown) {
            l.laps.textContent = lapsLabel((l.shown = at.laps))
            l.runner.classList.toggle('lapped', at.laps > 0)
          }
        }
        for (const f of fires) {
          const lit = burnAt(elapsed, f.total, most)
          if (lit === f.shown) continue
          f.shown = lit
          f.fire.style.clipPath = burnClip(lit, cols)
        }
        requestAnimationFrame(frame)
      }
      const sync = (): void => {
        const on = racing(speed.getBoundingClientRect(), innerHeight, document.hidden)
        if (on === live) return
        live = on
        if (!on) return
        speed.classList.add('racing')
        last = performance.now()
        requestAnimationFrame(frame)
      }
      new IntersectionObserver(sync).observe(speed)
      document.addEventListener('visibilitychange', sync)
      addEventListener('pageshow', sync)
      addEventListener('scroll', sync, { passive: true })
      // The scope steps through its example tasks while it is in view.
      const scope = document.querySelector<HTMLElement>('.scope')!
      const tasks = JSON.parse(scope.dataset['scope']!) as Array<Record<string, string | number>>
      const tabs = [...scope.querySelectorAll<HTMLButtonElement>('[data-task]')]
      let at = 0
      const tune = (i: number): void => {
        at = i % tasks.length
        const t = tasks[at]!
        tabs.forEach((b, j) => {
          b.classList.toggle('on', j === at)
          b.setAttribute('aria-selected', String(j === at))
        })
        scope.querySelectorAll<HTMLElement>('[data-f]').forEach((el) => (el.textContent = String(t[el.dataset['f']!])))
        scope.classList.toggle('hit', String(t['cache']).includes('hit'))
      }
      let turn = 0
      const cycle = (): void => {
        clearInterval(turn)
        turn = window.setInterval(() => tune(at + 1), 3600)
      }
      tabs.forEach((b, i) =>
        b.addEventListener('click', () => {
          tune(i)
          cycle()
        }),
      )
      new IntersectionObserver(([e]) => {
        clearInterval(turn)
        if (e!.isIntersecting) cycle()
      }).observe(scope)
      // The hop replays while it is in view: run, fail, retry elsewhere, pass.
      const hop = document.querySelector<HTMLElement>('.hop')!
      const HOP = [1500, 1100, 1700, 2800]
      let hopAt = 0
      let hopT = 0
      const hopStep = (): void => {
        hop.dataset['at'] = String(hopAt)
        hopT = window.setTimeout(hopStep, HOP[hopAt])
        hopAt = (hopAt + 1) % HOP.length
      }
      new IntersectionObserver(
        ([e]) => {
          clearTimeout(hopT)
          if (!e!.isIntersecting) return
          hopAt = 0
          hopStep()
        },
        { threshold: 0.4 },
      ).observe(hop)
      // The sky: each row slides on its own and loops; the second runs the
      // other way, offset by half a card. A hovered row stops. On a touch
      // screen a finger scrolls a row, and it drifts on from there.
      const sky = document.querySelector<HTMLElement>('.sky')!
      const touch = matchMedia('(hover: none)').matches
      const sayRows = [...sky.querySelectorAll<HTMLElement>('.say-row')].map((lane, r) => {
        const track = lane.querySelector<HTMLElement>('.say-track')!
        const first = track.firstElementChild as HTMLElement
        const count = track.children.length
        for (let n = touch ? 2 : 1; n > 0; n--) {
          for (const li of [...track.querySelectorAll(':scope > li:not([aria-hidden])')]) {
            const copy = li.cloneNode(true) as HTMLElement
            copy.setAttribute('aria-hidden', 'true')
            const a = copy.querySelector('a')
            if (a) a.tabIndex = -1
            track.appendChild(copy)
          }
        }
        // One loop is where the first copy starts; padding stays out of it.
        const one = (track.children[count] as HTMLElement).offsetLeft - first.offsetLeft
        return { lane, track, one, r, dir: Number(lane.dataset['dir']) }
      })
      if (touch) {
        const rows = sayRows.map(({ lane, one, r, dir }) => {
          const row = { lane, one, dir, pos: one + r * 200, set: -1, held: false, restUntil: 0 }
          const hold = (): void => {
            row.restUntil = performance.now() + DRIFT_REST_MS
          }
          lane.addEventListener('touchstart', () => ((row.held = true), hold()), { passive: true })
          lane.addEventListener('touchend', () => ((row.held = false), hold()), { passive: true })
          lane.addEventListener('touchcancel', () => ((row.held = false), hold()), { passive: true })
          lane.addEventListener(
            'scroll',
            () => {
              if (Math.abs(lane.scrollLeft - row.set) < 2) return
              row.pos = lane.scrollLeft
              hold()
            },
            { passive: true },
          )
          return row
        })
        let last = 0
        let frame = 0
        const tick = (now: number): void => {
          const ms = Math.min(now - last, 100)
          last = now
          for (const row of rows) {
            if (row.held || now < row.restUntil) continue
            row.pos = drift(row.pos, ms, row.dir, row.one)
            row.lane.scrollLeft = row.pos
            row.set = row.lane.scrollLeft
          }
          frame = requestAnimationFrame(tick)
        }
        sky.classList.add('swipe')
        for (const row of rows) {
          row.lane.scrollLeft = row.pos
          row.set = row.lane.scrollLeft
        }
        new IntersectionObserver(([e]) => {
          cancelAnimationFrame(frame)
          if (!e!.isIntersecting) return
          last = performance.now()
          frame = requestAnimationFrame(tick)
        }).observe(sky)
      } else {
        const runs = sayRows.map(({ lane, track, one, r, dir }) => {
          const start = -(r * 200)
          const run = track.animate(
            [
              { transform: `translateX(${dir < 0 ? start : start - one}px)` },
              { transform: `translateX(${dir < 0 ? start - one : start}px)` },
            ],
            { duration: one * 28, iterations: Infinity },
          )
          run.pause()
          return { lane, run }
        })
        // A row stops while the pointer is on it, and every row while the sky is off screen.
        let skyInView = false
        const syncRows = (): void => runs.forEach(({ lane, run }) => (skyInView && !lane.matches(':hover') ? run.play() : run.pause()))
        runs.forEach(({ lane }) => {
          lane.addEventListener('pointerenter', syncRows)
          lane.addEventListener('pointerleave', () => requestAnimationFrame(syncRows))
        })
        sky.classList.add('live')
        new IntersectionObserver(([e]) => {
          skyInView = e!.isIntersecting
          syncRows()
        }).observe(sky)
      }
      // The parts lean toward the pointer.
      document.querySelectorAll<HTMLElement>('.part').forEach((card) => {
        card.addEventListener('pointermove', (ev) => {
          const r = card.getBoundingClientRect()
          const x = (ev.clientX - r.left) / r.width - 0.5
          const y = (ev.clientY - r.top) / r.height - 0.5
          card.style.transform = `perspective(700px) rotateY(${x * 12}deg) rotateX(${-y * 12}deg) translateZ(8px)`
          card.style.setProperty('--mx', `${(x + 0.5) * 100}%`)
          card.style.setProperty('--my', `${(y + 0.5) * 100}%`)
        })
        card.addEventListener('pointerleave', () => {
          card.style.transform = ''
        })
      })
    }
    // Each install command copies itself.
    document.querySelectorAll<HTMLButtonElement>('.install-pill').forEach((pill) =>
      pill.addEventListener('click', async () => {
        const note = pill.querySelector('.copied-note')
        try {
          await navigator.clipboard.writeText(pill.dataset['copy'] ?? '')
          pill.classList.add('copied')
          if (note) note.textContent = 'copied'
          setTimeout(() => {
            pill.classList.remove('copied')
            if (note) note.textContent = ''
          }, 1400)
        } catch {
          // clipboard unavailable: the command is visible to select by hand
        }
      }),
    )
  </script>
</StarlightPage>
