---
// vx landing page (2026-11-12, rebuilt from nothing: "epic", "bold", the
// system graph as the hero in 3D over a futuristic grid, scroll-driven,
// speed lines). Top to bottom: the stage (HeroStage: the graph tilted over
// an endless grid, standing up as you scroll and playing one CI run), the
// conformance scoreboard, the benchmark race, Distributed task execution,
// the parts (every plugin and server), agents, and the one command to
// start. Every figure is read from src/data: the bench rows and the
// conformance results. At rest (no script, reduced motion) the page is
// whole and still; the motion is script on top. tests/landing.test.ts holds it.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import Footer from '../components/landing/Footer.astro'
import HeroStage from '../components/landing/HeroStage.astro'
import DteRun from '../components/landing/DteRun.astro'
import '../styles/landing.css'
import '../styles/stage.css'
import { posts } from '../blog/posts.js'
import { parseDuration } from '../plugins/data-charts.ts'
import { FIGURES, fillBench } from '../bench/data.ts'
import { RESULTS, TOOLS, percent, supports, toolName } from '../conformance/data.ts'

const base = import.meta.env.BASE_URL // '/vx/' on Pages, '/' on a custom domain
const href = (p: string) => `${base}${p}`
const TITLE = 'vx — task orchestration you own'
const DESCRIPTION =
  'Correct, sandboxed, extensible task orchestration. Plugins decide where tasks run and where the cache lives. MIT, no cloud, no account.'

const latest = (await posts('releases'))[0]!

// ---- the scoreboard: every tool's passes out of every case, rounded down ----
const caseCount = RESULTS.cases.length
const vxAll = RESULTS.scores['vx']!.all!
const board = TOOLS.map((t) => {
  const all = RESULTS.scores[t]!.all!
  return { tool: t, name: toolName(t), pct: percent(all), sup: supports(all), h: (all.pass / all.of) * 100 }
})

// ---- the race: what each tool adds over the ideal run, from bench.json ----
const bench = (key: string): string => FIGURES.get(key)!
const RACERS = [
  ['vx', 'vx'],
  ['turbo', 'Turborepo'],
  ['nx', 'Nx'],
  ['vt', 'Vite Task'],
] as const
const races = (
  [
    ['warm', 'Nothing changed'],
    ['restore', 'Nothing changed, outputs restored'],
    ['cold', 'Cold build'],
    ['cpu', 'Cold build: CPU the runner burns'],
  ] as const
).map(([k, title]) => {
  const lanes = RACERS.map(([r, name]) => ({ r, name, value: bench(`${r}.${k}`), ms: parseDuration(bench(`${r}.${k}`))! }))
  const max = Math.max(...lanes.map((l) => l.ms))
  return { k, title, lanes: lanes.map((l) => ({ ...l, w: (l.ms / max) * 100, t: 0.35 + 2.4 * (l.ms / max) })) }
})
const benchFormula = 'Time each tool adds over the ideal run; lower is better.'
const benchWorkload = fillBench(
  'Benchmark workload: a synthetic monorepo of %bench.projects% projects and %bench.tasks% tasks in %bench.levels% dependency levels, five core libraries a quarter of the projects use; build %bench.task.build%, test and typecheck %bench.task.test%, lint %bench.task.lint%, publish %bench.task.publish%; real repos with uneven task times will differ.',
)
const benchRun = bench('provenance')

// ---- the parts: every package beside core, in its colour on the graph ----
const parts = [
  { pkg: 'vx-dte', server: 'vx-dte-server', tone: 'dte', title: 'Distributed task execution', line: 'One run across every worker your CI can start.' },
  { pkg: 'vx-cache', server: 'vx-cache-server', tone: 'remote', title: 'Remote cache', line: 'One bucket. CI writes, everyone reads.' },
  { pkg: 'vx-history', server: 'vx-history-server', tone: 'read', title: 'Shared history', line: 'Every CI run’s timings, so the critical path goes first.' },
  { pkg: 'vx-lockfile', tone: 'read', title: 'Lockfile keys', line: 'pnpm, bun, npm or yarn: each task keyed on its own dependencies.' },
  { pkg: 'vx-otel', tone: 'report', title: 'OpenTelemetry', line: 'Every run and task in any OTLP backend.' },
  { pkg: 'vx-ci', tone: 'report', title: 'CI results', line: 'Every task in the GitHub job summary.' },
  { pkg: 'vx-reapi', tone: 'remote', title: 'Bazel REAPI', line: 'Cache and run on the REAPI server you already have.' },
  { pkg: 'vx-migrate', tone: 'remote', title: 'Migrate', line: 'Bring a Turbo or Nx repo, keep its remote cache.' },
]

const startCommands = [
  ['bunx @vzn/vx init', 'installs vx, writes .vx/workspace.ts'],
  ['vx lock', 'after you declare a task in vx.config.ts'],
  ['vx run build', 'runs it and stores what it writes'],
  ['vx run build', 'again: up to date, from the cache'],
]
---

<!doctype html>
<StarlightPage
  frontmatter={{
    title: TITLE,
    description: DESCRIPTION,
    template: 'splash',
    head: [
      { tag: 'title', content: TITLE },
      { tag: 'meta', attrs: { property: 'og:title', content: TITLE } },
    ],
  }}
  hasSidebar={false}
>
  <div class="not-content vx-landing vx-stage-page">
    <HeroStage base={base} latest={latest} />

    <section class="band" id="proof">
      <div class="band-in">
        <header class="band-head">
          <p class="kicker">Conformance · {caseCount} cases · {TOOLS.length} tools</p>
          <h2>Their tests.<br /><em>Our score.</em></h2>
          <p class="band-sub">Every test in vx, Turborepo, Nx, Vite Task, Nix and moon, turned into one suite and run sandboxed against each tool.</p>
        </header>
        <div class="score">
          <div class="score-big">
            <strong class="count" data-to={vxAll.pass}>{vxAll.pass}</strong>{' '}
            <span>of {vxAll.of} cases pass on vx</span>
          </div>
          <ol class="columns">
            {
              board.map((b) => (
                <li class:list={{ vx: b.tool === 'vx' }} style={`--h:${b.h.toFixed(1)}`}>
                  <span class="col-pct">{b.pct}</span>
                  <span class="col-bar" aria-hidden="true"><span /></span>
                  <span class="col-name">{b.name}</span>
                  <span class="col-sup">supports {b.sup}</span>
                </li>
              ))
            }
          </ol>
        </div>
        <ul class="vows">
          <li id="sandbox"><strong>Sandboxed.</strong> A task cannot read a workspace file it did not declare.</li>
          <li><strong>Keyed on everything.</strong> Every file, setting and env var a task declares is in its cache key.</li>
          <li><strong>Exact replays.</strong> A cache hit leaves the disk as the real run would.</li>
        </ul>
        <a class="band-link" href={href('conformance/')}>Every case, every tool <span class="arr">→</span></a>
      </div>
    </section>

    <section class="band" id="speed">
      <div class="band-in">
        <header class="band-head">
          <p class="kicker">{fillBench('%bench.tasks% tasks · %bench.projects% projects · same commands, same machine')}</p>
          <h2>Blink and<br /><em>it’s done.</em></h2>
        </header>
        <div class="races">
          {
            races.map((race) => (
              <figure class="race">
                <figcaption>{race.title}</figcaption>
                {race.lanes.map((l) => (
                  <div class:list={['lane', { vx: l.r === 'vx' }]} style={`--w:${l.w.toFixed(1)}; --t:${l.t.toFixed(2)}s`}>
                    <span class="lane-name">{l.name}</span>
                    <span class="lane-track">
                      <span class="streak" />
                    </span>
                    <span class="lane-value">{l.value}</span>
                  </div>
                ))}
              </figure>
            ))
          }
        </div>
        <p class="fine">{benchFormula}</p>
        <p class="fine">{benchWorkload}</p>
        <p class="fine">{benchRun}</p>
        <a class="band-link" href={href('benchmarks/')}>Benchmarks: tables, method, run it yourself <span class="arr">→</span></a>
      </div>
    </section>

    <section class="band" id="dte">
      <div class="band-in">
        <header class="band-head">
          <p class="kicker">Distributed task execution</p>
          <h2>One run.<br /><em>Every machine you’ve got.</em></h2>
          <p class="band-sub">Add <code>@vzn/vx-dte</code> and a single <code>vx run</code> on CI starts workers on your own CI, feeds them the critical path first and reports back as one run.</p>
        </header>
        <DteRun />
        <a class="band-link" href={href('plugins/vx-dte/')}>Distributed task execution <span class="arr">→</span></a>
      </div>
    </section>

    <section class="band" id="plugins">
      <div class="band-in">
        <header class="band-head">
          <p class="kicker">Plugins</p>
          <h2>Swap any piece.<br /><em>Fork nothing.</em></h2>
          <p class="band-sub">Each part on the graph is its own package on the public plugin API, and every server is yours to host.</p>
        </header>
        <div class="parts">
          {
            parts.map((p) => (
              <a class:list={['part', `tone-${p.tone}`]} href={href(`plugins/${p.pkg}/`)}>
                <span class="part-glow" aria-hidden="true" />
                <code class="part-pkg">@vzn/{p.pkg}</code>
                <strong class="part-title">{p.title}</strong>
                <span class="part-line">{p.line}</span>
                {p.server && <span class="part-server">+ @vzn/{p.server}</span>}
              </a>
            ))
          }
          <a class="part part-own tone-core" id="extensible" href={href('docs/plugins/')}>
            <span class="part-glow" aria-hidden="true" />
            <code class="part-pkg">definePlugin()</code>
            <strong class="part-title">Yours</strong>
            <span class="part-line">Take over any of the 15 stages: where tasks run, where the cache lives, who watches.</span>
          </a>
        </div>
      </div>
    </section>

    <section class="band" id="agents">
      <div class="band-in agents">
        <header class="band-head">
          <p class="kicker">AI first</p>
          <h2>Your agents<br /><em>already speak vx.</em></h2>
          <p class="band-sub">One skill teaches any coding agent the whole CLI, and every report prints JSON with a published schema.</p>
          <button class="install-pill small" data-copy="bunx skills add vznjs/vx" type="button">
            <span class="dollar">$</span><span class="cmd">bunx skills add vznjs/vx</span><span class="copied-note" aria-live="polite"></span>
          </button>
          <a class="band-link" href={href('docs/agents/')}>Built for agents <span class="arr">→</span></a>
        </header>
        <div class="term" role="img" aria-label="vx why names the file that made a task run again">
          <div class="term-bar" aria-hidden="true"><i></i><i></i><i></i></div>
          <pre><code><span class="t-p">$</span> <span class="t-c">vx why</span> <span class="t-a">@demo/web#build</span>
  <span class="t-d">verdict</span>    <span class="t-w">cache key changed:</span> upstream <span class="t-a">@demo/ui#build</span>
  <span class="t-d">root cause:</span>
    <span class="t-a">@demo/web#build</span> <span class="t-d">←</span> <span class="t-a">@demo/ui#build</span> <span class="t-d">←</span> file <span class="t-f">packages/ui/src/index.ts</span></code></pre>
        </div>
      </div>
    </section>

    <section class="band" id="start">
      <div class="band-in start">
        <p class="kicker">Start</p>
        <h2>Own it in<br /><em>one command.</em></h2>
        <button class="install-pill big" data-copy="bunx @vzn/vx init" type="button">
          <span class="dollar">$</span><span class="cmd">bunx @vzn/vx init</span><span class="copied-note" aria-live="polite"></span>
        </button>
        <ol class="steps-cmd">
          {
            startCommands.map(([c, note]) => (
              <li>
                <code>{c}</code>
                <span>{note}</span>
              </li>
            ))
          }
        </ol>
        <div class="start-links">
          <a class="btn btn-primary" href={href('quickstart/')}>Quickstart <span class="arr">→</span></a>
          <a class="btn btn-ghost" href={href('guides/migrate/')}>Migrate from Turbo or Nx</a>
          <a class="btn btn-ghost" href={href('features/')}>Every feature</a>
        </div>
      </div>
    </section>

    <Footer />
  </div>

  <script>
    // Bands play once as they come near: the count runs up, the columns
    // rise, the streaks race. Everything already shows at rest; the play
    // class only replays it, and never with reduced motion.
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const count = (el: HTMLElement): void => {
        const to = Number(el.dataset['to'])
        const t0 = performance.now()
        const tick = (now: number): void => {
          const t = Math.min(1, (now - t0) / 1800)
          el.textContent = String(Math.round(to * (1 - (1 - t) ** 4)))
          if (t < 1) requestAnimationFrame(tick)
        }
        requestAnimationFrame(tick)
      }
      const seen = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue
            e.target.classList.add('play')
            e.target.querySelectorAll<HTMLElement>('.count').forEach(count)
            seen.unobserve(e.target)
          }
        },
        { rootMargin: '0px 0px -15% 0px' },
      )
      document.querySelectorAll('.band').forEach((el) => seen.observe(el))
      // The parts lean toward the pointer.
      document.querySelectorAll<HTMLElement>('.part').forEach((card) => {
        card.addEventListener('pointermove', (ev) => {
          const r = card.getBoundingClientRect()
          const x = (ev.clientX - r.left) / r.width - 0.5
          const y = (ev.clientY - r.top) / r.height - 0.5
          card.style.transform = `perspective(700px) rotateY(${x * 12}deg) rotateX(${-y * 12}deg) translateZ(8px)`
          card.style.setProperty('--mx', `${(x + 0.5) * 100}%`)
          card.style.setProperty('--my', `${(y + 0.5) * 100}%`)
        })
        card.addEventListener('pointerleave', () => {
          card.style.transform = ''
        })
      })
    }
    // Each install command copies itself.
    document.querySelectorAll<HTMLButtonElement>('.install-pill').forEach((pill) =>
      pill.addEventListener('click', async () => {
        const note = pill.querySelector('.copied-note')
        try {
          await navigator.clipboard.writeText(pill.dataset['copy'] ?? '')
          pill.classList.add('copied')
          if (note) note.textContent = 'copied'
          setTimeout(() => {
            pill.classList.remove('copied')
            if (note) note.textContent = ''
          }, 1400)
        } catch {
          // clipboard unavailable: the command is visible to select by hand
        }
      }),
    )
  </script>
</StarlightPage>
