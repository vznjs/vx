---
// One page per tag: the blog's listing narrowed to it.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import Listing from '../../../components/blog/Listing.astro'
import { filters } from '../../../blog/posts.js'

export async function getStaticPaths() {
  return (await filters()).map((f) => ({ params: { tag: f.id }, props: { label: f.label } }))
}

const { tag } = Astro.params
const { label } = Astro.props
---

<StarlightPage
  frontmatter={{
    title: label,
    // The tab and search title say it is the blog's: "Caching" alone was
    // also the docs page's title.
    head: [{ tag: 'title', content: `${label} posts | vx blog` }],
    description: `Every vx blog post about ${label.toLowerCase()}, newest first.`,
    template: 'splash',
    pagefind: false,
  }}
  hasSidebar={false}
>
  <Listing filter={tag} />
</StarlightPage>
