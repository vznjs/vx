---
// The conformance table: every case of @vzn/vx-conformance and what each
// tool did with it, from src/data/conformance.json (src/conformance/data.ts).
// The score board's rows are the categories, each a <details> whose summary
// is its scores; open, it says what it checks and lists its cases in the
// same columns. A failing cell opens its detail as one, an N/A cell why the
// tool does not have the feature, and the "only where
// tools differ" switch is a checkbox the stylesheet reads. Every case is a
// link: `#<case ref>`, and `?tool=<tool>#<case ref>` for one tool's failure.
// The script at the end only opens what such a link points into.
import FeaturesPage from '../../components/features/FeaturesPage.astro'
import {
  about,
  agree,
  CATEGORIES,
  groupName,
  inline,
  note,
  RESULTS,
  RANKED,
  toolName,
  toolShort,
} from '../../conformance/data.ts'
import Cell from '../../components/conformance/Cell.astro'
import '../../styles/conformance.css'

const README = 'https://github.com/vznjs/vx/blob/main/private/vx-conformance/README.md'
const { cases, tools } = RESULTS
const differ = cases.filter((c) => !agree(c)).length
const sections = CATEGORIES.map((id) => ({
  id,
  cases: cases.filter((c) => c.category === id),
}))
const MARK = { pass: '✓', fail: '✗', 'n/a': '–' } as const
const SAY = { pass: 'passes', fail: 'fails', 'n/a': 'does not have this feature' } as const
---

<FeaturesPage
  title="One test suite, run on every task runner"
  description={`${cases.length} task-runner behaviours, each run against ${RANKED.map(toolName).join(', ')}: what each tool did, case by case.`}
  edit="src/pages/conformance/index.astro"
>
  <div class="cfm">
    <section class="fhub-hero cfm-hero">
      <div class="container">
        <p class="vx-kicker">// {cases.length} cases, {RANKED.length} tools</p>
        <h1>One test suite, run on every task runner</h1>
        <p class="lede">
          We took the tests of vx, Turbo, Nx, Vite Task, Nix and moon and rewrote each as a small
          workspace with one expected outcome, so every tool gets the same tests.
        </p>
        <p class="lede">
          Each case runs sandboxed on each tool, and only the outcome counts: which commands ran,
          the files left on disk, the exit code, and what the tool reports about the run. Every
          week the suite runs again on each tool's latest release.
        </p>
        <p class="lede">
          A case is N/A for a tool that does not have the feature at all. A tool that has the
          feature but gets the case wrong fails it, even when it does things its own way: you would
          hit it using that feature.
        </p>
        <ul class="chips" aria-label="Tool versions">
          {
            RANKED.map((t) => (
              <li>
                <span class="cfm-chip">
                  {toolName(t)} <span class="count">{tools[t]}</span>
                </span>
              </li>
            ))
          }
          <li>
            <a href={README}>How it works</a>
          </li>
        </ul>
      </div>
    </section>

    <section class="cfm-section" id="scores">
      <div class="container">
        <h2>Scores</h2>
        <p class="cfm-sub">
          Cases passed, of every case, rounded down: 100% means every case passed. An N/A case is
          not a pass. The bar's red part is the tool's issues: cases it has the feature for but
          fails.
        </p>
        <p class="cfm-sub">
          Open a group to see its cases: ✓ passes, ✗ fails, – N/A. Open a ✗ to see what the tool did
          instead, or a – to see which feature it does not have.
        </p>
        <input type="checkbox" id="cfm-differ" class="cfm-toggle" />
        <label for="cfm-differ" class="cfm-switch">
          Only the {differ} cases where tools differ
        </label>
        <div class="cfm-board">
          <div class="cfm-row cfm-head" aria-hidden="true">
            <span class="cfm-name" />
            {
              RANKED.map((t) => (
                <span class="cfm-tool">
                  <span class="cfm-long">{toolName(t)}</span>
                  <span class="cfm-short">{toolShort(t)}</span>
                </span>
              ))
            }
          </div>
          <div class="cfm-row cfm-all" data-group="all">
            <span class="cfm-name">
              {groupName('all')}
              <span class="cfm-cat-count">{cases.length} cases</span>
            </span>
            {RANKED.map((t) => <Cell t={t} g="all" />)}
          </div>
          {
            sections.map((s) => (
              <details
                class="cfm-cat"
                id={s.id}
                data-agree={s.cases.every(agree) ? '' : undefined}
              >
                <summary class="cfm-row" data-group={s.id}>
                  <span class="cfm-name">
                    <h3>{groupName(s.id)}</h3>
                    <span class="cfm-cat-count">{s.cases.length} cases</span>
                  </span>
                  {RANKED.map((t) => (
                    <Cell t={t} g={s.id} />
                  ))}
                </summary>
                <p class="cfm-cat-about" set:html={inline(about(s.id))} />
                <table class="cfm-cases">
                  <colgroup>
                    <col />
                    <col span={RANKED.length} class="cfm-col" />
                  </colgroup>
                  <thead class="cfm-sr">
                    <tr>
                      <th scope="col">Case</th>
                      {RANKED.map((t) => (
                        <th scope="col" class="cfm-tool">
                          {toolName(t)}
                        </th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {s.cases.map((c) => (
                      <tr id={c.ref} data-case={c.id} data-agree={agree(c) ? '' : undefined}>
                        <th scope="row">
                          <span class="cfm-title" set:html={inline(c.title)} />
                          <details class="cfm-why">
                            <summary>Why this is right</summary>
                            <p set:html={inline(c.why)} />
                          </details>
                          <span class="cfm-meta">
                            <a href={`#${c.ref}`}>{c.ref}</a> · {c.id} · {c.kind}
                          </span>
                        </th>
                        {RANKED.map((t) => {
                          const o = c.outcomes[t] ?? { status: 'n/a' as const }
                          const label = `${toolName(t)} ${SAY[o.status]}`
                          return (
                            <td data-tool={t} data-status={o.status}>
                              {o.status !== 'pass' && note(o) !== '' ? (
                                <details>
                                  <summary aria-label={label} title={note(o)}>
                                    {MARK[o.status]}
                                  </summary>
                                  <p class="cfm-detail">
                                    <strong>
                                      {toolName(t)}
                                      {o.status === 'n/a' ? ': N/A' : ''}
                                    </strong>{' '}
                                    {note(o)}
                                  </p>
                                </details>
                              ) : (
                                <span aria-label={label}>{MARK[o.status]}</span>
                              )}
                            </td>
                          )
                        })}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</FeaturesPage>

<script>
  // A case's row sits in a closed category, and not every browser opens a
  // <details> to reach a link's target.
  const show = (): void => {
    let id = location.hash.slice(1)
    try {
      id = decodeURIComponent(id)
    } catch {}
    const at = id ? document.getElementById(id) : null
    const cat = at?.closest<HTMLDetailsElement>('details.cfm-cat')
    if (!at || !cat) return
    cat.open = true
    if (at.hasAttribute('data-agree')) {
      const differ = document.querySelector<HTMLInputElement>('#cfm-differ')
      if (differ) differ.checked = false
    }
    const tool = new URLSearchParams(location.search).get('tool')
    for (const td of at.querySelectorAll<HTMLElement>('td[data-tool]')) {
      const detail = td.querySelector('details')
      if (detail) detail.open = td.dataset['tool'] === tool
    }
    at.scrollIntoView()
  }
  show()
  addEventListener('hashchange', show)
</script>
