---
// The conformance table: every case of @vzn/vx-conformance and what each
// tool did with it, from src/data/conformance.json (src/conformance/data.ts).
// The score board's rows are the categories, each a <details> whose summary
// is its scores; open, it says what it checks and lists its cases in the
// same columns. A failing cell opens its detail as one, an N/A cell why the
// tool does not have the feature, and the "only where
// tools differ" switch is a checkbox the stylesheet reads. Every case is a
// link: `#<case ref>`, and `?tool=<tool>#<case ref>` for one tool's failure.
// The script at the end only opens what such a link points into.
import WidePage from '../../components/WidePage.astro'
import {
  about,
  agree,
  CATEGORIES,
  groupName,
  inline,
  RESULTS,
  RANKED,
  toolName,
  toolShort,
} from '../../conformance/data.ts'
import Cell from '../../components/conformance/Cell.astro'
import '../../styles/conformance.css'

const README = 'https://github.com/vznjs/vx/blob/main/private/vx-conformance/README.md'
const { cases, tools } = RESULTS
const differ = cases.filter((c) => !agree(c)).length
const sections = CATEGORIES.map((id) => ({
  id,
  cases: cases.filter((c) => c.category === id),
}))
// Each case's category, by ref: a link to `#<ref>` opens the category
// and loads its cases first.
const REFS = Object.fromEntries(cases.map((c) => [c.ref, c.category]))
---

<WidePage
  title="One test suite, run on every task runner"
  description={`${cases.length} task-runner behaviours, each run against ${RANKED.map(toolName).join(', ')}: what each tool did, case by case.`}
  edit="src/pages/conformance/index.astro"
>
  <div class="cfm">
    <section class="page-hero cfm-hero">
      <div class="container">
        <p class="vx-kicker">// {cases.length} cases, {RANKED.length} tools</p>
        <h1>One test suite, run on every task runner</h1>
        <p class="lede">
          We took the tests of vx, Turbo, Nx, Vite Task, Nix and moon and rewrote each as a small
          workspace with one expected outcome, so every tool gets the same tests.
        </p>
        <p class="lede">
          Each case runs sandboxed on each tool, and only the outcome counts: which commands ran,
          the files left on disk, the exit code, and what the tool reports about the run. Every
          week the suite runs again on each tool's latest release.
        </p>
        <ul class="chips" aria-label="Tool versions">
          {
            RANKED.map((t) => (
              <li>
                <span class="cfm-chip">
                  {toolName(t)} <span class="count">{tools[t]}</span>
                </span>
              </li>
            ))
          }
          <li>
            <a href={README}>How it works</a>
          </li>
        </ul>
      </div>
    </section>

    <section class="cfm-section" id="scores">
      <div class="container">
        <h2>Scores</h2>
        <p class="cfm-sub">
          Cases passed, of every case, rounded down: 100% means every case passed. An N/A case is
          not a pass. The bar's red part is the tool's issues: cases it has the feature for but
          fails.
        </p>
        <ul class="cfm-legend" aria-label="What each mark means">
          <li data-status="pass">
            <span class="cfm-mark" aria-hidden="true">✓</span>
            <span><strong>Pass.</strong> The tool did what the case expects.</span>
          </li>
          <li data-status="fail">
            <span class="cfm-mark" aria-hidden="true">✗</span>
            <span>
              <strong>Fail: an issue.</strong> The tool has the feature but got the case wrong, even
              if it does things its own way: you would hit it using that feature.
            </span>
          </li>
          <li data-status="n/a">
            <span class="cfm-mark" aria-hidden="true">–</span>
            <span>
              <strong>N/A.</strong> The tool does not have the feature at all. Not a pass, and not
              an issue.
            </span>
          </li>
        </ul>
        <p class="cfm-sub">
          Open a group to see its cases. Open a ✗ to see what the tool did instead, or a – to see
          which feature it does not have.
        </p>
        <div class="cfm-search" role="search">
          <label for="cfm-q" class="cfm-sr">Find a case</label>
          <input
            id="cfm-q"
            type="search"
            placeholder={`Find a case in ${cases.length}: words, id or #ref`}
            autocomplete="off"
            spellcheck="false"
            aria-controls="cfm-hits"
          />
          <p id="cfm-said" class="cfm-said" aria-live="polite"></p>
          <ol id="cfm-hits" class="cfm-hits" hidden></ol>
        </div>
        <input type="checkbox" id="cfm-differ" class="cfm-toggle" />
        <label for="cfm-differ" class="cfm-switch">
          Only the {differ} cases where tools differ
        </label>
        <div class="cfm-board">
          <div class="cfm-row cfm-head" aria-hidden="true">
            <span class="cfm-name" />
            {
              RANKED.map((t) => (
                <span class="cfm-tool">
                  <span class="cfm-long">{toolName(t)}</span>
                  <span class="cfm-short">{toolShort(t)}</span>
                </span>
              ))
            }
          </div>
          <div class="cfm-row cfm-all" data-group="all">
            <span class="cfm-name">
              {groupName('all')}
              <span class="cfm-cat-count">{cases.length} cases</span>
            </span>
            {RANKED.map((t) => <Cell t={t} g="all" />)}
          </div>
          {
            sections.map((s) => (
              <details
                class="cfm-cat"
                id={s.id}
                data-agree={s.cases.every(agree) ? '' : undefined}
              >
                <summary class="cfm-row" data-group={s.id}>
                  <span class="cfm-name">
                    <h3>{groupName(s.id)}</h3>
                    <span class="cfm-cat-count">{s.cases.length} cases</span>
                  </span>
                  {RANKED.map((t) => (
                    <Cell t={t} g={s.id} />
                  ))}
                </summary>
                <p class="cfm-cat-about" set:html={inline(about(s.id))} />
                <p class="cfm-more" data-cat={s.id}>
                  <a href={`${s.id}/`}>All {s.cases.length} cases</a>
                </p>
              </details>
            ))
          }
        </div>
      </div>
    </section>
  </div>
</WidePage>

<script type="application/json" id="cfm-refs" set:html={JSON.stringify(REFS)} />
<script type="application/json" id="cfm-tools" set:html={JSON.stringify(RANKED.map(toolShort))} />
<script
  type="application/json"
  id="cfm-cats"
  set:html={JSON.stringify(Object.fromEntries(CATEGORIES.map((c) => [c, groupName(c)])))}
/>

<script>
  // A category's cases live on its own page (conformance/<category>/): the
  // whole table here was 3.4 MB. Opening a category fetches that page's
  // table into it; a link to `#<ref>` opens the case's category first,
  // and `?tool=<tool>` opens that tool's detail.
  const REFS = JSON.parse(document.getElementById('cfm-refs')?.textContent ?? '{}') as Record<
    string,
    string
  >
  const loads = new Map<string, Promise<void>>()

  const load = (cat: HTMLDetailsElement): Promise<void> => {
    const more = cat.querySelector<HTMLElement>('.cfm-more')
    if (!more) return Promise.resolve()
    let done = loads.get(cat.id)
    if (!done) {
      const href = more.querySelector('a')!.href
      done = fetch(href)
        .then((r) => (r.ok ? r.text() : Promise.reject(new Error(String(r.status)))))
        .then((html) => {
          const table = new DOMParser()
            .parseFromString(html, 'text/html')
            .querySelector('table.cfm-cases')
          if (table) more.replaceWith(document.importNode(table, true))
        })
        .catch(() => loads.delete(cat.id))
      loads.set(cat.id, done)
    }
    return done
  }

  for (const cat of document.querySelectorAll<HTMLDetailsElement>('details.cfm-cat'))
    cat.addEventListener('toggle', () => {
      if (cat.open) void load(cat)
    })

  const show = async (): Promise<void> => {
    let id = location.hash.slice(1)
    try {
      id = decodeURIComponent(id)
    } catch {}
    if (!id) return
    const cat = document.querySelector<HTMLDetailsElement>(
      `details.cfm-cat[id="${CSS.escape(REFS[id] ?? id)}"]`,
    )
    if (!cat) return
    cat.open = true
    await load(cat)
    const at = REFS[id] ? document.getElementById(id) : cat
    if (!at) return
    if (at.hasAttribute('data-agree') && at !== cat) {
      const differ = document.querySelector<HTMLInputElement>('#cfm-differ')
      if (differ) differ.checked = false
    }
    const tool = new URLSearchParams(location.search).get('tool')
    for (const td of at.querySelectorAll<HTMLElement>('td[data-tool]')) {
      const detail = td.querySelector('details')
      if (detail) detail.open = td.dataset['tool'] === tool
    }
    // `:target` misses a row loaded after the hash was set: mark it.
    for (const was of document.querySelectorAll('.cfm-linked')) was.classList.remove('cfm-linked')
    if (at !== cat) at.classList.add('cfm-linked')
    at.scrollIntoView()
  }
  void show()
  addEventListener('hashchange', () => void show())

  // Case search: every case's ref, category, id, title and marks
  // (conformance/cases.json), fetched the first time the box is used.
  type Hit = [ref: string, cat: string, id: string, title: string, marks: string]
  const box = document.querySelector<HTMLInputElement>('#cfm-q')
  const hits = document.querySelector<HTMLOListElement>('#cfm-hits')
  const said = document.querySelector<HTMLElement>('#cfm-said')
  const NAMES = JSON.parse(document.getElementById('cfm-tools')?.textContent ?? '[]') as string[]
  const CATS = JSON.parse(document.getElementById('cfm-cats')?.textContent ?? '{}') as Record<
    string,
    string
  >
  const MARK: Record<string, [string, string]> = {
    p: ['✓', 'passes'],
    f: ['✗', 'fails'],
    n: ['–', 'N/A'],
  }
  const SHOW = 25
  let all: Promise<Hit[]> | undefined
  const index = (): Promise<Hit[]> =>
    (all ??= fetch('cases.json')
      .then((r) => (r.ok ? (r.json() as Promise<Hit[]>) : Promise.reject(new Error(String(r.status)))))
      .catch((e: unknown) => {
        all = undefined
        throw e
      }))

  // A title's `code` spans in code font, built as nodes: no HTML from data.
  const title = (text: string): DocumentFragment => {
    const out = document.createDocumentFragment()
    text.split('`').forEach((part, i) => {
      if (i % 2 === 0) out.append(part)
      else out.append(Object.assign(document.createElement('code'), { textContent: part }))
    })
    return out
  }

  const render = (q: string, list: Hit[]): void => {
    if (!hits || !said) return
    const words = q.toLowerCase().replace(/^#/, '').split(/\s+/).filter(Boolean)
    hits.replaceChildren()
    if (words.length === 0) {
      hits.hidden = true
      said.textContent = ''
      return
    }
    const found = list.filter(([ref, cat, id, text]) => {
      const hay = `${ref} ${id} ${CATS[cat] ?? cat} ${text}`.toLowerCase()
      return words.every((w) => hay.includes(w))
    })
    for (const [ref, cat, , text, marks] of found.slice(0, SHOW)) {
      const a = document.createElement('a')
      a.href = `#${ref}`
      const name = document.createElement('span')
      name.className = 'cfm-hit-title'
      name.append(title(text))
      const meta = document.createElement('span')
      meta.className = 'cfm-hit-meta'
      meta.textContent = `${CATS[cat] ?? cat} · #${ref}`
      const row = document.createElement('span')
      row.className = 'cfm-hit-marks'
      ;[...marks].forEach((m, i) => {
        const [mark, says] = MARK[m] ?? MARK['n']!
        const cell = document.createElement('span')
        cell.dataset['status'] = m === 'p' ? 'pass' : m === 'f' ? 'fail' : 'n/a'
        cell.title = `${NAMES[i]} ${says}`
        cell.textContent = `${NAMES[i]} ${mark}`
        row.append(cell)
      })
      a.append(name, meta, row)
      const li = document.createElement('li')
      li.append(a)
      hits.append(li)
    }
    hits.hidden = found.length === 0
    said.textContent =
      found.length === 0
        ? 'No case matches.'
        : found.length > SHOW
          ? `${found.length} cases match; the first ${SHOW} are shown.`
          : `${found.length} ${found.length === 1 ? 'case matches' : 'cases match'}.`
  }

  if (box && hits) {
    box.addEventListener('focus', () => void index().catch(() => {}), { once: true })
    box.addEventListener('input', () => {
      const q = box.value
      index()
        .then((list) => {
          if (box.value === q) render(q, list)
        })
        .catch(() => {
          if (said) said.textContent = 'The case list did not load. Try again.'
        })
    })
    // Picking a case goes to it; the same case twice fires no hashchange.
    hits.addEventListener('click', (e) => {
      const a = (e.target as Element).closest('a')
      if (a && a.getAttribute('href') === location.hash) void show()
    })
  }
</script>
