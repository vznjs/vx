---
// One tool's score in one group of the conformance board: the share of
// every case it passes, a bar of every case (faint: supported, solid:
// passed), and the counts.
import { percent, RESULTS } from '../../conformance/data.ts'

interface Props {
  t: string
  g: string
}
const { t, g } = Astro.props
const s = RESULTS.scores[t]?.[g]
const share = (n: number) => (s && s.of > 0 ? (n / s.of) * 100 : 0)
---

<span class="cfm-cell" data-tool={t}>
  <span class="cfm-pct">{percent(s)}</span>
  <span class="cfm-bar" aria-hidden="true">
    <span class="cfm-can" style={`width:${share(s?.can ?? 0)}%`} />
    <span class="cfm-pass" style={`width:${share(s?.pass ?? 0)}%`} />
  </span>
  <span class="cfm-of">{s ? `${s.pass} of ${s.of}` : '–'}</span>
  <span class="cfm-of">{s ? `${s.can} supported` : '–'}</span>
</span>
