---
// The one link every page ends on: where the reader goes next, and why.
interface Props {
  href: string
  title: string
}
---

<a class="vx-next not-content" href={Astro.props.href}>
  <span class="vx-next-tag">Next</span>
  <span class="vx-next-title">{Astro.props.title} →</span>
  <span class="vx-next-why"><slot /></span>
</a>

<style>
  .vx-next {
    display: grid;
    gap: 0.2rem;
    margin: 2rem 0 0.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--vx-accent) 55%, var(--vx-border));
    border-radius: 12px;
    background: linear-gradient(100deg, var(--vx-accent-soft), color-mix(in srgb, var(--vx-surface) 60%, var(--vx-bg)) 75%);
    text-decoration: none;
    color: var(--vx-text);
    transition:
      border-color 0.15s,
      box-shadow 0.15s;
  }
  .vx-next:hover {
    border-color: var(--vx-accent);
    box-shadow: 0 0 28px color-mix(in srgb, var(--vx-accent) 18%, transparent);
  }
  .vx-next-tag {
    font-family: var(--vx-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--vx-accent);
  }
  .vx-next-why {
    color: var(--vx-text);
  }
  .vx-next-title {
    font-family: var(--vx-font-display);
    font-size: 1.2rem;
    letter-spacing: -0.02em;
    font-weight: 600;
    color: var(--vx-fg);
  }
</style>
