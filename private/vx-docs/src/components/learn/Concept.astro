---
// A new word, explained the first time a page uses it: the term, then one
// or two plain sentences. Juniors meet each idea here before they need it.
interface Props {
  term: string
}
---

<aside class="vx-concept" aria-label={`New word: ${Astro.props.term}`}>
  <p class="vx-concept-head"><span class="vx-concept-tag">New word</span> <strong>{Astro.props.term}</strong></p>
  <div class="vx-concept-body"><slot /></div>
</aside>

<style>
  .vx-concept {
    border: 1px solid color-mix(in srgb, var(--vx-accent) 30%, var(--vx-border));
    border-left: 3px solid var(--vx-accent);
    background: linear-gradient(100deg, var(--vx-accent-soft), color-mix(in srgb, var(--vx-surface) 60%, var(--vx-bg)) 70%);
    border-radius: 12px;
    padding: 0.9rem 1.15rem;
    margin: 1.25rem 0;
  }
  .vx-concept-head {
    margin: 0 0 0.3rem;
    color: var(--vx-fg);
  }
  .vx-concept-tag {
    font-family: var(--vx-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--vx-accent);
  }
  .vx-concept-body :global(p) {
    margin: 0;
  }
</style>
