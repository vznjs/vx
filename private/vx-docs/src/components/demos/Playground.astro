---
// The playground (playground/; item 700, design/playground-ui-2026-09.md).
// Without JavaScript it is the toy workspace: each `vx.config.mjs`, folded,
// and the tasks its run plans as a table of what each waits for and the
// inputs it declares. `playground.ts` unhides the editor and the run
// controls, hides that, and imports vx's planner from `data-planner` on the
// first Run. The element reads `.controls` (and its `data-planner`), `.file`,
// `.editor`, `.new-path`, `.env`, `.tasks`, the `data-action` buttons,
// `.status`, `.errors`, `.results` with its `caption` and `tbody`, `.order`
// and `.static`, so they are its contract with this markup.
//
// The table comes from the config TEXTS, evaluated here at build time by the
// page's own rewrite and JSON rule (`evaluateConfigInProcess`: no Worker, which
// a Node build lacks), so the reader's first Run and the static render read
// one source.
import Demo from '../Demo.astro'
import { evaluateConfigInProcess } from '../../playground/config-eval.js'
import { START } from '../../playground/workspace.js'
import {
  configTextsOf,
  envText,
  staticCells,
  staticProjects,
  staticTable,
} from './model/playground-view.js'

const { files: FILES, env: ENV, tasks: TASKS } = START
const configs: Record<string, unknown> = {}
for (const [name, text] of Object.entries(configTextsOf(FILES))) {
  const r = await evaluateConfigInProcess(text)
  if (!r.ok) throw new Error(`<Playground>: ${name}'s vx.config.mjs does not evaluate: ${r.error}`)
  configs[name] = r.config
}
const rows = staticTable(staticProjects(FILES, configs), TASKS).map(staticCells)
const paths = Object.keys(FILES)
const configFiles = paths.filter((f) => f.endsWith('/vx.config.mjs'))
const planner = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}playground/planner.js`
const HEAD = ['Task', 'Waits for', 'Inputs']
---

<Demo name="playground">
  <div class="controls not-content" data-planner={planner} hidden>
    <p class="vx-row">
      <select class="file" aria-label="File">{paths.map((f) => <option value={f}>{f}</option>)}</select>
      <button type="button" data-action="delete">Delete</button>
    </p>
    <textarea class="editor" rows="10" spellcheck="false" autocomplete="off" aria-label="The file's contents"
    ></textarea>
    <p class="vx-row">
      <input class="new-path" type="text" placeholder="packages/ui/README.md" aria-label="New file" />
      <button type="button" data-action="add">Add file</button>
    </p>
    <p class="vx-row">
      <span class="vx-label">env</span>
      <textarea
        class="env"
        rows="1"
        spellcheck="false"
        autocomplete="off"
        aria-label="Environment, one NAME=value per line">{envText(ENV)}</textarea
      >
    </p>
    <p class="vx-row">
      <span class="vx-label">vx run</span>
      <input class="tasks" type="text" value={TASKS.join(' ')} aria-label="Task specs" />
      <span class="vx-label">--all</span>
      <button type="button" class="primary" data-action="run">Run</button>
      <button type="button" data-action="reset">Reset</button>
    </p>
  </div>
  <p class="status vx-say" aria-live="polite" hidden></p>
  <ul class="errors not-content" hidden></ul>
  <table class="results" hidden>
    <caption></caption>
    <thead>
      <tr>
        <th scope="col">Task</th>
        <th scope="col">Key</th>
        <th scope="col">Cache</th>
        <th scope="col">Key moved</th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>
  <p class="order" hidden></p>
  <div class="static">
    {
      configFiles.map((f) => (
        <details>
          <summary>
            <code>{f}</code>
          </summary>
          <pre class="config">{FILES[f]}</pre>
        </details>
      ))
    }
    <table class="graph">
      <caption><code>vx run {TASKS.join(' ')} --all</code> plans:</caption>
      <thead>
        <tr>{HEAD.map((h) => <th scope="col">{h}</th>)}</tr>
      </thead>
      <tbody>
        {
          rows.map(([id, waits, inputs]) => (
            <tr>
              <th scope="row">{id}</th>
              <td>{waits}</td>
              <td>{inputs}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <Fragment slot="caption">
    vx's own planner, in your browser. It plans and runs nothing. A test holds its keys to the CLI's.
  </Fragment>
</Demo>

<!--
  Global, under the element's tag: the element writes the results table's
  rows, and Astro's scoping attribute is only on the markup it rendered.
-->
<style is:global>
  vx-playground {
    display: block;
  }
  vx-playground textarea {
    display: block;
    width: 100%;
    margin: 0;
    padding: 0.5rem 0.75rem;
    white-space: pre;
    overflow-x: auto;
    resize: vertical;
    tab-size: 2;
  }
  vx-playground .vx-row {
    margin: 0.5rem 0;
  }
  vx-playground .vx-row textarea.env {
    flex: 1;
    width: auto;
  }
  vx-playground .file {
    max-width: 100%;
  }
  vx-playground :is(.controls, .static, .results, .errors, .order)[hidden] {
    display: none;
  }
  vx-playground .errors {
    margin: 0.5rem 0;
    padding: 0.5rem 0.75rem 0.5rem 1.75rem;
    border: 1.5px solid var(--vx-danger);
    border-radius: 8px;
    color: var(--vx-danger);
    font-family: var(--vx-mono);
    font-size: 13px;
    white-space: pre-wrap;
  }
  vx-playground .results tr[data-change='moved'] td:nth-child(4) {
    color: var(--vx-accent);
    font-weight: 700;
  }
  vx-playground .results td:nth-child(3) {
    color: var(--vx-muted);
  }
  vx-playground .results[data-stale='true'] {
    opacity: 0.55;
  }
  vx-playground .results[data-stale='true'] caption {
    color: var(--vx-danger);
  }
  vx-playground .order {
    font-family: var(--vx-mono);
    font-size: 13px;
    color: var(--vx-muted);
  }
  vx-playground details {
    margin-top: 0.5rem;
  }
  vx-playground summary {
    cursor: pointer;
    font-family: var(--vx-mono);
    font-size: 13px;
  }
  vx-playground .graph {
    margin-top: 1rem;
  }
</style>
