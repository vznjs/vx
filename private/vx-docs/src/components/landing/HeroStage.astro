---
// The hero is the copy alone, a screen tall, over a retro sunset sky. Below
// it, as its own section, the system graph: every piece one CI run talks to,
// before a striped sun sinking into an endless grid. When the graph comes
// into view it rises in, then plays one real run on a loop: 10 tasks as
// vx-dte's simulator ran them (src/data/hero-run.json), every message named
// as it travels. At rest (no script, reduced motion) it is a plain section:
// the copy, the graph, and the six groups listed.
import run from '../../data/hero-run.json'
import SystemMap from './SystemMap.astro'
import { GROUPS, TRAVEL_MS, WIRES, play, type Run } from './system-map.ts'

interface Props {
  base: string
  latest: { href: string; version: string; title: string }
}
const { base, latest } = Astro.props
const href = (p: string) => `${base}${p}`
const codeHtml = (s: string): string => s.replace(/`([^`]+)`/g, '<code>$1</code>')
const data = { ...play(run as Run), travel: TRAVEL_MS, ends: Object.fromEntries(WIRES.map((w) => [w.id, [w.from, w.to]])) }
const specs = [
  { n: '15', line: 'stages a plugin can take over' },
  { n: 'MIT', line: 'every piece, no paid tier' },
  { n: '0', line: 'daemons, accounts or clouds' },
]
---

<section class="stage" data-play={JSON.stringify(data)} aria-label="vx">
  <div class="stage-pin">
    <canvas class="stage-sky" aria-hidden="true"></canvas>
    <div class="stage-copy">
      <a class="stage-release" href={latest.href}>
        <span class="tag">New</span>
        <span class="ver">{latest.version}</span>
        <span class="ttl">{latest.title}</span>
      </a>
      <h1><span class="l1">Run everything.</span> <span class="l2">Own <em>everything</em>.</span></h1>
      <p class="lede">One task graph from your laptop to every machine your CI can start, with the cache, the history, the workers and the telemetry all yours to host.</p>
      <div class="stage-actions">
        <button class="install-pill" data-copy="bunx @vzn/vx init" type="button">
          <span class="dollar">$</span>
          <span class="cmd">bunx @vzn/vx init</span>
          <span class="copied-note" aria-live="polite"></span>
        </button>
        <a class="btn btn-primary" href={href('quickstart/')}>Quickstart <span class="arr">→</span></a>
        <a class="btn btn-ghost" href="https://github.com/vznjs/vx">GitHub</a>
      </div>
      <ul class="specs">
        {
          specs.map((s) => (
            <li>
              <strong>{s.n}</strong>
              <span>{s.line}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <header class="stage-head">
      <p class="kicker">One CI run, 10 tasks, every message</p>
      <h2>One run.<br /><em>Every piece.</em></h2>
    </header>
    <div class="stage-world" aria-hidden="true">
      <div class="stage-tilt">
        <SystemMap />
      </div>
    </div>
    <div class="stage-story" id="one-run">
      <p class="story-kicker">One run, six groups</p>
      <ol class="story-steps">
        {
          GROUPS.map((g, i) => (
            <li class:list={[`tone-${g.tone}`]} id={g.anchors?.[0]} data-step={i} data-group={g.id}>
              {g.anchors?.slice(1).map((a) => <span id={a} />)}
              <span class="story-n">{String(i + 1).padStart(2, '0')}<span class="of"> / {String(GROUPS.length).padStart(2, '0')}</span></span>
              <strong class="story-title">{g.title}</strong>
              <p set:html={codeHtml(g.line)} />
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import type { Play } from './system-map.ts'
  interface Data extends Play {
    travel: number
    ends: Record<string, [string, string]>
  }
  const TONES: Record<string, string> = {
    core: '#c6f84e',
    read: '#5ee0ff',
    remote: '#ff9d42',
    dte: '#b794ff',
    report: '#f472b6',
  }
  const stage = document.querySelector<HTMLElement>('.stage')
  if (stage) boot(stage)

  function boot(stage: HTMLElement): void {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    const P = JSON.parse(stage.dataset['play'] ?? '{}') as Data
    const canvas = stage.querySelector<HTMLCanvasElement>('.stage-sky')!
    const ctx = canvas.getContext('2d')
    const clamp = (x: number, a = 0, b = 1): number => Math.min(b, Math.max(a, x))
    const ease = (t: number): number => 1 - (1 - t) ** 3

    if (still || !ctx) {
      stage.classList.add('still')
      return
    }
    stage.classList.add('js')

    // ---- the run: one clock, every piece drawn from the simulated run ----
    const NS = 'http://www.w3.org/2000/svg'
    const svg = (): SVGSVGElement | undefined =>
      [...stage.querySelectorAll<SVGSVGElement>('.map-svg')].find((s) => s.getBoundingClientRect().width > 0)
    const fmt = (ms: number): string => {
      const sec = Math.max(0, Math.round(ms / 1000))
      return `${Math.floor(sec / 60)}:${String(sec % 60).padStart(2, '0')}`
    }
    // Per layout: its wires' paths and lengths, its slots' geometry, its dot and bar pools.
    interface View {
      root: SVGSVGElement
      paths: Map<string, { el: SVGPathElement; len: number }>
      dots: { g: SVGGElement; c: SVGCircleElement; l: SVGTextElement }[]
      slots: Map<number, { g: SVGGElement; warm: SVGRectElement; state: SVGTextElement; x: number; y: number; w: number; h: number; cores: number }>
      bars: Map<string, { g: SVGGElement; done: SVGRectElement }>
      clock: SVGTextElement
    }
    const views = new Map<SVGSVGElement, View>()
    const view = (root: SVGSVGElement): View => {
      let v = views.get(root)
      if (v) return v
      const paths = new Map<string, { el: SVGPathElement; len: number }>()
      root.querySelectorAll<SVGPathElement>('[data-wire]').forEach((el) => paths.set(el.dataset['wire']!, { el, len: el.getTotalLength() }))
      const slots: View['slots'] = new Map()
      root.querySelectorAll<SVGGElement>('[data-slot]').forEach((g) => {
        const n = (k: string): number => Number(g.dataset[k])
        slots.set(n('slot'), { g, warm: g.querySelector('.slot-warm')!, state: g.querySelector('.slot-state')!, x: n('x'), y: n('y'), w: n('w'), h: n('h'), cores: n('cores') })
      })
      v = { root, paths, dots: [], slots, bars: new Map(), clock: root.querySelector('.core-clock')! }
      views.set(root, v)
      return v
    }
    const bar = (v: View, i: number): { g: SVGGElement; done: SVGRectElement } => {
      const b = P.bars[i]!
      let made = v.bars.get(b.id)
      if (made) return made
      const s = v.slots.get(b.slot)!
      const x = s.x + (b.at / s.cores) * s.w + 2
      const w = (b.cores / s.cores) * s.w - 4
      const g = document.createElementNS(NS, 'g')
      g.setAttribute('class', 'bar')
      const face = document.createElementNS(NS, 'rect')
      for (const [k, val] of [['x', x], ['y', s.y + 3], ['width', w], ['height', s.h - 6], ['rx', 3]] as const) face.setAttribute(k, `${val}`)
      face.setAttribute('class', 'bar-face')
      const done = document.createElementNS(NS, 'rect')
      for (const [k, val] of [['x', x], ['y', s.y + 3], ['width', 0], ['height', s.h - 6], ['rx', 3]] as const) done.setAttribute(k, `${val}`)
      done.setAttribute('class', 'bar-done')
      const label = document.createElementNS(NS, 'text')
      label.setAttribute('x', `${x + 5}`)
      label.setAttribute('y', `${s.y + s.h / 2 + 4}`)
      label.setAttribute('class', 'bar-label')
      const room = Math.floor((w - 8) / 6.2)
      // A narrow bar names the task alone; one too narrow for that, a cut of it.
      const full = w > 110 ? b.id : b.id.split('#')[1]!
      label.textContent = full.length > room ? `${full.slice(0, Math.max(0, room - 1))}…` : full
      g.append(face, done, label)
      s.g.querySelector('.bars')!.append(g)
      v.bars.set(b.id, (made = { g, done }))
      return made
    }

    const render = (t: number): void => {
      const root = svg()
      if (!root) return
      const v = view(root)
      const T = P.travel
      // Dots in flight, and the wires and boxes they light.
      const live = new Set<string>()
      const boxes = new Set<string>(['core'])
      let n = 0
      for (const d of P.dots) {
        if (d.at > t) break
        const k = (t - d.at) / T
        if (k >= 1) continue
        const p = v.paths.get(d.wire)
        if (!p) continue
        live.add(d.wire)
        const [from, to] = P.ends[d.wire]!
        boxes.add(from)
        boxes.add(to)
        let dot = v.dots[n]
        if (!dot) {
          const g = document.createElementNS(NS, 'g')
          const c = document.createElementNS(NS, 'circle')
          c.setAttribute('r', '4.5')
          const l = document.createElementNS(NS, 'text')
          l.setAttribute('class', 'dot-label')
          l.setAttribute('x', '8')
          l.setAttribute('y', '-7')
          g.append(c, l)
          root.querySelector('.packets')!.appendChild(g)
          v.dots[n] = dot = { g, c, l }
        }
        const e = k < 0.5 ? 2 * k * k : 1 - (-2 * k + 2) ** 2 / 2
        const pt = p.el.getPointAtLength((d.back ? 1 - e : e) * p.len)
        dot.g.setAttribute('transform', `translate(${pt.x} ${pt.y})`)
        dot.c.setAttribute('fill', TONES[d.tone]!)
        dot.l.setAttribute('fill', TONES[d.tone]!)
        if (dot.l.textContent !== d.label) dot.l.textContent = d.label
        dot.g.style.display = ''
        n++
      }
      for (let i = n; i < v.dots.length; i++) v.dots[i]!.g.style.display = 'none'
      root.querySelectorAll<SVGElement>('[data-wire]').forEach((w) => {
        const on = live.has(w.dataset['wire']!)
        w.classList.toggle('live', on)
        if (on) w.dataset['tone'] = P.dots.find((d) => d.wire === w.dataset['wire'] && d.at <= t && t < d.at + T)?.tone ?? ''
      })

      // Groups lit now: more than one at once while the run streams.
      const lit = new Set(Object.entries(P.lit).filter(([, spans]) => spans.some(([a, b]) => a <= t && t < b)).map(([g]) => g))
      root.querySelectorAll<SVGElement>('[data-stage]').forEach((c) => c.classList.toggle('on', lit.has(c.dataset['stage']!)))
      stage.querySelectorAll<HTMLElement>('.story-steps li').forEach((li) => li.classList.toggle('on', lit.has(li.dataset['group']!)))

      // Workers: off, booting, running, idle, tearing down, off again.
      let online = 0
      for (const [k, s] of v.slots) {
        const lane = P.lanes.find((l) => l.slot === k && l.spawn <= t && t < l.leave)
        let state = 'off'
        let warm = 0
        if (lane) {
          online++
          if (t < lane.join) {
            state = 'booting'
            warm = (t - lane.spawn) / (lane.join - lane.spawn)
          } else if (t >= lane.leave - 2 * T) state = 'tearing down'
          else state = P.bars.some((b) => b.slot === k && b.start <= t && t < b.end) ? 'running' : 'idle'
        }
        s.g.dataset['state'] = state.replace(' ', '-')
        s.state.textContent = state
        s.warm.setAttribute('width', `${clamp(warm) * (s.w + 20)}`)
      }
      P.bars.forEach((b, i) => {
        const on = b.start <= t && t < b.end
        const had = v.bars.get(b.id)
        if (!on) {
          if (had) had.g.style.display = 'none'
          return
        }
        const made = bar(v, i)
        made.g.style.display = ''
        const s = v.slots.get(b.slot)!
        made.done.setAttribute('width', `${clamp((t - b.start) / (b.end - b.start)) * ((b.cores / s.cores) * s.w - 4)}`)
      })
      root.querySelectorAll<SVGElement>('[data-box]').forEach((el) => el.classList.toggle('on', boxes.has(el.dataset['box']!)))
      stage.classList.add('telling')

      // The core's clock: the run's own time, not the play's.
      const ran = P.bars.filter((b) => b.end <= t).length
      const hit = P.hits.filter((h) => h <= t).length
      const now = P.first + (t - P.zero) / P.scale
      v.clock.textContent =
        t < P.zero
          ? [...lit].join(' · ') || 'setup'
          : t < P.end
            ? `${fmt(now)} · ${online} worker${online === 1 ? '' : 's'} · ${ran} ran · ${hit} cached`
            : `teardown · ${fmt(P.first + (P.end - P.zero) / P.scale)} · ${ran} ran · ${hit} cached`
    }

    // The play starts when the graph comes into view, not at page load.
    let born = Infinity
    new IntersectionObserver(
      (entries, io) => {
        if (!entries.some((e) => e.isIntersecting)) return
        born = Math.min(born, performance.now())
        stage.classList.add('seen')
        io.disconnect()
      },
      { threshold: 0.25 },
    ).observe(stage.querySelector('.stage-world')!)
    // How far the entrance has played: the sun rises with the graph.
    let rise = 0
    const ENTER_MS = 1400
    const autoplay = (now: number): void => {
      rise = ease(clamp((now - born) / 1600))
      if (now - born < ENTER_MS) return
      render((now - born - ENTER_MS) % P.loop)
    }
    // An old link to a group's anchor lands on the graph.
    if (stage.querySelector(`.story-steps [id="${CSS.escape(location.hash.slice(1))}"]`)) {
      born = performance.now()
      stage.classList.add('seen')
    }

    // ---- the sky: a retro sunset, a striped sun sinking into the grid ----
    // Everything still (sky, stars, floor, the grid's long lines) is painted
    // once per size into `back`; a frame only draws the sun and the grid's
    // moving cross lines over it.
    let W = 0
    let H = 0
    const back = document.createElement('canvas')
    const sunCanvas = document.createElement('canvas')
    const world = stage.querySelector<HTMLElement>('.stage-world')!
    // The horizon runs behind the graph's lower part, the sun centred on it.
    const horizon = (): number => world.offsetTop + world.offsetHeight * 0.74
    const sunR = (): number => Math.min(W * 0.2, world.offsetHeight * 0.42)
    const size = (): void => {
      // One pixel per CSS pixel: the sky is soft, and a 2x canvas quadruples each frame's fill.
      const dpr = 1
      W = canvas.clientWidth
      H = canvas.clientHeight
      for (const c of [canvas, back]) {
        c.width = Math.round(W * dpr)
        c.height = Math.round(H * dpr)
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      const r = sunR()
      sunCanvas.width = Math.round(2 * r * dpr)
      sunCanvas.height = Math.round(2 * r * dpr)
      const b = back.getContext('2d')!
      b.setTransform(dpr, 0, 0, dpr, 0, 0)
      const hy = horizon()
      const cx = W / 2
      const sky = b.createLinearGradient(0, 0, 0, hy)
      sky.addColorStop(0, '#040b08')
      sky.addColorStop(0.5, '#07170f')
      sky.addColorStop(0.85, '#0d2e1c')
      sky.addColorStop(1, '#1d5a32')
      b.fillStyle = sky
      b.fillRect(0, 0, W, hy)
      b.fillStyle = 'rgba(236,255,240,0.5)'
      for (let i = 0, n = W < 720 ? 40 : 90; i < n; i++) b.fillRect(Math.random() * W, Math.random() ** 1.6 * hy * 0.8, 1.4, 1.4)
      const glow = b.createRadialGradient(cx, hy, r * 0.6, cx, hy, r * 2.6)
      glow.addColorStop(0, 'rgba(120,245,150,0.35)')
      glow.addColorStop(1, 'rgba(120,245,150,0)')
      b.fillStyle = glow
      b.fillRect(0, hy - r * 2.6, W, r * 2.6)
      b.fillStyle = '#030805'
      b.fillRect(0, hy, W, H - hy)
      const haze = b.createLinearGradient(0, hy, 0, hy + H * 0.12)
      haze.addColorStop(0, 'rgba(120,245,150,0.35)')
      haze.addColorStop(1, 'rgba(120,245,150,0)')
      b.fillStyle = haze
      b.fillRect(0, hy, W, H * 0.12)
      const f = H * 0.9
      b.lineWidth = 1
      for (let i = -30; i <= 30; i++) {
        const x1 = cx + (i * 1.1 * f) / 0.6
        const x2 = cx + (i * 1.1 * f) / 36
        const lg = b.createLinearGradient(x1, hy + f / 0.6, x2, hy + f / 36)
        lg.addColorStop(0, 'rgba(120,245,150,0.5)')
        lg.addColorStop(1, 'rgba(120,245,150,0.05)')
        b.strokeStyle = lg
        b.beginPath()
        b.moveTo(x1, hy + f / 0.6)
        b.lineTo(x2, hy + f / 36)
        b.stroke()
      }
    }
    // The sun's disc with its stripes cut, drawn small, then placed.
    const paintSun = (drift: number): void => {
      const r = sunR()
      const s = sunCanvas.getContext('2d')!
      s.setTransform(sunCanvas.width / (2 * r), 0, 0, sunCanvas.height / (2 * r), 0, 0)
      s.globalCompositeOperation = 'source-over'
      s.clearRect(0, 0, 2 * r, 2 * r)
      s.beginPath()
      s.arc(r, r, r, 0, Math.PI * 2)
      const g = s.createLinearGradient(0, 0, 0, r * 1.32)
      g.addColorStop(0, '#f4ff9a')
      g.addColorStop(0.45, '#c6f84e')
      g.addColorStop(1, '#3fe0a0')
      s.fillStyle = g
      s.fill()
      s.globalCompositeOperation = 'destination-out'
      for (let i = 0; i < 8; i++) {
        const k = (i + drift) / 8
        s.fillRect(0, r * 0.95 + k * r * 0.4 + k * k * r * 0.25, 2 * r, 1 + k * r * 0.07)
      }
    }
    let travel = 0
    let clock = 0
    const draw = (dt: number): void => {
      const hy = horizon()
      const r = sunR()
      clock += dt
      ctx.drawImage(back, 0, 0, W, H)
      // set low behind the copy, it rises as the graph comes up
      paintSun((clock * 0.12) % 1)
      const top = hy - r * 0.32 + (1 - rise) * r * 1.05 - r
      ctx.save()
      ctx.beginPath()
      ctx.rect(0, 0, W, hy)
      ctx.clip()
      ctx.drawImage(sunCanvas, W / 2 - r, top, 2 * r, 2 * r)
      ctx.restore()
      ctx.fillStyle = 'rgba(210,255,170,0.9)'
      ctx.fillRect(0, hy - 0.5, W, 1.2)
      const speed = 0.9
      travel = (travel + speed * dt) % 1
      const f = H * 0.9
      ctx.lineWidth = 1
      for (let k = 1; k <= 36; k++) {
        const z = (k - travel) * 0.9
        if (z < 0.6) continue
        const y = hy + f / z
        if (y > H) continue
        ctx.strokeStyle = `rgba(120,245,150,${0.55 * (1 - z / 32.4) ** 1.5})`
        ctx.beginPath()
        ctx.moveTo(0, y)
        ctx.lineTo(W, y)
        ctx.stroke()
      }
    }

    // ---- one loop, only while the stage is on screen ----
    let running = false
    let tick = 0
    let last = 0
    const frame = (now: number): void => {
      if (!running) return
      const dt = Math.min(0.05, (now - (last || now)) / 1000)
      last = now
      // The sky moves slowly: 30 frames a second is enough, and halves its cost.
      if ((tick = (tick + 1) % 2) === 0) draw(dt * 2)
      autoplay(now)
      requestAnimationFrame(frame)
    }
    const start = (): void => {
      if (running || document.hidden) return
      running = true
      last = 0
      requestAnimationFrame(frame)
    }
    const stop = (): void => {
      running = false
    }
    new IntersectionObserver(([e]) => (e!.isIntersecting ? start() : stop())).observe(stage)
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()))
    // The sky follows the graph, so repaint its still layer whenever the stage resizes.
    new ResizeObserver(size).observe(stage)
    size()
  }
</script>
