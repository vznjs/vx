---
// The hero is the system graph: every piece one CI run talks to, gently
// tilted before a retro sunset, a striped sun sinking into an endless grid.
// Scrolling stands the graph up, then plays the run one step at a time.
// At rest (no script, reduced motion) it is a plain section: the copy, the
// graph tilted once, and every step listed.
import SystemMap from './SystemMap.astro'
import { STEPS } from './system-map.ts'

interface Props {
  base: string
  latest: { href: string; version: string; title: string }
}
const { base, latest } = Astro.props
const href = (p: string) => `${base}${p}`
const codeHtml = (s: string): string => s.replace(/`([^`]+)`/g, '<code>$1</code>')
const play = STEPS.map((s) => ({ boxes: s.boxes, stages: s.stages, wires: s.wires, tone: s.tone, anchor: s.anchor ?? '' }))
const specs = [
  { n: '15', line: 'stages a plugin can take over' },
  { n: 'MIT', line: 'every piece, no paid tier' },
  { n: '0', line: 'daemons, accounts or clouds' },
]
---

<section class="stage" data-steps={JSON.stringify(play)} aria-label="vx">
  <div class="stage-pin">
    <canvas class="stage-sky" aria-hidden="true"></canvas>
    <div class="stage-copy">
      <a class="stage-release" href={latest.href}>
        <span class="tag">New</span>
        <span class="ver">{latest.version}</span>
        <span class="ttl">{latest.title}</span>
      </a>
      <h1><span class="l1">Run everything.</span> <span class="l2">Own <em>everything</em>.</span></h1>
      <p class="lede">One task graph from your laptop to every machine your CI can start, with the cache, the history, the workers and the telemetry all yours to host.</p>
      <div class="stage-actions">
        <button class="install-pill" data-copy="bunx @vzn/vx init" type="button">
          <span class="dollar">$</span>
          <span class="cmd">bunx @vzn/vx init</span>
          <span class="copied-note" aria-live="polite"></span>
        </button>
        <a class="btn btn-primary" href={href('quickstart/')}>Quickstart <span class="arr">→</span></a>
        <a class="btn btn-ghost" href="https://github.com/vznjs/vx">GitHub</a>
      </div>
      <ul class="specs">
        {
          specs.map((s) => (
            <li>
              <strong>{s.n}</strong>
              <span>{s.line}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="stage-world" aria-hidden="true">
      <div class="stage-tilt">
        <SystemMap />
      </div>
    </div>
    <div class="stage-story" id="one-run">
      <p class="story-kicker">One CI run, step by step</p>
      <ol class="story-steps">
        {
          STEPS.map((s, i) => (
            <li class:list={[`tone-${s.tone}`]} id={s.anchor} data-step={i}>
              <span class="story-n">{String(i + 1).padStart(2, '0')}<span class="of"> / {String(STEPS.length).padStart(2, '0')}</span></span>
              <strong class="story-title">{s.title}</strong>
              <p set:html={codeHtml(s.line)} />
            </li>
          ))
        }
      </ol>
      <nav class="story-rail" aria-label="Steps of the run">
        {STEPS.map((s, i) => (
          <button type="button" class={`tone-${s.tone}`} data-goto={i} aria-label={`Step ${i + 1}: ${s.title}`} />
        ))}
      </nav>
    </div>
    <p class="stage-hint" aria-hidden="true">Scroll to run it</p>
  </div>
</section>

<script>
  interface Play {
    boxes: string[]
    stages: string[]
    wires: string[]
    tone: string
    anchor: string
  }
  const TONES: Record<string, string> = {
    core: '#c6f84e',
    read: '#5ee0ff',
    remote: '#ff9d42',
    dte: '#b794ff',
    report: '#f472b6',
  }
  const stage = document.querySelector<HTMLElement>('.stage')
  if (stage) boot(stage)

  function boot(stage: HTMLElement): void {
    const still = matchMedia('(prefers-reduced-motion: reduce)').matches
    const steps = JSON.parse(stage.dataset['steps'] ?? '[]') as Play[]
    const INTRO = 0.14
    // The graph lies back a little in the intro and stands flat for the run.
    const RX0 = 24
    const RX1 = 0
    const tilt = stage.querySelector<HTMLElement>('.stage-tilt')!
    const copy = stage.querySelector<HTMLElement>('.stage-copy')!
    const story = stage.querySelector<HTMLElement>('.stage-story')!
    const hint = stage.querySelector<HTMLElement>('.stage-hint')!
    const canvas = stage.querySelector<HTMLCanvasElement>('.stage-sky')!
    const ctx = canvas.getContext('2d')
    const clamp = (x: number, a = 0, b = 1): number => Math.min(b, Math.max(a, x))
    const ease = (t: number): number => 1 - (1 - t) ** 3

    if (still || !ctx) {
      stage.classList.add('still')
      return
    }
    stage.classList.add('js')

    // ---- the graph: which step is lit, packets on its wires ----
    let step = -2
    type Packet = { path: SVGPathElement; len: number; back: boolean; t0: number; dot: SVGCircleElement }
    let packets: Packet[] = []
    let lastSpawn = 0
    const svg = (): SVGSVGElement | undefined =>
      [...stage.querySelectorAll<SVGSVGElement>('.map-svg')].find((s) => s.getBoundingClientRect().width > 0)

    const send = (wire: string, tone: string, delay: number, now: number): void => {
      const root = svg()
      if (!root) return
      const back = wire.startsWith('-')
      const path = root.querySelector<SVGPathElement>(`[data-wire="${back ? wire.slice(1) : wire}"]`)
      if (!path) return
      const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle')
      dot.setAttribute('r', '5')
      dot.setAttribute('fill', TONES[tone] ?? TONES['core']!)
      dot.setAttribute('opacity', '0')
      root.querySelector('.packets')!.appendChild(dot)
      packets.push({ path, len: path.getTotalLength(), back, t0: now + delay, dot })
    }

    const light = (i: number): void => {
      if (i === step) return
      step = i
      const s = steps[i]
      stage.querySelectorAll<HTMLElement>('.story-steps li').forEach((li, j) => li.classList.toggle('on', j === i))
      stage.querySelectorAll<HTMLElement>('.story-rail button').forEach((b, j) => b.classList.toggle('on', j <= i))
      stage.querySelectorAll<SVGElement>('[data-box]').forEach((n) =>
        n.classList.toggle('on', !s || n.dataset['box'] === 'core' || s.boxes.includes(n.dataset['box']!)),
      )
      stage.querySelectorAll<SVGElement>('[data-stage]').forEach((n) =>
        n.classList.toggle('on', !!s && s.stages.includes(n.dataset['stage']!)),
      )
      const live = new Set(s ? s.wires.map((w) => w.replace(/^-/, '')) : [])
      stage.querySelectorAll<SVGElement>('[data-wire]').forEach((n) => {
        n.classList.toggle('live', live.has(n.dataset['wire']!))
        n.dataset['tone'] = s?.tone ?? ''
      })
      stage.classList.toggle('telling', !!s)
      lastSpawn = 0
    }

    const ALL = ['ws', 'lockfile', 'history', 'cache', '-cache', 'otel', 'ci', 'relay', 'w1', 'w2', 'w3', 'w4', 'store', 'reapi', 'migrate']
    const ALL_TONE: Record<string, string> = {
      ws: 'read', lockfile: 'read', history: 'read', cache: 'remote', '-cache': 'remote', otel: 'report',
      ci: 'report', relay: 'dte', w1: 'dte', w2: 'dte', w3: 'dte', w4: 'dte', store: 'remote', reapi: 'remote', migrate: 'remote',
    }
    const spawn = (now: number): void => {
      const s = steps[step]
      if (s) {
        if (now - lastSpawn < 850) return
        lastSpawn = now
        s.wires.forEach((w, i) => send(w, s.tone, i * 120, now))
      } else {
        if (now - lastSpawn < 220) return
        lastSpawn = now
        const w = ALL[Math.floor(Math.random() * ALL.length)]!
        send(w, ALL_TONE[w]!, 0, now)
      }
    }

    const movePackets = (now: number): void => {
      const DUR = 1050
      packets = packets.filter((p) => {
        const t = (now - p.t0) / DUR
        if (t > 1) {
          p.dot.remove()
          return false
        }
        if (t < 0) return true
        const e = t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2
        const pt = p.path.getPointAtLength((p.back ? 1 - e : e) * p.len)
        p.dot.setAttribute('cx', `${pt.x}`)
        p.dot.setAttribute('cy', `${pt.y}`)
        p.dot.setAttribute('opacity', `${Math.min(1, 6 * Math.min(t, 1 - t) + 0.25)}`)
        return true
      })
    }

    // ---- scroll: the graph stands up, then the steps play ----
    let speedBoost = 0
    // How far the intro has played: the sun rises with the graph.
    let rise = 0
    let lastY = scrollY
    const narrow = (): boolean => matchMedia('(max-width: 720px)').matches
    // Where the graph sits at both ends of the intro, measured once per
    // size: lying under the copy, then standing above the step panel. A
    // perspective shift shrinks with the plane's depth, so each converges.
    let fit: { drop: number; s0: number; s1: number; lift: number } | null = null
    addEventListener('resize', () => (fit = null))
    const place = (ty: number, rx: number, sc: number): DOMRect => {
      tilt.style.transform = `translate(-50%, -50%) translateY(${ty}px) rotateX(${rx}deg) scale(${sc})`
      return tilt.getBoundingClientRect()
    }
    const converge = (want: number, rx: number, sc: number, floor: number): number => {
      const world = tilt.parentElement!.getBoundingClientRect().top
      let ty = 0
      for (let i = 0; i < 5; i++) {
        const top = place(ty, rx, sc).top - world
        if (Math.abs(want - top) < 2) break
        ty = Math.max(floor, ty + (want - top) * 1.4)
      }
      return ty
    }
    const measure = (): NonNullable<typeof fit> => {
      const s0 = narrow() ? 1.12 : 1.02
      const drop = converge(copy.offsetTop + copy.offsetHeight + 28, RX0, s0, 0)
      // The tallest step panel sets the room the standing graph gets.
      const items = [...story.querySelectorAll<HTMLElement>('.story-steps li')]
      const was = items.map((li) => li.classList.contains('on'))
      let panelTop = Infinity
      for (const li of items) {
        items.forEach((x) => x.classList.toggle('on', x === li))
        panelTop = Math.min(panelTop, story.offsetTop)
      }
      items.forEach((x, i) => x.classList.toggle('on', was[i]))
      const room = panelTop - 20 - 12
      const s1 = Math.min(s0 - 0.1, (s0 - 0.1) * (room / place(0, RX1, s0 - 0.1).height))
      const lift = converge(12, RX1, s1, -Infinity)
      return { drop, s0, s1, lift }
    }
    const layout = (): void => {
      const total = stage.offsetHeight - innerHeight
      const p = clamp(-stage.getBoundingClientRect().top / Math.max(1, total))
      const a = ease(clamp(p / INTRO))
      rise = a
      fit ??= measure()
      const rx = RX0 + (RX1 - RX0) * a
      const sc = fit.s0 + (fit.s1 - fit.s0) * a
      const ty = fit.drop * (1 - a) + fit.lift * a
      tilt.style.transform = `translate(-50%, -50%) translateY(${ty}px) rotateX(${rx}deg) scale(${sc})`
      copy.style.opacity = `${clamp(1 - a * 1.6)}`
      copy.style.transform = `translateY(${-60 * a}px)`
      copy.style.pointerEvents = a > 0.6 ? 'none' : ''
      hint.style.opacity = `${clamp(1 - a * 4)}`
      story.style.opacity = `${clamp((a - 0.75) * 4)}`
      light(p < INTRO ? -1 : Math.min(steps.length - 1, Math.floor(((p - INTRO) / (1 - INTRO)) * steps.length)))
      const dy = scrollY - lastY
      lastY = scrollY
      speedBoost = Math.min(40, speedBoost + Math.abs(dy) * 0.05)
    }
    const goto = (i: number, smooth = true): void => {
      const total = stage.offsetHeight - innerHeight
      const p = INTRO + ((i + 0.5) / steps.length) * (1 - INTRO)
      scrollTo({ top: stage.offsetTop + p * total, behavior: smooth ? 'smooth' : 'instant' })
    }
    stage.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((b) =>
      b.addEventListener('click', () => goto(Number(b.dataset['goto']))),
    )
    // An old link to a step's anchor lands on that step.
    const landed = steps.findIndex((s) => s.anchor !== '' && `#${s.anchor}` === location.hash)
    if (landed >= 0) requestAnimationFrame(() => goto(landed, false))

    // ---- the sky: a retro sunset, a striped sun sinking into the grid ----
    let W = 0
    let H = 0
    let stars: [number, number, number][] = []
    const size = (): void => {
      const dpr = Math.min(2, devicePixelRatio || 1)
      W = canvas.clientWidth
      H = canvas.clientHeight
      canvas.width = Math.round(W * dpr)
      canvas.height = Math.round(H * dpr)
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
      stars = Array.from({ length: W < 720 ? 40 : 90 }, () => [Math.random(), Math.random() ** 1.6, Math.random()])
    }
    let travel = 0
    let clock = 0
    const draw = (dt: number): void => {
      const hy = H * 0.58
      const cx = W / 2
      clock += dt
      // sky: night above, sunset warming toward the horizon
      const sky = ctx.createLinearGradient(0, 0, 0, hy)
      sky.addColorStop(0, '#06051a')
      sky.addColorStop(0.5, '#120a2e')
      sky.addColorStop(0.85, '#3a1146')
      sky.addColorStop(1, '#7a2253')
      ctx.fillStyle = sky
      ctx.fillRect(0, 0, W, hy)
      for (const [x, y, t] of stars) {
        ctx.fillStyle = `rgba(255,236,250,${0.25 + 0.35 * Math.sin(clock * 0.8 + t * 9) ** 2})`
        ctx.fillRect(x * W, y * hy * 0.8, 1.4, 1.4)
      }
      // the sun: a disc of warm bands, its lower half cut by widening stripes
      const r = Math.min(W * 0.2, H * 0.3)
      const glow = ctx.createRadialGradient(cx, hy, r * 0.6, cx, hy, r * 2.6)
      glow.addColorStop(0, 'rgba(255,79,139,0.35)')
      glow.addColorStop(1, 'rgba(255,79,139,0)')
      ctx.fillStyle = glow
      ctx.fillRect(0, hy - r * 2.6, W, r * 2.6)
      // set low behind the copy, it rises as the graph stands up
      const cy = hy - r * 0.32 + (1 - rise) * r * 1.05
      ctx.save()
      ctx.beginPath()
      ctx.rect(0, 0, W, hy)
      ctx.clip()
      ctx.beginPath()
      ctx.arc(cx, cy, r, 0, Math.PI * 2)
      ctx.clip()
      const sun = ctx.createLinearGradient(0, cy - r, 0, cy + r * 0.32)
      sun.addColorStop(0, '#ffd36e')
      sun.addColorStop(0.45, '#ff8a3d')
      sun.addColorStop(1, '#ff4f8b')
      ctx.fillStyle = sun
      ctx.fillRect(cx - r, cy - r, r * 2, r * 2)
      ctx.globalCompositeOperation = 'destination-out'
      const drift = (clock * 0.12) % 1
      for (let i = 0; i < 8; i++) {
        const k = (i + drift) / 8
        const y = cy - r * 0.05 + k * r * 0.4 + k * k * r * 0.25
        ctx.fillRect(cx - r, y, r * 2, 1 + k * r * 0.07)
      }
      ctx.restore()
      // the floor: dark, with a magenta grid running toward you
      ctx.fillStyle = '#0b0616'
      ctx.fillRect(0, hy, W, H - hy)
      const haze = ctx.createLinearGradient(0, hy, 0, hy + H * 0.12)
      haze.addColorStop(0, 'rgba(255,79,139,0.35)')
      haze.addColorStop(1, 'rgba(255,79,139,0)')
      ctx.fillStyle = haze
      ctx.fillRect(0, hy, W, H * 0.12)
      ctx.fillStyle = 'rgba(255,170,120,0.9)'
      ctx.fillRect(0, hy - 0.5, W, 1.2)

      const speed = 0.9 + speedBoost * 0.12
      speedBoost *= Math.pow(0.05, dt)
      travel = (travel + speed * dt) % 1
      const f = H * 0.9
      const proj = (x: number, z: number): [number, number] => [cx + (x * f) / z, hy + f / z]
      const ZF = 36
      ctx.lineWidth = 1
      for (let i = -30; i <= 30; i++) {
        const [x1, y1] = proj(i * 1.1, 0.6)
        const [x2, y2] = proj(i * 1.1, ZF)
        const lg = ctx.createLinearGradient(x1, y1, x2, y2)
        lg.addColorStop(0, 'rgba(255,79,139,0.5)')
        lg.addColorStop(1, 'rgba(255,79,139,0.05)')
        ctx.strokeStyle = lg
        ctx.beginPath()
        ctx.moveTo(x1, y1)
        ctx.lineTo(x2, y2)
        ctx.stroke()
      }
      for (let k = 1; k <= ZF; k++) {
        const z = (k - travel) * 0.9
        if (z < 0.6) continue
        const y = hy + f / z
        if (y > H) continue
        ctx.strokeStyle = `rgba(255,79,139,${0.55 * (1 - z / (ZF * 0.9)) ** 1.5})`
        ctx.beginPath()
        ctx.moveTo(0, y)
        ctx.lineTo(W, y)
        ctx.stroke()
      }
    }

    // ---- one loop, only while the stage is on screen ----
    let running = false
    let last = 0
    const frame = (now: number): void => {
      if (!running) return
      const dt = Math.min(0.05, (now - (last || now)) / 1000)
      last = now
      draw(dt)
      spawn(now)
      movePackets(now)
      requestAnimationFrame(frame)
    }
    const start = (): void => {
      if (running || document.hidden) return
      running = true
      last = 0
      requestAnimationFrame(frame)
    }
    const stop = (): void => {
      running = false
    }
    new IntersectionObserver(([e]) => (e!.isIntersecting ? start() : stop())).observe(stage)
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()))
    addEventListener('scroll', () => requestAnimationFrame(layout), { passive: true })
    addEventListener('resize', () => {
      size()
      layout()
    })
    size()
    layout()
  }
</script>
