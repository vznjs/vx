---
// The system graph as two SVG layouts (wide, phone) from system-map.ts:
// every box with a lit edge under it for depth, every wire, the core's seven
// hook groups, the workers' slots (always drawn, grey while no worker
// holds one), and the layers the hero's script fills with bars and dots.
import run from '../../data/hero-run.json'
import { BOXES, GROUPS, LAYOUTS, SLOTS, WIRES, chips, rect, wirePath, type LayoutName } from './system-map.ts'

const layouts: LayoutName[] = ['wide', 'narrow']
const slots = Array.from({ length: SLOTS }, (_, i) => i + 1)
const cores = Math.max(...run.workers.map((w) => w.cores))
const hits = run.tasks.filter((t) => 'hit' in t && t.hit).length
const summary = `${run.tasks.length} tasks · ${hits} from cache · ${run.workers.length} workers`
---

{
  layouts.map((name) => {
    const L = LAYOUTS[name]
    const split = name === 'narrow'
    const c = rect(name, 'core')
    const wk = rect(name, 'workers')
    return (
      <svg
        class="map-svg"
        data-layout={name}
        viewBox={`${-L.pad} -6 ${L.width + L.pad * 2} ${L.height + 20}`}
        aria-hidden="true"
      >
        <g class="node tone-dte workers" data-box="workers">
          <rect class="edge" x={wk.x} y={wk.y + 7} width={wk.w} height={wk.h} rx="12" />
          <rect class="face" x={wk.x} y={wk.y} width={wk.w} height={wk.h} rx="12" />
          <text class="node-label" x={wk.x + 16} y={wk.y + 25}>Workers</text>
          <text class="node-sub" x={wk.x + (split ? 16 : 100)} y={wk.y + (split ? 42 : 25)}>
            {BOXES.find((b) => b.id === 'workers')!.sub}
          </text>
        </g>
        <g class="wires">
          {WIRES.map((w) => (
            <path class:list={['wire', { dashed: w.dashed }]} data-wire={w.id} d={wirePath(name, w)} />
          ))}
        </g>
        {BOXES.filter((b) => b.id !== 'core' && b.id !== 'workers').map((b) => {
          const r = rect(name, b.id)
          const small = r.w < 130
          // A phone's narrow box keeps the package alone under its short label.
          const lines = small ? [b.sub.split(' · ')[0]!] : split ? b.sub.split(' · ') : [b.sub]
          const tx = r.x + (small ? r.w / 2 : 16)
          const anchor = small ? 'middle' : 'start'
          const label = small ? (b.short ?? b.label) : b.label
          return (
            <g class:list={['node', `tone-${b.tone}`]} data-box={b.id}>
              <rect class="edge" x={r.x} y={r.y + 7} width={r.w} height={r.h} rx="10" />
              <rect class="face" x={r.x} y={r.y} width={r.w} height={r.h} rx="10" />
              <text class="node-label" x={tx} y={r.y + (split ? 21 : 25)} text-anchor={anchor}>
                {label}
              </text>
              {lines.map((l, i) => (
                <text class="node-sub" x={tx} y={r.y + (split ? 38 + i * 14 : 44)} text-anchor={anchor}>
                  {l}
                </text>
              ))}
            </g>
          )
        })}
        {slots.map((k) => {
          const r = rect(name, `slot${k}`)
          const barX = r.x + 12
          const barW = r.w - 24
          const barY = r.y + 36
          const barH = r.h - 48
          return (
            <g class="slot" data-slot={k} data-x={barX} data-y={barY} data-w={barW} data-h={barH} data-cores={cores}>
              <rect class="slot-face" x={r.x} y={r.y} width={r.w} height={r.h} rx="8" />
              <rect class="slot-warm" x={r.x} y={r.y} width="0" height={r.h} rx="8" />
              <text class="slot-name" x={r.x + 12} y={r.y + 22}>worker {k}</text>
              <text class="slot-state" x={r.x + r.w - 12} y={r.y + 22} text-anchor="end">
                {cores} cores
              </text>
              {Array.from({ length: cores }, (_, i) => (
                <rect class="slot-core" x={barX + (i * barW) / cores + 1} y={barY} width={barW / cores - 2} height={barH} rx="4" />
              ))}
              <g class="bars" />
            </g>
          )
        })}
        <g class="node tone-core core" data-box="core">
          <rect class="edge" x={c.x} y={c.y + 10} width={c.w} height={c.h} rx="16" />
          <rect class="face" x={c.x} y={c.y} width={c.w} height={c.h} rx="16" />
          <text class="core-label" x={c.x + 22} y={c.y + (split ? 50 : 58)}>
            vx
          </text>
          <text class="core-sub" x={c.x + (split ? 82 : 96)} y={c.y + (split ? 30 : 38)}>
            one run, every stage
          </text>
          <text class="core-clock" x={c.x + (split ? 82 : 96)} y={c.y + (split ? 48 : 58)}>
            {summary}
          </text>
          {chips(name).map((s) => {
            const g = GROUPS.find((x) => x.id === s.id)!
            return (
              <g class="chip" data-stage={s.id}>
                <rect x={s.x} y={s.y} width={s.w} height={s.h} rx="6" />
                <text class="chip-title" x={s.x + 8} y={s.y + 18}>
                  {g.title}
                </text>
                {g.hooks.map((h, i) => (
                  <text class="chip-hook" x={s.x + 8} y={s.y + 36 + i * 14}>
                    {h}
                  </text>
                ))}
              </g>
            )
          })}
        </g>
        <g class="packets" />
      </svg>
    )
  })
}
