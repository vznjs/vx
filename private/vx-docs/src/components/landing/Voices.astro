---
// What others say about us: every quote, word for word, floating up,
// popping in and out. At rest (no script, reduced motion) a few sit still.
import { ALL_VOICES } from './voices.ts'
---

<section class="band" id="voices">
  <div class="band-in">
    <header class="band-head">
      <p class="kicker">Word for word</p>
      <h2>What others<br /><em>say about us.</em></h2>
    </header>
    <div class="sky" data-voices={JSON.stringify(ALL_VOICES)}>
      <ul class="sky-rest">
        {
          ALL_VOICES.slice(0, 4).map((v) => (
            <li>
              <figure class="bubble-in">
                <blockquote>
                  <a href={v.href} rel="noopener" target="_blank">“{v.quote}”</a>
                </blockquote>
                <figcaption>
                  <strong>{v.who}</strong> · {v.role}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
