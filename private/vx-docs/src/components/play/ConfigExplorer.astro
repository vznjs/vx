---
// The config explorer: a sample config with every field the validator
// accepts, each key a button that opens what the config reference says
// about it. Without JavaScript it shows the whole file and the first
// field's panel. `config-explorer.ts` unhides the search and the fold
// buttons and fills `.cx-panel` from the `.cx-data` JSON.
//
// Both sources are read here, at build time, so the widget follows them:
// the fields from core's validator contract, the words from schema.md.
// A field the reference has no entry for shows its type and a link only.
import '../demos/widget.css'
import { readFileSync } from 'node:fs'
import path from 'node:path'
import {
  anchorsFromForward,
  buildFields,
  configOfArea,
  defaultField,
  renderFile,
  renderPanel,
  rows,
  type Area,
  type SchemaRecord,
} from './model/config-explorer.js'

interface Props {
  /** Which file: a project's `vx.config.ts` (from the top, or opened at the task), or `.vx/workspace.ts`. */
  area?: Area
  /** The field opened first: `outputs.files`, `exec.timeout`, `run.failFast`. */
  field?: string
}

const { area = 'task', field } = Astro.props
const config = configOfArea(area)
// The build's cwd is the site; the sources sit in core's package, as the
// site installed it.
const core = path.resolve(process.cwd(), 'node_modules/@vzn/vx')
const doc = readFileSync(path.join(core, 'docs/schema.md'), 'utf8')
const record = (
  JSON.parse(readFileSync(path.join(core, 'tests/contract/config-schema.json'), 'utf8')) as Record<
    string,
    SchemaRecord
  >
)[config]!
// Where each heading landed when the reference was split into pages.
const anchors = anchorsFromForward(readFileSync('src/content/docs/schema.md', 'utf8'))
const fields = buildFields(config, record, doc, anchors, import.meta.env.BASE_URL)
const data = rows(fields)
const start = defaultField(fields, area, field)
const file = config === 'project' ? 'vx.config.ts' : '.vx/workspace.ts'
const uid = Math.random().toString(36).slice(2, 8)
const fileHtml = renderFile(fields, config, start)
---

<figure class="vx-demo not-content">
  <vx-config-explorer data-start={start} data-area={area}>
    <div class="cx-find vx-row" hidden>
      <label class="vx-label" for={`cx-q-${uid}`}>Find a field</label>
      <input id={`cx-q-${uid}`} class="cx-q" type="search" placeholder="timeout, VX_CACHE_DIR, --force" autocomplete="off" spellcheck="false" />
    </div>
    <div class="cx-hits vx-row" hidden></div>
    <div class="cx-grid">
      <div class="cx-file">
        <p class="cx-name-tab">{file}</p>
        <div class="cx-src" role="region" aria-label={`${file}, every field`} tabindex="0" set:html={fileHtml} />
      </div>
      <div class="cx-panel" set:html={renderPanel(data.find((r) => r.path === start)!)} />
    </div>
    <p class="cx-say vx-say" aria-live="polite"></p>
    <script type="application/json" class="cx-data" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
  </vx-config-explorer>
  <figcaption>Tap a key to see what it does. A <code>//</code> line is a field this file leaves at its default.</figcaption>
</figure>

<script>
  import './config-explorer.ts'
</script>

<style>
  vx-config-explorer {
    display: block;
    container-type: inline-size;
  }
  .cx-grid {
    display: grid;
    gap: 1rem;
    align-items: start;
  }
  /* Side by side only where both halves fit without wrapping every line. */
  @container (min-width: 46rem) {
    .cx-grid {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }
    .cx-panel {
      position: sticky;
      top: 5rem;
    }
  }
  .cx-file {
    min-width: 0;
    border: 1.5px solid var(--vx-border);
    border-radius: 8px;
    background: var(--vx-surface-2);
    overflow: hidden;
  }
  .cx-name-tab {
    margin: 0;
    padding: 0.35rem 0.75rem;
    border-bottom: 1px solid var(--vx-border);
    font-family: var(--vx-mono);
    font-size: 12px;
    color: var(--vx-muted);
  }
  .cx-src {
    position: relative;
    max-height: 24rem;
    overflow-y: auto;
    padding-block: 0.4rem;
    font-family: var(--vx-mono);
    font-size: 13px;
  }
  @media (max-width: 40rem) {
    .cx-src {
      max-height: 55vh;
    }
  }
  .cx-src :global(.cx-line) {
    min-height: 32px;
    padding-block: 6px;
    line-height: 20px;
    padding-inline-end: 0.5rem;
    box-sizing: border-box;
    /* A long line wraps inside the box, its tail indented under its key. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    text-indent: -2ch;
  }
  .cx-src :global(.cx-line.is-on) {
    background: color-mix(in srgb, var(--vx-accent) 14%, transparent);
  }
  .cx-src :global(.is-off),
  .cx-src :global(.is-off .cx-v) {
    color: var(--vx-muted);
  }
  .cx-src :global(.cx-v) {
    color: var(--vx-link);
  }
  .cx-src :global(.cx-k),
  .cx-src :global(.cx-c) {
    color: var(--vx-muted);
  }
  .vx-demo .cx-src :global(button) {
    font: inherit;
    line-height: 1.4;
    text-indent: 0;
  }
  .vx-demo .cx-src :global(.cx-key) {
    min-height: 20px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: none;
    color: inherit;
    text-decoration: underline dotted;
    text-underline-offset: 3px;
  }
  .vx-demo .cx-src :global(.is-off .cx-key) {
    color: var(--vx-muted);
  }
  .vx-demo .cx-src :global(.cx-key:hover) {
    color: var(--vx-accent);
  }
  .vx-demo .cx-src :global(.cx-key[aria-pressed='true']) {
    color: var(--vx-accent);
    font-weight: 700;
    box-shadow: none;
    background: none;
    text-decoration: none;
  }
  .vx-demo .cx-src :global(.cx-fold) {
    width: 32px;
    min-height: 32px;
    margin-block: -6px;
    margin-inline-start: -34px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--vx-muted);
  }
  .vx-demo .cx-src :global(.cx-fold[aria-expanded='true'])::before {
    content: '▾';
  }
  .vx-demo .cx-src :global(.cx-fold[aria-expanded='false'])::before {
    content: '▸';
  }
  .cx-src :global(.cx-group[hidden]),
  .cx-src :global([hidden]) {
    display: none;
  }
  .cx-panel {
    min-width: 0;
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--vx-accent);
    border-radius: 8px;
    background: var(--vx-surface);
    line-height: 1.5;
  }
  .cx-panel :global(.cx-name) {
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }
  .cx-panel :global(.cx-name code) {
    color: var(--vx-accent);
    font-weight: 700;
    overflow-wrap: anywhere;
  }
  .cx-panel :global(.cx-facts) {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.25rem 0.75rem;
    margin: 0.5rem 0;
    font-size: 0.9rem;
  }
  .cx-panel :global(dt) {
    color: var(--vx-muted);
  }
  .cx-panel :global(dd) {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .vx-demo .cx-panel :global(.cx-ex) {
    margin: 0.5rem 0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .cx-panel :global(.cx-inside) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }
  .vx-demo .cx-panel :global(.cx-kid) {
    min-height: 32px;
  }
  .cx-panel :global(.cx-ref) {
    margin: 0.5rem 0 0;
  }
  .cx-hits {
    justify-content: flex-start;
  }
  .vx-demo .cx-hits :global(button) {
    min-height: 32px;
  }
  .vx-demo .cx-q {
    min-height: 32px;
    min-width: 0;
    flex: 1 1 12rem;
    max-width: 20rem;
  }
  .cx-say:empty {
    display: none;
  }
</style>
