---
// The client-side Mermaid renderer, on every docs page (Head.astro). The
// site's own pictures draw at build time (components/guide/diagram); Mermaid
// is for the imported internals pages.
---

<script>
  // Self-hosted, lazy mermaid rendering. mermaid is only fetched on pages
  // that actually contain a <pre class="mermaid"> block (dynamic import =
  // its own chunk), and re-renders when Starlight toggles the theme.
  const sources = new WeakMap<Element, string>()

  // Setting any xyChart variable drops the theme's text colours, so all
  // are given, from the site's tokens.
  function chartColors(): Record<string, string> {
    const css = getComputedStyle(document.documentElement)
    const token = (name: string): string => css.getPropertyValue(name).trim()
    const text = token('--vx-text')
    const muted = token('--vx-muted')
    return {
      backgroundColor: 'transparent',
      plotColorPalette: token('--vx-accent'),
      titleColor: text,
      xAxisLabelColor: text,
      yAxisLabelColor: muted,
      xAxisTitleColor: muted,
      yAxisTitleColor: muted,
      xAxisLineColor: muted,
      yAxisLineColor: muted,
      xAxisTickColor: muted,
      yAxisTickColor: muted,
    }
  }

  // Pie slices: the accent first, then quieter tones, readable in both
  // themes (the dark theme's defaults are near-black on the page).
  function pieColors(): Record<string, string> {
    const css = getComputedStyle(document.documentElement)
    const token = (name: string): string => css.getPropertyValue(name).trim()
    const text = token('--vx-text')
    return {
      pie1: token('--vx-accent'),
      pie2: token('--vx-muted'),
      pie3: token('--vx-border'),
      pie4: token('--vx-warn'),
      pieStrokeColor: token('--vx-bg'),
      pieOuterStrokeColor: token('--vx-border'),
      pieSectionTextColor: token('--vx-bg'),
      pieTitleTextColor: text,
      pieLegendTextColor: text,
    }
  }

  async function renderMermaid(blocks: HTMLElement[]) {
    if (blocks.length === 0) return

    const { default: mermaid } = await import('mermaid')
    const dark = document.documentElement.dataset.theme === 'dark'

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'loose',
      theme: dark ? 'dark' : 'neutral',
      // Mermaid 12 defaults to ELK, a 1.4 MB layout engine every flowchart
      // then downloads and parses; dagre draws these diagrams at a fraction.
      layout: 'dagre',
      fontFamily: 'inherit',
      // Charts in the site's accent on the page's own background, not
      // Mermaid's blue on a grey card.
      // An edge label on the dark theme's own grey read 4.4:1, under WCAG AA.
      themeVariables: { xyChart: chartColors(), ...pieColors(), ...(dark ? { edgeLabelBackground: '#2c333b' } : {}) },
    })

    for (const el of blocks) {
      if (!sources.has(el)) sources.set(el, el.textContent ?? '')
      el.removeAttribute('data-processed')
      // Restore the raw definition as TEXT, not innerHTML — the source can
      // contain `<br/>` in labels, and innerHTML would parse those into real
      // <br> elements, corrupting the definition mermaid reads (→ "Syntax
      // error"). textContent keeps `<br/>` literal so mermaid renders it.
      el.textContent = sources.get(el) ?? ''
    }

    await mermaid.run({ nodes: blocks })
  }

  // One render at a time. The first render and the theme observer both
  // fire on load (Starlight sets `data-theme` as it starts), and two
  // `mermaid.run` calls over the same blocks tear each other's DOM down:
  // every page with a diagram threw "Cannot read properties of null
  // (reading 'firstChild')" as an uncaught non-Error (item 697). A failed
  // render is reported with mermaid's own message, not thrown into the page.
  let rendering: Promise<void> = Promise.resolve()
  function scheduleRender(blocks: HTMLElement[]): void {
    rendering = rendering
      .then(() => renderMermaid(blocks))
      .catch((err: unknown) => {
        const message = (err as { message?: unknown } | null)?.message
        console.error(`[vx] a diagram did not render: ${String(message ?? err)}`)
      })
  }

  // A diagram draws once it nears the viewport: Mermaid and its diagram
  // chunks load only then, and a page of many diagrams (flows/ has ten)
  // lays out one screenful at a time instead of all of them on load.
  let drawn = new Set<HTMLElement>()
  let io: IntersectionObserver | undefined
  function watch(): void {
    io?.disconnect()
    drawn = new Set()
    const view = new IntersectionObserver(
      (entries) => {
        const near = entries.filter((e) => e.isIntersecting).map((e) => e.target as HTMLElement)
        for (const el of near) {
          view.unobserve(el)
          drawn.add(el)
        }
        scheduleRender(near)
      },
      { rootMargin: '600px 0px' },
    )
    io = view
    for (const el of document.querySelectorAll<HTMLElement>('pre.mermaid')) view.observe(el)
  }

  watch()
  // Re-render after Starlight's view-transition navigations.
  document.addEventListener('astro:after-swap', watch)

  // Re-render on light/dark toggle so diagram colors track the theme.
  const observer = new MutationObserver((records) => {
    if (records.some((r) => r.attributeName === 'data-theme')) scheduleRender([...drawn])
  })
  observer.observe(document.documentElement, { attributes: true })
</script>
