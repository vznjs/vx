---
// A feature's 1600×900 image as resized WebP at the widths the layout asks
// for (scripts/build-images.ts), never the source PNG.
import { srcset } from '../../images.js'

interface Props {
  file: string
  alt: string
  widths: number[]
  sizes: string
  class?: string
  eager?: boolean
}
const { file, alt, widths, sizes, class: cls, eager = false } = Astro.props
---

<img
  {...srcset(`features/${file.replace(/\.png$/, '')}`, widths)}
  alt={alt}
  sizes={sizes}
  decoding="async"
  class={cls}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
/>
