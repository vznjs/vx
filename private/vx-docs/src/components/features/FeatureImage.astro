---
// A feature's 1600×900 image through astro:assets: resized WebP at the
// widths the layout asks for, never the source PNG.
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
  file: string
  alt: string
  widths: number[]
  sizes: string
  class?: string
  eager?: boolean
}
const { file, alt, widths, sizes, class: cls, eager = false } = Astro.props
const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/features/*.png', {
  eager: true,
})
const src = images[`../../assets/features/${file}`]?.default
if (src === undefined) throw new Error(`no image src/assets/features/${file}`)
---

<Image
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  format="webp"
  quality={80}
  class={cls}
  loading={eager ? 'eager' : 'lazy'}
  fetchpriority={eager ? 'high' : 'auto'}
/>
