{
  "tasks": {
    "install": {
      "dependsOn": [
        "^build"
      ]
    },
    "ci": {
      "dependsOn": [
        "lint.oxlint",
        "lint.oxfmt",
        "test",
        "test.live"
      ]
    },
    "lint.oxlint": {
      "description": "oxlint with tsgolint-backed type-aware checks",
      "exec": {
        "command": "oxlint --type-aware --type-check",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "*.ts",
          "tests/**",
          "package.json",
          ".oxlintrc.json",
          "tsconfig.json"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    },
    "lint.oxfmt": {
      "description": "oxfmt --check (no rewrite; CI-safe)",
      "exec": {
        "command": "oxfmt --check .",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "**/*",
          "package.json"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    },
    "test": {
      "description": "bun test",
      "exec": {
        "command": "bun test --only-failures --timeout=30000",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0"
          }
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "*.ts",
          "tests/**",
          "compose.yaml",
          "package.json"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    },
    "test.live": {
      "description": "docker compose up, each server answering, then a clean stop",
      "exec": {
        "command": "sh tests/smoke.sh"
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "compose.yaml",
          "tests/smoke.sh",
          "package.json"
        ],
        "workspaceFiles": [
          "packages/vx-dte-server/Dockerfile",
          "packages/vx-dte-server/src/**",
          "packages/vx-cache-server/Dockerfile",
          "packages/vx-cache-server/src/**",
          "packages/vx-history-server/Dockerfile",
          "packages/vx-history-server/src/**",
          "packages/vx-devtools/package.json",
          "packages/vx-devtools/src/**"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": {
        "files": [
          "**"
        ]
      }
    }
  }
}
