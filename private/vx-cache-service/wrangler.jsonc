// vznjs's cache server, https://vx-cache.exelord.workers.dev, which
// .vx/workspace.ts names. Workers Builds deploys it from main.
{
  "name": "vx-cache",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Plain vars, never secrets (owner, 2026-10-23). CI jobs sign in with
  // their OIDC token. ALLOW: only ci.yml's jobs get in; a run of main
  // writes main's scope, which every run reads after its own, and a
  // branch's run its own. vx-worker.yml is left out: it may be dispatched
  // on main to run a fork PR's code, and writes with its run's lent token.
  "vars": {
    "ALLOW": "https://token.actions.githubusercontent.com:vznjs/vx:ci.yml",
  },
  // Expiry: one bucket lifecycle rule, every object after 1 day
  // (README): names are hashed, so no prefix tells main from a branch.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "vx-cache" }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "issues": { "enabled": true },
  },
  // A PR that changes the server runs on Workers Builds' Preview of its
  // commit (README), which inherits no production setting: the same
  // ALLOW and bucket, so a PR reads main's artifacts as the deployed one.
  "previews": {
    "vars": {
      "ALLOW": "https://token.actions.githubusercontent.com:vznjs/vx:ci.yml",
    },
    "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "vx-cache" }],
    "observability": {
      "enabled": true,
      "head_sampling_rate": 1,
      "issues": { "enabled": true },
    },
  },
}
