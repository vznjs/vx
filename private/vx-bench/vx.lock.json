{
  "tasks": {
    "install": {
      "dependsOn": [
        "^build"
      ]
    },
    "ci": {
      "dependsOn": [
        "lint",
        "test"
      ]
    },
    "check.perf": {
      "description": "perf-guard.ts then pr-bench.ts: hot-path counts and vx vs Turborepo ratios against their baselines",
      "dependsOn": [
        "install"
      ],
      "exec": {
        "command": "bun perf-guard.ts && bun pr-bench.ts",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0"
          },
          "passThrough": [
            "VX_BENCH_BASE"
          ]
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*",
              "../../.git"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "inputs": {
        "files": [
          "perf-guard.ts",
          "perf-baseline.json",
          "pr-bench.ts",
          "pr-bench-base.ts",
          "pr-bench-baseline.json",
          "quiet.ts",
          "bench-env.ts",
          "edges.ts",
          "workspace-copy.ts",
          "package.json"
        ],
        "env": [
          "VX_BENCH_BASE"
        ]
      },
      "cache": {
        "outputs": {
          "files": []
        }
      }
    },
    "vs-turbo.update": {
      "description": "pr-bench.ts --update: record this platform in pr-bench-baseline.json",
      "dependsOn": [
        "install"
      ],
      "exec": {
        "command": "bun pr-bench.ts --update",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0"
          }
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "write": [
              "pr-bench-baseline.json"
            ]
          }
        }
      }
    },
    "perf.update": {
      "description": "perf-guard.ts --update: rewrite perf-baseline.json for this platform",
      "dependsOn": [
        "install"
      ],
      "exec": {
        "command": "bun perf-guard.ts --update",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0"
          }
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "write": [
              "perf-baseline.json"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      }
    },
    "bench.vx": {
      "description": "compare.ts: vx on the 9,603-task head-to-head → site/vx.json",
      "dependsOn": [
        "install"
      ],
      "exec": {
        "command": "bun compare.ts 3",
        "timeout": "30m",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0",
            "RUNNERS": "vx",
            "OUT": "site/vx.json"
          },
          "passThrough": [
            "GITHUB_SHA"
          ]
        }
      },
      "inputs": {
        "files": [
          "compare.ts",
          "shape.ts",
          "prng.ts",
          "ideal.ts",
          "ab.ts",
          "outputs.ts",
          "bench-env.ts",
          "package.json",
          "edges.ts"
        ]
      },
      "cache": {
        "outputs": {
          "files": [
            "site/vx.json"
          ]
        }
      }
    },
    "bench.turbo": {
      "description": "compare.ts: turbo on the 9,603-task head-to-head → site/turbo.json",
      "exec": {
        "command": "bun compare.ts 3",
        "timeout": "30m",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0",
            "RUNNERS": "turbo",
            "OUT": "site/turbo.json"
          },
          "passThrough": [
            "GITHUB_SHA"
          ]
        }
      },
      "inputs": {
        "files": [
          "compare.ts",
          "shape.ts",
          "prng.ts",
          "ideal.ts",
          "ab.ts",
          "outputs.ts",
          "bench-env.ts",
          "package.json"
        ]
      },
      "cache": {
        "outputs": {
          "files": [
            "site/turbo.json"
          ]
        }
      }
    },
    "bench.nx": {
      "description": "compare.ts: nx on the 9,603-task head-to-head → site/nx.json",
      "exec": {
        "command": "bun compare.ts 3",
        "timeout": "30m",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0",
            "RUNNERS": "nx",
            "OUT": "site/nx.json"
          },
          "passThrough": [
            "GITHUB_SHA"
          ]
        }
      },
      "inputs": {
        "files": [
          "compare.ts",
          "shape.ts",
          "prng.ts",
          "ideal.ts",
          "ab.ts",
          "outputs.ts",
          "bench-env.ts",
          "package.json"
        ]
      },
      "cache": {
        "outputs": {
          "files": [
            "site/nx.json"
          ]
        }
      }
    },
    "bench.vite-task": {
      "description": "compare.ts: vite-task on the 9,603-task head-to-head → site/vite-task.json",
      "exec": {
        "command": "bun compare.ts 3",
        "timeout": "30m",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0",
            "RUNNERS": "vite-task",
            "OUT": "site/vite-task.json"
          },
          "passThrough": [
            "GITHUB_SHA"
          ]
        }
      },
      "inputs": {
        "files": [
          "compare.ts",
          "shape.ts",
          "prng.ts",
          "ideal.ts",
          "ab.ts",
          "outputs.ts",
          "bench-env.ts",
          "package.json"
        ]
      },
      "cache": {
        "outputs": {
          "files": [
            "site/vite-task.json"
          ]
        }
      }
    },
    "site.numbers": {
      "description": "every runner of the head-to-head, the rows the site reads",
      "dependsOn": [
        "bench.*"
      ]
    },
    "lint": {
      "dependsOn": [
        "lint.oxlint",
        "lint.oxfmt"
      ]
    },
    "lint.oxlint": {
      "description": "oxlint with tsgolint-backed type-aware checks",
      "exec": {
        "command": "oxlint --type-aware --type-check",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "*.ts",
          "tests/**",
          "package.json",
          ".oxlintrc.json",
          "tsconfig.json"
        ]
      },
      "cache": {
        "outputs": {
          "files": []
        }
      }
    },
    "lint.oxfmt": {
      "description": "oxfmt --check (no rewrite; CI-safe)",
      "exec": {
        "command": "oxfmt --check .",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "**/*",
          "package.json"
        ]
      },
      "cache": {
        "outputs": {
          "files": []
        }
      }
    },
    "test": {
      "description": "bun test",
      "exec": {
        "command": "bun test --only-failures",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0",
            "VX_CACHE_DIR": ".vx/cache"
          }
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space",
              "net.link.addr"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "*.ts",
          "tests/**",
          "package.json"
        ]
      },
      "cache": {
        "outputs": {
          "files": []
        }
      }
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": {
        "files": [
          "**"
        ]
      }
    }
  }
}
