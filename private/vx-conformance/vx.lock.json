{
  "tasks": {
    "install": {
      "dependsOn": [
        "^build"
      ]
    },
    "ci": {
      "dependsOn": [
        "lint",
        "test"
      ]
    },
    "conformance": {
      "description": "bun src/cli.ts: every case against vx, Turborepo, Nx, Vite Task, Nix and moon → vx-docs/src/data/conformance.json",
      "dependsOn": [
        "install"
      ],
      "exec": {
        "command": "bun src/cli.ts",
        "timeout": "30m",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0"
          }
        }
      },
      "inputs": {
        "files": [
          "src/**",
          "cases/**",
          "package.json"
        ]
      }
    },
    "lint": {
      "dependsOn": [
        "lint.oxlint",
        "lint.oxfmt"
      ]
    },
    "lint.oxlint": {
      "description": "oxlint with tsgolint-backed type-aware checks",
      "exec": {
        "command": "oxlint --type-aware --type-check",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "src/**",
          "cases/**",
          "package.json",
          "tests/**",
          "*.ts",
          ".oxlintrc.json",
          "tsconfig.json"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    },
    "lint.oxfmt": {
      "description": "oxfmt --check (no rewrite; CI-safe)",
      "exec": {
        "command": "oxfmt --check .",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "**/*",
          "package.json"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    },
    "test": {
      "description": "bun test",
      "exec": {
        "command": "bun test --only-failures --timeout=30000",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0"
          },
          "passThrough": [
            "VX_REQUIRE_SANDBOX"
          ]
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "src/**",
          "cases/**",
          "package.json",
          "tests/**"
        ],
        "workspaceFiles": [
          "packages/*/tests/*.test.ts"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": {
        "files": [
          "**"
        ]
      }
    }
  }
}
