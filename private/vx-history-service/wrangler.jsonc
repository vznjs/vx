// vznjs's history server, https://vx-history.exelord.workers.dev.
// Workers Builds deploys it from main.
{
  "name": "vx-history",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Plain vars, never secrets (owner, 2026-10-23). CI jobs sign in with
  // their OIDC token. TRUST: only ci.yml's own runs of main write main's
  // rows. vx-worker.yml is left out: it may be dispatched on main to run a
  // fork PR's code. Any other job of this repo writes its branch's rows.
  "vars": {
    "TRUST": "[{\"iss\":\"https://token.actions.githubusercontent.com\",\"repository\":\"vznjs/vx\",\"workflow_ref\":\"vznjs/vx/.github/workflows/ci.yml@*\",\"event_name\":[\"push\",\"merge_group\",\"workflow_dispatch\"],\"ref\":[\"refs/heads/main\",\"refs/heads/gh-readonly-queue/main/*\"],\"ref_protected\":\"true\"}]",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vx-history",
      "database_id": "4e7cbec4-b650-466e-8480-14fb931d26f8",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "issues": { "enabled": true },
  },
}
