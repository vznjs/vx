// vznjs's history server, https://vx-history.exelord.workers.dev.
// Workers Builds deploys it from main.
{
  "name": "vx-history",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Plain vars, never secrets (owner, 2026-10-23). CI jobs sign in with
  // their OIDC token. ALLOW: only ci.yml's jobs get in; a run of main
  // writes main's rows, a branch's run its own. vx-worker.yml is left out:
  // it may be dispatched on main to run a fork PR's code.
  "vars": {
    "ALLOW": "https://token.actions.githubusercontent.com:vznjs/vx:ci.yml",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vx-history",
      "database_id": "4e7cbec4-b650-466e-8480-14fb931d26f8",
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "issues": { "enabled": true },
  },
}
