// vznjs's relay, https://vx-dte.exelord.workers.dev, which ci.yml
// names. Workers Builds deploys it from main.
{
  "name": "vx-dte",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Who may take part: this repo's CI and its workers. A plain var, never a
  // secret, hardcoded here so each deploy sets it (owner, 2026-10-23).
  "vars": {
    "ALLOW": "https://token.actions.githubusercontent.com:vznjs/vx:ci.yml https://token.actions.githubusercontent.com:vznjs/vx:vx-worker.yml",
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayRun" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayRun"] }],
  // Every invocation's outcome, CPU and wall time in Workers Logs, and its
  // exceptions grouped in Issues: two relay stalls (2026-10-24, 00:47 and
  // 01:03 UTC) threw nothing and left no record to read. A run is about
  // 120 requests, far inside the free plan's daily events.
  // One event in 10: every message of a run is an invocation (a worker's
  // heartbeat every 2 s, #4473), 400k events a day at 1, twice Workers
  // Logs' daily allowance (M, 2026-10-25: "limit reached, reduce").
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "issues": { "enabled": true },
  },
  // A branch's Preview (private/vx-servers/worker-url.ts): Previews
  // inherit no production setting, so the same ALLOW and the binding the
  // code reads. Each gets its own Durable Object namespace.
  "previews": {
    "vars": {
      "ALLOW": "https://token.actions.githubusercontent.com:vznjs/vx:ci.yml https://token.actions.githubusercontent.com:vznjs/vx:vx-worker.yml",
    },
    "durable_objects": {
      "bindings": [{ "name": "RELAY", "class_name": "RelayRun" }],
    },
    "observability": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "issues": { "enabled": true },
    },
  },
}
