{
  "name": "@vzn/vx-reapi",
  "version": "0.0.0",
  "description": "Bazel Remote Execution API plugin for vx — remote cache (ActionCache + CAS) and remote execution against NativeLink, BuildBuddy, Buildbarn or bazel-remote.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "protos",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "protobufjs": "^7.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14"
  },
  "publishConfig": {
    "access": "public"
  }
}
