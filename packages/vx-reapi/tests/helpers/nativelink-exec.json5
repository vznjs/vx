{
  stores: [
    { name: 'CAS', memory: { eviction_policy: { max_bytes: 500000000 } } },
    { name: 'AC', memory: { eviction_policy: { max_bytes: 100000000 } } },
    {
      name: 'WORK_FS',
      fast_slow: {
        fast: {
          filesystem: {
            content_path: '/tmp/nl/content',
            temp_path: '/tmp/nl/temp',
            eviction_policy: { max_bytes: 200000000 },
          },
        },
        slow: { ref_store: { name: 'CAS' } },
      },
    },
  ],
  schedulers: [
    {
      name: 'MAIN',
      simple: {
        supported_platform_properties: {
          cpu_count: 'minimum',
          OSFamily: 'priority',
          'container-image': 'priority',
        },
      },
    },
  ],
  workers: [
    {
      local: {
        worker_api_endpoint: { uri: 'grpc://127.0.0.1:50061' },
        cas_fast_slow_store: 'WORK_FS',
        upload_action_result: { ac_store: 'AC' },
        work_directory: '/tmp/work',
        platform_properties: {
          cpu_count: { values: ['1'] },
          OSFamily: { values: ['Linux'] },
          'container-image': { values: ['*'] },
        },
      },
    },
  ],
  servers: [
    {
      listener: { http: { socket_address: '0.0.0.0:50051' } },
      services: {
        cas: { '': { cas_store: 'CAS' } },
        ac: { '': { ac_store: 'AC' } },
        execution: { '': { cas_store: 'CAS', scheduler: 'MAIN' } },
        capabilities: { '': { remote_execution: { scheduler: 'MAIN' } } },
        bytestream: { cas_stores: { '': 'CAS' } },
      },
    },
    {
      listener: { http: { socket_address: '127.0.0.1:50061' } },
      services: { worker_api: { scheduler: 'MAIN' } },
    },
  ],
}
