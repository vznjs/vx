{
  "tasks": {
    "install": {
      "dependsOn": [
        "^build"
      ]
    },
    "build": {
      "description": "nothing to build — consumed as source",
      "dependsOn": [
        "^build"
      ],
      "inputs": {
        "files": [
          "src/**",
          "protos/**",
          "package.json"
        ]
      }
    },
    "ci": {
      "dependsOn": [
        "lint",
        "test",
        "test.live"
      ]
    },
    "test": {
      "description": "bun test, one process per file (live suites need VX_REAPI_*_ENDPOINT)",
      "dependsOn": [
        "install"
      ],
      "exec": {
        "command": "for f in tests/*.test.ts; do echo \"== $f\"; bun test --only-failures \"$f\" --timeout 90000 || exit 1; done",
        "env": {
          "passThrough": [
            "VX_REAPI_TEST_ENDPOINT",
            "VX_REQUIRE_REAPI",
            "VX_REAPI_EXEC_ENDPOINT",
            "VX_REQUIRE_REAPI_EXEC"
          ],
          "define": {
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "VX_CACHE_DIR": ".vx/cache"
          }
        }
      },
      "inputs": {
        "files": [
          "src/**",
          "tests/**",
          "package.json",
          "tsconfig.json"
        ],
        "env": [
          "VX_REAPI_TEST_ENDPOINT",
          "VX_REQUIRE_REAPI",
          "VX_REAPI_EXEC_ENDPOINT",
          "VX_REQUIRE_REAPI_EXEC"
        ]
      },
      "cache": {
        "outputs": {
          "files": []
        }
      }
    },
    "test.live": {
      "description": "bun test, the live REAPI files, against services.cache and services.exec",
      "dependsOn": [
        "install",
        "services.cache",
        "services.exec"
      ],
      "exec": {
        "command": "for f in tests/*-e2e.test.ts; do echo \"== $f\"; bun test --only-failures \"$f\" --timeout 90000 || exit 1; done",
        "env": {
          "define": {
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "VX_CACHE_DIR": ".vx/cache",
            "VX_REAPI_TEST_ENDPOINT": "grpc://127.0.0.1:19092",
            "VX_REQUIRE_REAPI": "1",
            "VX_REAPI_EXEC_ENDPOINT": "grpc://127.0.0.1:51051",
            "VX_REQUIRE_REAPI_EXEC": "1"
          }
        }
      }
    },
    "services.cache": {
      "description": "bazel-remote (REAPI cache) on :19092",
      "exec": {
        "command": "sh tests/helpers/bazel-remote.sh",
        "persistent": {
          "readyWhen": "Starting gRPC server"
        },
        "timeout": "5m"
      },
      "inputs": {
        "files": [
          "tests/helpers/bazel-remote.sh",
          "package.json"
        ]
      }
    },
    "services.exec": {
      "description": "NativeLink (REAPI execution) on :51051",
      "exec": {
        "command": "sh tests/helpers/nativelink.sh",
        "persistent": {
          "readyWhen": "Worker registered"
        },
        "timeout": "5m"
      },
      "inputs": {
        "files": [
          "tests/helpers/nativelink.sh",
          "tests/helpers/nativelink-exec.json5",
          "package.json"
        ]
      }
    },
    "lint": {
      "dependsOn": [
        "lint.oxlint",
        "lint.oxfmt"
      ]
    },
    "lint.oxlint": {
      "description": "oxlint with tsgolint-backed type-aware checks",
      "exec": {
        "command": "oxlint --type-aware --type-check",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "src/**",
          "tests/**",
          "package.json",
          ".oxlintrc.json",
          "tsconfig.json"
        ]
      },
      "cache": {
        "outputs": {
          "files": []
        }
      }
    },
    "lint.oxfmt": {
      "description": "oxfmt --check (no rewrite; CI-safe)",
      "exec": {
        "command": "oxfmt --check .",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "**/*",
          "package.json"
        ]
      },
      "cache": {
        "outputs": {
          "files": []
        }
      }
    }
  }
}
