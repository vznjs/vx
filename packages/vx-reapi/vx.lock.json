{
  "tasks": {
    "install": {
      "dependsOn": [
        "^build"
      ]
    },
    "build": {
      "description": "nothing to build — consumed as source",
      "dependsOn": [
        "^build"
      ],
      "inputs": {
        "files": [
          "src/**",
          "protos/**",
          "package.json"
        ]
      }
    },
    "ci": {
      "dependsOn": [
        "lint",
        "test",
        "test.live"
      ]
    },
    "test": {
      "dependsOn": [
        "test.shard-*"
      ]
    },
    "test.shard-1": {
      "description": "bun test, shard 1 of 3, one process per file (live suites need VX_REAPI_*_ENDPOINT)",
      "dependsOn": [
        "install"
      ],
      "exec": {
        "command": "for f in tests/cache-ac-refused.test.ts tests/cancel-operation.test.ts tests/exec-e2e.test.ts tests/executor-auth.test.ts tests/executor-sweep.test.ts tests/executor.test.ts tests/fake-reapi.test.ts tests/materialise-fence.test.ts tests/merkle-sweep.test.ts tests/reapi-e2e.test.ts tests/string-map-options.test.ts tests/wedged.test.ts tests/wire-exec-unavailable.test.ts; do echo \"== $f\"; bun test --only-failures \"$f\" --timeout 90000 || exit 1; done",
        "env": {
          "passThrough": [
            "VX_REAPI_TEST_ENDPOINT",
            "VX_REQUIRE_REAPI",
            "VX_REAPI_EXEC_ENDPOINT",
            "VX_REQUIRE_REAPI_EXEC"
          ],
          "define": {
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "VX_CACHE_DIR": ".vx/cache"
          }
        }
      },
      "inputs": {
        "files": [
          "src/**",
          "tests/**",
          "package.json",
          "tsconfig.json"
        ],
        "env": [
          "VX_REAPI_TEST_ENDPOINT",
          "VX_REQUIRE_REAPI",
          "VX_REAPI_EXEC_ENDPOINT",
          "VX_REQUIRE_REAPI_EXEC"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    },
    "test.shard-2": {
      "description": "bun test, shard 2 of 3, one process per file (live suites need VX_REAPI_*_ENDPOINT)",
      "dependsOn": [
        "install"
      ],
      "exec": {
        "command": "for f in tests/encoding.test.ts tests/executor-no-stale-replay.test.ts tests/factory-capabilities.test.ts tests/merkle.test.ts tests/no-stale-hit.test.ts tests/option-kinds.test.ts tests/plugin-sweep.test.ts tests/queue-timeout.test.ts tests/read-bounds.test.ts tests/request-metadata-action.test.ts tests/timeout-options.test.ts tests/tls.test.ts tests/unknown-options.test.ts tests/wire-exec-sweep.test.ts; do echo \"== $f\"; bun test --only-failures \"$f\" --timeout 90000 || exit 1; done",
        "env": {
          "passThrough": [
            "VX_REAPI_TEST_ENDPOINT",
            "VX_REQUIRE_REAPI",
            "VX_REAPI_EXEC_ENDPOINT",
            "VX_REQUIRE_REAPI_EXEC"
          ],
          "define": {
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "VX_CACHE_DIR": ".vx/cache"
          }
        }
      },
      "inputs": {
        "files": [
          "src/**",
          "tests/**",
          "package.json",
          "tsconfig.json"
        ],
        "env": [
          "VX_REAPI_TEST_ENDPOINT",
          "VX_REQUIRE_REAPI",
          "VX_REAPI_EXEC_ENDPOINT",
          "VX_REQUIRE_REAPI_EXEC"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    },
    "test.shard-3": {
      "description": "bun test, shard 3 of 3, one process per file (live suites need VX_REAPI_*_ENDPOINT)",
      "dependsOn": [
        "install"
      ],
      "exec": {
        "command": "for f in tests/boolean-options.test.ts tests/cache-sweep.test.ts tests/capabilities-retry.test.ts tests/decode-sweep.test.ts tests/executor-helpers-sweep.test.ts tests/integrity.test.ts tests/materialise-concurrency.test.ts tests/no-env.test.ts tests/plugin.test.ts tests/record-digest-sizes.test.ts tests/stream-cache.test.ts tests/vx-run-e2e.test.ts tests/wire-only-options.test.ts tests/wire-sweep.test.ts tests/wire.test.ts; do echo \"== $f\"; bun test --only-failures \"$f\" --timeout 90000 || exit 1; done",
        "env": {
          "passThrough": [
            "VX_REAPI_TEST_ENDPOINT",
            "VX_REQUIRE_REAPI",
            "VX_REAPI_EXEC_ENDPOINT",
            "VX_REQUIRE_REAPI_EXEC"
          ],
          "define": {
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "VX_CACHE_DIR": ".vx/cache"
          }
        }
      },
      "inputs": {
        "files": [
          "src/**",
          "tests/**",
          "package.json",
          "tsconfig.json"
        ],
        "env": [
          "VX_REAPI_TEST_ENDPOINT",
          "VX_REQUIRE_REAPI",
          "VX_REAPI_EXEC_ENDPOINT",
          "VX_REQUIRE_REAPI_EXEC"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    },
    "test.live": {
      "description": "bun test, the live REAPI files, against services.cache and services.exec",
      "dependsOn": [
        "install",
        "services.cache",
        "services.exec"
      ],
      "exec": {
        "command": "for f in tests/*-e2e.test.ts; do echo \"== $f\"; bun test --only-failures \"$f\" --timeout 90000 || exit 1; done",
        "env": {
          "define": {
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "VX_CACHE_DIR": ".vx/cache",
            "VX_REAPI_TEST_ENDPOINT": "grpc://127.0.0.1:19092",
            "VX_REQUIRE_REAPI": "1",
            "VX_REAPI_EXEC_ENDPOINT": "grpc://127.0.0.1:51051",
            "VX_REQUIRE_REAPI_EXEC": "1"
          }
        }
      }
    },
    "services.cache": {
      "description": "bazel-remote (REAPI cache) on :19092",
      "exec": {
        "command": "sh tests/helpers/bazel-remote.sh",
        "persistent": {
          "readyWhen": "Starting gRPC server"
        },
        "timeout": "5m"
      },
      "inputs": {
        "files": [
          "tests/helpers/bazel-remote.sh",
          "package.json"
        ]
      }
    },
    "services.exec": {
      "description": "NativeLink (REAPI execution) on :51051",
      "exec": {
        "command": "sh tests/helpers/nativelink.sh",
        "persistent": {
          "readyWhen": "Worker registered"
        },
        "timeout": "5m"
      },
      "inputs": {
        "files": [
          "tests/helpers/nativelink.sh",
          "tests/helpers/nativelink-exec.json5",
          "package.json"
        ]
      }
    },
    "lint": {
      "dependsOn": [
        "lint.oxlint",
        "lint.oxfmt"
      ]
    },
    "lint.oxlint": {
      "description": "oxlint with tsgolint-backed type-aware checks",
      "exec": {
        "command": "oxlint --type-aware --type-check",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "src/**",
          "tests/**",
          "package.json",
          ".oxlintrc.json",
          "tsconfig.json"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    },
    "lint.oxfmt": {
      "description": "oxfmt --check (no rewrite; CI-safe)",
      "exec": {
        "command": "oxfmt --check .",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "**/*",
          "package.json"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    }
  }
}
