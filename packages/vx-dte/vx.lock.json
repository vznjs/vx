      "exec": {
        "command": "BUN_RUNTIME_TRANSPILER_CACHE_PATH=\"${TMPDIR:-/tmp}/bun-transpiler\" bun test --only-failures --timeout=30000 $(ls tests/*.test.ts | grep -v -e /wire.test.ts -e /wire-faults.test.ts -e /wire-dials.test.ts -e /local-e2e.test.ts -e /local-e2e-workers.test.ts -e /local-e2e-saves.test.ts -e /local-e2e-worktrees.test.ts -e /units.test.ts -e /gitlab.test.ts -e /github.test.ts)",
