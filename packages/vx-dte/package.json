{
  "name": "@vzn/vx-dte",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Distributed task execution for vx: one run spread over workers your own CI spawns, joined through a relay.",
  "keywords": [
    "vx",
    "monorepo",
    "vx-plugin",
    "distributed",
    "ci"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "dependencies": {
    "@vzn/vx-dte-server": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@vzn/vx": "workspace:*"
  },
  "peerDependencies": {
    "@vzn/vx": "*"
  }
}
