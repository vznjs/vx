{
  "name": "@vzn/vx-mcp",
  "version": "0.0.0",
  "description": "Model Context Protocol server for vx — a plugin that adds `vx mcp`, exposing cache stats, run history and cache-key explanations to AI coding agents over stdio.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@vzn/vx": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@vzn/vx": "*"
  }
}
