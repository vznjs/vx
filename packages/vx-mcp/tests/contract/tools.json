      "summary.summary.cachedLocal",
      "summary.summary.cachedRemote",
      "summary.summary.failed",
      "summary.summary.restoredLocal",
      "summary.summary.restoredRemote",
      "summary.summary.skipped",
      "summary.summary.successful",
      "summary.summary.total",
      "summary.summary.upToDate",
      "summary.tasks",
      "summary.tasks[]",
      "summary.tasks[].durationMs",
      "summary.tasks[].exitCode",
      "summary.tasks[].hash",
      "summary.tasks[].id",
      "summary.tasks[].project",
      "summary.tasks[].restored",
      "summary.tasks[].status",
      "summary.tasks[].storedCpuMs",
