---
// The feature hub: every feature in src/features/features.ts as a card,
// grouped by category, each linking its own page ([slug].astro). Static;
// the chips are anchors to the sections, and the last one is the Reference's
// one-line list of every feature (all-features).
import FeatureCard from '../../components/features/FeatureCard.astro'
import FeaturesPage from '../../components/features/FeaturesPage.astro'
import { CATEGORIES, FEATURES } from '../../features/features.js'
import { inventory } from '../../features/inventory.js'

const groups = CATEGORIES.map((c) => ({
  ...c,
  features: FEATURES.filter((f) => f.category === c.id),
}))
const base = import.meta.env.BASE_URL
const all = await inventory(base)
const total = all.reduce((n, g) => n + g.items.length, 0)
---

<FeaturesPage
  title="Features"
  description={`Everything vx does: ${total} features, from the cache and the sandbox to watch mode and plugins.`}
>
  <section class="fhub-hero">
    <div class="container">
      <p class="vx-kicker">// {total} features and counting</p>
      <h1>Everything <span class="phosphor">vx</span> does.</h1>
      <p class="lede">
        A fast runner, a cache you can trust, and the small things you meet every day. Each one
        has a page that shows what it does for you.
      </p>
      <ul class="chips" aria-label="Categories">
        {
          groups.map((g) => (
            <li>
              <a href={`#${g.id}`}>
                {g.title} <span class="count">{g.features.length}</span>
              </a>
            </li>
          ))
        }
        <li>
          <a href={`${base}all-features/`}>
            The one-line list <span class="count">{total}</span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  {
    groups.map((g) => (
      <section class="fcat" id={g.id}>
        <div class="container">
          <div class="fcat-head">
            <h2>{g.title}</h2>
            <p>{g.line}</p>
          </div>
          <div class="fgrid">
            {g.features.map((f) => (
              <FeatureCard feature={f} showCategory={false} />
            ))}
          </div>
        </div>
      </section>
    ))
  }

</FeaturesPage>
