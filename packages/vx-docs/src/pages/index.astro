    </div>

    <script>
      // The one interaction on the page: the install command copies itself.
      const pill = document.querySelector<HTMLButtonElement>('.install-pill')
      pill?.addEventListener('click', async () => {
        const text = pill.dataset['copy'] ?? ''
        try {
          await navigator.clipboard.writeText(text)
          pill.classList.add('copied')
          setTimeout(() => pill.classList.remove('copied'), 1400)
        } catch {
          // clipboard unavailable: the command is visible to select by hand
        }
      })
    </script>
  </body>
</html>
