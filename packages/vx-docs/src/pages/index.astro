            </div>
          </div>
          <div class="hero-aside">
            <div class="term">
            <div class="term-bar-top">
              <span class="tdot" style="background:#ff5f57"></span>
              <span class="tdot" style="background:#febc2e"></span>
              <span class="tdot" style="background:#28c840"></span>
              <span class="ttitle">zsh — vx · sample output</span>
            </div>
            <div class="term-body">
              <div class="term-prompt">
                <span class="caret">❯ </span><span class="cmd">vx run build --affected</span>
              </div>
              {
                termTasks.map((t) => (
                  <div class="term-task">
                    <span class="glyph">⏺ </span>
                    <span class="time">{t.ms}ms</span>
                    <span class="ok">success</span>
                    <span class="cache">miss</span>
