---
// Standalone landing: two independent synthetic workloads, not a universal speed claim.
// update-site.ts validates both datasets before writing the generated measurements;
// check.site guards their regions and landing.test.ts holds the built presentation.
import Diagram from '../components/guide/diagram/Diagram.astro'
import { CALLOUTS, oneRun } from '../components/landing/one-run.js'
import '../styles/landing.css'
import '../styles/charts.css'
import { parseDuration, renderBars, type BarGroup } from '../plugins/data-charts.ts'

const base = import.meta.env.BASE_URL // '/vx/' on Pages, '/' on a custom domain
const href = (p: string) => `${base}${p}`
const GH = 'https://github.com/vznjs/vx'
const TITLE = 'vx — a task runner and build cache for JS monorepos'
const DESCRIPTION =
  'Native-config measurements of two synthetic workloads, including a scheduling counterexample. End-to-end time and baseline-subtracted excess are separate metrics.'
// Absolute, as a link preview fetches it from wherever the link was pasted.
const siteUrl = new URL(base, Astro.site).href

/** A callout's line, each backticked span as code. */
const codeHtml = (s: string): string => s.replace(/`([^`]+)`/g, '<code>$1</code>')

// One card per pillar: an icon, a title, one sentence of at most fifteen
// words, and the Docs page that says the rest.
const pillars = [
  {
    id: 'correct',
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>',
    tone: 'var(--vx-ok)',
    title: 'Correctness',
    body: 'A task’s cache key covers every file, setting and env var it declares.',
    more: 'Caching in depth',
    doc: href('caching/'),
  },
  {
    id: 'sandboxed',
    icon: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>',
    tone: 'var(--vx-link)',
    title: 'Sandbox',
    body: 'A sandboxed task cannot read a workspace file it did not declare.',
    more: 'Sandboxing',
    doc: href('guides/sandboxing/'),
  },
  {
    id: 'extensible',
    icon: '<path d="M9 2v6M15 2v6M6 8h12v4a6 6 0 01-12 0V8zM12 18v4"/>',
    tone: 'var(--vx-accent)',
    title: 'Extensibility',
    body: 'Plugins decide where tasks run, where the cache lives and who watches.',
    more: 'Writing a plugin',
    doc: href('guides/plugins/'),
  },
  {
    id: 'free',
    icon: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 019.9-1"/>',
    tone: 'var(--vx-warn)',
    title: 'Freedom',
    body: 'MIT, no paywall, no cloud, no account.',
    more: 'Migrate',
    doc: href('guides/migrate/'),
  },
]

const benchTable = [
  { label: 'Cold build: whole wall time', vx: '3m 40s', turbo: '4m 59s (vx 1.3× faster)', nx: '3m 49s (vx 1.03× faster)', vt: '4m 49s (vx 1.3× faster)' },
  { label: 'Cold build: baseline-subtracted excess', vx: '2.33s', turbo: '1m 21s (vx 34× faster)', nx: '10.98s (vx 4.7× faster)', vt: '1m 11s (vx 30× faster)' },
  { label: 'Cold build: CPU burned', vx: '17.27s', turbo: '21.04s (vx 1.2× faster)', nx: '52.19s (vx 3× faster)', vt: '12.46s (vx 1.4× slower)' },
  { label: 'Fully cached run (restored)', vx: '650ms', turbo: '997ms (vx 1.5× faster)', nx: '6.25s (vx 9.6× faster)', vt: '2.64s (vx 4× faster)' },
  { label: 'Fully cached run (up-to-date)', vx: '393ms', turbo: '463ms (vx 1.1× faster)', nx: '6.45s (vx 16× faster)', vt: '2.49s (vx 6.3× faster)' },
]
const benchFormula = 'vx N× faster: that tool takes N times as long as vx (theirs ÷ vx); N× slower: vx takes N times as long (vx ÷ theirs).'

/** A competitor cell's value and its "vx N× faster". */
const vsOf = (c: string): [string, string] => {
  const at = c.indexOf(' (')
  return [c.slice(0, at), c.slice(at + 2, -1)]
}
const benchBars = renderBars(
  benchTable.map((r) => ({
    title: r.label,
    bars: [
      { name: 'vx', ms: parseDuration(r.vx)!, value: r.vx, hero: true },
      ...(
        [
          ['Turborepo', r.turbo],
          ['Nx', r.nx],
          ['Vite Task', r.vt],
        ] as const
      ).map(([name, c]) => ({ name, ms: parseDuration(c)!, value: vsOf(c)[0], note: vsOf(c)[1] })),
    ],
  })),
)

const benchScope = "Synthetic layered stress graph (2026-10-04): 1,090 packages, 2,180 executable tasks + 1,090 ordering/group nodes; single repetition per runner/state, concurrency 10."

// counterexample:data:start
const counterexampleScope = "Synthetic scheduling counterexample (2026-10-08): 7 DAG nodes, 5 executable waiting tasks and 2 commandless root gates, two workers, five alternating rounds, ten conforming actual CLI samples, zero cache hits and zero exit codes."
const counterexampleRows = [{"label":"End-to-end wall time: median; min–max","vx":"89.916 s; 89.899 s–89.992 s","turbo":"60.255 s; 60.234 s–60.347 s"},{"label":"Baseline-subtracted excess: median; min–max","vx":"29.916 s; 29.899 s–29.992 s","turbo":"0.255 s; 0.234 s–0.347 s"}]
const counterexampleGroups: BarGroup[] = [{"title":"End-to-end wall time: median; min–max","bars":[{"name":"vx","ms":89915.84075,"value":"89.916 s; 89.899 s–89.992 s"},{"name":"Turborepo","ms":60254.991375,"value":"60.255 s; 60.234 s–60.347 s"}]},{"title":"Baseline-subtracted excess: median; min–max","bars":[{"name":"vx","ms":29915.840750000003,"value":"29.916 s; 29.899 s–29.992 s"},{"name":"Turborepo","ms":254.9913749999978,"value":"0.255 s; 0.234 s–0.347 s"}]}]
const counterexampleNotes = ["End-to-end ratio of all-five-round medians (vx / Turborepo): 1.492×; all-sample envelope 1.490–1.494×.","Excess ratio of all-five-round medians ((vx − ideal) / (Turborepo − ideal)): 117.321×; all-sample envelope 86.24358–128.43789×.","All five rounds are retained; 1 paired excess ratio is below 100×, and a ratio of all-sample medians is not an every-round threshold or a universal guarantee.","Paired round 1: end-to-end vx/Turborepo ratio 1.48999×; baseline-subtracted excess ratio 86.29344×.","Paired round 2: end-to-end vx/Turborepo ratio 1.49197×; baseline-subtracted excess ratio 117.25320×.","Paired round 3: end-to-end vx/Turborepo ratio 1.49126×; baseline-subtracted excess ratio 102.75401×.","Paired round 4: end-to-end vx/Turborepo ratio 1.49384×; baseline-subtracted excess ratio 123.97604×.","Paired round 5: end-to-end vx/Turborepo ratio 1.49330×; baseline-subtracted excess ratio 128.24447×.","Both runners receive the same zero-cost readiness gates.","This controls when parents become ready: count priority may admit newly ready parents ahead of the independent long task, while a FIFO semaphore may retain the already waiting long task.","These are hypotheses about ordering, not guaranteed runner behavior; keep every observed task-start order.","Only the five executable tasks have observed process spans and output files; commandless gate readiness timing is not trace-verified.","The retained earlier minimal five-task case includes an adverse Turborepo root-order run and an unresolved excess ratio; it is a different shared DAG, not a discarded outlier or a subset of this primary measurement.","Analytic ideal 60.000 s; commandless gates add no modeled work or duration.","Median excess denominator 254.991 ms; configured noise floor 1 ms; nonpositive or noise/spread-dominated denominators suppress the excess ratio.","Envelopes are observed min/max combinations, not confidence intervals; an excess multiple is not that multiple slower whole builds.","Default vx counts dependent tasks, so the two parents can delay the long independent task; it does not know durations or guarantee an optimal schedule.","darwin/arm64 25.6.0, Apple M4 Max, 14 cores, Bun 1.4.2+744846f84, vx 0.0.0, native-direct Turborepo 2.11.7; source commit b82388663a445a9ee099be0f80c81ff66c90c638."]
const counterexamplePreliminaryLinks = [{"label":"counterexample-preliminary-results.json","href":"https://github.com/vznjs/vx/blob/main/packages/vx-bench/counterexample-preliminary-results.json"},{"label":"COUNTEREXAMPLE-PRELIMINARY.md","href":"https://github.com/vznjs/vx/blob/main/packages/vx-bench/COUNTEREXAMPLE-PRELIMINARY.md"},{"label":"counterexample-preliminary-samples.jsonl","href":"https://github.com/vznjs/vx/blob/main/packages/vx-bench/counterexample-preliminary-samples.jsonl"}]
// counterexample:data:end

// The retained stress graph's multiples, never a claim about the independent counterexample.
const addsRow = benchTable.find((r) => /excess|time the runner adds/.test(r.label))!
const cpuRow = benchTable.find((r) => r.label === 'Cold build: CPU burned')!
const cachedRow = benchTable.find((r) => r.label === 'Fully cached run (up-to-date)')!
const wins = [
  { n: vsOf(addsRow.turbo)[1], line: 'cold baseline-subtracted excess vs Turborepo, stress graph only' },
  { n: vsOf(cpuRow.turbo)[1], line: 'cold CPU vs Turborepo, stress graph only' },
  { n: vsOf(cachedRow.nx)[1], line: 'fully cached run vs Nx, stress graph only' },
]

// Where vx differs from both, each cell as the choosing page's model says it
// (src/components/demos/model/choosing.ts, checked against each tool's own
// docs): yes, no, or only as a paid cloud service.
type Edge = { kind: 'yes' | 'no' | 'paid'; text: string }
const edges: { trait: string; vx: Edge; turbo: Edge; nx: Edge }[] = [
  {
    trait: 'A file sandbox for every task',
    vx: { kind: 'yes', text: 'Local and free, Linux and macOS' },
    turbo: { kind: 'no', text: 'None' },
    nx: { kind: 'paid', text: 'Nx Cloud add-on' },
  },
  {
    trait: 'Remote execution you host',
    vx: { kind: 'yes', text: 'Bazel’s open REAPI protocol' },
    turbo: { kind: 'no', text: 'None' },
    nx: { kind: 'paid', text: 'Nx Agents on Nx Cloud' },
  },
  {
    trait: 'A remote cache on any backend',
    vx: { kind: 'yes', text: 'REAPI, Turborepo’s or Nx’s wire, by plugin' },
    turbo: { kind: 'no', text: 'Its own HTTP API' },
    nx: { kind: 'no', text: 'Nx Cloud or its own API' },
  },
  {
    trait: 'Config is code',
    vx: { kind: 'yes', text: 'TypeScript, evaluated and hashed' },
    turbo: { kind: 'no', text: 'JSON' },
    nx: { kind: 'no', text: 'JSON, merged with inferred tasks' },
  },
  {
    trait: 'No background daemon',
    vx: { kind: 'yes', text: 'None' },
    turbo: { kind: 'yes', text: 'None for turbo run' },
    nx: { kind: 'no', text: 'On by default' },
  },
]
const mark = { yes: '✓', no: '✕', paid: '$' }

// Why it is faster: three reasons, one short sentence each.
const reasons = [
  { term: 'Nothing boots per task.', line: 'No daemon, no Node process per task: vx spawns your command.' },
  { term: 'Hashing without reading.', line: 'On a clean tree, cache keys come from git’s index.' },
  { term: 'One pass over the repo.', line: 'One git walk per run; each stat and lookup happens once.' },
]

// Start: four commands, native config from the first one.
const startCommands = `npm install -D @vzn/vx
npx vx init                 # a vx.config.ts per package; add the cache block each TODO shows
npx vx run build --all      # builds in dependency order; stores what is cached
npx vx run build --all      # again: the cached tasks are up-to-date`

const footCols = {
  docs: [
    { t: 'Quickstart', h: href('quickstart/') },
    { t: 'Configure', h: href('guides/configure/') },
    { t: 'Sandboxing', h: href('guides/sandboxing/') },
    { t: 'CI and remote', h: href('guides/ci/') },
    { t: 'Migrate', h: href('guides/migrate/') },
    { t: 'Plugins', h: href('guides/plugins/') },
    { t: 'Try it', h: href('playground/') },
  ],
  reference: [
    { t: 'CLI', h: href('cli/') },
    { t: 'Config', h: href('schema/') },
    { t: 'Benchmarks', h: href('benchmarks/') },
    { t: 'vx, Turborepo, Nx, Bazel', h: href('compare/') },
    { t: 'Turbo / Nx parity map', h: href('parity/') },
    { t: 'Glossary', h: href('glossary/') },
  ],
  community: [
    { t: 'GitHub', h: GH },
    { t: 'Blog', h: href('blog/') },
  ],
}
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={siteUrl} />
    <link rel="sitemap" href={href('sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:image" content={`${siteUrl}og.png`} />
    <meta property="og:image:alt" content="vx: a task runner and build cache for JS monorepos" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={href('logo-mark.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap"
    />
    <style is:global>
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class="vx-landing">
      <header class="nav">
        <div class="nav-left">
          <a class="brand" href={base}>
            <img src={href('logo-mark.svg')} width="26" height="26" alt="vx" />
            <span class="word">vx</span>
          </a>
          <nav class="nav-links">
            <a href={href('quickstart/')}>docs</a>
            <a href={href('cli/')}>reference</a>
            <a href={href('blog/')}>blog</a>
          </nav>
        </div>
        <div class="nav-right">
          <a class="btn-github" href={GH}>
            <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"
              ><path
                d="M8 0C3.58 0 0 3.58 0 8a8 8 0 005.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.49-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.81.06 1.24.83 1.24.83.71 1.23 1.87.87 2.33.67.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.01.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 014 0c1.53-1.03 2.2-.82 2.2-.82.44 1.11.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            >
            GitHub
          </a>
        </div>
      </header>

      <section class="hero">
        <div class="container">
          <h1>A task runner and <span class="phosphor">build cache</span> for JS monorepos.</h1>
          <p class="lede">Native-config benchmarks show different scheduling trade-offs, not a universal speed ranking.</p>
          <p class="bench-scope">The following multiples describe only the synthetic layered stress graph with a single repetition; cold excess is not whole-build speedup.</p>
          <ul class="wins">
            {
              wins.map((w) => (
                <li>
                  <strong>{w.n}</strong>
                  <span>{w.line}</span>
                </li>
              ))
            }
          </ul>
          <div class="actions">
            <button class="install-pill" data-copy="npm install -g @vzn/vx" type="button">
              <span class="dollar">$</span>
              <span class="cmd">npm install -g @vzn/vx</span>
              <span class="copy">
                <svg class="icon-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  ><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 012-2h10"></path></svg
                >
                <svg class="icon-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"></path></svg>
              </span>
            </button>
          </div>
          <div class="actions">
            <a class="btn btn-primary btn-lg" href={href('quickstart/')}
              >Quickstart <span class="arr">→</span></a
            >
            <a class="btn btn-ghost btn-lg" href={GH}>GitHub</a>
          </div>
          <img
            class="demo"
            src={href('demo.svg')}
            width="760"
            alt="vx run ci --all on the starter: cold, three tasks run; again, three up-to-date."
          />
        </div>
      </section>

      <section class="section" id="bench">
        <div class="container">
          <div class="section-head">
            <p class="vx-kicker">// 3,270 tasks · 1,090 packages · 100 layers · identical commands, identical concurrency</p>
            <h2>Two synthetic workloads, different trade-offs.</h2>
          </div>
          <article class="bench-panel" id="counterexample-case">
            <h3>Synthetic scheduling counterexample</h3>
            <p>{counterexampleScope}</p>
            <Fragment set:html={renderBars(counterexampleGroups)} />
            {
              counterexampleRows.length > 0 && (
                <table>
                  <thead><tr><th scope="col">Metric</th><th scope="col">vx</th><th scope="col">Turborepo</th></tr></thead>
                  <tbody>
                    {counterexampleRows.map((r) => <tr><th scope="row">{r.label}</th><td>{r.vx}</td><td>{r.turbo}</td></tr>)}
                  </tbody>
                </table>
              )
            }
            {counterexampleNotes.map((note) => <p>{note}</p>)}
            <nav aria-label="Retained preliminary measurement">
              {counterexamplePreliminaryLinks.map((link) => <a class="section-link" href={link.href}>{link.label}</a>)}
            </nav>
            <a class="section-link" href={href('benchmarks/#synthetic-scheduling-counterexample')}>Methodology, raw samples and the exact baseline <span class="arr">→</span></a>
          </article>
          <article class="bench-panel" id="stress-case">
            <h3>Synthetic layered stress graph</h3>
            <p>{benchScope}</p>
            <Fragment set:html={benchBars} />
            <p class="bench-formula">{benchFormula}</p>
            <p>Cold excess compares wall time minus the analytic ideal, including scheduling delay and runner work; its multiple is not the whole-build speedup.</p>
          </article>
          <ul class="reasons">
            {
              reasons.map((r) => (
                <li>
                  <strong>{r.term}</strong> {r.line}
                </li>
              ))
            }
          </ul>
          <div class="section-links">
            <a class="section-link" href={href('benchmarks/')}>Benchmarks: tables, methodology, reproduce it <span class="arr">→</span></a>
            <a class="section-link" href={href('compare/')}>When another tool is the better pick <span class="arr">→</span></a>
          </div>
        </div>
      </section>

      <section class="section" id="edge">
        <div class="container">
          <div class="section-head">
            <p class="vx-kicker">// vx vs Turborepo vs Nx</p>
            <h2>Built in, free, on your own machines.</h2>
          </div>
          <table class="edge-table">
            <thead>
              <tr>
                <th scope="col"></th>
                <th scope="col" class="vx">vx</th>
                <th scope="col">Turborepo</th>
                <th scope="col">Nx</th>
              </tr>
            </thead>
            <tbody>
              {
                edges.map((e) => (
                  <tr>
                    <th scope="row">{e.trait}</th>
                    {(
                      [
                        ['vx', e.vx],
                        ['Turborepo', e.turbo],
                        ['Nx', e.nx],
                      ] as const
                    ).map(([tool, c]) => (
                      <td class={c.kind} data-tool={tool}>
                        <span class="mark" aria-hidden="true">
                          {mark[c.kind]}
                        </span>
                        {c.text}
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
          <div class="section-links">
            <a class="section-link" href={href('compare/')}>Every choice, with sources, and when another tool fits better <span class="arr">→</span></a>
          </div>
        </div>
      </section>

      <section class="section" id="try">
        <div class="container">
          <div class="section-head">
            <p class="vx-kicker">// four commands</p>
            <h2>Start in a minute.</h2>
          </div>
          <pre class="code"><code>{startCommands}</code></pre>
          <p class="sub">Coming from Turbo or Nx: <code>vx init</code> gives a temporary start, and <code>bunx @vzn/vx-migrate</code> writes the native vx config.</p>
          <div class="section-links">
            <a class="section-link" href={href('quickstart/')}>Quickstart: a cache block, the first hit <span class="arr">→</span></a>
            <a class="section-link" href={href('guides/migrate/')}>Migrate from Turbo or Nx <span class="arr">→</span></a>
          </div>
        </div>
      </section>

      <section class="section" id="one-run">
        <div class="container">
          <div class="section-head">
            <p class="vx-kicker">// one run, after you edit app</p>
            <h2>Everything vx does, in one picture.</h2>
          </div>
          <div class="one-run">
            <Diagram {...oneRun} />
            <ol class="callouts">
              {
                CALLOUTS.map((c, i) => (
                  <li id={c.id}>
                    <span class="n">{i + 1}</span>
                    <span>
                      <strong>{c.term}</strong> <Fragment set:html={codeHtml(c.line)} />
                    </span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <section class="section" id="pillars">
        <div class="container">
          <div class="section-head">
            <p class="vx-kicker">// what you can count on</p>
            <h2>Correct. Sandboxed. Extensible. Free.</h2>
          </div>
          <div class="cards">
            {
              pillars.map((p) => (
                <a class="card" id={p.id} style={`--c:${p.tone}`} href={p.doc}>
                  <span class="ico">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
                  </span>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                  <span class="learn">{p.more} <span class="arr">→</span></span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <footer class="footer">
        <div class="foot-grid container">
          <div class="foot-brand">
            <div class="row">
              <img src={href('logo-mark.svg')} width="24" height="24" alt="vx" />
              <span class="word">vx</span>
            </div>
            <p>One binary · MIT licensed · no account.</p>
          </div>
          {
            Object.entries(footCols).map(([title, links]) => (
              <div class="foot-col">
                <p class="title">{title}</p>
                <div class="links">
                  {links.map((l) => (
                    <a href={l.h}>{l.t}</a>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
        <div class="foot-bottom container">
          <span>© 2026 vx contributors</span>
          <span>MIT licensed · @vzn/vx</span>
        </div>
      </footer>
    </div>

    <script>
      // The one interaction on the page: the install command copies itself.
      const pill = document.querySelector<HTMLButtonElement>('.install-pill')
      pill?.addEventListener('click', async () => {
        const text = pill.dataset['copy'] ?? ''
        try {
          await navigator.clipboard.writeText(text)
          pill.classList.add('copied')
          setTimeout(() => pill.classList.remove('copied'), 1400)
        } catch {
          // clipboard unavailable: the command is visible to select by hand
        }
      })
    </script>
  </body>
</html>
