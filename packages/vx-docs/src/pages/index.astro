---
// vx landing page — the whole story on one page (design/site-short-2026-09.md
// § The shape): the hero, the one diagram with its six callouts, the first
// benchmark, and the four pillars. Standalone (its own nav, footer and
// theme), static, one script for the copy button. Every measurement is
// written by packages/vx-bench/update-site.ts (check.site guards it) from
// results.json: the benchRows block and the graph's size in the #bench
// kicker and sub. tests/landing.test.ts holds the rest of the page.
import Diagram from '../components/guide/diagram/Diagram.astro'
import { CALLOUTS, oneRun } from '../components/landing/one-run.js'
import '../styles/landing.css'

const base = import.meta.env.BASE_URL // '/vx/' on Pages, '/' on a custom domain
const href = (p: string) => `${base}${p}`
const GH = 'https://github.com/vznjs/vx'

/** A callout's line, each backticked span as code. */
const codeHtml = (s: string): string => s.replace(/`([^`]+)`/g, '<code>$1</code>')

// One card per pillar: an icon, a title, one sentence of at most fifteen
// words, and the Docs page that says the rest.
const pillars = [
  {
    id: 'correct',
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>',
    tone: 'var(--vx-ok)',
    title: 'Correctness',
    body: 'A task’s cache key covers every file, setting and env var it declares.',
    more: 'Caching in depth',
    doc: href('caching/'),
  },
  {
    id: 'sandboxed',
    icon: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>',
    tone: 'var(--vx-link)',
    title: 'Sandbox',
    body: 'A sandboxed task fails on any read it did not declare.',
    more: 'Sandboxing',
    doc: href('guides/sandboxing/'),
  },
  {
    id: 'extensible',
    icon: '<path d="M9 2v6M15 2v6M6 8h12v4a6 6 0 01-12 0V8zM12 18v4"/>',
    tone: 'var(--vx-accent)',
    title: 'Extensibility',
    body: 'Plugins decide where tasks run, where the cache lives and who watches.',
    more: 'Writing a plugin',
    doc: href('guides/plugins/'),
  },
  {
    id: 'free',
    icon: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 019.9-1"/>',
    tone: 'var(--vx-warn)',
    title: 'Freedom',
    body: 'MIT, no paywall, no cloud, no account; bring a Turborepo or Nx repo unchanged.',
    more: 'Migrate',
    doc: href('guides/migrate/'),
  },
]

const benchRows = [
  {
    task: 'Cold build · from scratch',
    bars: [
      { name: 'baseline', val: 218000, disp: '3m 38s', c: 'var(--c-baseline)' },
      { name: 'vx', val: 226450, disp: '3m 46s', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 313463, disp: '5m 13s', c: 'var(--c-turbo)' },
      { name: 'nx', val: 2084171, disp: '34m 44s', c: 'var(--c-nx)' },
    ],
  },
  {
    task: 'Fully cached · nothing to rebuild',
    bars: [
      { name: 'baseline', val: 0, disp: '0', c: 'var(--c-baseline)' },
      { name: 'vx', val: 510, disp: '510ms', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 760, disp: '760ms', c: 'var(--c-turbo)' },
      { name: 'nx', val: 3594, disp: '3.59s', c: 'var(--c-nx)' },
    ],
  },
  {
    task: 'Restoring outputs · cache → disk',
    bars: [
      { name: 'baseline', val: 0, disp: '0', c: 'var(--c-baseline)' },
      { name: 'vx', val: 777, disp: '777ms', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 1174, disp: '1.17s', c: 'var(--c-turbo)' },
      { name: 'nx', val: 4149, disp: '4.15s', c: 'var(--c-nx)' },
    ],
  },
  {
    task: 'CPU burned · cold build, user + system',
    bars: [
      { name: 'baseline', val: 0, disp: '0', c: 'var(--c-baseline)' },
      { name: 'vx', val: 34610, disp: '34.61s', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 73079, disp: '1m 13s', c: 'var(--c-turbo)' },
      { name: 'nx', val: 6846039, disp: '114m 06s', c: 'var(--c-nx)' },
    ],
  },
]

// The cold row's overhead reads in ONE unit for every runner — clock time
// over the ideal schedule, `+m:ss` — as the generator prints it (owner,
// 2026-09-10: never a percentage for one runner and a multiple for another).
const cold = benchRows[0]!
const coldBar = (name: string) => cold.bars.find((b) => b.name === name)!
const coldBase = coldBar('baseline')
const clock = (ms: number): string => {
  const m = Math.floor(ms / 60_000)
  const sec = Math.round((ms - m * 60_000) / 1000)
  return `${m}:${String(sec).padStart(2, '0')}`
}
// What each runner adds, as one more row of the same panel, so the
// multiples are of vx's overhead.
const overheadRow = {
  task: 'Runner overhead · cold build over the ideal schedule',
  bars: [
    { name: 'vx', c: 'var(--phosphor)' },
    { name: 'turbo', c: 'var(--c-turbo)' },
    { name: 'nx', c: 'var(--c-nx)' },
  ].map((r) => ({
    ...r,
    val: coldBar(r.name).val - coldBase.val,
    disp: `+${clock(coldBar(r.name).val - coldBase.val)}`,
    ...(r.name === 'vx' ? { best: true } : {}),
  })),
}
type Bar = { name: string; val: number; disp: string; c: string; best?: boolean }
/** Every competitor bar reads as a multiple of vx's; vx's own reads "fastest". */
const times = (b: Bar, best: number): string => {
  if (b.name === 'baseline') return ''
  if (b.best) return 'fastest'
  const r = b.val / best
  return r >= 10 ? `${Math.round(r)}× vx` : `${r.toFixed(1)}× vx`
}

const footCols = {
  docs: [
    { t: 'Quickstart', h: href('quickstart/') },
    { t: 'Configure', h: href('guides/configure/') },
    { t: 'Sandboxing', h: href('guides/sandboxing/') },
    { t: 'CI and remote', h: href('guides/ci/') },
    { t: 'Migrate', h: href('guides/migrate/') },
    { t: 'Plugins', h: href('guides/plugins/') },
    { t: 'Try it', h: href('playground/') },
  ],
  reference: [
    { t: 'CLI', h: href('cli/') },
    { t: 'Config', h: href('schema/') },
    { t: 'Benchmarks', h: href('benchmarks/') },
    { t: 'vx, Turborepo, Nx, Bazel', h: href('compare/') },
    { t: 'Turbo / Nx parity map', h: href('parity/') },
    { t: 'Glossary', h: href('glossary/') },
  ],
  community: [
    { t: 'GitHub', h: GH },
    { t: 'Blog', h: href('blog/') },
  ],
}
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>vx — Bend time. Not the rules.</title>
    <meta
      name="description"
      content="A fast, correct task runner and cache for JavaScript monorepos. MIT, no paywall, no cloud, no account."
    />
    <link rel="icon" href={href('logo-mark.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap"
    />
    <style is:global>
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class="vx-landing">
      <header class="nav">
        <div class="nav-left">
          <a class="brand" href={base}>
            <img src={href('logo-mark.svg')} width="26" height="26" alt="vx" />
            <span class="word">vx</span>
          </a>
          <nav class="nav-links">
            <a href={href('quickstart/')}>docs</a>
            <a href={href('cli/')}>reference</a>
            <a href={href('blog/')}>blog</a>
          </nav>
        </div>
        <div class="nav-right">
          <a class="btn-github" href={GH}>
            <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"
              ><path
                d="M8 0C3.58 0 0 3.58 0 8a8 8 0 005.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.49-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.81.06 1.24.83 1.24.83.71 1.23 1.87.87 2.33.67.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.01.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 014 0c1.53-1.03 2.2-.82 2.2-.82.44 1.11.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            >
            GitHub
          </a>
        </div>
      </header>

      <section class="hero">
        <div class="container">
          <h1>A fast, correct task runner for <span class="phosphor">JavaScript monorepos</span>.</h1>
          <div class="actions">
            <button class="install-pill" data-copy="npm install -g @vzn/vx" type="button">
              <span class="dollar">$</span>
              <span class="cmd">npm install -g @vzn/vx</span>
              <span class="copy">
                <svg class="icon-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  ><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 012-2h10"></path></svg
                >
                <svg class="icon-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"></path></svg>
              </span>
            </button>
          </div>
          <div class="actions">
            <a class="btn btn-primary btn-lg" href={href('quickstart/')}
              >Quickstart <span class="arr">→</span></a
            >
            <a class="btn btn-ghost btn-lg" href={GH}>GitHub</a>
          </div>
        </div>
      </section>

      <section class="section" id="one-run">
        <div class="container">
          <div class="section-head">
            <p class="vx-kicker">// one run, after you edit app</p>
            <h2>Everything vx does, in one picture.</h2>
          </div>
          <div class="one-run">
            <Diagram {...oneRun} />
            <ol class="callouts">
              {
                CALLOUTS.map((c, i) => (
                  <li id={c.id}>
                    <span class="n">{i + 1}</span>
                    <span>
                      <strong>{c.term}</strong> <Fragment set:html={codeHtml(c.line)} />
                    </span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <section class="section" id="bench">
        <div class="container">
          <div class="section-head">
            <p class="vx-kicker">// 3,270 tasks · 1,090 packages · 100 layers · identical commands, identical concurrency</p>
            <h2>First in every row.</h2>
            <p class="sub">The same synthetic 3,270-task graph under vx, Turborepo and Nx, each bar a multiple of vx.</p>
          </div>
          <div class="bench-panel">
            <div class="bench-legend">
              <span class="legend"><span class="sw" style="background:var(--phosphor)"></span>vx</span>
              <span class="legend"><span class="sw" style="background:var(--c-turbo)"></span>turborepo</span>
              <span class="legend"><span class="sw" style="background:var(--c-nx)"></span>nx</span>
            </div>
            <div class="bench-rows">
              {
                [overheadRow, ...benchRows].map((r) => {
                  const sorted = [...r.bars.map((b) => b.val)].sort((a, b) => b - a)
                  const outlier = sorted.length > 1 && sorted[0]! > 10 * sorted[1]!
                  const rowMax = (outlier ? sorted[1]! : sorted[0]!) * 1.05
                  const best = r.bars.find((x) => x.best)?.val ?? 1
                  return (
                    <div class="bench-row">
                      <p class="task">{r.task}</p>
                      {r.bars.map((b) => {
                        const clipped = b.val > rowMax
                        const pct = clipped ? 100 : (b.val / rowMax) * 100
                        return (
                          <div
                            class={`bench-bar${b.best ? ' best' : ''}${b.name === 'baseline' ? ' baseline' : ''}${clipped ? ' clipped' : ''}`}
                            style={`--c:${b.c};--w:${pct}%`}
                          >
                            <span class="name">{b.name}</span>
                            <span class="track">
                              <span class="fill" />
                            </span>
                            <span class="disp">{b.disp}</span>
                            <span class="ratio">{times(b, best)}</span>
                          </div>
                        )
                      })}
                    </div>
                  )
                })
              }
            </div>
          </div>
          <div class="section-links">
            <a class="section-link" href={href('benchmarks/')}>Benchmarks: tables, methodology, reproduce it <span class="arr">→</span></a>
            <a class="section-link" href={href('compare/')}>When another tool is the better pick <span class="arr">→</span></a>
          </div>
        </div>
      </section>

      <section class="section" id="pillars">
        <div class="container">
          <div class="section-head">
            <p class="vx-kicker">// what you can count on</p>
            <h2>Correct. Sandboxed. Extensible. Free.</h2>
          </div>
          <div class="cards">
            {
              pillars.map((p) => (
                <a class="card" id={p.id} style={`--c:${p.tone}`} href={p.doc}>
                  <span class="ico">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
                  </span>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                  <span class="learn">{p.more} <span class="arr">→</span></span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <footer class="footer">
        <div class="foot-grid container">
          <div class="foot-brand">
            <div class="row">
              <img src={href('logo-mark.svg')} width="24" height="24" alt="vx" />
              <span class="word">vx</span>
            </div>
            <p>One binary · MIT licensed · no account.</p>
          </div>
          {
            Object.entries(footCols).map(([title, links]) => (
              <div class="foot-col">
                <p class="title">{title}</p>
                <div class="links">
                  {links.map((l) => (
                    <a href={l.h}>{l.t}</a>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
        <div class="foot-bottom container">
          <span>© 2026 vx contributors</span>
          <span>MIT licensed · @vzn/vx</span>
        </div>
      </footer>
    </div>

    <script>
      // The one interaction on the page: the install command copies itself.
      const pill = document.querySelector<HTMLButtonElement>('.install-pill')
      pill?.addEventListener('click', async () => {
        const text = pill.dataset['copy'] ?? ''
        try {
          await navigator.clipboard.writeText(text)
          pill.classList.add('copied')
          setTimeout(() => pill.classList.remove('copied'), 1400)
        } catch {
          // clipboard unavailable: the command is visible to select by hand
        }
      })
    </script>
  </body>
</html>
