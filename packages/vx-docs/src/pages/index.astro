    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>vx — Bend time. Not the rules.</title>
    <meta
      name="description"
      content="The fastest task runner for JavaScript monorepos, in every row: cold, cached, restore and CPU, on a 3,270-task graph and on a real Turbo repo. One binary, sandboxed tasks, a plugin at every stage. No daemon, no cloud, no paywall."
    />
    <link rel="icon" href={href('logo-mark.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap"
    />
    <style is:global>
