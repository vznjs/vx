            features.map((f, i) => (
              <div class="feat-card tilt reveal" style={`--c:${f.tone};--i:${i}`}>
                <span class="ico">
                  <svg
                    width="21"
                    height="21"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={featIcons[f.icon]}
                  />
                </span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
