    <script>
      // The film. Every effect here decorates a page that reads complete
      // without it — the DOM ships whole and the numbers are server-rendered.
      // `prefers-reduced-motion` turns the motion off at the source: pinned
      // scenes render their final frame and nothing scrubs.
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches
      const fine = matchMedia('(hover: hover) and (pointer: fine)').matches
      const clamp01 = (x: number) => Math.min(1, Math.max(0, x))
      const ease = (t: number) => 1 - Math.pow(1 - clamp01(t), 3)
      const fmt = (ms: number) => {
        const s = Math.floor(ms / 1000)
        return `T+${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`
      }

      document.querySelectorAll<HTMLButtonElement>('.install-pill').forEach((pill) => {
        pill.addEventListener('click', () => {
          navigator.clipboard?.writeText(pill.dataset.copy ?? '').catch(() => {})
          pill.classList.add('copied')
          setTimeout(() => pill.classList.remove('copied'), 1400)
        })
      })

      // ---- reveals for the flowing sections ----
      const revealed = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue
            e.target.classList.add('in')
            revealed.unobserve(e.target)
          }
        },
        { rootMargin: '0px 0px -6% 0px', threshold: 0.01 },
      )
      document.querySelectorAll('.reveal').forEach((el) => revealed.observe(el))

      // ---- cards tilt toward the cursor ----
      if (fine && !reduced) {
        document.querySelectorAll<HTMLElement>('.tilt').forEach((card) => {
          card.addEventListener('pointermove', (e) => {
            const r = card.getBoundingClientRect()
            const px = (e.clientX - r.left) / r.width
            const py = (e.clientY - r.top) / r.height
            card.style.setProperty('--mx', `${px * 100}%`)
            card.style.setProperty('--my', `${py * 100}%`)
            card.style.setProperty('--rx', `${(0.5 - py) * 7}deg`)
            card.style.setProperty('--ry', `${(px - 0.5) * 9}deg`)
          })
          card.addEventListener('pointerleave', () => {
            card.style.setProperty('--rx', '0deg')
            card.style.setProperty('--ry', '0deg')
          })
        })
      }

      // ---- the terminal types its command, then its rows land ----
      const term = document.querySelector<HTMLElement>('[data-term]')
      if (term && !reduced) {
        const cmd = term.querySelector<HTMLElement>('.term-prompt .cmd')
        const rows = [...term.querySelectorAll<HTMLElement>('.term-task, .term-rule, .term-row')]
        const text = cmd?.textContent ?? ''
        term.classList.add('playing')
        rows.forEach((r) => r.classList.add('pending'))
        if (cmd) cmd.textContent = ''
        const once = new IntersectionObserver((entries) => {
          if (!entries.some((e) => e.isIntersecting)) return
          once.disconnect()
          let i = 0
          const type = () => {
            if (!cmd) return
            cmd.textContent = text.slice(0, ++i)
            if (i < text.length) setTimeout(type, 34 + Math.random() * 40)
            else {
              rows.forEach((r, k) => setTimeout(() => r.classList.remove('pending'), 260 + k * 70))
              setTimeout(() => term.classList.remove('playing'), 260 + rows.length * 70 + 200)
            }
          }
          setTimeout(type, 400)
        })
        once.observe(term)
      }

      // ---- canvases sized to their stage, at most 2× ----
      const fit = (canvas: HTMLCanvasElement) => {
        const stage = canvas.parentElement!
        const dpr = Math.min(devicePixelRatio || 1, 2)
        const w = stage.clientWidth
        const h = stage.clientHeight
        canvas.width = Math.floor(w * dpr)
        canvas.height = Math.floor(h * dpr)
        canvas.style.width = `${w}px`
        canvas.style.height = `${h}px`
        const ctx = canvas.getContext('2d')!
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0)
        return { ctx, w, h }
      }

      // ---- warp fields (cold open and outro): stars streaming past the camera ----
      type Star = { x: number; y: number; z: number; pz: number; c: string }
      const tints = ['198,248,78', '94,224,255', '255,157,66', '242,245,239']
      const warpFields = [...document.querySelectorAll<HTMLCanvasElement>('canvas.warp')].map((canvas) => {
        let stars: Star[] = []
        let size = fit(canvas)
        const spawn = (anywhere = false): Star => {
          const z = anywhere ? Math.random() * 1 + 0.05 : 1
          return { x: (Math.random() * 2 - 1) * 1.6, y: (Math.random() * 2 - 1) * 1.0, z, pz: z, c: tints[Math.floor(Math.random() * tints.length)]! }
        }
        const reseed = () => {
          size = fit(canvas)
          stars = Array.from({ length: Math.min(700, Math.floor((size.w * size.h) / 2200)) }, () => spawn(true))
        }
        reseed()
        let mx = 0
        let my = 0
        if (fine) {
          canvas.parentElement!.addEventListener('pointermove', (e) => {
            const r = canvas.getBoundingClientRect()
            mx = ((e.clientX - r.left) / r.width - 0.5) * 2
            my = ((e.clientY - r.top) / r.height - 0.5) * 2
          })
        }
        // `speed` in [0, 1]: the open accelerates as you scroll into the page.
        const draw = (speed: number) => {
          const { ctx, w, h } = size
          const cx = w * 0.5 + mx * 30
          const cy = h * 0.46 + my * 20
          const f = Math.min(w, h) * 0.9
          ctx.fillStyle = `rgba(10, 11, 13, ${0.22 + (1 - speed) * 0.4})`
          ctx.fillRect(0, 0, w, h)
          ctx.lineCap = 'round'
          const v = reduced ? 0 : 0.003 + speed * 0.028
          for (const s of stars) {
            s.pz = s.z
            s.z -= v
            if (s.z <= 0.03) {
              Object.assign(s, spawn())
              continue
            }
            const sx = cx + (s.x / s.z) * f
            const sy = cy + (s.y / s.z) * f
            const px = cx + (s.x / s.pz) * f
            const py = cy + (s.y / s.pz) * f
            if (sx < -80 || sx > w + 80 || sy < -80 || sy > h + 80) {
              Object.assign(s, spawn())
              continue
            }
            const depth = 1 - s.z
            ctx.strokeStyle = `rgba(${s.c}, ${0.06 + depth * 0.7})`
            ctx.lineWidth = 0.5 + depth * (1.6 + speed * 2.4)
            ctx.beginPath()
            ctx.moveTo(px, py)
            ctx.lineTo(sx, sy)
            ctx.stroke()
          }
        }
        return { canvas, draw, reseed }
      })

      // ---- the orbit: one lap is the ideal schedule; runners are comets ----
      const clocks = document.querySelector<HTMLElement>('[data-scene="clocks"]')
      const orbit = clocks?.querySelector<HTMLCanvasElement>('canvas.orbit') ?? null
      const laneEls = [...(clocks?.querySelectorAll<HTMLElement>('.ll') ?? [])]
      const clockEl = clocks?.querySelector<HTMLElement>('[data-clock]') ?? null
      const rateEl = clocks?.querySelector<HTMLElement>('[data-rate]') ?? null
      const caps = [...(clocks?.querySelectorAll<HTMLElement>('.cap') ?? [])]
      const lapMs = Number(document.querySelector<HTMLElement>('[data-scene="clocks"]')?.dataset.lap) || 1
      const runnerMs = (clocks?.dataset.runners ?? '0,0,0').split(',').map(Number)
      const runners = [
        { name: 'vx', ms: runnerMs[0] ?? 0, c: '198,248,78' },
        { name: 'turbo', ms: runnerMs[1] ?? 0, c: '255,94,156' },
        { name: 'nx', ms: runnerMs[2] ?? 0, c: '106,168,255' },
      ]
      let orbitSize = orbit ? fit(orbit) : null
      const drawOrbit = (p: number) => {
        if (!orbit || !orbitSize) return
        const { ctx, w, h } = orbitSize
        // Two phases: real time at 60× to just past Turbo's finish, then
        // tenfold compression so Nx's remaining laps fit the scroll.
        const split = 0.62
        const turbo = runners[1]!.ms
        const nx = runners[2]!.ms
        const t = p < split ? (p / split) * (turbo + 12000) : turbo + 12000 + ((p - split) / (1 - split)) * (nx - turbo - 12000 + 1)
        if (clockEl) clockEl.textContent = fmt(Math.min(t, nx))
        if (rateEl) rateEl.textContent = p < split ? '×60' : '×600'
        for (const cap of caps) cap.classList.toggle('on', t >= Number(cap.dataset.at))
        ctx.clearRect(0, 0, w, h)
        const cx = w / 2
        const cy = h / 2
        const R = Math.min(w, h) * 0.34
        ctx.lineWidth = 1
        ctx.strokeStyle = 'rgba(203, 209, 201, 0.14)'
        ctx.beginPath()
        ctx.arc(cx, cy, R, 0, Math.PI * 2)
        ctx.stroke()
        for (let i = 0; i < 60; i++) {
          const a = (i / 60) * Math.PI * 2 - Math.PI / 2
          const long = i % 5 === 0
          ctx.strokeStyle = long ? 'rgba(203, 209, 201, 0.35)' : 'rgba(203, 209, 201, 0.12)'
          ctx.beginPath()
          ctx.moveTo(cx + Math.cos(a) * (R - (long ? 14 : 7)), cy + Math.sin(a) * (R - (long ? 14 : 7)))
          ctx.lineTo(cx + Math.cos(a) * R, cy + Math.sin(a) * R)
          ctx.stroke()
        }
        // The start/finish line at twelve o'clock.
        ctx.strokeStyle = 'rgba(242, 245, 239, 0.6)'
        ctx.lineWidth = 2
        ctx.beginPath()
        ctx.moveTo(cx, cy - R - 22)
        ctx.lineTo(cx, cy - R + 18)
        ctx.stroke()
        runners.forEach((r, k) => {
          const at = Math.min(t, r.ms)
          const laps = at / lapMs
          const a = laps * Math.PI * 2 - Math.PI / 2
          const rr = R - 36 * k
          const done = t >= r.ms
          const tail = done ? 0.35 : Math.min(1.4, 0.35 + Math.min(t, r.ms) / 40000)
          const grad = ctx.createLinearGradient(cx + Math.cos(a - tail) * rr, cy + Math.sin(a - tail) * rr, cx + Math.cos(a) * rr, cy + Math.sin(a) * rr)
          grad.addColorStop(0, `rgba(${r.c}, 0)`)
          grad.addColorStop(1, `rgba(${r.c}, 0.9)`)
          ctx.strokeStyle = grad
          ctx.lineWidth = 10
          ctx.lineCap = 'round'
          ctx.beginPath()
          ctx.arc(cx, cy, rr, a - tail, a)
          ctx.stroke()
          const x = cx + Math.cos(a) * rr
          const y = cy + Math.sin(a) * rr
          const glow = ctx.createRadialGradient(x, y, 0, x, y, done ? 30 : 22)
          glow.addColorStop(0, '#fff')
          glow.addColorStop(0.25, `rgba(${r.c}, 1)`)
          glow.addColorStop(1, `rgba(${r.c}, 0)`)
          ctx.fillStyle = glow
          ctx.beginPath()
          ctx.arc(x, y, done ? 30 : 22, 0, Math.PI * 2)
          ctx.fill()
          laneEls[k]?.classList.toggle('done', done)
        })
      }

      // ---- scale: 3,270 dots lit in one sweep, the counter naming each ----
      const scale = document.querySelector<HTMLElement>('[data-scene="scale"]')
      const gridCanvas = scale?.querySelector<HTMLCanvasElement>('canvas.grid') ?? null
      const countNum = scale?.querySelector<HTMLElement>('[data-count]') ?? null
      let gridSize = gridCanvas ? fit(gridCanvas) : null
      const drawGrid = (p: number) => {
        if (!gridCanvas || !gridSize) return
        const { ctx, w, h } = gridSize
        ctx.clearRect(0, 0, w, h)
        // 3,270 dots fill the stage; the sweep lights them along a diagonal
        // so the wave reads as a front crossing the graph.
        const cols = w > 700 ? 109 : 55
        const rows = Math.ceil(3270 / cols)
        const cw = w / cols
        const ch = h / rows
        const front = ease(p / 0.55) * (cols + rows)
        if (countNum) countNum.textContent = Math.round(Math.min(1, p / 0.55) * 3270).toLocaleString('en-US')
        for (let i = 0; i < 3270; i++) {
          const c = i % cols
          const r = Math.floor(i / cols)
          const x = c * cw + cw / 2
          const y = r * ch + ch / 2
          const d = c + r
          const on = d < front
          const fresh = on && d > front - 4
          ctx.fillStyle = on ? (fresh ? 'rgba(216,255,107,0.9)' : 'rgba(198,248,78,0.3)') : 'rgba(203,209,201,0.07)'
          ctx.beginPath()
          ctx.arc(x, y, on ? (fresh ? 2.6 : 1.9) : 1.2, 0, Math.PI * 2)
          ctx.fill()
        }
      }

      // ---- the scrubber: each pinned scene owns a progress in [0, 1] ----
      const scenes = [...document.querySelectorAll<HTMLElement>('.scene.pin')]
      const progress = document.querySelector<HTMLElement>('.nav .progress')
      let ticking = false
      const render = () => {
        ticking = false
        const max = document.documentElement.scrollHeight - innerHeight
        if (progress) progress.style.width = `${max > 0 ? (scrollY / max) * 100 : 0}%`
        for (const scene of scenes) {
          const r = scene.getBoundingClientRect()
          const span = scene.offsetHeight - innerHeight
          const p = reduced ? 1 : clamp01(span > 0 ? -r.top / span : 1)
          const onScreen = r.bottom > 0 && r.top < innerHeight
          scene.style.setProperty('--p', p.toFixed(4))
          scene.classList.toggle('live', onScreen)
          const kind = scene.dataset.scene
          if (kind === 'clocks' && onScreen) drawOrbit(p)
          if (kind === 'scale' && onScreen) drawGrid(p)
          if (kind === 'none') {
            scene.querySelectorAll<HTMLElement>('.strike').forEach((s, k) => s.classList.toggle('gone', p > 0.1 + k * 0.14))
            scene.classList.toggle('one-in', p > 0.66)
          }
        }
      }
      const onScroll = () => {
        if (ticking) return
        ticking = true
        requestAnimationFrame(render)
      }
      addEventListener('scroll', onScroll, { passive: true })
      addEventListener('resize', () => {
        orbitSize = orbit ? fit(orbit) : null
        gridSize = gridCanvas ? fit(gridCanvas) : null
        warpFields.forEach((f) => f.reseed())
        render()
      })

      // ---- the warp fields run while their scene is on screen ----
      const frame = () => {
        for (const f of warpFields) {
          const scene = f.canvas.closest<HTMLElement>('.scene')!
          if (!scene.classList.contains('live')) continue
          const p = Number(scene.style.getPropertyValue('--p') || 0)
          f.draw(scene.dataset.scene === 'open' ? 0.15 + p * 0.85 : 0.5)
        }
        if (!reduced) requestAnimationFrame(frame)
      }

      // ---- cold open: the command types, then the title rises ----
      const open = document.querySelector<HTMLElement>('[data-scene="open"]')
      const typed = open?.querySelector<HTMLElement>('.typed') ?? null
      if (open && typed && !reduced) {
        const text = typed.dataset.type ?? ''
        let i = 0
        const type = () => {
          typed.textContent = text.slice(0, ++i)
          if (i < text.length) setTimeout(type, 42 + Math.random() * 50)
          else setTimeout(() => open.classList.add('titled'), 320)
        }
        setTimeout(type, 500)
      } else open?.classList.add('titled')

      render()
      if (reduced) warpFields.forEach((f) => f.draw(0.4))
      else requestAnimationFrame(frame)
    </script>
  </body>
</html>
