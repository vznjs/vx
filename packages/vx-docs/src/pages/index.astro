---
// vx landing page — standalone (its own nav, footer and theme; the docs
// stay Starlight), static, one script for the copy button. Every number is
// server-rendered from results.json by packages/vx-bench/update-site.ts:
// the benchRows block and the three stat tiles are the regions it
// rewrites (check.site guards them).
import '../styles/landing.css'

const base = import.meta.env.BASE_URL // '/vx/' on Pages, '/' on a custom domain
const href = (p: string) => `${base}${p}`
const GH = 'https://github.com/vznjs/vx'

// Terminal meters (▰ filled / ▱ empty) — faithful to real `vx run` output.
const meter = (on: number, total = 50) => ({
  on: '▰'.repeat(on),
  off: '▱'.repeat(Math.max(total - on, 0)),
})
const projects = meter(25) // round(1 affected / 2 total · 50)
const tasks = meter(50)
const cache = meter(50)
const dashes = '─'.repeat(80)

// Real `vx run` rows. The id paints as project-hue `@vzn/vx` + dim `#` +
// pink task, exactly like the CLI's identity coloring.
const termTasks = [
  { time: '241ms', proj: '@vzn/vx', task: 'build.bun.darwin-x64' },
  { time: '243ms', proj: '@vzn/vx', task: 'build.bun.linux-arm64' },
  { time: '242ms', proj: '@vzn/vx', task: 'build.bun.darwin-arm64' },
  { time: '245ms', proj: '@vzn/vx', task: 'build.bun.linux-x64' },
]

// Differentiators only — the things Turbo and Nx can't do. Every claim
// traces to README.md / docs (no table-stakes like "affected graph",
// which both competitors already ship).
// Every card is the same card: icon, title, one or two sentences, a link
// to the page that proves it (owner, 2026-09-11: same layout 1:1, every
// point references the docs).
const features = [
  {
    icon: 'bolt',
    tone: 'var(--phosphor)',
    title: 'Fastest in every row',
    body: 'Cold, cached, restore and CPU — on a synthetic 3,270-task graph and on a real Turbo repo, vx is first in every measurement.',
    doc: href('benchmarks/'),
  },
  {
    icon: 'shield',
    tone: 'var(--phosphor)',
    title: 'Sandboxed, per task',
    body: 'An OS-level file and network allow-list per task. An undeclared read or a phone-home fails the build instead of hiding in it.',
    doc: href('guides/sandboxing/'),
  },
  {
    icon: 'plug',
    tone: 'var(--amber)',
    title: 'A plugin at every stage',
    body: 'Project, graph, key, schedule, executor, cache, telemetry, commands: one plugin object fills any of them. Core applies none by default.',
    doc: href('guides/plugins/'),
  },
  {
    icon: 'lock',
    tone: 'var(--plasma)',
    title: 'Open, with no paywall',
    body: 'MIT. Remote cache and execution on open protocols; flaky detection, run history and why-a-miss in the binary, not a tier.',
    doc: href('comparison/'),
  },
  {
    icon: 'cache',
    tone: 'var(--phosphor)',
    title: 'Correct by construction',
    body: 'Content-addressed keys from git, the evaluated config and the lockfile closure. Outputs are owned, so a stale file cannot survive.',
    doc: href('guides/trusting-the-cache/'),
  },
  {
    icon: 'mesh',
    tone: 'var(--plasma)',
    title: 'Compatible with what you have',
    body: 'A Turborepo workspace runs as it is. Migrate from turbo.json or an Nx graph; pnpm, bun, npm and yarn lockfiles are each a plugin.',
    doc: href('migrate/from-turborepo/'),
  },
  {
    icon: 'wire',
    tone: 'var(--amber)',
    title: 'Modular to the core',
    body: 'Core is a pipeline with seams and every module’s index is its contract. Nothing distributed ships in core.',
    doc: href('architecture/'),
  },
  {
    icon: 'box',
    tone: 'var(--plasma)',
    title: 'Tested like infrastructure',
    body: '2,700+ tests, every fix pinned by one that fails without it, and parity suites that run Turborepo’s and Nx’s behaviours under vx.',
    doc: href('parity/'),
  },
  {
    icon: 'graph',
    tone: 'var(--amber)',
    title: 'A cache you can interrogate',
    body: 'vx why names the file, env var or upstream that moved a key. vx last replays any run; vx lock freezes the graph.',
    doc: href('cli/') + '#vx-why',
  },
]

// The pipeline — what plugins can decide. Same card, same shape.
const platform = [
  {
    icon: 'plug',
    tone: 'var(--amber)',
    title: 'Hooks, Vite-style',
    body: 'project() adds tasks, graph() edits edges, key() folds material into the key, schedule() picks what runs next, commands adds verbs.',
    doc: href('guides/plugins/'),
  },
  {
    icon: 'wire',
    tone: 'var(--phosphor)',
    title: 'Nothing applied by default',
    body: 'Core names no plugin. Running here and caching here are the floor; a plugin that declines a task hands it back to this machine.',
    doc: href('guides/extensibility/'),
  },
  {
    icon: 'cloud',
    tone: 'var(--plasma)',
    title: 'Bazel-compatible remote execution',
    body: '@vzn/vx-reapi speaks the Remote Execution API: NativeLink, BuildBuddy, Buildbarn and bazel-remote as a shared cache and as workers.',
    doc: href('guides/remote-execution/'),
  },
  {
    icon: 'cache',
    tone: 'var(--plasma)',
    title: 'Turbo and Nx cache wires',
    body: '@vzn/vx-turbo-cache and @vzn/vx-nx-cache speak the remote caches you already run, self-hosted or hosted.',
    doc: href('guides/remote-caching/'),
  },
  {
    icon: 'spark',
    tone: 'var(--phosphor)',
    title: 'MCP for AI agents',
    body: 'vx mcp is a read-only Model Context Protocol server over stdio: cache stats, run history and rebuild causes for any agent.',
    doc: href('guides/mcp/'),
  },
  {
    icon: 'brain',
    tone: 'var(--amber)',
    title: 'Scheduling that learns',
    body: '@vzn/vx-schedule-history orders ready tasks by the critical path learned from your own run history. A plugin, not a flag.',
    doc: href('guides/plugins/') + '#keys-and-order',
  },
]

// What is not inside. Same card, same shape.
const nots = [
  { icon: 'bolt', tone: 'var(--c-turbo)', title: 'No daemon', body: 'One binary per platform, nothing long-lived. Every run starts clean and finishes.', doc: href('comparison/') },
  { icon: 'cloud', tone: 'var(--c-turbo)', title: 'No cloud, no account', body: 'Nothing phones home. A remote is a plugin you declare, on a protocol you can host.', doc: href('guides/remote-caching/') },
  { icon: 'lock', tone: 'var(--c-turbo)', title: 'No paywall', body: 'MIT, all of it. Every seam a cloud would sit on is a documented hook.', doc: href('comparison/') },
]

const featIcons: Record<string, string> = {
  cache:
    '<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.66 3.58 3 8 3s8-1.34 8-3V6"/><path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/>',
  graph:
    '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="M7.7 7.8L10.5 16M16.3 7.8L13.5 16"/>',
  shield: '<path d="M12 2l8 3v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V5l8-3z"/><path d="M9 12l2 2 4-4"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/>',
  box: '<path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3.5 8l8.5 5 8.5-5M12 13v8"/>',
  lock: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>',
  // Platform icons
  spark: '<path d="M12 2v6M12 16v6M2 12h6M16 12h6M5 5l3 3M16 16l3 3M5 19l3-3M16 8l3-3"/>',
  mesh: '<circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/><circle cx="12" cy="12" r="2"/><path d="M8 7l3 4M16 7l-3 4M11 13l-3 3M13 13l3 3"/>',
  plug: '<path d="M9 2v6M15 2v6M7 8h10v4a5 5 0 01-10 0V8zM12 17v5"/>',
  wire: '<path d="M3 8h6l3 8h6M3 16h6l3-8h6"/>',
  cloud: '<path d="M17.5 19a4.5 4.5 0 100-9 6 6 0 00-11.5 1.5A4.5 4.5 0 006.5 19h11z"/>',
  brain: '<path d="M9 3a3 3 0 00-3 3v1a3 3 0 00-3 3v2a3 3 0 003 3v1a3 3 0 003 3M15 3a3 3 0 013 3v1a3 3 0 013 3v2a3 3 0 01-3 3v1a3 3 0 01-3 3M9 12h6M9 7h6M9 17h6"/>',
}

const benchRows = [
  {
    task: 'Cold build · from scratch',
    bars: [
      { name: 'baseline', val: 218000, disp: '3m 38s', c: 'var(--c-baseline)' },
      { name: 'vx', val: 226450, disp: '3m 46s', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 313463, disp: '5m 13s', c: 'var(--c-turbo)' },
      { name: 'nx', val: 2084171, disp: '34m 44s', c: 'var(--c-nx)' },
    ],
  },
  {
    task: 'Fully cached · nothing to rebuild',
    bars: [
      { name: 'baseline', val: 0, disp: '0', c: 'var(--c-baseline)' },
      { name: 'vx', val: 510, disp: '510ms', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 760, disp: '760ms', c: 'var(--c-turbo)' },
      { name: 'nx', val: 3594, disp: '3.59s', c: 'var(--c-nx)' },
    ],
  },
  {
    task: 'Restoring outputs · cache → disk',
    bars: [
      { name: 'baseline', val: 0, disp: '0', c: 'var(--c-baseline)' },
      { name: 'vx', val: 777, disp: '777ms', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 1174, disp: '1.17s', c: 'var(--c-turbo)' },
      { name: 'nx', val: 4149, disp: '4.15s', c: 'var(--c-nx)' },
    ],
  },
  {
    task: 'CPU burned · cold build, user + system',
    bars: [
      { name: 'baseline', val: 0, disp: '0', c: 'var(--c-baseline)' },
      { name: 'vx', val: 34610, disp: '34.61s', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 73079, disp: '1m 13s', c: 'var(--c-turbo)' },
      { name: 'nx', val: 6846039, disp: '114m 06s', c: 'var(--c-nx)' },
    ],
  },
]

// The race: the cold-build row, played back on real numbers. The track is
// scaled to Turbo's time; Nx runs off the end and keeps going. Overhead
// reads in ONE unit for every runner — clock time over the ideal schedule,
// `+m:ss` — as the generator prints it (owner, 2026-09-10: never a
// percentage for one runner and a multiple for another).
const cold = benchRows[0]!
const raceBar = (name: string) => cold.bars.find((b) => b.name === name)!
const raceBase = raceBar('baseline')
const raceVx = raceBar('vx')
const raceTurbo = raceBar('turbo')
const raceNx = raceBar('nx')
const clock = (ms: number): string => {
  const m = Math.floor(ms / 60_000)
  const sec = Math.round((ms - m * 60_000) / 1000)
  return `${m}:${String(sec).padStart(2, '0')}`
}
const plus = (val: number): string => `+${clock(val - raceBase.val)}`
const PACKAGES = 1090
const perPkg = (val: number): string => Math.round((val - raceBase.val) / PACKAGES).toLocaleString('en-US')
const lanes = [
  { name: 'vx', label: 'vx', bar: raceVx, tone: 'var(--phosphor)' },
  { name: 'turbo', label: 'Turborepo', bar: raceTurbo, tone: 'var(--c-turbo)' },
  { name: 'nx', label: 'Nx', bar: raceNx, tone: 'var(--c-nx)' },
]

// A real Turbo repo (solidjs/solid, its own turbo.json, nothing rewritten)
// in the same panel, the same rows; the tables are in docs/benchmarks.md.
const solidRows = [
  {
    task: 'Cold build · caches and outputs wiped',
    bars: [
      { name: 'vx', val: 40600, disp: '40.6s', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 45500, disp: '45.5s', c: 'var(--c-turbo)' },
    ],
  },
  {
    task: 'Restoring outputs · cache → disk',
    bars: [
      { name: 'vx', val: 66, disp: '66ms', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 127, disp: '127ms', c: 'var(--c-turbo)' },
    ],
  },
  {
    task: 'Fully cached · nothing to rebuild',
    bars: [
      { name: 'vx', val: 51, disp: '51ms', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 95, disp: '95ms', c: 'var(--c-turbo)' },
    ],
  },
]
// The cold row's overhead over the ideal schedule, as one more row of the
// same panel: what each runner adds, so the multiples are of vx's overhead.
const overheadRow = {
  task: 'Runner overhead · cold build over the ideal schedule',
  bars: lanes.map((l) => ({
    name: l.name,
    val: l.bar.val - raceBase.val,
    disp: plus(l.bar.val),
    c: l.tone,
    ...(l.name === 'vx' ? { best: true } : {}),
  })),
}
type Bar = { name: string; val: number; disp: string; c: string; best?: boolean }
/** Every competitor bar reads as a multiple of vx's; vx's own reads "fastest". */
const times = (b: Bar, best: number): string => {
  if (b.name === 'baseline') return ''
  if (b.best) return 'fastest'
  const r = b.val / best
  return r >= 10 ? `${Math.round(r)}× vx` : `${r.toFixed(1)}× vx`
}

const footCols = {
  product: [
    { t: 'Benchmarks', h: href('benchmarks/') },
    { t: 'Quickstart', h: href('quickstart/') },
    { t: 'Architecture', h: href('architecture/') },
    { t: 'Comparison', h: href('comparison/') },
  ],
  docs: [
    { t: 'Quickstart', h: href('quickstart/') },
    { t: 'Config', h: href('schema/') },
    { t: 'CLI reference', h: href('cli/') },
    { t: 'Sandboxing', h: href('guides/sandboxing/') },
    { t: 'Turbo / Nx parity map', h: href('parity/') },
  ],
  migrate: [
    { t: 'From package.json scripts (vx init)', h: href('cli/') + '#vx-init' },
    { t: 'From Turborepo', h: href('migrate/from-turborepo/') },
    { t: 'From Nx', h: href('migrate/from-nx/') },
  ],
  community: [{ t: 'GitHub', h: GH }],
}
