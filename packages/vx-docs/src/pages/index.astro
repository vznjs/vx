---
// vx landing page — standalone (its own nav, footer and theme; the docs
// stay Starlight), static, one script for the copy button. Every number is
// server-rendered from results.json by packages/vx-bench/update-site.ts:
// the benchRows block, the three stat tiles and the two benchmark note
// paragraphs are the regions it rewrites (check.site guards them).
import '../styles/landing.css'

const base = import.meta.env.BASE_URL // '/vx/' on Pages, '/' on a custom domain
const href = (p: string) => `${base}${p}`
const GH = 'https://github.com/vznjs/vx'

// Terminal meters (▰ filled / ▱ empty) — faithful to real `vx run` output.
const meter = (on: number, total = 50) => ({
  on: '▰'.repeat(on),
  off: '▱'.repeat(Math.max(total - on, 0)),
})
const projects = meter(25) // round(1 affected / 2 total · 50)
const tasks = meter(50)
const cache = meter(50)
const dashes = '─'.repeat(80)

// Real `vx run` rows. The id paints as project-hue `@vzn/vx` + dim `#` +
// pink task, exactly like the CLI's identity coloring.
const termTasks = [
  { time: '241ms', proj: '@vzn/vx', task: 'build.bun.darwin-x64' },
  { time: '243ms', proj: '@vzn/vx', task: 'build.bun.linux-arm64' },
  { time: '242ms', proj: '@vzn/vx', task: 'build.bun.darwin-arm64' },
  { time: '245ms', proj: '@vzn/vx', task: 'build.bun.linux-x64' },
]

// Differentiators only — the things Turbo and Nx can't do. Every claim
// traces to README.md / docs (no table-stakes like "affected graph",
// which both competitors already ship).
const features = [
  {
    icon: 'bolt',
    tone: 'var(--phosphor)',
    title: 'Overhead in seconds, at any size',
    body: 'On 1,090 packages and 3,270 tasks, vx adds eight seconds to the cold build — 8 ms per package. Turborepo adds a minute and a half, Nx half an hour. The graph grows; the runner stays in seconds.',
  },
  {
    icon: 'shield',
    tone: 'var(--phosphor)',
    title: 'Sandboxed, per task',
    body: 'exec.sandbox runs a task under an OS-level file and network allow-list — bwrap on Linux, seatbelt on macOS. A read outside the declared inputs or a phone-home fails the build instead of hiding in it. A task proves what it touches; nothing is inferred.',
  },
  {
    icon: 'plug',
    tone: 'var(--amber)',
    title: 'A plugin at every stage',
    body: 'One VxPlugin object: project() gives packages tasks, graph() edits the edges, key() folds material into the key, schedule() picks what runs next, executor and cache decide where, telemetry watches, commands adds verbs. Core applies none by default.',
  },
  {
    icon: 'lock',
    tone: 'var(--plasma)',
    title: 'Open, with no paywall behind it',
    body: 'MIT. Remote cache and remote execution are plugins on open protocols — Bazel’s Remote Execution API, Turborepo’s and Nx’s own cache wires — so a NativeLink, a bazel-remote or your own server is the “cloud”. Flaky-task detection, run history, why-a-miss: in the binary, not a tier.',
  },
  {
    icon: 'cache',
    tone: 'var(--phosphor)',
    title: 'Correct by construction',
    body: 'Keys are content-addressed: git blob ids for clean files, the evaluated config object (imports and presets included), the project’s own dependency closure from the lockfile, upstream input keys folded through the graph. Declared outputs are wiped before every run and restore, so a stale file cannot survive.',
  },
  {
    icon: 'mesh',
    tone: 'var(--plasma)',
    title: 'Compatible with what you have',
    body: 'A Turborepo workspace runs as it is through @vzn/vx-turbo; @vzn/vx-migrate writes vx.config.ts from turbo.json or an Nx graph; pnpm, bun, npm and yarn lockfiles are each a plugin; Turbo and Nx remote caches are wires you can keep.',
  },
  {
    icon: 'wire',
    tone: 'var(--amber)',
    title: 'Modular to the core',
    body: 'Core is a pipeline with seams — config, project, graph, key, schedule, executor, cache, telemetry, commands — and every module’s index.ts is its contract, enforced by tests. Nothing distributed ships in core; the seams exist so someone can build it on top.',
  },
  {
    icon: 'box',
    tone: 'var(--plasma)',
    title: 'Tested like infrastructure',
    body: '2,700+ tests across core and the plugins, every fix pinned with a test that fails without it, parity suites that run Turborepo’s and Nx’s behaviours under vx, and cache correctness treated as the worst failure class: a stale hit is a bug before anything else is.',
  },
  {
    icon: 'graph',
    tone: 'var(--amber)',
    title: 'A cache you can interrogate',
    body: 'vx why names the exact file, env var or upstream that moved a task’s key instead of “miss”; vx last replays any run; vx lock freezes the resolved graph so --frozen runs exactly that. Every key component is recorded at save time, so the answer is exact.',
  },
]

// The pipeline — what plugins can decide. Every claim traces to
// docs/design/pipeline-2026-09.md and the plugin guide.
const platform = [
  {
    icon: 'plug',
    tone: 'var(--amber)',
    title: 'A pipeline with a hook at every stage',
    body: 'One VxPlugin object, Vite-style: project() adds or rewrites a package’s tasks (keyed exactly like yours), graph() edits the edges, key() folds extra material into the cache key, schedule() decides which ready task runs first, commands adds verbs to vx. Declaration order is the order; core re-validates what a stage produced.',
  },
  {
    icon: 'wire',
    tone: 'var(--phosphor)',
    title: 'Nothing applied by default',
    body: 'Core is only the pipeline — fully offline, no account, no service, and it names no plugin. Where a task runs (executor), where artifacts live (cache) and where run records go (telemetry) are plugins you declare in vx.workspace.ts; running here and caching here are the floor under them, so a workspace with no plugins runs, and a plugin that declines a task hands it back to this machine.',
  },
  {
    icon: 'cloud',
    tone: 'var(--plasma)',
    title: 'Bazel-compatible remote cache and execution',
    body: '@vzn/vx-reapi speaks the Bazel Remote Execution API: NativeLink, BuildBuddy, Buildbarn and bazel-remote work as a shared cache, and NativeLink’s workers run your tasks remotely — the executor seam, filled by a plugin, with nothing distributed shipped in core.',
  },
  {
    icon: 'spark',
    tone: 'var(--phosphor)',
    title: 'MCP for AI agents',
    body: '@vzn/vx-mcp adds vx mcp: a read-only Model Context Protocol server over stdio, so Claude Code, Cursor and Continue.dev query cache stats, run history and rebuild causes through the standard agent-tool protocol. No SDK, no service — a plugin on the commands seam.',
  },
  {
    icon: 'brain',
    tone: 'var(--amber)',
    title: 'Scheduling that learns — as a plugin',
    body: '@vzn/vx-schedule-history orders ready tasks by the expected remaining critical path learned from your own run history. It is the reference schedule() plugin, its own package: a policy core exposes a hook for, not a flag core carries — core ships no plugin at all.',
  },
]

const featIcons: Record<string, string> = {
  cache:
    '<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.66 3.58 3 8 3s8-1.34 8-3V6"/><path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3"/>',
  graph:
    '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="M7.7 7.8L10.5 16M16.3 7.8L13.5 16"/>',
  shield: '<path d="M12 2l8 3v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V5l8-3z"/><path d="M9 12l2 2 4-4"/>',
  bolt: '<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/>',
  box: '<path d="M21 8l-9-5-9 5v8l9 5 9-5V8z"/><path d="M3.5 8l8.5 5 8.5-5M12 13v8"/>',
  lock: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>',
  // Platform icons
  spark: '<path d="M12 2v6M12 16v6M2 12h6M16 12h6M5 5l3 3M16 16l3 3M5 19l3-3M16 8l3-3"/>',
  mesh: '<circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/><circle cx="12" cy="12" r="2"/><path d="M8 7l3 4M16 7l-3 4M11 13l-3 3M13 13l3 3"/>',
  plug: '<path d="M9 2v6M15 2v6M7 8h10v4a5 5 0 01-10 0V8zM12 17v5"/>',
  wire: '<path d="M3 8h6l3 8h6M3 16h6l3-8h6"/>',
  cloud: '<path d="M17.5 19a4.5 4.5 0 100-9 6 6 0 00-11.5 1.5A4.5 4.5 0 006.5 19h11z"/>',
  brain: '<path d="M9 3a3 3 0 00-3 3v1a3 3 0 00-3 3v2a3 3 0 003 3v1a3 3 0 003 3M15 3a3 3 0 013 3v1a3 3 0 013 3v2a3 3 0 01-3 3v1a3 3 0 01-3 3M9 12h6M9 7h6M9 17h6"/>',
}

const benchRows = [
  {
    task: 'Cold build · from scratch',
    bars: [
      { name: 'baseline', val: 218000, disp: '3m 38s', c: 'var(--c-baseline)' },
      { name: 'vx', val: 226450, disp: '3m 46s', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 313463, disp: '5m 13s', c: 'var(--c-turbo)' },
      { name: 'nx', val: 2084171, disp: '34m 44s', c: 'var(--c-nx)' },
    ],
  },
  {
    task: 'Fully cached · nothing to rebuild',
    bars: [
      { name: 'baseline', val: 0, disp: '0', c: 'var(--c-baseline)' },
      { name: 'vx', val: 510, disp: '510ms', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 760, disp: '760ms', c: 'var(--c-turbo)' },
      { name: 'nx', val: 3594, disp: '3.59s', c: 'var(--c-nx)' },
    ],
  },
  {
    task: 'Restoring outputs · cache → disk',
    bars: [
      { name: 'baseline', val: 0, disp: '0', c: 'var(--c-baseline)' },
      { name: 'vx', val: 777, disp: '777ms', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 1174, disp: '1.17s', c: 'var(--c-turbo)' },
      { name: 'nx', val: 4149, disp: '4.15s', c: 'var(--c-nx)' },
    ],
  },
  {
    task: 'CPU burned · cold build, user + system',
    bars: [
      { name: 'baseline', val: 0, disp: '0', c: 'var(--c-baseline)' },
      { name: 'vx', val: 34610, disp: '34.61s', c: 'var(--phosphor)', best: true },
      { name: 'turbo', val: 73079, disp: '1m 13s', c: 'var(--c-turbo)' },
      { name: 'nx', val: 6846039, disp: '114m 06s', c: 'var(--c-nx)' },
    ],
  },
]

// The race: the cold-build row, played back on real numbers. The track is
// scaled to Turbo's time; Nx runs off the end and keeps going. Overhead
// reads in ONE unit for every runner — clock time over the ideal schedule,
// `+m:ss` — as the generator prints it (owner, 2026-09-10: never a
// percentage for one runner and a multiple for another).
const cold = benchRows[0]!
const raceBar = (name: string) => cold.bars.find((b) => b.name === name)!
const raceBase = raceBar('baseline')
const raceVx = raceBar('vx')
const raceTurbo = raceBar('turbo')
const raceNx = raceBar('nx')
const clock = (ms: number): string => {
  const m = Math.floor(ms / 60_000)
  const sec = Math.round((ms - m * 60_000) / 1000)
  return `${m}:${String(sec).padStart(2, '0')}`
}
const plus = (val: number): string => `+${clock(val - raceBase.val)}`
const PACKAGES = 1090
const perPkg = (val: number): string => Math.round((val - raceBase.val) / PACKAGES).toLocaleString('en-US')
const lanes = [
  { name: 'vx', label: 'vx', bar: raceVx, tone: 'var(--phosphor)' },
  { name: 'turbo', label: 'Turborepo', bar: raceTurbo, tone: 'var(--c-turbo)' },
  { name: 'nx', label: 'Nx', bar: raceNx, tone: 'var(--c-nx)' },
]

const footCols = {
  product: [
    { t: 'Benchmarks', h: href('benchmarks/') },
    { t: 'Quickstart', h: href('quickstart/') },
    { t: 'Architecture', h: href('architecture/') },
    { t: 'Comparison', h: href('comparison/') },
  ],
  docs: [
    { t: 'Quickstart', h: href('quickstart/') },
    { t: 'Config', h: href('schema/') },
    { t: 'CLI reference', h: href('cli/') },
    { t: 'Sandboxing', h: href('guides/sandboxing/') },
    { t: 'Turbo / Nx parity map', h: href('parity/') },
  ],
  migrate: [
    { t: 'From package.json scripts (vx init)', h: href('cli/') + '#vx-init' },
    { t: 'From Turborepo', h: href('migrate/from-turborepo/') },
    { t: 'From Nx', h: href('migrate/from-nx/') },
  ],
  community: [{ t: 'GitHub', h: GH }],
}
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>vx — Bend time. Not the rules.</title>
    <meta
      name="description"
      content="vx runs, sandboxes and caches a JavaScript monorepo's task graph from one binary and adds eight seconds of overhead to a 3,270-task cold build where Turborepo adds a minute and a half and Nx half an hour. No daemon, no cloud, no account, no paywall. Every seam is a documented plugin hook."
    />
    <link rel="icon" href={href('logo-mark.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap"
    />
    <style is:global>
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class="vx-landing">
      <header class="nav">
        <div class="nav-left">
          <a class="brand" href={base}>
            <img src={href('logo-mark.svg')} width="26" height="26" alt="vx" />
            <span class="word">vx</span>
          </a>
          <nav class="nav-links">
            <a href={href('quickstart/')}>docs</a>
            <a href={href('benchmarks/')}>benchmarks</a>
            <a href={href('migrate/from-turborepo/')}>migrate</a>
            <a href={href('blog/')}>blog</a>
          </nav>
        </div>
        <div class="nav-right">
          <a class="btn-github" href={GH}>
            <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"
              ><path
                d="M8 0C3.58 0 0 3.58 0 8a8 8 0 005.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.49-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.81.06 1.24.83 1.24.83.71 1.23 1.87.87 2.33.67.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.01.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 014 0c1.53-1.03 2.2-.82 2.2-.82.44 1.11.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            >
            GitHub
          </a>
          <a class="btn btn-primary btn-sm" href={href('quickstart/')}
            >Get started <span class="arr">→</span></a
          >
        </div>
      </header>

      <!-- ===================== Hero ===================== -->
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="vx-kicker">// a task runner and cache for JavaScript monorepos</p>
            <h1>Seconds of overhead.<br /><span class="phosphor">Not minutes.</span></h1>
            <p class="lede">
              vx runs, sandboxes and caches your task graph from one binary. On 1,090 packages and
              3,270 tasks it adds eight seconds to a cold build; Turborepo adds a minute and a half,
              Nx half an hour. No daemon, no cloud, no account, no paywall.
            </p>
            <div class="actions">
              <a class="btn btn-primary btn-lg" href={href('quickstart/')}
                >Get started <span class="arr">→</span></a
              >
              <button class="install-pill" data-copy="npm install -g @vzn/vx" type="button">
                <span class="dollar">$</span>
                <span class="cmd">npm install -g @vzn/vx</span>
                <span class="copy">
                  <svg class="icon-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                    ><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 012-2h10"></path></svg
                  >
                  <svg class="icon-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"></path></svg>
                </span>
              </button>
            </div>
          </div>
          <div class="hero-aside">
            <div class="term">
            <div class="term-bar-top">
              <span class="tdot" style="background:#ff5f57"></span>
              <span class="tdot" style="background:#febc2e"></span>
              <span class="tdot" style="background:#28c840"></span>
              <span class="ttitle">zsh — vx</span>
            </div>
            <div class="term-body">
              <div class="term-prompt">
                <span class="caret">❯ </span><span class="cmd">vx run build --affected</span>
              </div>
              {
                termTasks.map((t) => (
                  <div class="term-task">
                    <span class="glyph">⏺ </span>
                    <span class="time">{t.time}</span>
                    <span class="ok">success</span>
                    <span class="cache">miss</span>
                    <span class="target">
                      <span class="t-proj">{t.proj}</span><span class="t-dim">#</span><span
                        class="t-pink">{t.task}</span
                      >
                    </span>
                  </div>
                ))
              }
              <div class="term-gap"></div>
              <div class="term-rule">
                <span class="t-dim">─ </span><span class="mark">vx 0.0.0</span><span class="t-dim"
                  > </span
                ><span class="fill">{dashes}</span>
              </div>
              <div style="height:4px"></div>
              <div class="term-row">
                <span class="lbl">projects</span>
                <span class="v"
                  ><span class="term-meter"
                    ><span class="t-yellow">{projects.on}</span><span class="off"
                      >{projects.off}</span
                    ></span
                  ></span
                >
              </div>
              <div class="term-row">
                <span class="lbl"></span><span class="v"
                  ><span class="t-yellow">1 affected</span><span class="t-dim"> · 2 total</span></span
                >
              </div>
              <div style="height:6px"></div>
              <div class="term-row">
                <span class="lbl">tasks</span>
                <span class="v"
                  ><span class="term-meter"
                    ><span class="t-green">{tasks.on}</span><span class="off">{tasks.off}</span></span
                  ></span
                >
              </div>
              <div class="term-row">
                <span class="lbl"></span><span class="v"
                  ><span class="t-green">4 success</span><span class="t-dim"> · 4 total</span></span
                >
              </div>
              <div style="height:6px"></div>
              <div class="term-row">
                <span class="lbl">cache</span>
                <span class="v"
                  ><span class="term-meter"
                    ><span class="t-red">{cache.on}</span><span class="off">{cache.off}</span></span
                  ></span
                >
              </div>
              <div class="term-row">
                <span class="lbl"></span><span class="v"><span class="t-red">4 miss</span></span>
              </div>
              <div class="term-gap"></div>
              <div class="term-row">
                <span class="lbl">info</span><span class="v t-dim">10 workers · local cache</span>
              </div>
              <div class="term-row">
                <span class="lbl">time</span>
                <span class="v"
                  ><span class="term-time">252ms</span><span class="term-time-rest"
                    > · max 245ms · avg 243ms · min 241ms</span
                  ></span
                >
              </div>
            </div>
          </div>
          </div>
        </div>
      </section>

      <!-- ===================== Overhead ===================== -->
      <section class="section overhead" id="overhead">
        <div class="container">
          <div class="section-head">
            <p class="vx-kicker">// one cold build · 3,270 tasks · 1,090 packages · the same commands, the same concurrency</p>
            <h2>Your tasks are the floor.<br />Everything above it is the runner.</h2>
            <p class="sub">
              The tasks alone take {raceBase.disp} on an ideal schedule. What each runner adds on top,
              in one unit:
            </p>
          </div>
          <div class="overhead-chart" aria-label="Runner overhead over the ideal schedule">
            {
              lanes.map((l) => {
                const extra = l.bar.val - raceBase.val
                const turboExtra = raceTurbo.val - raceBase.val
                const clipped = extra > turboExtra * 2.4
                const w = clipped ? 100 : (extra / (turboExtra * 1.08)) * 100
                return (
                  <div class={`bench-bar${l.name === 'vx' ? ' best' : ''}${clipped ? ' clipped' : ''}`} style={`--c:${l.tone};--w:${w.toFixed(1)}%`}>
                    <span class="name">{l.label}</span>
                    <span class="track"><span class="fill" /></span>
                    <span class="disp">{plus(l.bar.val)}</span>
                    <span class="ratio">{perPkg(l.bar.val)} ms / pkg</span>
                  </div>
                )
              })
            }
          </div>
          <div class="stats">
            <div class="stat">
              <span class="val"><span class="num">8</span><span class="unit">ms</span></span>
              <span class="label">per package · vx</span>
              <span class="sub">+0:08 on 1,090 packages</span>
            </div>
            <div class="stat turbo">
              <span class="val"><span class="num">88</span><span class="unit">ms</span></span>
              <span class="label">per package · Turborepo</span>
              <span class="sub">+1:35 on 1,090 packages</span>
            </div>
            <div class="stat nx">
              <span class="val"><span class="num">1,712</span><span class="unit">ms</span></span>
              <span class="label">per package · Nx</span>
              <span class="sub">+31:06 on 1,090 packages</span>
            </div>
          </div>
          <p class="foot-note">
            Grow the graph and the runner grows with it in milliseconds per package — and stays in
            seconds where the others go to minutes. The full tables, the CPU and warm rows, and how
            the overhead scales from 100 to 1,000 packages are in the
            <a href={href('benchmarks/')}>benchmarks</a>.
          </p>
        </div>
      </section>

      <!-- ===================== Open ===================== -->
      <section class="section open">
        <div class="container open-grid">
          <div>
            <p class="vx-kicker">// what is not inside</p>
            <h2>Open. All of it.</h2>
            <p class="sub">
              MIT, one binary for Linux and macOS. Remote cache and remote execution speak open
              protocols — Bazel's Remote Execution API, Turborepo's and Nx's own cache wires — and
              every seam a cloud would sit on is a documented hook you can fill yourself.
            </p>
          </div>
          <ul class="nots">
            <li><span class="x">✕</span> No daemon</li>
            <li><span class="x">✕</span> No cloud</li>
            <li><span class="x">✕</span> No account</li>
            <li><span class="x">✕</span> No paywall</li>
          </ul>
        </div>
      </section>

      <!-- ===================== What sets it apart ===================== -->
      <section class="section only">
        <div class="container">
          <div class="section-head">
