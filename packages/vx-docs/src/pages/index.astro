      <!-- ===================== The pipeline ===================== -->
      <section class="section machine">
        <div class="container">
          <div class="section-head">
            <p class="vx-kicker">// built to be built on</p>
            <h2>A pipeline with a seam at every stage.</h2>
            <p class="sub">
              Core is the pipeline and nothing else. Plugins fill a stage; core applies none by
              default and names none — running here and caching here are the floor.
            </p>
          </div>
          <div class="rail" aria-hidden="true">
            {
              ['config', 'project', 'graph', 'key', 'fingerprint', 'schedule', 'executor', 'cache', 'telemetry', 'commands'].map((s) => (
                <span class="node">{s}</span>
              ))
            }
          </div>
          <div class="cards">
            {
              platform.map((f) => (
                <a
                  class="card"
                  style={`--c:${f.tone}`}
                  href={
                    f.icon === 'spark'
                      ? href('guides/mcp/')
                      : f.icon === 'plug'
                        ? href('guides/plugins/')
                        : f.icon === 'wire'
                          ? href('guides/extensibility/')
                          : f.icon === 'cloud'
                            ? href('guides/remote-caching/')
                            : href('guides/plugins/') + '#keys-and-order'
                  }
                >
                  <span class="ico">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={featIcons[f.icon]} />
                  </span>
