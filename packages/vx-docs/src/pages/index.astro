---
// vx landing page (owner, 2026-10-02: vx is its own tool; Turbo and Nx
// only through migration): the hero, the benchmark table and why it is
// faster, how to start, then the one diagram with its six callouts and the four pillars.
// Standalone (its own nav, footer and theme), static, one script for the
// copy button. The benchTable and benchFormula blocks and the graph's size in the #bench
// kicker are written by packages/vx-bench/update-site.ts from results.json
// (check.site guards them). tests/landing.test.ts holds the rest.
import Diagram from '../components/guide/diagram/Diagram.astro'
import { CALLOUTS, oneRun } from '../components/landing/one-run.js'
import '../styles/landing.css'

const base = import.meta.env.BASE_URL // '/vx/' on Pages, '/' on a custom domain
const href = (p: string) => `${base}${p}`
const GH = 'https://github.com/vznjs/vx'
const TITLE = 'vx — the fastest task runner for JS monorepos'
const DESCRIPTION =
  'Seconds of overhead where Turborepo and Nx add minutes, each measured in its own native config. MIT, no account.'
// Absolute, as a link preview fetches it from wherever the link was pasted.
const siteUrl = new URL(base, Astro.site).href

/** A callout's line, each backticked span as code. */
const codeHtml = (s: string): string => s.replace(/`([^`]+)`/g, '<code>$1</code>')

// One card per pillar: an icon, a title, one sentence of at most fifteen
// words, and the Docs page that says the rest.
const pillars = [
  {
    id: 'correct',
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>',
    tone: 'var(--vx-ok)',
    title: 'Correctness',
    body: 'A task’s cache key covers every file, setting and env var it declares.',
    more: 'Caching in depth',
    doc: href('caching/'),
  },
  {
    id: 'sandboxed',
    icon: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/>',
    tone: 'var(--vx-link)',
    title: 'Sandbox',
    body: 'A sandboxed task cannot read a workspace file it did not declare.',
    more: 'Sandboxing',
    doc: href('guides/sandboxing/'),
  },
  {
    id: 'extensible',
    icon: '<path d="M9 2v6M15 2v6M6 8h12v4a6 6 0 01-12 0V8zM12 18v4"/>',
    tone: 'var(--vx-accent)',
    title: 'Extensibility',
    body: 'Plugins decide where tasks run, where the cache lives and who watches.',
    more: 'Writing a plugin',
    doc: href('guides/plugins/'),
  },
  {
    id: 'free',
    icon: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 019.9-1"/>',
    tone: 'var(--vx-warn)',
    title: 'Freedom',
    body: 'MIT, no paywall, no cloud, no account.',
    more: 'Migrate',
    doc: href('guides/migrate/'),
  },
]

const benchTable = [
  { label: 'Cold build: time the runner adds', vx: '9 s', turbo: '1 min 35 s (vx 91% faster)', nx: '31 min (vx 99% faster)' },
  { label: 'Cold build: CPU burned', vx: '34 s', turbo: '1 min 13 s (vx 53% faster)', nx: '114 min (vx 99% faster)' },
  { label: 'Fully cached run', vx: '476 ms', turbo: '760 ms (vx 37% faster)', nx: '3.59 s (vx 86% faster)' },
  { label: 'Overhead per package', vx: '8 ms', turbo: '88 ms (vx 91% faster)', nx: '1,712 ms (vx 99% faster)' },
]
const benchFormula = 'vx N% faster: vx takes N% less time than that tool (1 − vx ÷ theirs); N% slower: N% more (vx ÷ theirs − 1).'
const benchNote = "Nx's column ran every task through npm run (~200 ms of CPU each; Turbo ran bun run), a harness fault since fixed; with bun, on a 4-core Linux box, Nx took 6m 59s cold and 4.50 s fully cached (vx 47% and 92% faster)."

/** A competitor cell's value and its "(vx N% faster)", shown on two lines. */
const vsOf = (c: string): [string, string] => {
  const at = c.indexOf(' (')
  return [c.slice(0, at), c.slice(at + 1)]
}

// Why it is faster: three reasons, one short sentence each.
const reasons = [
  { term: 'Nothing boots per task.', line: 'No daemon, no Node process per task: vx spawns your command.' },
  { term: 'Hashing without reading.', line: 'On a clean tree, cache keys come from git’s index.' },
  { term: 'One pass over the repo.', line: 'One git walk per run; each stat and lookup happens once.' },
]

// Start: four commands, native config from the first one.
const startCommands = `npm install -D @vzn/vx
npx vx init                 # a vx.config.ts per package, from its scripts
npx vx run build --all      # builds in dependency order; stores the results
npx vx run build --all      # again: up-to-date in milliseconds`

const footCols = {
  docs: [
    { t: 'Quickstart', h: href('quickstart/') },
    { t: 'Configure', h: href('guides/configure/') },
    { t: 'Sandboxing', h: href('guides/sandboxing/') },
    { t: 'CI and remote', h: href('guides/ci/') },
    { t: 'Migrate', h: href('guides/migrate/') },
    { t: 'Plugins', h: href('guides/plugins/') },
    { t: 'Try it', h: href('playground/') },
  ],
  reference: [
    { t: 'CLI', h: href('cli/') },
    { t: 'Config', h: href('schema/') },
    { t: 'Benchmarks', h: href('benchmarks/') },
    { t: 'vx, Turborepo, Nx, Bazel', h: href('compare/') },
    { t: 'Turbo / Nx parity map', h: href('parity/') },
    { t: 'Glossary', h: href('glossary/') },
  ],
  community: [
    { t: 'GitHub', h: GH },
    { t: 'Blog', h: href('blog/') },
  ],
}
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{TITLE}</title>
    <meta name="description" content={DESCRIPTION} />
    <link rel="canonical" href={siteUrl} />
    <link rel="sitemap" href={href('sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={TITLE} />
    <meta property="og:description" content={DESCRIPTION} />
    <meta property="og:image" content={`${siteUrl}og.png`} />
    <meta property="og:image:alt" content="vx: the fastest task runner for JS monorepos" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href={href('logo-mark.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap"
    />
    <style is:global>
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
      }
    </style>
  </head>
  <body>
    <div class="vx-landing">
      <header class="nav">
        <div class="nav-left">
          <a class="brand" href={base}>
            <img src={href('logo-mark.svg')} width="26" height="26" alt="vx" />
            <span class="word">vx</span>
          </a>
          <nav class="nav-links">
            <a href={href('quickstart/')}>docs</a>
            <a href={href('cli/')}>reference</a>
            <a href={href('blog/')}>blog</a>
          </nav>
        </div>
        <div class="nav-right">
          <a class="btn-github" href={GH}>
            <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"
              ><path
                d="M8 0C3.58 0 0 3.58 0 8a8 8 0 005.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.49-2.7-1.07-2.7-1.07-.36-.93-.89-1.18-.89-1.18-.73-.5.05-.49.05-.49.81.06 1.24.83 1.24.83.71 1.23 1.87.87 2.33.67.07-.52.28-.87.5-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.01.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 014 0c1.53-1.03 2.2-.82 2.2-.82.44 1.11.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0016 8c0-4.42-3.58-8-8-8z"
              ></path></svg
            >
            GitHub
          </a>
        </div>
      </header>

      <section class="hero">
        <div class="container">
          <h1>The <span class="phosphor">fastest</span> task runner for JS monorepos.</h1>
          <p class="lede">Measured against Turborepo and Nx, each in its own native config.</p>
          <div class="actions">
            <button class="install-pill" data-copy="npm install -g @vzn/vx" type="button">
              <span class="dollar">$</span>
              <span class="cmd">npm install -g @vzn/vx</span>
              <span class="copy">
                <svg class="icon-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                  ><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V5a2 2 0 012-2h10"></path></svg
                >
                <svg class="icon-check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20 6L9 17l-5-5"></path></svg>
              </span>
            </button>
          </div>
          <div class="actions">
            <a class="btn btn-primary btn-lg" href={href('quickstart/')}
              >Quickstart <span class="arr">→</span></a
            >
            <a class="btn btn-ghost btn-lg" href={GH}>GitHub</a>
          </div>
          <img
            class="demo"
            src={href('demo.svg')}
            width="760"
            alt="vx run ci --all on the starter: cold, three tasks run; again, three up-to-date."
          />
        </div>
      </section>

      <section class="section" id="bench">
        <div class="container">
          <div class="section-head">
            <p class="vx-kicker">// 3,270 tasks · 1,090 packages · 100 layers · identical commands, identical concurrency</p>
            <h2>Seconds of overhead where others add minutes.</h2>
          </div>
          <div class="bench-panel">
            <table class="bench-table">
              <thead>
                <tr>
                  <th scope="col"></th>
                  <th scope="col" class="vx">vx</th>
                  <th scope="col">Turborepo</th>
                  <th scope="col">Nx</th>
                </tr>
              </thead>
              <tbody>
                {
                  benchTable.map((r) => (
                    <tr>
                      <th scope="row">{r.label}</th>
                      <td class="vx">{r.vx}</td>
                      {[r.turbo, r.nx].map((c) => (
                        <td>
                          {vsOf(c)[0]}
                          <span class="vs">{vsOf(c)[1]}</span>
                        </td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <p class="bench-formula">{benchFormula}</p>
            <p class="bench-formula">{benchNote}</p>
          </div>
          <ul class="reasons">
            {
              reasons.map((r) => (
                <li>
                  <strong>{r.term}</strong> {r.line}
                </li>
              ))
            }
          </ul>
          <div class="section-links">
            <a class="section-link" href={href('benchmarks/')}>Benchmarks: tables, methodology, reproduce it <span class="arr">→</span></a>
            <a class="section-link" href={href('compare/')}>When another tool is the better pick <span class="arr">→</span></a>
          </div>
        </div>
      </section>

      <section class="section" id="try">
        <div class="container">
          <div class="section-head">
            <p class="vx-kicker">// four commands</p>
            <h2>Start in a minute.</h2>
          </div>
          <pre class="code"><code>{startCommands}</code></pre>
          <p class="sub">Coming from Turbo or Nx: <code>vx init</code> gives a temporary start, and <code>bunx @vzn/vx-migrate</code> writes the native vx config (its first publish is pending).</p>
          <div class="section-links">
            <a class="section-link" href={href('quickstart/')}>Quickstart: a cache block, the first hit <span class="arr">→</span></a>
            <a class="section-link" href={href('guides/migrate/')}>Migrate from Turbo or Nx <span class="arr">→</span></a>
          </div>
        </div>
      </section>

      <section class="section" id="one-run">
        <div class="container">
          <div class="section-head">
            <p class="vx-kicker">// one run, after you edit app</p>
            <h2>Everything vx does, in one picture.</h2>
          </div>
          <div class="one-run">
            <Diagram {...oneRun} />
            <ol class="callouts">
              {
                CALLOUTS.map((c, i) => (
                  <li id={c.id}>
                    <span class="n">{i + 1}</span>
                    <span>
                      <strong>{c.term}</strong> <Fragment set:html={codeHtml(c.line)} />
                    </span>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <section class="section" id="pillars">
        <div class="container">
          <div class="section-head">
            <p class="vx-kicker">// what you can count on</p>
            <h2>Correct. Sandboxed. Extensible. Free.</h2>
          </div>
          <div class="cards">
            {
              pillars.map((p) => (
                <a class="card" id={p.id} style={`--c:${p.tone}`} href={p.doc}>
                  <span class="ico">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={p.icon} />
                  </span>
                  <h3>{p.title}</h3>
                  <p>{p.body}</p>
                  <span class="learn">{p.more} <span class="arr">→</span></span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <footer class="footer">
        <div class="foot-grid container">
          <div class="foot-brand">
            <div class="row">
              <img src={href('logo-mark.svg')} width="24" height="24" alt="vx" />
              <span class="word">vx</span>
            </div>
            <p>One binary · MIT licensed · no account.</p>
          </div>
          {
            Object.entries(footCols).map(([title, links]) => (
              <div class="foot-col">
                <p class="title">{title}</p>
                <div class="links">
                  {links.map((l) => (
                    <a href={l.h}>{l.t}</a>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
        <div class="foot-bottom container">
          <span>© 2026 vx contributors</span>
          <span>MIT licensed · @vzn/vx</span>
        </div>
      </footer>
    </div>

    <script>
      // The one interaction on the page: the install command copies itself.
      const pill = document.querySelector<HTMLButtonElement>('.install-pill')
      pill?.addEventListener('click', async () => {
        const text = pill.dataset['copy'] ?? ''
        try {
          await navigator.clipboard.writeText(text)
          pill.classList.add('copied')
          setTimeout(() => pill.classList.remove('copied'), 1400)
        } catch {
          // clipboard unavailable: the command is visible to select by hand
        }
      })
    </script>
  </body>
</html>
