---
// One benchmark row: runner name · relative-length bar · value label.
//
// The BAR width is the runner's time relative to the slowest in the group
// (slowest = full width), so every row shows its real magnitude up front — a
// faint "ghost" of the full length. A progress fill then sweeps INSIDE that
// bar from 0 to 100% over `dur` seconds.
//
// Because `dur` is proportional to the bar's length (see BenchChart) the fill
// FRONT advances at the same speed on every row — one shared timeline. So the
// rows race: vx's short bar fills and stops while Turbo/Nx keep grinding past
// the point where vx already finished. The value reveals the instant its row
// completes. CSS owns the final fixed state, so it stays legible without JS.
interface Props {
  name: string
  value: string
  pct: number
  dur: number
  hero?: boolean
}
const { name, value, pct, dur, hero = false } = Astro.props
const style = `--pct:${pct}%;--dur:${dur}s`
---

<div class:list={['lane', { hero }]} style={style}>
  <span class="name">{name}</span>
  <div class="track">
    <div class="bar"><span class="prog"></span></div>
  </div>
  <span class="value">{value}</span>
</div>

<style>
  .lane {
    display: grid;
    grid-template-columns: 5rem 1fr 4.6rem;
    align-items: center;
    gap: 0.75rem;
  }
  .name {
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
  }
  .hero .name {
    color: var(--sl-color-white);
  }
  .value {
    font-family: ui-monospace, 'SFMono-Regular', 'Cascadia Code', monospace;
    font-variant-numeric: tabular-nums;
    font-size: 0.85rem;
    text-align: right;
    white-space: nowrap;
    color: var(--sl-color-gray-3);
  }
  .hero .value {
    color: var(--vx-pink);
    font-weight: 700;
  }

  /* The track is the shared measuring space; the bar's width is this runner's
     time relative to the slowest (the visible "fixed" length). */
  .track {
    width: 100%;
  }
  .bar {
    position: relative;
    width: var(--pct);
    min-width: 3px;
    height: 0.7rem;
    border-radius: 999px;
    overflow: hidden;
    /* faint ghost showing the full relative length before it fills */
    background: color-mix(in srgb, var(--sl-color-gray-4) 24%, transparent);
  }
  .hero .bar {
    background: color-mix(in srgb, var(--vx-violet) 18%, transparent);
    box-shadow: 0 0 14px color-mix(in srgb, var(--vx-pink) 45%, transparent);
  }

  /* The realtime progress fill, sweeping inside the bar. */
  .prog {
    position: absolute;
    inset: 0 auto 0 0;
    width: 100%;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-gray-2) 68%, transparent);
  }
  .hero .prog {
    background: var(--vx-grad);
  }
  /* bright leading edge — the moving "now" front */
  .prog::after {
    content: '';
    position: absolute;
    inset: 0 0 0 auto;
    width: 0.9rem;
    border-radius: 999px;
    opacity: 0;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, #fff 75%, transparent));
  }
  .hero .prog::after {
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--vx-pink) 95%, transparent));
  }

  /* JS-ready: collapse the fill to the start line, waiting to run.
     Without JS (or reduced motion) the defaults render the final state. */
  :global(.chart.ready) .prog {
    width: 0;
  }
  :global(.chart.ready) .value {
    opacity: 0;
  }

  /* Running: sweep the fill, the edge glow, then reveal the value on finish. */
  :global(.chart.run) .prog {
    animation: grow var(--dur) linear both;
  }
  :global(.chart.run) .prog::after {
    animation: edge var(--dur) linear both;
  }
  :global(.chart.run) .value {
    animation: reveal 0.3s ease both;
    animation-delay: var(--dur);
  }

  @keyframes grow {
    from {
      width: 0;
    }
    to {
      width: 100%;
    }
  }
  @keyframes edge {
    0% {
      opacity: 0;
    }
    8%,
    72% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateX(-0.25rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 30rem) {
    .lane {
      grid-template-columns: 3.6rem 1fr 3.6rem;
      gap: 0.5rem;
    }
    .name,
    .value {
      font-size: 0.78rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.chart.ready) .prog {
      width: 100%;
    }
    :global(.chart.ready) .value {
      opacity: 1;
    }
    :global(.chart.run) .prog,
    :global(.chart.run) .prog::after,
    :global(.chart.run) .value {
      animation: none;
    }
  }
</style>
