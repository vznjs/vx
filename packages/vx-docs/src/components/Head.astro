---
import Default from '@astrojs/starlight/components/Head.astro'
---

<Default><slot /></Default>

<script>
  // Self-hosted, lazy mermaid rendering. mermaid is only fetched on pages
  // that actually contain a <pre class="mermaid"> block (dynamic import =
  // its own chunk), and re-renders when Starlight toggles the theme.
  const sources = new WeakMap<Element, string>()

  async function renderMermaid() {
    const blocks = Array.from(
      document.querySelectorAll<HTMLElement>('pre.mermaid'),
    )
    if (blocks.length === 0) return

    const { default: mermaid } = await import('mermaid')
    const dark = document.documentElement.dataset.theme === 'dark'

    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'loose',
      theme: dark ? 'dark' : 'neutral',
      fontFamily: 'inherit',
    })

    for (const el of blocks) {
      if (!sources.has(el)) sources.set(el, el.textContent ?? '')
      el.removeAttribute('data-processed')
      // Restore the raw definition as TEXT, not innerHTML — the source can
      // contain `<br/>` in labels, and innerHTML would parse those into real
      // <br> elements, corrupting the definition mermaid reads (→ "Syntax
      // error"). textContent keeps `<br/>` literal so mermaid renders it.
      el.textContent = sources.get(el) ?? ''
    }

    await mermaid.run({ nodes: blocks })
  }

  renderMermaid()
  // Re-render after Starlight's view-transition navigations.
  document.addEventListener('astro:after-swap', renderMermaid)

  // Re-render on light/dark toggle so diagram colors track the theme.
  const observer = new MutationObserver((records) => {
    if (records.some((r) => r.attributeName === 'data-theme')) renderMermaid()
  })
  observer.observe(document.documentElement, { attributes: true })
</script>

<script>
  // The self-hosting setup generator. Mounts into `#vx-setup` (only the
  // cloud/setup page has one, so every other page pays a single failed
  // querySelector). It writes a COMPLETE docker-compose.yml with the secret
  // already generated — nobody should ever be told "now provide a key".
  //
  // The secret is generated in YOUR browser with crypto.getRandomValues and
  // never leaves it: this page is static, there is no backend to send it to.
  interface Field {
    id: string
    label: string
    value: string
    hint?: string
  }

  const hex = (bytes: number): string =>
    Array.from(crypto.getRandomValues(new Uint8Array(bytes)))
      .map((b) => b.toString(16).padStart(2, '0'))
      .join('')

  function composeFor(mode: 'local' | 'prod', f: Record<string, string>): string {
    const local = mode === 'local'
    const head = `# vx-cloud — generated by the setup generator.
# Save as docker-compose.yml, then:  docker compose up
services:
  app:
    image: ghcr.io/vznjs/vx-cloud:latest
    ports: ['4321:4321']
    environment:
      DATABASE_URL: '${local ? 'postgres://vx:vx@postgres:5432/vx' : f['db']}'
      VX_CLOUD_SECRET: '${f['secret']}'
      VX_CLOUD_BASE_URL: '${local ? 'http://localhost:4321' : f['baseUrl']}'
      VX_CLOUD_S3_ENDPOINT: '${local ? 'http://minio:9000' : f['s3Endpoint']}'
      VX_CLOUD_S3_BUCKET: '${local ? 'vx-artifacts' : f['s3Bucket']}'
      VX_CLOUD_S3_ACCESS_KEY_ID: '${local ? 'vxminio' : f['s3Key']}'
      VX_CLOUD_S3_SECRET_ACCESS_KEY: '${local ? 'vxminiosecret' : f['s3Secret']}'
    restart: unless-stopped`
    if (!local) return `${head}\n`
    return `${head}
    depends_on:
      postgres: { condition: service_healthy }
      createbucket: { condition: service_completed_successfully }

  postgres:
    image: postgres:16-alpine
    environment:
      POSTGRES_USER: vx
      POSTGRES_PASSWORD: vx
      POSTGRES_DB: vx
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -U vx']
      interval: 2s
      timeout: 3s
      retries: 30
    volumes: ['pgdata:/var/lib/postgresql/data']

  minio:
    image: minio/minio:latest
    command: server /data
    environment:
      MINIO_ROOT_USER: vxminio
      MINIO_ROOT_PASSWORD: vxminiosecret
    healthcheck:
      test: ['CMD', 'mc', 'ready', 'local']
      interval: 2s
      timeout: 3s
      retries: 30
    volumes: ['miniodata:/data']

  createbucket:
    image: minio/mc:latest
    depends_on:
      minio: { condition: service_healthy }
    entrypoint: >
      /bin/sh -c "mc alias set local http://minio:9000 vxminio vxminiosecret &&
                  mc mb --ignore-existing local/vx-artifacts"

volumes:
  pgdata:
  miniodata:
`
  }

  function mountSetup() {
    const root = document.querySelector<HTMLElement>('#vx-setup')
    if (root === null) return

    let mode: 'local' | 'prod' = 'local'
    const fields: Field[] = [
      { id: 'secret', label: 'Session secret', value: hex(32), hint: 'generated here, never sent anywhere' },
      { id: 'baseUrl', label: 'Public URL', value: 'https://vx.example.com' },
      { id: 'db', label: 'DATABASE_URL', value: 'postgres://user:pass@host:5432/vx' },
      { id: 's3Endpoint', label: 'S3 endpoint', value: 'https://<account>.r2.cloudflarestorage.com' },
      { id: 's3Bucket', label: 'S3 bucket', value: 'vx-artifacts' },
      { id: 's3Key', label: 'S3 access key id', value: '' },
      { id: 's3Secret', label: 'S3 secret access key', value: '' },
    ]
    const val = (): Record<string, string> =>
      Object.fromEntries(fields.map((f) => [f.id, f.value]))

    root.innerHTML = `
      <div class="vxg">
        <div class="vxg-modes" role="tablist">
          <button type="button" data-mode="local" class="vxg-mode is-on">Try it locally</button>
          <button type="button" data-mode="prod" class="vxg-mode">Production</button>
        </div>
        <div class="vxg-fields"></div>
        <div class="vxg-out">
          <div class="vxg-bar">
            <span>docker-compose.yml</span>
            <button type="button" class="vxg-copy" data-what="yaml">Copy</button>
          </div>
          <pre class="vxg-pre"><code></code></pre>
        </div>
        <div class="vxg-out">
          <div class="vxg-bar">
            <span>then run</span>
            <button type="button" class="vxg-copy" data-what="cmd">Copy</button>
          </div>
          <pre class="vxg-pre"><code class="vxg-cmd"></code></pre>
        </div>
      </div>`

    const fieldsEl = root.querySelector<HTMLElement>('.vxg-fields')!
    const codeEl = root.querySelector<HTMLElement>('.vxg-pre code')!
    const cmdEl = root.querySelector<HTMLElement>('.vxg-cmd')!

    const render = () => {
      const shown = mode === 'local' ? fields.slice(0, 1) : fields
      fieldsEl.innerHTML = shown
        .map(
          (f) => `<label class="vxg-field">
            <span>${f.label}${f.hint !== undefined ? ` <em>— ${f.hint}</em>` : ''}</span>
            <span class="vxg-input">
              <input data-id="${f.id}" value="${f.value.replace(/"/g, '&quot;')}" spellcheck="false" />
              ${f.id === 'secret' ? '<button type="button" class="vxg-regen" title="Generate a new secret">↻</button>' : ''}
            </span>
          </label>`,
        )
        .join('')
      codeEl.textContent = composeFor(mode, val())
      cmdEl.textContent = 'docker compose up'
    }

    root.addEventListener('input', (e) => {
      const el = e.target as HTMLInputElement
      const f = fields.find((x) => x.id === el.dataset['id'])
      if (f === undefined) return
      f.value = el.value
      codeEl.textContent = composeFor(mode, val())
    })

    root.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest('button')
      if (el === null) return
      if (el.classList.contains('vxg-mode')) {
        mode = el.dataset['mode'] === 'prod' ? 'prod' : 'local'
        for (const b of root.querySelectorAll('.vxg-mode')) {
          b.classList.toggle('is-on', b === el)
        }
        render()
      } else if (el.classList.contains('vxg-regen')) {
        fields[0]!.value = hex(32)
        render()
      } else if (el.classList.contains('vxg-copy')) {
        const text = el.dataset['what'] === 'cmd' ? cmdEl.textContent : codeEl.textContent
        void navigator.clipboard.writeText(text ?? '').then(() => {
          const was = el.textContent
          el.textContent = 'Copied'
          setTimeout(() => {
            el.textContent = was
          }, 1200)
        })
      }
    })

    render()
  }

  mountSetup()
  document.addEventListener('astro:after-swap', mountSetup)
</script>

<style is:global>
  .vxg-modes {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .vxg-mode {
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    font-size: var(--sl-text-sm);
  }
  .vxg-mode.is-on {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-white);
  }
  .vxg-field {
    display: block;
    margin-bottom: 0.75rem;
    font-size: var(--sl-text-sm);
  }
  .vxg-field > span:first-child {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--sl-color-gray-2);
  }
  .vxg-field em {
    color: var(--sl-color-gray-3);
    font-style: normal;
  }
  .vxg-input {
    display: flex;
    gap: 0.4rem;
  }
  .vxg-input input {
    flex: 1;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
  }
  .vxg-regen {
    padding: 0 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .vxg-out {
    margin-top: 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
  }
  .vxg-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0.75rem;
    background: var(--sl-color-gray-6);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }
  .vxg-copy {
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    background: transparent;
    color: var(--sl-color-gray-2);
    cursor: pointer;
    font-size: var(--sl-text-xs);
  }
  .vxg-pre {
    margin: 0;
    padding: 0.75rem;
    max-height: 26rem;
    overflow: auto;
    background: var(--sl-color-black);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
  }
</style>
