---
// The toy monorepo's task graph, drawn in waves. Without JavaScript it is a
// diagram, a caption that states the waves, and a table of what each change
// selects; `graph-explorer.ts` unhides the package buttons and lights up the
// run a change starts. The element reads the `data-task` / `data-pkg`,
// `data-from` / `data-to`, `.controls` and `.status` hooks below, so they are
// its contract with this markup.
import Demo from '../Demo.astro'
import {
  TOY_PACKAGES,
  TOY_TASKS,
  joinNames,
  neededBy,
  orderSentence,
  rerunBy,
  waveOf,
  waves,
} from './model/toy-monorepo.js'

const NODE = { w: 100, h: 40 }
const ROW = 80
const WIDTH = 460
const centerY = (wave: number): number => wave * ROW - 40
// Three columns, each `test` under its `build`, so that no edge crosses a
// node; the wave (the row) comes from the model.
const centerX: Record<string, number> = {
  'utils#build': 270,
  'utils#test': 270,
  'ui#build': 140,
  'ui#test': 140,
  'api#build': 400,
  'api#test': 400,
  'app#build': 270,
  'app#test': 270,
}
const at = (id: string) => ({ x: centerX[id]!, y: centerY(waveOf(id)) })
const edges = TOY_TASKS.flatMap((t) => t.dependsOn.map((d) => ({ from: d, to: t.id })))
const allWaves = waves()
const height = allWaves.length * ROW + 10

const wavesSentence = allWaves
  .map((w, i) => `wave ${i + 1} is ${joinNames(w)}`)
  .join('; ')
const rows = TOY_PACKAGES.map((p) => ({
  pkg: p.id,
  rerun: rerunBy(p.id),
  needed: neededBy(p.id),
  order: orderSentence(rerunBy(p.id)),
}))
---

<Demo name="graph-explorer">
  <div class="controls" hidden>
    <span class="label">Change a package:</span>
    {
      TOY_PACKAGES.map((p) => (
        <button type="button" data-pkg={p.id} aria-pressed="false">
          {p.id}
        </button>
      ))
    }
    <button type="button" class="clear" disabled>Clear</button>
  </div>
  <svg
    viewBox={`0 0 ${WIDTH} ${height}`}
    role="img"
    aria-label={`Task graph of the toy monorepo in ${allWaves.length} waves: ${wavesSentence}.`}
  >
    <defs>
      <marker
        id="vx-ge-arrow"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path class="arrow" d="M0 0 L10 5 L0 10 z"></path>
      </marker>
      <marker
        id="vx-ge-arrow-on"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path class="arrow on" d="M0 0 L10 5 L0 10 z"></path>
      </marker>
    </defs>
    {
      allWaves.map((_, i) => (
        <text class="wave" x="4" y={centerY(i + 1) + 4}>
          wave {i + 1}
        </text>
      ))
    }
    {
      edges.map((e) => (
        <line
          class="edge"
          data-from={e.from}
          data-to={e.to}
          x1={at(e.from).x}
          y1={at(e.from).y + NODE.h / 2}
          x2={at(e.to).x}
          y2={at(e.to).y - NODE.h / 2 - 2}
        />
      ))
    }
    {
      TOY_TASKS.map((t) => (
        <g
          class="node"
          data-task={t.id}
          data-pkg={t.pkg}
          data-wave={waveOf(t.id)}
          transform={`translate(${at(t.id).x - NODE.w / 2} ${at(t.id).y - NODE.h / 2})`}
        >
          <rect width={NODE.w} height={NODE.h} rx="8" />
          <text class="name" x={NODE.w / 2} y="18">
            {t.pkg}
          </text>
          <text class="task" x={NODE.w / 2} y="32">
            {t.name}
          </text>
        </g>
      ))
    }
  </svg>
  <p class="status" aria-live="polite" hidden></p>
  <table>
    <thead>
      <tr>
        <th scope="col">You change</th>
        <th scope="col">
          <code>--affected</code> runs
        </th>
        <th scope="col">Needed first, from the cache</th>
        <th scope="col">In this order</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr data-pkg={r.pkg}>
            <th scope="row">{r.pkg}</th>
            <td data-label="Runs">{joinNames(r.rerun)}</td>
            <td data-label="Needed first">
              {r.needed.length === 0 ? 'nothing' : joinNames(r.needed)}
            </td>
            <td data-label="Order">{r.order}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <Fragment slot="caption">
    The build and test tasks of a four-package monorepo. An arrow goes from a task to a task that
    needs it, so the first must finish before the second starts. Tasks in the same wave do not need
    each other and can run at the same time: {wavesSentence}. The table says what a change to each
    package makes <code>vx run build test --affected</code> run.
  </Fragment>
</Demo>

<style>
  svg {
    display: block;
    width: 100%;
    max-width: 30rem;
    height: auto;
    margin: 0 auto;
  }
  .edge {
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
    marker-end: url(#vx-ge-arrow);
  }
  .edge.is-on {
    stroke: var(--sl-color-accent);
    stroke-width: 2.5;
    marker-end: url(#vx-ge-arrow-on);
  }
  .arrow {
    fill: var(--sl-color-gray-4);
  }
  .arrow.on {
    fill: var(--sl-color-accent);
  }
  rect {
    fill: var(--sl-color-gray-6);
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
  }
  text {
    text-anchor: middle;
  }
  .wave {
    text-anchor: start;
    font-size: 12px;
    fill: var(--sl-color-gray-3);
  }
  .name {
    font-size: 15px;
    font-weight: 700;
    fill: var(--sl-color-white);
  }
  .task {
    font-size: 12px;
    fill: var(--sl-color-gray-3);
  }
  .node.is-rerun rect {
    fill: var(--sl-color-accent-low);
    stroke: var(--sl-color-accent);
    stroke-width: 2.5;
  }
  .node.is-needed rect {
    stroke: var(--sl-color-accent);
    stroke-dasharray: 5 3;
  }
  .node.is-idle,
  .edge.is-idle {
    opacity: 0.35;
  }
  .node[data-pkg] {
    cursor: pointer;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .controls[hidden] {
    display: none;
  }
  .controls button {
    padding: 0.2rem 0.75rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 999px;
    background: transparent;
    color: var(--sl-color-white);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  .controls button[aria-pressed='true'] {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
  }
  .controls button:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .controls button:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .label {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .status {
    min-height: 1.5em;
    margin: 0.5rem 0 0;
    font-size: var(--sl-text-sm);
  }
  table {
    margin-top: 1rem;
    font-size: var(--sl-text-sm);
  }
  tr.is-selected {
    background: var(--sl-color-accent-low);
  }
  /* Four columns of task lists do not fit a phone: one block per change. */
  @media (max-width: 40rem) {
    table,
    tbody,
    tr,
    th,
    td {
      display: block;
    }
    thead {
      display: none;
    }
    tr {
      padding-block: 0.5rem;
      border-bottom: 1px solid var(--sl-color-gray-5);
    }
    th,
    td {
      border: none;
      padding-block: 0.1rem;
    }
    th[scope='row']::before {
      content: 'You change ';
      font-weight: 400;
    }
    td::before {
      content: attr(data-label) ': ';
      font-weight: 600;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    rect,
    .edge,
    .node {
      transition:
        fill 0.15s ease,
        stroke 0.15s ease,
        opacity 0.15s ease;
    }
  }
</style>
