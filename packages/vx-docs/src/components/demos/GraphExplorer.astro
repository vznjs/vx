---
// The toy monorepo's task graph, drawn in waves with the Guide's own kit
// (`DiagramSvg.astro`), so it is one of the pictures. Without JavaScript it
// is the drawing and a table of what a change to each package runs;
// `graph-explorer.ts` unhides one button per package and recolours the
// drawing for the run a change starts. The element reads the boxes'
// `data-task` / `data-pkg`, the arrows' `data-from` / `data-to`, `.controls`,
// `.status` and `.static`, so they are its contract with this markup.
import Demo from '../Demo.astro'
import DiagramSvg from '../guide/diagram/DiagramSvg.astro'
import { narrowOf, type Picture } from '../guide/diagram/diagram.js'
import {
  TOY_PACKAGES,
  TOY_TASKS,
  affectedBy,
  joinNames,
  neededBy,
  waveOf,
  waves,
} from './model/toy-monorepo.js'

const BOX = { w: 120, h: 60 }
const ROW = 84
const rowY = (wave: number): number => 16 + (wave - 1) * ROW
// Three columns, each `test` under its `build`, so that no arrow crosses a
// box; the wave (the row) comes from the model.
const column: Record<string, number> = { ui: 200, utils: 340, app: 340, api: 480 }
// On a phone: the same three columns, narrower, with each wave's name
// above its row rather than beside it, so the drawing fits 340 across.
const PHONE = { w: 100, row: 90 }
const phoneColumn: Record<string, number> = { ui: 70, utils: 180, app: 180, api: 290 }
const phoneRowY = (wave: number): number => 34 + (wave - 1) * PHONE.row
const allWaves = waves()
const wavesSentence = allWaves.map((w, i) => `wave ${i + 1} is ${joinNames(w)}`).join('; ')

const picture: Picture = {
  name: 'graph-explorer',
  label: `Task graph of the toy monorepo in ${allWaves.length} waves: ${wavesSentence}.`,
  caption: '',
  height: rowY(allWaves.length) + BOX.h + 16,
  boxes: TOY_TASKS.map((t) => ({
    id: t.id,
    x: column[t.pkg]! - BOX.w / 2,
    y: rowY(waveOf(t.id)),
    w: BOX.w,
    label: t.pkg,
    sub: t.name,
    data: { task: t.id, pkg: t.pkg, wave: String(waveOf(t.id)) },
  })),
  arrows: TOY_TASKS.flatMap((t) => t.dependsOn.map((d) => ({ from: d, to: t.id }))),
  notes: allWaves.map((_, i) => ({
    x: 30,
    y: rowY(i + 1) + BOX.h / 2 + 5,
    text: `wave ${i + 1}`,
    anchor: 'start' as const,
  })),
  narrow: {
    width: 340,
    height: phoneRowY(allWaves.length) + BOX.h + 16,
    boxes: TOY_TASKS.map((t) => ({
      id: t.id,
      x: phoneColumn[t.pkg]! - PHONE.w / 2,
      y: phoneRowY(waveOf(t.id)),
      w: PHONE.w,
      label: t.pkg,
      sub: t.name,
      data: { task: t.id, pkg: t.pkg, wave: String(waveOf(t.id)) },
    })),
    arrows: TOY_TASKS.flatMap((t) => t.dependsOn.map((d) => ({ from: d, to: t.id }))),
    notes: allWaves.map((_, i) => ({
      x: 10,
      y: phoneRowY(i + 1) - 8,
      text: `wave ${i + 1}`,
      anchor: 'start' as const,
    })),
  },
}
const phone = narrowOf(picture)!
const rows = TOY_PACKAGES.map((p) => ({
  pkg: p.id,
  affected: affectedBy(p.id),
  needed: neededBy(p.id),
}))
---

<Demo name="graph-explorer">
  <div class="controls vx-row" hidden>
    <span class="vx-label">Change</span>
    {
      TOY_PACKAGES.map((p) => (
        <button type="button" data-pkg={p.id} aria-pressed="false">
          {p.id}
        </button>
      ))
    }
  </div>
  <div class="vx-diagram inset not-content">
    <DiagramSvg {...picture} live layout="wide" /><DiagramSvg {...phone} live layout="narrow" />
  </div>
  <p class="status vx-say" aria-live="polite" hidden></p>
  <table class="static">
    <thead>
      <tr>
        <th scope="col">Change</th>
        <th scope="col">Build + test again</th>
        <th scope="col">From the cache</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr data-pkg={r.pkg}>
            <th scope="row">{r.pkg}</th>
            <td>{joinNames(r.affected)}</td>
            <td>{r.needed.length === 0 ? 'nothing' : joinNames(r.needed)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <Fragment slot="caption">
    An arrow points to the task that waits. Tasks in one row run at the same time.
  </Fragment>
</Demo>

<style>
  .static[hidden] {
    display: none;
  }
  .vx-diagram :global([data-task]) {
    cursor: pointer;
  }
  @media (prefers-reduced-motion: no-preference) {
    .vx-diagram :global(:is(rect, path, text)) {
      transition:
        fill 0.15s ease,
        stroke 0.15s ease;
    }
  }
</style>
