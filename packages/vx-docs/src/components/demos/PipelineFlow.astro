---
// The pipeline as a Mermaid flowchart, generated from the model so it names
// the same stages as the explorer. The markup is what `remark-mermaid.mjs`
// makes of a fence, so `Head.astro` renders it the same way.
import { pipelineMermaid, pipelineSentence } from './model/pipeline.js'
---

<pre class="mermaid" role="img" aria-label={pipelineSentence()}>{pipelineMermaid()}</pre>
