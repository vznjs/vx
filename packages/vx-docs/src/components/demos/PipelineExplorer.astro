---
// The pipeline explorer. Without JavaScript it is the strip (each stage a
// link to its section), one section per stage with the hook's declaration,
// its first-party plugins and an example plugin, and a table of what core
// does and what a plugin decides at each stage. `pipeline-explorer.ts`
// turns the strip's links into toggle buttons, shows one section at a time
// and hides the table, whose sentence for the chosen stage it says instead.
// The `a[data-hook]`, `section[data-hook]`, `.overview` and `.status` hooks
// below are the element's contract with this markup.
//
// The declarations are read from core's source at build time and the
// examples from `src/examples/stages/`, so neither is a copy.
import { Code } from '@astrojs/starlight/components'
// Vite's `?raw` query: the default export is the file's text, which the
// import plugin cannot see.
// oxlint-disable-next-line import/default
import pluginSource from '../../../../vx/src/orchestrator/plugin.ts?raw'
import Demo from '../Demo.astro'
import PipelineStrip from './PipelineStrip.astro'
import { STAGES, hookSignatures, stageExample } from './model/pipeline.js'

const examples = import.meta.glob<string>('../../examples/stages/*.ts', {
  query: '?raw',
  import: 'default',
  eager: true,
})
const signatures = hookSignatures(pluginSource)
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/')
const stages = STAGES.map((s, i) => {
  const signature = signatures.get(s.hook)
  if (signature === undefined) throw new Error(`VxPlugin in plugin.ts declares no ${s.hook}`)
  const file = stageExample(s.hook)
  const example = examples[`../../examples/${file}`]
  if (example === undefined) throw new Error(`no src/examples/${file}`)
  return { ...s, n: i + 1, signature, file, example }
})
---

<Demo name="pipeline-explorer">
  <PipelineStrip label="The pipeline's stages. Each leads to its hook and an example." />
  <p class="status vx-say" aria-live="polite" hidden></p>
  {
    stages.map((s) => (
      <section
        class="stage"
        id={`vx-stage-${s.hook}`}
        data-hook={s.hook}
        aria-labelledby={`vx-stage-${s.hook}-title`}
      >
        <h3 id={`vx-stage-${s.hook}-title`}>
          Stage {s.n} of {stages.length}: <code>{s.hook}</code>
        </h3>
        <Code code={s.signature} lang="ts" />
        <p class="first-party">
          First-party:{' '}
          {s.firstParty.length === 0
            ? 'none yet.'
            : s.firstParty.map((p, i) => (
                <>
                  {i > 0 && (i === s.firstParty.length - 1 ? ' and ' : ', ')}
                  <a href={`${base}${p.href}`}>
                    <code>{p.call}</code> from <code>{p.pkg}</code>
                  </a>
                </>
              ))}
        </p>
        <Code code={s.example} lang="ts" title={`packages/vx-docs/src/examples/${s.file}`} />
      </section>
    ))
  }
  <table class="overview">
    <thead>
      <tr>
        <th scope="col">Stage</th>
        <th scope="col">Core, alone</th>
        <th scope="col">A plugin</th>
      </tr>
    </thead>
    <tbody>
      {
        stages.map((s) => (
          <tr data-hook={s.hook}>
            <th scope="row">{s.hook}</th>
            <td>{s.core}</td>
            <td>{s.plugin}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <Fragment slot="caption">
    The {stages.length} stages a plugin can fill, in core's order. Pick one to see its hook and a
    plugin.
  </Fragment>
</Demo>

<style>
  .stage {
    margin-top: 1.25rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--vx-border);
  }
  .stage[hidden],
  .overview[hidden] {
    display: none;
  }
  h3 {
    margin: 0 0 0.5rem;
    font-family: var(--vx-mono);
    font-size: 15px;
  }
  .stage > :global(* + *) {
    margin-top: 0.75rem;
  }
  /* Past widget.css's paragraph rule, which the scoped one above loses to. */
  .stage .first-party {
    margin: 0.75rem 0;
    font-size: 0.95rem;
    color: var(--vx-muted);
  }
  .overview {
    margin-top: 1.5rem;
  }
  .overview td {
    font-family: var(--vx-font-body);
  }
</style>
