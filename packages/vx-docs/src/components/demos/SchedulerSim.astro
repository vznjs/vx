---
// The scheduler simulator. Without JavaScript it is two Gantt charts of the
// default graph on two workers (vx with no plugin, and with the history
// plugin), the bound no order can beat, the finish time on one to four
// workers, and the tasks' times, folded away. `scheduler-sim.ts` unhides the
// controls, hides the finish table, and redraws the rest through the same
// model functions. It reads the `.controls`, `[data-slot]`, `.gantt`,
// `.policy`, `.note`, `.done`, `.bounds`, `.status`, `.finish`,
// `[data-task-row]`, `.js-only` and `.dur` hooks below, so they are its
// contract with this markup.
import Demo from '../Demo.astro'
import {
  DEFAULT_PAIR,
  DEFAULT_WORKERS,
  MAX_SECONDS,
  MAX_WORKERS,
  POLICIES,
  POLICY_NAME,
  POLICY_NOTE,
  SIM_TASKS,
  boundsSentence,
  criticalPath,
  finishTable,
  ganttSvg,
  lowerBound,
  schedule,
  secs,
} from './model/scheduler-sim.js'

const none = new Set<string>()
const critical = new Set(criticalPath(SIM_TASKS).chain)
const charts = DEFAULT_PAIR.map((p) => schedule(SIM_TASKS, none, p, DEFAULT_WORKERS))
const span = Math.max(...charts.map((c) => c.makespan))
const bound = lowerBound(SIM_TASKS, DEFAULT_WORKERS)
const rows = finishTable(SIM_TASKS, none)
---

<Demo name="scheduler-sim">
  <div class="controls vx-row" hidden>
    <label>
      <span class="vx-label">workers</span>
      <select name="workers">
        {
          Array.from({ length: MAX_WORKERS }, (_, i) => (
            <option value={i + 1} selected={i + 1 === DEFAULT_WORKERS}>
              {i + 1}
            </option>
          ))
        }
      </select>
    </label>
    {
      DEFAULT_PAIR.map((chosen, slot) => (
        <select name="policy" data-slot={slot} aria-label={slot === 0 ? 'First chart' : 'Second chart'}>
          {POLICIES.map((p) => (
            <option value={p} selected={p === chosen}>
              {POLICY_NAME[p]}
            </option>
          ))}
        </select>
      ))
    }
    <button type="button" class="reset">Reset</button>
  </div>
  {
    charts.map((c, slot) => (
      <div class="chart" data-slot={slot}>
        <p class="chart-title"><strong class="policy">{POLICY_NAME[c.policy]}</strong> (<span class="note">{POLICY_NOTE[c.policy]}</span>): <span class="done">{secs(c.makespan)}</span></p>
        <div class="gantt" tabindex="0" set:html={ganttSvg(c, span, bound, none, critical)} />
      </div>
    ))
  }
  <p class="bounds">{boundsSentence(SIM_TASKS, DEFAULT_WORKERS)}</p>
  <p class="status vx-say" aria-live="polite" hidden></p>
  <table class="finish">
    <caption>Done at, by workers</caption>
    <thead>
      <tr>
        <th scope="col">Workers</th>
        <th scope="col">No order beats</th>
        {DEFAULT_PAIR.map((p) => <th scope="col">{POLICY_NAME[p]}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        rows.map((r) => (
          <tr data-workers={r.workers} class={r.workers === DEFAULT_WORKERS ? 'is-selected' : ''}>
            <th scope="row">{r.workers}</th>
            <td>{secs(r.bound)}</td>
            {DEFAULT_PAIR.map((p) => <td>{secs(r.makespans[p])}</td>)}
          </tr>
        ))
      }
    </tbody>
  </table>
  <details class="times">
    <summary>Task times</summary>
    <table class="tasks">
      <thead>
        <tr>
          <th scope="col">Task</th>
          <th scope="col">Waits for</th>
          <th scope="col">Takes</th>
          <th scope="col" class="js-only" hidden>No history</th>
        </tr>
      </thead>
      <tbody>
        {
          SIM_TASKS.map((t) => (
            <tr data-task-row={t.id}>
              <th scope="row">{t.id}</th>
              <td>{t.deps.length === 0 ? 'nothing' : t.deps.join(', ')}</td>
              <td>
                <span class="dur">{secs(t.dur)}</span>
                <input
                  class="js-only"
                  type="number"
                  min="1"
                  max={MAX_SECONDS}
                  step="1"
                  value={t.dur / 1000}
                  aria-label={`${t.id} takes, in seconds`}
                  hidden
                />
              </td>
              <td class="js-only" hidden>
                <input type="checkbox" aria-label={`${t.id} has no history`} />
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
  <Fragment slot="caption">
    One bar per task, one lane per worker. Lime: the longest chain. Dashed line: no order beats it.
  </Fragment>
</Demo>

<style>
  .chart {
    margin-bottom: 0.75rem;
  }
  .chart-title {
    margin: 0 0 0.25rem;
    font-family: var(--vx-mono);
    font-size: 13px;
  }
  .note {
    color: var(--vx-muted);
  }
  .done {
    color: var(--vx-fg);
    font-weight: 700;
  }
  /* Each chart is drawn twice (ganttSvg): time across, and for a phone time
     down the page. The phone one shows at the diagram kit's breakpoint,
     where it draws at about full size; above it the wide one keeps a width
     its labels read at, and scrolls sideways short of it. */
  .gantt {
    overflow-x: auto;
  }
  .gantt :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    font-family: var(--vx-mono);
  }
  .gantt :global(svg[data-layout='wide']) {
    min-width: 34rem;
  }
  .gantt :global(svg[data-layout='narrow']) {
    display: none;
  }
  @media (max-width: 32rem) {
    .gantt :global(svg[data-layout='wide']) {
      display: none;
    }
    .gantt :global(svg[data-layout='narrow']) {
      display: block;
    }
  }
  .gantt :global(.lane-label),
  .gantt :global(.tick) {
    font-size: 12px;
    fill: var(--vx-muted);
  }
  .gantt :global(.tick) {
    text-anchor: middle;
  }
  .gantt :global([data-layout='narrow'] .lane-label) {
    text-anchor: middle;
  }
  .gantt :global([data-layout='narrow'] .tick) {
    text-anchor: end;
  }
  .gantt :global(.lane-rule),
  .gantt :global(.tick-rule) {
    stroke: var(--vx-border);
    stroke-width: 1;
  }
  .gantt :global(.bar rect) {
    fill: var(--vx-surface-2);
    stroke: var(--vx-border);
    stroke-width: 1.5;
  }
  .gantt :global(.bar.is-critical rect) {
    fill: color-mix(in srgb, var(--vx-accent) 12%, var(--vx-surface-2));
    stroke: var(--vx-accent);
    stroke-width: 2.5;
  }
  .gantt :global(.bar.is-unknown rect) {
    stroke-dasharray: 5 4;
  }
  .gantt :global(.bar text) {
    font-size: 11px;
    text-anchor: middle;
    fill: var(--vx-fg);
  }
  .gantt :global(.bound) {
    stroke: var(--vx-link);
    stroke-width: 2;
    stroke-dasharray: 5 4;
  }
  .gantt :global(.done) {
    stroke: var(--vx-fg);
    stroke-width: 2;
  }
  .bounds {
    margin: 0.5rem 0 0;
    font-family: var(--vx-mono);
    font-size: 13px;
    color: var(--vx-muted);
  }
  .controls label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .tasks input[type='number'] {
    width: 4.25rem;
    padding: 0.15rem 0.4rem;
  }
  .tasks :is(th, td) {
    padding-block: 0.2rem;
  }
  .times {
    margin-top: 1rem;
  }
  .times summary {
    cursor: pointer;
    font-family: var(--vx-mono);
    font-size: 13px;
    color: var(--vx-muted);
  }
  .finish {
    margin-top: 1rem;
  }
  tr.is-selected {
    background: color-mix(in srgb, var(--vx-accent) 12%, transparent);
  }
  [hidden] {
    display: none !important;
  }
</style>
