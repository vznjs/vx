---
// The pipeline as a strip: the run's stages in order, then the hooks outside
// the run. Plain HTML, so it is a diagram without JavaScript. Each stage
// links to its section in the explorer, and `pipeline-explorer.ts` turns the
// links into toggle buttons.
import { STAGES, RUN_STAGES } from './model/pipeline.js'

interface Props {
  /** Names the strip for assistive technology. */
  label: string
}

const { label } = Astro.props
const around = STAGES.filter((s) => s.group !== 'run')
---

<div class="vx-pipeline" role="group" aria-label={label}>
  <ol class="run">
    {
      RUN_STAGES.map((s) => (
        <li data-hook={s.hook}>
          <a href={`#vx-stage-${s.hook}`} data-hook={s.hook}>
            <code>{s.hook}</code>
          </a>
        </li>
      ))
    }
  </ol>
  <div class="around">
    <span class="label">outside the run:</span>
    <ul>
      {
        around.map((s) => (
          <li data-hook={s.hook}>
            <a href={`#vx-stage-${s.hook}`} data-hook={s.hook}>
              <code>{s.hook}</code>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  /* The strip is drawn as the pictures draw a box: mono, the kit's corner
     and strokes, the accent for the stage in question. */
  .vx-pipeline {
    margin-block: 0.5rem 1rem;
    font-family: var(--vx-mono);
  }
  ol,
  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    align-items: center;
    margin: 0;
  }
  ol li + li::before {
    content: '→' / '';
    padding-inline: 0.3rem;
    color: var(--vx-muted);
  }
  ul li + li::before {
    content: '·' / '';
    padding-inline: 0.4rem;
    color: var(--vx-muted);
  }
  code {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    border: 1.5px solid var(--vx-border);
    border-radius: 8px;
    background: var(--vx-surface-2);
    color: var(--vx-fg);
    font-family: var(--vx-mono);
    font-size: 13px;
  }
  a {
    border-radius: 8px;
    text-decoration: none;
  }
  a:focus-visible {
    outline: 2px solid var(--vx-link);
    outline-offset: 2px;
  }
  a[aria-pressed='true'] code {
    border-color: var(--vx-accent);
    background: color-mix(in srgb, var(--vx-accent) 12%, var(--vx-surface-2));
    box-shadow: inset 0 0 0 1px var(--vx-accent);
    font-weight: 700;
  }
  .around {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    margin-top: 0.6rem;
  }
  .label {
    font-size: 13px;
    color: var(--vx-muted);
  }
</style>
