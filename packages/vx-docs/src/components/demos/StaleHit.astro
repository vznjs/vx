---
// The stale-hit demo: five runs of one task that reads a file it does not
// list. Without JavaScript it is a table of the five runs (the key, what the
// run did, what you get and what it should be) and the report vx prints at
// step 4. `stale-hit.ts` unhides the step buttons and a live panel, and
// hides the table. The element reads the `data-step` buttons, `.controls`,
// `.status`, `.live` with its `.config`, `.key`, `.verdict`, `.got`, `.want`
// and `.report`, and `.static`, so they are its contract with this markup.
import Demo from '../Demo.astro'
import {
  REPORT_ROOT,
  STALE_OUTPUT,
  STALE_PROJECT,
  STALE_STEPS,
  configSource,
  keyCellOf,
  outputOf,
  sandboxReport,
  staleRuns,
  verdictOf,
} from './model/stale-hit.js'

const runs = staleRuns()
const first = runs[0]!
// Illustrative, like the keys: the path and the duration are one run's.
const report = sandboxReport(`${REPORT_ROOT}/packages/${STALE_PROJECT}`, 12)
const mark = (r: (typeof runs)[number]): string => (r.stale ? 'stale' : r.verdict)
---

<Demo name="stale-hit">
  <div class="controls vx-row not-content" hidden>
    {
      STALE_STEPS.map((s, i) => (
        <button type="button" data-step={s.id} aria-pressed={i === 0 ? 'true' : 'false'}>
          {i + 1}. {s.title}
        </button>
      ))
    }
  </div>
  <div class="live not-content" hidden>
    <pre class="config">{configSource(first.state)}</pre>
    <dl class="facts">
      <dt>key</dt>
      <dd class="key">{keyCellOf(first)}</dd>
      <dt>this run</dt>
      <dd class="verdict">{verdictOf(first)}</dd>
    </dl>
    <div class="compare">
      <div>
        <p class="vx-label">{STALE_OUTPUT}</p>
        <pre class="got">{outputOf(first)}</pre>
      </div>
      <div>
        <p class="vx-label">should be</p>
        <pre class="want">{first.truth}</pre>
      </div>
    </div>
    <pre class="report" hidden>{report}</pre>
  </div>
  <p class="status vx-say" aria-live="polite" hidden></p>
  <div class="static">
    <table class="runs">
      <thead>
        <tr>
          <th scope="col">Step</th>
          <th scope="col">Key</th>
          <th scope="col">This run</th>
          <th scope="col">{STALE_OUTPUT}</th>
          <th scope="col">Should be</th>
        </tr>
      </thead>
      <tbody>
        {
          runs.map((r, i) => (
            <tr data-verdict={mark(r)}>
              <th scope="row">
                {i + 1}. {STALE_STEPS[i]!.title}
              </th>
              <td>{keyCellOf(r)}</td>
              <td class="verdict">{verdictOf(r)}</td>
              <td>
                <pre class="got">{outputOf(r)}</pre>
              </td>
              <td>
                <pre>{r.truth}</pre>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="vx-label">Step 4 prints:</p>
    <pre class="report">{report}</pre>
  </div>
  <Fragment slot="caption">
    The keys come from a model of this task. Tests check it against real vx.
  </Fragment>
</Demo>

<!--
  Global, under the element's tag: the element rewrites the live panel's
  text, and Astro's scoping attribute is only on the markup it rendered.
  The tones are the pictures': a miss runs (warn), a right hit (ok), a stale
  hit or a failure (danger).
-->
<style is:global>
  vx-stale-hit {
    display: block;
  }
  vx-stale-hit td pre {
    padding: 0.25rem 0.5rem;
  }
  vx-stale-hit .runs :is(thead th, td.verdict) {
    white-space: nowrap;
  }
  vx-stale-hit :is(.controls, .live, .static, .report)[hidden] {
    display: none;
  }
  vx-stale-hit .live {
    display: grid;
    gap: 0.75rem;
  }
  vx-stale-hit .facts {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.75rem;
    margin: 0;
    font-family: var(--vx-mono);
    font-size: 13px;
  }
  vx-stale-hit .facts dt {
    color: var(--vx-muted);
  }
  vx-stale-hit .facts dd {
    margin: 0 1rem 0 0;
  }
  vx-stale-hit .compare {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.75rem;
  }
  vx-stale-hit .compare .vx-label,
  vx-stale-hit .static .vx-label {
    margin: 0 0 0.25rem;
  }
  vx-stale-hit .static .vx-label {
    margin-top: 1rem;
  }
  vx-stale-hit [data-verdict='miss'] .verdict,
  vx-stale-hit .verdict[data-verdict='miss'] {
    color: var(--vx-warn);
  }
  vx-stale-hit [data-verdict='hit'] .verdict,
  vx-stale-hit .verdict[data-verdict='hit'] {
    color: var(--vx-ok);
  }
  vx-stale-hit :is([data-verdict='stale'], [data-verdict='failed']) .verdict,
  vx-stale-hit .verdict:is([data-verdict='stale'], [data-verdict='failed']) {
    color: var(--vx-danger);
    font-weight: 700;
  }
  vx-stale-hit [data-verdict='stale'] .got,
  vx-stale-hit .got[data-verdict='stale'] {
    border-color: var(--vx-danger);
  }
</style>
