---
// One worked example on the extending page: the pipeline strip with the
// stages the example fills lit up, then the example itself, read from its
// file under `src/examples/`. The file is what the site's test type-checks
// against `@vzn/vx`, so the page cannot show a plugin that does not compile.
import type { PluginHook } from '@vzn/vx'
import { Code } from '@astrojs/starlight/components'
import PipelineStrip from './PipelineStrip.astro'
import { joinNames } from './model/pipeline.js'

interface Props {
  /** A file under `src/examples/`. */
  file: string
  /** The stages the example fills. */
  stages: readonly PluginHook[]
}

const { file, stages } = Astro.props
const examples = import.meta.glob<string>('../../examples/*.ts', {
  query: '?raw',
  import: 'default',
  eager: true,
})
const code = examples[`../../examples/${file}`]
if (code === undefined) throw new Error(`<PluginExample file="${file}">: no src/examples/${file}`)
---

<figure class="vx-example" data-example={file}>
  <PipelineStrip lit={stages} label={`The pipeline, with ${joinNames(stages)} lit: the stage this example fills.`} />
  <Code code={code} lang="ts" title={`packages/vx-docs/src/examples/${file}`} />
</figure>

<style>
  .vx-example {
    margin-block: 1.5rem;
  }
</style>
