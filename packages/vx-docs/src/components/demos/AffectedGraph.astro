---
// The toy monorepo's build tasks as a graph. Without JavaScript it is a
// diagram whose caption says what depends on what and what each change
// affects; `affected-graph.ts` turns each node into a button that lights up
// that set. The element reads the `data-node`, `data-from` / `data-to` and
// `.status` hooks below, so they are its contract with this markup.
import Demo from '../Demo.astro'
import { TOY_PACKAGES, affectedBy, joinNames } from './model/toy-monorepo.js'

const NODE = { w: 112, h: 44 }
const at: Record<string, { x: number; y: number }> = {
  ui: { x: 90, y: 42 },
  api: { x: 270, y: 42 },
  app: { x: 180, y: 158 },
}
const edges = TOY_PACKAGES.flatMap((p) => p.dependsOn.map((d) => ({ from: p.id, to: d })))

const roots = TOY_PACKAGES.filter((p) => p.dependsOn.length === 0).map((p) => p.id)
const dependsSentence = [
  ...TOY_PACKAGES.filter((p) => p.dependsOn.length > 0).map(
    (p) => `${p.id} depends on ${joinNames(p.dependsOn)}`,
  ),
  `${joinNames(roots)} ${roots.length === 1 ? 'depends' : 'depend'} on nothing`,
].join(', and ')
const affectsSentence = TOY_PACKAGES.map((p) => {
  const set = affectedBy(p.id)
  return `a change to ${p.id} affects ${set.length === 1 ? `${p.id} alone` : joinNames(set)}`
}).join('; ')
---

<Demo name="affected-graph">
  <svg
    viewBox="0 0 360 200"
    role="img"
    aria-label={`Task graph of the toy monorepo: ${dependsSentence}.`}
  >
    <defs>
      <marker
        id="vx-ag-arrow"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path class="arrow" d="M0 0 L10 5 L0 10 z"></path>
      </marker>
      <marker
        id="vx-ag-arrow-on"
        viewBox="0 0 10 10"
        refX="9"
        refY="5"
        markerWidth="7"
        markerHeight="7"
        orient="auto-start-reverse"
      >
        <path class="arrow on" d="M0 0 L10 5 L0 10 z"></path>
      </marker>
    </defs>
    {
      edges.map((e) => (
        <line
          class="edge"
          data-from={e.from}
          data-to={e.to}
          x1={at[e.from]!.x}
          y1={at[e.from]!.y - NODE.h / 2}
          x2={at[e.to]!.x}
          y2={at[e.to]!.y + NODE.h / 2 + 2}
        />
      ))
    }
    {
      TOY_PACKAGES.map((p) => (
        <g
          class="node"
          data-node={p.id}
          transform={`translate(${at[p.id]!.x - NODE.w / 2} ${at[p.id]!.y - NODE.h / 2})`}
        >
          <rect width={NODE.w} height={NODE.h} rx="8" />
          <text class="name" x={NODE.w / 2} y="20">
            {p.id}
          </text>
          <text class="task" x={NODE.w / 2} y="35">
            build
          </text>
        </g>
      ))
    }
  </svg>
  <p class="status" aria-live="polite" hidden></p>
  <Fragment slot="caption">
    The build tasks of a toy monorepo. An arrow points from a task to the task it depends on: {
      dependsSentence
    }. So {affectsSentence}.
  </Fragment>
</Demo>

<style>
  svg {
    display: block;
    width: 100%;
    max-width: 26rem;
    height: auto;
    margin: 0 auto;
  }
  .edge {
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
    marker-end: url(#vx-ag-arrow);
  }
  .edge.is-affected {
    stroke: var(--sl-color-accent);
    stroke-width: 2.5;
    marker-end: url(#vx-ag-arrow-on);
  }
  .arrow {
    fill: var(--sl-color-gray-4);
  }
  .arrow.on {
    fill: var(--sl-color-accent);
  }
  rect {
    fill: var(--sl-color-gray-6);
    stroke: var(--sl-color-gray-4);
    stroke-width: 1.5;
  }
  text {
    text-anchor: middle;
  }
  .name {
    font-size: 15px;
    font-weight: 700;
    fill: var(--sl-color-white);
  }
  .task {
    font-size: 11px;
    fill: var(--sl-color-gray-3);
  }
  .node[role='button'] {
    cursor: pointer;
  }
  .node:focus {
    outline: none;
  }
  .node:focus-visible rect {
    stroke: var(--sl-color-text-accent);
    stroke-width: 3;
    stroke-dasharray: 5 3;
  }
  .node.is-affected rect {
    fill: var(--sl-color-accent-low);
    stroke: var(--sl-color-accent);
  }
  .node.is-source rect {
    stroke: var(--sl-color-accent-high);
    stroke-width: 3;
  }
  .status {
    min-height: 1.5em;
    margin: 0.5rem 0 0;
    text-align: center;
    font-size: var(--sl-text-sm);
  }
  @media (prefers-reduced-motion: no-preference) {
    rect,
    .edge {
      transition:
        fill 0.15s ease,
        stroke 0.15s ease;
    }
  }
</style>
