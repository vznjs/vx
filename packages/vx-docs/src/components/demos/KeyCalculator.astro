---
// The toy monorepo's cache keys. Without JavaScript it is one small table:
// each task, and whether it runs or hits after each of four changes.
// `key-calculator.ts` swaps it for the edit buttons and a live table of the
// next run (task, key, runs or hit). The element reads the `data-edit`
// buttons, `.reset`, `.controls`, `.status`, `.live` and `.static`, so they
// are its contract with this markup.
import Demo from '../Demo.astro'
import {
  TOY_ENV,
  TOY_PACKAGES,
  TOY_SCENARIOS,
  TOY_SOURCE,
  TOY_START,
  TOY_TASKS,
  rowMarks,
  rowOf,
  toyRun,
  toyRuns,
} from './model/toy-monorepo.js'

const columns = TOY_SCENARIOS.map((s) => ({ ...s, run: toyRuns(s.changes).at(-1)! }))
const first = toyRun(TOY_START).tasks
---

<Demo name="key-calculator">
  <div class="controls vx-row" hidden>
    <span class="vx-label">Edit</span>
    {
      TOY_PACKAGES.map((p) => (
        <button
          type="button"
          data-edit={`${p.id}/${TOY_SOURCE}`}
          aria-pressed="false"
          aria-label={`edit ${p.id}/${TOY_SOURCE}`}
        >
          {p.id}
        </button>
      ))
    }
    <button type="button" data-edit={TOY_ENV} aria-pressed="false" aria-label={`change ${TOY_ENV}`}>
      {TOY_ENV}
    </button>
    <button type="button" class="reset">Reset</button>
  </div>
  <table class="live" hidden>
    <thead>
      <tr><th scope="col">Task</th><th scope="col">Key</th><th scope="col">This run</th></tr>
    </thead>
    <tbody>
      {
        first.map((t) => (
          <tr data-moved={rowMarks(t).moved} data-outcome={rowMarks(t).outcome}>
            {rowOf(t).map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
          </tr>
        ))
      }
    </tbody>
  </table>
  <p class="status vx-say" aria-live="polite" hidden></p>
  <table class="static">
    <thead>
      <tr>
        <th scope="col">Task</th>
        {columns.map((c) => <th scope="col">{c.title}</th>)}
      </tr>
    </thead>
    <tbody>
      {
        TOY_TASKS.map((t, i) => (
          <tr>
            <th scope="row">{t.id}</th>
            {columns.map((c) => (
              <td data-scenario={c.id} data-outcome={rowMarks(c.run.tasks[i]!).outcome}>
                {rowOf(c.run.tasks[i]!)[2]}
              </td>
            ))}
          </tr>
        ))
      }
    </tbody>
  </table>
  <Fragment slot="caption">
    The keys come from a model of vx. A test checks it against real vx.
  </Fragment>
</Demo>

<!--
  Global, under the element's tag: the element builds the live table's rows
  itself, and Astro's scoping attribute is only on the markup it rendered.
  The tones are the pictures': a miss runs (warn), a hit is restored (ok), a
  stale result is wrong (danger), a key that moved is what changed (accent).
-->
<style is:global>
  vx-key-calculator {
    display: block;
  }
  vx-key-calculator :is(.live, .static)[hidden] {
    display: none;
  }
  vx-key-calculator :is(tr[data-outcome='run'] td:last-child, td[data-outcome='run']) {
    color: var(--vx-warn);
  }
  vx-key-calculator :is(tr[data-outcome='hit'] td:last-child, td[data-outcome='hit']) {
    color: var(--vx-ok);
  }
  vx-key-calculator :is(tr[data-outcome^='stale'] td:last-child, td[data-outcome^='stale']) {
    color: var(--vx-danger);
    font-weight: 700;
  }
  vx-key-calculator tr:is([data-moved='input'], [data-moved='upstream']) td:nth-child(2) {
    color: var(--vx-accent);
    font-weight: 700;
  }
  vx-key-calculator .static thead th {
    vertical-align: bottom;
  }
</style>
