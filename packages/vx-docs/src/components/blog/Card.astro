---
// A post in a grid: its cover, the byline, the headline, one line of excerpt.
// The headline's link covers the card; when the cover prints the title,
// the headline is there for screen readers only.
import Byline from './Byline.astro'
import Cover from './Cover.astro'
import { coverShowsTitle, type Post } from '../../blog/posts.js'

type Props = { post: Post }
const { post } = Astro.props
---

<article class="vx-card">
  <Cover post={post} sizes="(min-width: 1100px) 380px, (min-width: 700px) 50vw, 100vw" />
  <div class="vx-card-body">
    <Byline post={post} />
    <h3 class:list={{ 'vx-title-in-cover': coverShowsTitle(post) }}><a href={post.href}>{post.title}</a></h3>
    <p class="vx-card-excerpt">{post.excerpt}</p>
  </div>
</article>
