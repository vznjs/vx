---
// A post's cover at 1200×630: a release's rendered PNG, or for an essay a
// cover drawn in CSS in the PNGs' look (ink, grid, one glow in the post's
// tone, the mark, a label, the title; or, as a post's banner under its own
// headline, the label set large). Text sizes are container units, so
// the drawn cover scales like an image at every card width.
import { Image } from 'astro:assets'
import { label, tone, type Post } from './posts.js'

type Props = { post: Post; sizes: string; eager?: boolean; title?: boolean }
const { post, sizes, eager = false, title = true } = Astro.props
const cover = post.entry.data.cover
const base = import.meta.env.BASE_URL
---

{
  cover ? (
    <Image
      class="vx-cover"
      src={cover.image}
      alt={cover.alt}
      widths={[480, 800, 1200]}
      sizes={sizes}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
  ) : (
    <div class="vx-cover vx-cover-drawn" style={`--tone:${tone(post)}`} role="img" aria-label={post.title}>
      <div class="vx-cover-in">
        <div class="vx-cover-top">
          <img src={`${base}logo-mark.svg`} alt="" width="32" height="32" />
          <span class="vx-cover-label">{label(post)}</span>
        </div>
        {title ? <p class="vx-cover-title">{post.title}</p> : <p class="vx-cover-word" aria-hidden="true">{label(post)}</p>}
      </div>
    </div>
  )
}
