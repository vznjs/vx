---
// The blog's index and each filter's page: on the index the newest post
// leads, large; then the filter chips, then every other post as a card.
// A chip is a link to its filter's page, so the listing needs no script.
import Byline from './Byline.astro'
import Card from './Card.astro'
import Cover from './Cover.astro'
import { blogHref, FILTERS, matches, posts } from '../../blog/posts.js'

type Props = { filter?: string }
const { filter } = Astro.props
const all = await posts()
const shown = filter === undefined ? all : all.filter((p) => matches(p, filter))
const lead = filter === undefined ? shown[0] : undefined
const rest = lead ? shown.slice(1) : shown
// A tag with no chip of its own shows one on its page.
const extra =
  filter !== undefined && !FILTERS.some((f) => f.id === filter) ? [{ id: filter, label: filter }] : []
const chips = [
  { id: undefined, label: 'All', href: blogHref(), n: all.length },
  ...[...FILTERS, ...extra].map((f) => ({
    id: f.id,
    label: f.label,
    href: blogHref(`tags/${f.id}/`),
    n: all.filter((p) => matches(p, f.id)).length,
  })),
]
---

<div class="vx-blog-listing not-content">
  {
    lead && (
      <article class="vx-feature">
        <a class="vx-feature-cover" href={lead.href} tabindex="-1" aria-hidden="true">
          <Cover post={lead} sizes="(min-width: 1100px) 680px, 100vw" eager />
        </a>
        <div class="vx-feature-text">
          <Byline post={lead} />
          <h2>
            <a href={lead.href}>{lead.title}</a>
          </h2>
          <p class="vx-feature-excerpt">{lead.excerpt}</p>
          <a class="vx-read" href={lead.href}>
            Read the post <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>
    )
  }

  <nav class="vx-filters" aria-label="Filter posts">
    {
      chips.map((c) => (
        <a href={c.href} aria-current={c.id === filter ? 'page' : undefined}>
          {c.label}
          <span class="n">{c.n}</span>
        </a>
      ))
    }
  </nav>

  <div class="vx-grid">
    {rest.map((p) => <Card post={p} />)}
  </div>
</div>
