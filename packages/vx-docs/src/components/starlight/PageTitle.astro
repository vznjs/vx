---
// A Guide chapter opens with its number, its title and, on one line, the
// problem it answers, all from src/guide/chapters.ts; the chapter's own text
// never writes them. Every other page keeps Starlight's title.
import Default from '@astrojs/starlight/components/PageTitle.astro'
import { chapterPage, problemHtml } from '../../guide/chapters.js'

const page = chapterPage(Astro.locals.starlightRoute.id)
---

{
  page === undefined ? (
    <Default />
  ) : (
    <div class="vx-chapter-head">
      <p class="vx-chapter-number">Chapter {page.chapter.chapter}</p>
      {/* `_top` is Starlight's page-title id, which "Overview" in the table of contents targets. */}
      <h1 id="_top">{page.chapter.title}</h1>
      <p class="vx-chapter-problem" set:html={problemHtml(page.chapter.problem)} />
    </div>
  )
}

<style>
  .vx-chapter-head {
    margin-top: 1.5rem;
    max-width: 60ch;
  }
  .vx-chapter-number {
    margin: 0;
    font: 500 var(--sl-text-sm) / 1.25 var(--vx-mono);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--vx-accent);
  }
  h1 {
    margin: 0.5rem 0 0;
    font-size: clamp(2.4rem, 6vw, 3.4rem);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--vx-fg);
  }
  .vx-chapter-problem {
    margin: 1rem 0 0.5rem;
    font-size: 1.25rem;
    line-height: 1.45;
    color: var(--vx-muted);
  }
  .vx-chapter-problem :global(code) {
    font-family: var(--vx-mono);
    font-size: 0.9em;
    color: var(--vx-fg);
    background: var(--vx-surface-2);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }
</style>
