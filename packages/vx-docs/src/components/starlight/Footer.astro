---
// Starlight's footer (the edit link); under a post, first its tags (an
// essay's) and three posts to read next, as cards.
import Default from '@astrojs/starlight/components/Footer.astro'
import Card from '../blog/Card.astro'
import { blogHref, postAt, related } from '../../blog/posts.js'

const route = Astro.locals.starlightRoute
const post =
  route.entry.data.date ? await postAt(route.id) : undefined
const next = post ? await related(post) : []
---

{
  post && (
    <div class="vx-post-end not-content">
      {post.kind === 'blog' && (
        <nav class="vx-filters vx-post-tags" aria-label="Tags">
          {post.tags.map((t) => (
            <a href={blogHref(`tags/${t}/`)}>{t}</a>
          ))}
        </nav>
      )}
      <section class="vx-related">
        <h2>{post.kind === 'releases' ? 'More releases' : 'Keep reading'}</h2>
        <div class="vx-grid">
          {next.map((p) => (
            <Card post={p} />
          ))}
        </div>
      </section>
    </div>
  )
}
<Default />
