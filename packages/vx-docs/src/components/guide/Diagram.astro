---
// Draws one Guide picture (`diagram.ts`) as build-time SVG: boxes, arrows
// and notes, theme tokens only, no client script. The caption is the slot.
import { boxHeight, exitPoint, type Picture } from './diagram.js'

type Props = Picture

const { id, label, boxes, arrows = [], notes = [], width = 600, height = 260 } = Astro.props
const byId = new Map(boxes.map((b) => [b.id, b]))
const centre = (id: string) => {
  const b = byId.get(id)
  if (b === undefined) throw new Error(`<Diagram id="${id}">: an arrow names no box ${id}`)
  return { b, x: b.x + b.w / 2, y: b.y + boxHeight(b) / 2 }
}
const lines = arrows.map((a) => {
  const from = centre(a.from)
  const to = centre(a.to)
  const p = exitPoint(from.b, to.x, to.y, 0)
  const q = exitPoint(to.b, from.x, from.y, 6)
  return { ...a, x1: p.x, y1: p.y, x2: q.x, y2: q.y }
})
---

<figure class="vx-diagram" data-picture={id}>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={label}>
    <defs>
      {
        ['default', 'accent', 'danger', 'ok', 'muted'].map((v) => (
          <marker
            id={`vx-dg-${id}-${v}`}
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="7"
            markerHeight="7"
            orient="auto-start-reverse"
          >
            <path class={`head ${v}`} d="M0 0 L10 5 L0 10 z" />
          </marker>
        ))
      }
    </defs>
    {
      lines.map((l) => (
        <g class={`arrow ${l.variant ?? 'default'}`} data-from={l.from} data-to={l.to}>
          <line
            x1={l.x1}
            y1={l.y1}
            x2={l.x2}
            y2={l.y2}
            marker-end={`url(#vx-dg-${id}-${l.variant ?? 'default'})`}
          />
          {l.label !== undefined && (
            <text class="arrow-label" x={(l.x1 + l.x2) / 2} y={(l.y1 + l.y2) / 2 - 8}>
              {l.label}
            </text>
          )}
        </g>
      ))
    }
    {
      boxes.map((b) => (
        <g class={`box ${b.variant ?? 'default'}`} data-box={b.id}>
          <rect x={b.x} y={b.y} width={b.w} height={boxHeight(b)} rx="8" />
          <text class="label" x={b.x + b.w / 2} y={b.y + (b.sub === undefined ? 27 : 24)}>
            {b.label}
          </text>
          {b.sub !== undefined && (
            <text class="sub" x={b.x + b.w / 2} y={b.y + 44}>
              {b.sub}
            </text>
          )}
        </g>
      ))
    }
    {
      notes.map((n) => (
        <text
          class={`note ${n.variant ?? 'default'}`}
          x={n.x}
          y={n.y}
          text-anchor={n.anchor ?? 'middle'}
        >
          {n.text}
        </text>
      ))
    }
  </svg>
  <figcaption><slot /></figcaption>
</figure>

<style>
  .vx-diagram {
    margin-block: 1.25rem;
  }
  svg {
    display: block;
    width: 100%;
    max-width: 40rem;
    height: auto;
    margin: 0 auto;
  }
  text {
    fill: var(--vx-fg);
    font-size: 15px;
  }
  .label {
    text-anchor: middle;
    font-family: var(--vx-mono);
    font-weight: 600;
  }
  .sub {
    text-anchor: middle;
    font-family: var(--vx-mono);
    font-size: 13px;
    fill: var(--vx-muted);
  }
  .arrow-label {
    text-anchor: middle;
    font-size: 14px;
    fill: var(--vx-muted);
  }
  .note {
    font-size: 14px;
    fill: var(--vx-muted);
  }
  .note.danger {
    fill: var(--vx-danger);
  }
  .note.ok {
    fill: var(--vx-ok);
  }
  .note.accent {
    fill: var(--vx-accent);
  }
  rect {
    fill: var(--vx-surface-2);
    stroke: var(--vx-border);
    stroke-width: 1.5;
  }
  .box.accent rect {
    stroke: var(--vx-accent);
    stroke-width: 2.5;
  }
  .box.danger rect {
    fill: var(--vx-surface);
    stroke: var(--vx-danger);
    stroke-width: 2.5;
  }
  .box.ok rect {
    stroke: var(--vx-ok);
    stroke-width: 2.5;
  }
  .box.muted {
    opacity: 0.5;
  }
  .box.muted rect {
    fill: var(--vx-surface);
    stroke-dasharray: 5 4;
  }
  line {
    stroke: var(--vx-border);
    stroke-width: 2;
  }
  .head {
    fill: var(--vx-border);
  }
  .arrow.accent line {
    stroke: var(--vx-accent);
  }
  .head.accent {
    fill: var(--vx-accent);
  }
  .arrow.danger line {
    stroke: var(--vx-danger);
  }
  .head.danger {
    fill: var(--vx-danger);
  }
  .arrow.ok line {
    stroke: var(--vx-ok);
  }
  .head.ok {
    fill: var(--vx-ok);
  }
  .arrow.muted {
    opacity: 0.5;
  }
  figcaption {
    margin-top: 0.4rem;
    text-align: center;
    font-size: var(--sl-text-sm);
    color: var(--vx-muted);
  }
</style>
