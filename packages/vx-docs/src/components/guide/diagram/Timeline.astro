---
// Workers over time: one lane per worker, one bar per task it ran, from
// `start` to `end` in `unit`s, and an axis underneath. A bar too short for
// its label keeps the label as a tooltip. The default slot is the caption.
import Diagram from './Diagram.astro'
import { round, textWidth, type Variant } from './geometry.js'

export interface TimelineBar {
  start: number
  end: number
  label: string
  variant?: Variant
}

export interface TimelineLane {
  name: string
  bars: TimelineBar[]
}

interface Props {
  lanes: TimelineLane[]
  /** The axis's unit, printed after each tick: `s`, `ms`, ` min`. */
  unit: string
  /** Read aloud in place of the picture; by default, each lane's bars in words. */
  label?: string
  /** The drawing's width before it scales to the column. */
  width?: number
}

const { lanes, unit, width = 640 } = Astro.props
const PAD = 12
const LANE = 34
const BAR = 24
const AXIS = 26
const nameCol = Math.ceil(Math.max(...lanes.map((l) => textWidth(l.name, 12))) + 16)
const total = Math.max(...lanes.flatMap((l) => l.bars.map((b) => b.end)))
const plot = width - nameCol - PAD * 2
const px = (t: number): number => round(PAD + nameCol + (t / total) * plot)
const height = PAD * 2 + lanes.length * LANE + AXIS

// A tick every 1, 2 or 5 × 10ⁿ units, so the axis holds at most eight.
const step = (() => {
  const raw = total / 8
  const pow = 10 ** Math.floor(Math.log10(raw))
  return [1, 2, 5, 10].map((m) => m * pow).find((s) => s >= raw)!
})()
const ticks = Array.from({ length: Math.floor(total / step + 1e-9) + 1 }, (_, i) => round(i * step))
const axisY = PAD + lanes.length * LANE + 4

const label =
  Astro.props.label ??
  `Timeline: ${lanes
    .map(
      (l) =>
        `${l.name} runs ${l.bars.map((b) => `${b.label} from ${b.start} to ${b.end}${unit}`).join(', ')}`,
    )
    .join('; ')}.`
---

<Diagram width={width} height={height} label={label}>
  {
    ticks.map((t) => (
      <line class="grid" x1={px(t)} y1={PAD - 4} x2={px(t)} y2={axisY} />
    ))
  }
  {
    lanes.map((lane, i) => {
      const y = PAD + i * LANE
      return (
        <g class="lane">
          <text class="name" x={PAD} y={y + LANE / 2}>
            {lane.name}
          </text>
          {lane.bars.map((b) => {
            const x = px(b.start)
            const w = round(px(b.end) - x)
            const fits = textWidth(b.label, 11) + 10 <= w
            return (
              <g class={`bar ${b.variant ?? 'default'}`}>
                <title>{`${b.label}: ${b.start}–${b.end}${unit}`}</title>
                <rect x={x} y={y + (LANE - BAR) / 2} width={w} height={BAR} rx="4" />
                {fits && (
                  <text x={round(x + w / 2)} y={y + LANE / 2}>
                    {b.label}
                  </text>
                )}
              </g>
            )
          })}
        </g>
      )
    })
  }
  <line class="axis" x1={px(0)} y1={axisY} x2={px(total)} y2={axisY}></line>
  {
    ticks.map((t) => (
      <text class="tick" x={px(t)} y={axisY + 14}>
        {`${t}${unit}`}
      </text>
    ))
  }
  {
    Astro.slots.has('default') && (
      <Fragment slot="caption">
        <slot />
      </Fragment>
    )
  }
</Diagram>

<style>
  text {
    dominant-baseline: central;
  }
  .name {
    fill: var(--vx-fg);
    font-size: 12px;
  }
  .grid {
    stroke: var(--vx-border);
    stroke-width: 1;
    stroke-dasharray: 2 4;
  }
  .axis {
    stroke: var(--vx-muted);
    stroke-width: 1;
  }
  .tick {
    fill: var(--vx-muted);
    font-size: 10px;
    text-anchor: middle;
  }
  .bar rect {
    fill: var(--vx-surface-2);
    stroke: var(--vx-link);
    stroke-width: 1.25;
  }
  .bar text {
    fill: var(--vx-fg);
    font-size: 11px;
    text-anchor: middle;
  }
  .bar.accent rect {
    fill: color-mix(in srgb, var(--vx-accent) 22%, var(--vx-surface-2));
    stroke: var(--vx-accent);
  }
  .bar.danger rect {
    fill: color-mix(in srgb, var(--vx-danger) 18%, var(--vx-surface-2));
    stroke: var(--vx-danger);
  }
  .bar.muted rect {
    fill: var(--vx-surface);
    stroke: var(--vx-border);
  }
  .bar.muted text {
    fill: var(--vx-muted);
  }
  .bar.dashed rect {
    fill: none;
    stroke: var(--vx-muted);
    stroke-dasharray: 5 4;
  }
</style>
