---
// Draws one Guide picture (`diagram.ts`) as build-time SVG (`DiagramSvg.astro`)
// with its caption under it. It ships no script. Every picture on the site
// is this component, and its look is `diagram.css` alone, so they read as
// one hand drew them.
import DiagramSvg from './DiagramSvg.astro'
import type { Picture } from './diagram.js'

type Props = Picture
---

<figure class="vx-diagram not-content" data-picture={Astro.props.name}>
  <DiagramSvg {...Astro.props} />
  <figcaption>{Astro.props.caption}</figcaption>
</figure>
