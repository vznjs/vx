---
// The frame every kit diagram draws into: a figure holding one responsive SVG
// (its viewBox is `width` × `height`; it scales down to the column, never up
// past its own width) and an optional caption. The frame's look is global
// (`.vx-diagram` in src/styles/theme.css), so a chapter's hand-drawn SVG in a
// `<figure class="vx-diagram">` matches it. Put Box and Arrow inside it;
// TaskGraph and Timeline use it themselves.
interface Props {
  width: number
  height: number
  /** What the picture says, for a reader who cannot see it. */
  label: string
  /** The narrowest the SVG may render; a narrower column scrolls it sideways. */
  minWidth?: number
}

const { width, height, label, minWidth } = Astro.props
const style = [
  `max-width: ${width}px`,
  minWidth === undefined ? '' : `min-width: ${Math.min(minWidth, width)}px`,
]
  .filter((s) => s !== '')
  .join('; ')
---

<figure class="vx-diagram not-content">
  <svg
    viewBox={`0 0 ${width} ${height}`}
    width={width}
    height={height}
    role="img"
    aria-label={label}
    style={style}
  >
    <slot />
  </svg>
  {
    Astro.slots.has('caption') && (
      <figcaption>
        <slot name="caption" />
      </figcaption>
    )
  }
</figure>
