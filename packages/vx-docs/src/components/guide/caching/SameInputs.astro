---
import '../vx-diagram.css'

const INPUTS = ['src/index.ts', 'tsconfig.json', 'tsc -b']
---

<figure class="vx-diagram" data-diagram="same-inputs">
  <svg
    viewBox="0 0 600 200"
    role="img"
    aria-label="utils#build reads src/index.ts and tsconfig.json and runs tsc -b. It writes dist/. With the same three inputs it writes the same dist/ every time."
  >
    <defs>
      <marker id="c5-same-head" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="8" markerHeight="8" orient="auto">
        <path class="head" d="M0,0 L10,5 L0,10 z"></path>
      </marker>
    </defs>
    {
      INPUTS.map((input, i) => (
        <>
          <rect class="box" x="0" y={16 + i * 58} width="160" height="40" rx="6" />
          <text x="80" y={41 + i * 58} text-anchor="middle">
            {input}
          </text>
          <path
            class="edge"
            d={`M160,${36 + i * 58} C200,${36 + i * 58} 200,100 236,100`}
            marker-end="url(#c5-same-head)"
          />
        </>
      ))
    }
    <rect class="box accent" x="240" y="78" width="150" height="44" rx="6"></rect>
    <text x="315" y="105" text-anchor="middle">utils#build</text>
    <path class="edge" d="M390,100 L456,100" marker-end="url(#c5-same-head)"></path>
    <rect class="box ok" x="460" y="78" width="120" height="44" rx="6"></rect>
    <text x="520" y="105" text-anchor="middle">dist/</text>
    <text class="note" x="80" y="196" text-anchor="middle">inputs</text>
    <text class="note" x="520" y="150" text-anchor="middle">output</text>
  </svg>
  <figcaption>Same inputs in, same output out. So the output can be kept and reused.</figcaption>
</figure>
