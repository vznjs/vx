---
// A small build-time picture for a Guide chapter: boxes, arrows between
// them, loose labels and dashed frames around groups. Each chapter keeps its
// pictures as data in `src/components/guide/<chapter>/pictures.ts`, so the
// chapter's test can hold a picture to what the chapter says it shows. Only
// the theme's `--vx-*` tokens colour it, and it ships no script.
import type { Picture, Point, Tone } from './sketch.js'

type Props = Picture

const { name, label, caption, width = 600, height = 260, boxes, arrows = [], notes = [], frames = [] } =
  Astro.props

const byId = new Map(boxes.map((b) => [b.id, b]))
const W = 130
const H = 52
const size = (id: string) => {
  const b = byId.get(id)
  if (b === undefined) throw new Error(`<Sketch name="${name}">: no box ${id}`)
  return { ...b, w: b.w ?? W, h: b.h ?? H }
}
const center = (id: string): Point => {
  const b = size(id)
  return [b.x + b.w / 2, b.y + b.h / 2]
}
// Where the ray from a box's centre towards `to` leaves the box, plus a gap.
const exit = (id: string, to: Point, gap: number): Point => {
  const b = size(id)
  const [cx, cy] = center(id)
  const dx = to[0] - cx
  const dy = to[1] - cy
  const t = Math.min(
    dx === 0 ? Infinity : b.w / 2 / Math.abs(dx),
    dy === 0 ? Infinity : b.h / 2 / Math.abs(dy),
  )
  const len = Math.hypot(dx, dy)
  return [cx + dx * t + (dx / len) * gap, cy + dy * t + (dy / len) * gap]
}
const lines = arrows.map((a) => {
  const via = a.via ?? []
  const start = exit(a.from, via[0] ?? center(a.to), 2)
  const end = exit(a.to, via.at(-1) ?? center(a.from), 4)
  const points = [start, ...via, end]
  const mid = Math.floor((points.length - 1) / 2)
  const [p, q] = [points[mid]!, points[mid + 1]!]
  const across = Math.abs(q[0] - p[0]) >= Math.abs(q[1] - p[1])
  return {
    ...a,
    tone: a.tone ?? 'default',
    d: points.map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' '),
    lx: (p[0] + q[0]) / 2 + (across ? 0 : 8),
    ly: (p[1] + q[1]) / 2 + (across ? -8 : 5),
    anchor: across ? 'middle' : 'start',
  }
})
const tones: Tone[] = ['default', 'accent', 'link', 'danger', 'ok', 'muted']
---

<figure class="vx-diagram" data-picture={name}>
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={label}>
    <defs>
      {
        tones.map((t) => (
          <marker
            id={`vx-sk-${name}-${t}`}
            viewBox="0 0 10 10"
            refX="9"
            refY="5"
            markerWidth="7"
            markerHeight="7"
            orient="auto-start-reverse"
          >
            <path class={`head ${t}`} d="M0 0 L10 5 L0 10 z" />
          </marker>
        ))
      }
    </defs>
    {
      frames.map((f) => (
        <g class="frame">
          <rect x={f.x} y={f.y} width={f.w} height={f.h} rx="12" />
          <text x={f.x + 12} y={f.y + 20}>
            {f.label}
          </text>
        </g>
      ))
    }
    {
      lines.map((l) => (
        <g class={`arrow ${l.tone}`} data-from={l.from} data-to={l.to}>
          <path
            d={l.d}
            class:list={{ dashed: l.dashed === true }}
            marker-end={`url(#vx-sk-${name}-${l.tone})`}
          />
          {l.label !== undefined && (
            <text x={l.lx} y={l.ly} style={`text-anchor: ${l.anchor}`}>
              {l.label}
            </text>
          )}
        </g>
      ))
    }
    {
      boxes.map((b) => {
        const s = size(b.id)
        return (
          <g class={`box ${b.tone ?? 'default'}`} data-box={b.id}>
            <rect x={s.x} y={s.y} width={s.w} height={s.h} rx="8" />
            <text class="label" x={s.x + s.w / 2} y={s.y + (b.sub === undefined ? s.h / 2 + 5 : s.h / 2 - 3)}>
              {b.label}
            </text>
            {b.sub !== undefined && (
              <text class="sub" x={s.x + s.w / 2} y={s.y + s.h / 2 + 15}>
                {b.sub}
              </text>
            )}
          </g>
        )
      })
    }
    {
      notes.map((n) => (
        <text
          class={`note ${n.tone ?? 'muted'}`}
          x={n.x}
          y={n.y}
          style={`text-anchor: ${n.anchor ?? 'middle'}`}
        >
          {n.text}
        </text>
      ))
    }
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .vx-diagram {
    margin-block: 1.25rem;
  }
  svg {
    display: block;
    width: 100%;
    max-width: 38rem;
    height: auto;
    margin: 0 auto;
    font-size: 15px;
  }
  text {
    fill: var(--vx-fg);
    text-anchor: middle;
  }
  .box rect {
    fill: var(--vx-surface-2);
    stroke: var(--vx-border);
    stroke-width: 1.5;
  }
  .box .label {
    font-weight: 700;
  }
  .box .sub {
    font-size: 13px;
    fill: var(--vx-muted);
  }
  .box.accent rect {
    stroke: var(--vx-accent);
    stroke-width: 2.5;
  }
  .box.ok rect {
    stroke: var(--vx-ok);
    stroke-width: 2.5;
  }
  .box.danger rect {
    stroke: var(--vx-danger);
    stroke-width: 2.5;
  }
  .box.muted rect {
    fill: var(--vx-surface);
    stroke-dasharray: 5 4;
  }
  .box.muted text {
    fill: var(--vx-muted);
  }
  .frame rect {
    fill: none;
    stroke: var(--vx-border);
    stroke-dasharray: 6 4;
  }
  .frame text {
    text-anchor: start;
    font-size: 13px;
    fill: var(--vx-muted);
  }
  .arrow path {
    fill: none;
    stroke-width: 2;
  }
  .arrow path.dashed {
    stroke-dasharray: 5 4;
  }
  .arrow text {
    font-size: 13px;
    fill: var(--vx-muted);
  }
  .arrow.default path {
    stroke: var(--vx-muted);
  }
  .arrow.accent path {
    stroke: var(--vx-accent);
  }
  .arrow.link path {
    stroke: var(--vx-link);
  }
  .arrow.danger path {
    stroke: var(--vx-danger);
  }
  .arrow.danger text {
    fill: var(--vx-danger);
  }
  .arrow.ok path {
    stroke: var(--vx-ok);
  }
  .arrow.muted path {
    stroke: var(--vx-border);
  }
  .head.default {
    fill: var(--vx-muted);
  }
  .head.accent {
    fill: var(--vx-accent);
  }
  .head.link {
    fill: var(--vx-link);
  }
  .head.danger {
    fill: var(--vx-danger);
  }
  .head.ok {
    fill: var(--vx-ok);
  }
  .head.muted {
    fill: var(--vx-border);
  }
  .note {
    font-size: 14px;
  }
  .note.muted {
    fill: var(--vx-muted);
  }
  .note.danger {
    fill: var(--vx-danger);
  }
  .note.ok {
    fill: var(--vx-ok);
  }
  .note.accent {
    fill: var(--vx-accent);
  }
  .note.mono {
    font-family: var(--vx-mono);
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--vx-muted);
    text-align: center;
  }
</style>
