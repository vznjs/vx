{
  "name": "@vzn/run",
  "version": "0.0.0",
  "description": "An open, extensible monorepo task runner.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "vzn": "./src/bin.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun test src/",
    "test:watch": "bun test --watch src/"
  },
  "dependencies": {
    "ignore": "^7.0.4",
    "jiti": "^2.4.2",
    "tinyglobby": "^0.2.10",
    "yaml": "^2.6.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
