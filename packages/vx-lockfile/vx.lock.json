{
  "tasks": {
    "install": {
      "dependsOn": [
        "^build"
      ]
    },
    "build": {
      "description": "nothing to build — consumed as source",
      "dependsOn": [
        "^build"
      ],
      "inputs": {
        "files": [
          "src/**",
          "package.json"
        ]
      }
    },
    "ci": {
      "dependsOn": [
        "lint",
        "test"
      ]
    },
    "lint": {
      "dependsOn": [
        "lint.oxlint",
        "lint.oxfmt"
      ]
    },
    "lint.oxlint": {
      "description": "oxlint with tsgolint-backed type-aware checks",
      "exec": {
        "command": "oxlint --type-aware --type-check",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "src/**",
          "tests/**",
          "package.json",
          ".oxlintrc.json",
          "tsconfig.json"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    },
    "lint.oxfmt": {
      "description": "oxfmt --check (no rewrite; CI-safe)",
      "exec": {
        "command": "oxfmt --check .",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "**/*",
          "package.json"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    },
    "test": {
      "dependsOn": [
        "test.shard-*"
      ]
    },
    "test.shard-1": {
      "description": "bun test, shard 1 of 3",
      "exec": {
        "command": "bun test --only-failures --timeout=30000 tests/dependency-names.test.ts tests/extra-in-project.test.ts tests/file-dir-dep.test.ts tests/installed-layout.test.ts tests/link-to-workspace.test.ts tests/lockfile-shapes.test.ts tests/npm.test.ts tests/pnpm-workspace-precise.test.ts tests/rehoist-identity.test.ts tests/transitive-workspace.test.ts tests/yarn-classic-root-deps.test.ts tests/yarn-package-settings.test.ts",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0",
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "VX_CACHE_DIR": ".vx/cache"
          }
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space",
              "net.link.addr"
            ],
            "localBinding": true
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "src/**",
          "tests/**",
          "package.json"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    },
    "test.shard-2": {
      "description": "bun test, shard 2 of 3",
      "exec": {
        "command": "bun test --only-failures --timeout=30000 tests/bun-patch-precise.test.ts tests/closure-per-project.test.ts tests/deleted-project.test.ts tests/dependency-section.test.ts tests/lazy-load.test.ts tests/lockfile-choice.test.ts tests/outside-dir-dep.test.ts tests/overrides-precise.test.ts tests/pnpm-exclude-links.test.ts tests/pnpm-ignored-optional.test.ts tests/pnpm-injected-workspace.test.ts tests/refusal-message.test.ts tests/unknown-options.test.ts tests/yarn-classic-link-workspace.test.ts tests/yarn-package-extensions.test.ts tests/yarn-transparent-workspaces.test.ts tests/yarn.test.ts",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0",
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "VX_CACHE_DIR": ".vx/cache"
          }
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space",
              "net.link.addr"
            ],
            "localBinding": true
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "src/**",
          "tests/**",
          "package.json"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    },
    "test.shard-3": {
      "description": "bun test, shard 3 of 3",
      "exec": {
        "command": "bun test --only-failures --timeout=30000 tests/bun-catalog-precise.test.ts tests/bun.test.ts tests/discover-parity.test.ts tests/discover.test.ts tests/entry-shapes.test.ts tests/io-refusals.test.ts tests/link-outside-root.test.ts tests/linked-dirs.test.ts tests/memo-identity.test.ts tests/npm-nested-workspace.test.ts tests/pnpm-manifest-files.test.ts tests/pnpm.test.ts tests/root-workspace-dep.test.ts tests/settings.test.ts tests/sparse-checkout.test.ts tests/yarn-bound-descriptor.test.ts tests/yarn-classic-workspace-deps.test.ts tests/yarn-numeric-range.test.ts",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0",
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "VX_CACHE_DIR": ".vx/cache"
          }
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space",
              "net.link.addr"
            ],
            "localBinding": true
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "src/**",
          "tests/**",
          "package.json"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    }
  }
}
