{
  "data": {
    "detail": "taskDetail",
    "cacheKey": "cacheKey",
    "config": "catalogTask",
    "flaky": "taskFlaky",
    "flakeTrend": "taskFlakeTrend",
    "recommendations": "taskRecommendations",
    "trend": "taskTrend"
  },
  "spec": {
    "type": "Page",
    "props": {
      "backHref": "/tasks",
      "backLabel": "tasks",
      "title": {
        "$state": "/params/id"
      },
      "mono": true
    },
    "children": [
      {
        "type": "Text",
        "props": {
          "text": "Loading\u2026",
          "tone": "faint"
        },
        "visible": {
          "$state": "/detailStatus",
          "eq": "loading"
        }
      },
      {
        "type": "Callout",
        "props": {
          "text": {
            "$computed": "flakyText",
            "args": {
              "flaky": {
                "$state": "/flaky"
              }
            }
          },
          "tone": "warn"
        },
        "visible": {
          "$state": "/flakyStatus",
          "eq": "ok"
        }
      },
      {
        "type": "Card",
        "props": {
          "title": "Flakiness trend",
          "actionText": "episodes per day \u00b7 last 90d"
        },
        "visible": {
          "$state": "/flakeTrendStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "Facts",
            "props": {
              "entry": {
                "$state": "/flakeTrend"
              },
              "fields": [
                {
                  "key": "_firstSeen",
                  "label": "first seen"
                },
                {
                  "key": "_lastSeen",
                  "label": "last episode"
                },
                {
                  "key": "episodes",
                  "label": "episodes (90d)",
                  "kind": "count"
                },
                {
                  "key": "direction",
                  "label": "trend"
                }
              ]
            }
          },
          {
            "type": "LineChart",
            "props": {
              "rows": {
                "$state": "/flakeTrend/series"
              },
              "xKey": "t",
              "xFormat": "date",
              "yFormat": "count",
              "yMin": 0,
              "height": 200,
              "series": [
                {
                  "name": "episodes",
                  "yKey": "episodes",
                  "strokeClass": "stroke-warn",
                  "areaClass": "fill-warn/10"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Grid",
        "props": {
          "variant": "metrics-4"
        },
        "visible": {
          "$state": "/trend/hasData",
          "eq": true
        },
        "children": [
          {
            "type": "Metric",
            "props": {
              "label": "Avg exec (this 7d)",
              "value": {
                "$computed": "fmtDuration",
                "args": {
                  "ms": {
                    "$state": "/trend/current/avgDurationMs"
                  }
                }
              },
              "sub": {
                "$state": "/trend/_avgLabel"
              },
              "tone": {
                "$state": "/trend/_avgTone"
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Failure rate (this 7d)",
              "value": {
                "$computed": "fmtPercent0",
                "args": {
                  "n": {
                    "$state": "/trend/current/failureRate"
                  }
                }
              },
              "sub": {
                "$state": "/trend/_failureLabel"
              },
              "tone": {
                "$state": "/trend/_failureTone"
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Runs (this 7d)",
              "value": {
                "$computed": "fmtNumber",
                "args": {
                  "n": {
                    "$state": "/trend/current/runs"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{d} vs prior 7d",
                  "d": {
                    "$state": "/trend/_runsDelta"
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Cache hit rate (this 7d)",
              "value": {
                "$computed": "fmtPercent0",
                "args": {
                  "n": {
                    "$state": "/trend/current/cacheHitRate"
                  }
                }
              },
              "sub": {
                "$state": "/trend/_hitLabel"
              },
              "tone": {
                "$state": "/trend/_hitTone"
              }
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Debug",
          "actionText": "one click to the evidence",
          "noPad": true
        },
        "visible": {
          "$state": "/detailStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "RankList",
            "props": {
              "items": {
                "$state": "/detail/_debug/runs"
              },
              "labelKey": "label",
              "valueKey": "at",
              "valueFormat": "relativeTime",
              "rowHref": "/runs/{_runId}?task={_taskRef}",
              "emptyTitle": "No recorded runs yet"
            }
          },
          {
            "type": "RankList",
            "props": {
              "items": {
                "$state": "/detail/_debug/artifact"
              },
              "labelKey": "label",
              "valueKey": "at",
              "valueFormat": "relativeTime",
              "rowHref": "/cache/{_hash}",
              "emptyTitle": "No cached artifact yet"
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Recommendations",
          "actionText": "actionable fixes for this task",
          "noPad": true
        },
        "visible": {
          "$state": "/detailStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "RecList",
            "props": {
              "items": {
                "$state": "/recommendations"
              },
              "status": {
                "$state": "/recommendationsStatus"
              },
              "emptyTitle": "Looks healthy \u2014 no recommendations \u2713"
            }
          }
        ]
      },
      {
        "type": "Empty",
        "props": {
          "title": "No data for this task",
          "cmd": {
            "$computed": "text",
            "args": {
              "tpl": "vx run {id}",
              "id": {
                "$state": "/params/id"
              }
            }
          }
        },
        "visible": {
          "$state": "/detailStatus",
          "eq": "missing"
        }
      },
      {
        "type": "Grid",
        "props": {
          "variant": "metrics-6"
        },
        "visible": {
          "$state": "/detailStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "Metric",
            "props": {
              "label": "Runs",
              "value": {
                "$computed": "fmtNumber",
                "args": {
                  "n": {
                    "$state": "/detail/aggregate/runs"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{a} ok \u00b7 {b} fail",
                  "a": {
                    "$state": "/detail/aggregate/successes"
                  },
                  "b": {
                    "$state": "/detail/aggregate/failures"
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Success rate",
              "value": {
                "$computed": "fmtPercent0",
                "args": {
                  "n": {
                    "$state": "/detail/aggregate/successRate"
                  }
                }
              },
              "sub": {
                "$state": "/detail/aggregate/failureMode"
              },
              "tone": {
                "$cond": {
                  "$state": "/detail/aggregate/failureMode",
                  "eq": "stable"
                },
                "$then": "good",
                "$else": {
                  "$cond": {
                    "$state": "/detail/aggregate/failureMode",
                    "eq": "flaky-fatal"
                  },
                  "$then": "bad",
                  "$else": "warn"
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Hit rate",
              "value": {
                "$computed": "fmtPercent0",
                "args": {
                  "n": {
                    "$state": "/detail/aggregate/hitRate"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{n} hits",
                  "n": {
                    "$state": "/detail/aggregate/hits"
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Avg duration",
              "value": {
                "$computed": "fmtDuration",
                "args": {
                  "ms": {
                    "$state": "/detail/aggregate/avgDurationMs"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "p50 {a} \u00b7 p99 {b}",
                  "a": {
                    "$computed": "fmtDuration",
                    "args": {
                      "ms": {
                        "$state": "/detail/aggregate/p50DurationMs"
                      }
                    }
                  },
                  "b": {
                    "$computed": "fmtDuration",
                    "args": {
                      "ms": {
                        "$state": "/detail/aggregate/p99DurationMs"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "CPU usage",
              "value": {
                "$computed": "cpuStat",
                "args": {
                  "rows": {
                    "$state": "/detail/recent"
                  },
                  "stat": "avg"
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "avg \u00b7 max {m}",
                  "m": {
                    "$computed": "cpuStat",
                    "args": {
                      "rows": {
                        "$state": "/detail/recent"
                      },
                      "stat": "max"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Last run",
              "value": {
                "$computed": "fmtRelTime",
                "args": {
                  "t": {
                    "$state": "/detail/aggregate/lastSeenAt"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "min {a} \u00b7 max {b}",
                  "a": {
                    "$computed": "fmtDuration",
                    "args": {
                      "ms": {
                        "$state": "/detail/aggregate/minDurationMs"
                      }
                    }
                  },
                  "b": {
                    "$computed": "fmtDuration",
                    "args": {
                      "ms": {
                        "$state": "/detail/aggregate/maxDurationMs"
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Duration over recent runs",
          "actionText": "oldest \u2192 newest"
        },
        "visible": {
          "$state": "/detailStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "LineChart",
            "props": {
              "rows": {
                "$state": "/detail/recent"
              },
              "reverse": true,
              "yFormat": "duration",
              "height": 280,
              "series": [
                {
                  "name": "duration",
                  "yKey": "durationMs",
                  "strokeClass": "stroke-accent",
                  "areaClass": "fill-accent/10"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Config",
          "actionText": {
            "$computed": "text",
            "args": {
              "tpl": "resolved \u00b7 source: {s}",
              "s": {
                "$state": "/config/source"
              }
            }
          }
        },
        "visible": {
          "$state": "/configStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "Text",
            "props": {
              "text": "The project's config file changed since vx lock \u2014 this is the FROZEN config. Run vx lock to refreeze.",
              "tone": "warn",
              "class": "mb-3"
            },
            "visible": {
              "$state": "/config/stale",
              "eq": true
            }
          },
          {
            "type": "Json",
            "props": {
              "value": {
                "$state": "/config/config"
              }
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Latest cache entry",
          "actionHref": {
            "$computed": "text",
            "args": {
              "tpl": "/cache/{h}",
              "h": {
                "$state": "/detail/latestEntry/hash"
              }
            }
          },
          "actionLabel": "entry page \u2192"
        },
        "visible": {
          "$state": "/detail/latestEntry",
          "neq": null
        },
        "children": [
          {
            "type": "Facts",
            "props": {
              "entry": {
                "$state": "/detail/latestEntry"
              },
              "commandKey": "command",
              "fields": [
                {
                  "label": "hash",
                  "key": "hash",
                  "kind": "shorthash16"
                },
                {
                  "label": "size",
                  "key": "sizeBytes",
                  "kind": "bytes"
                },
                {
                  "label": "duration",
                  "key": "durationMs",
                  "kind": "duration"
                },
                {
                  "label": "created",
                  "key": "createdAt",
                  "kind": "relativeTime"
                },
                {
                  "label": "accessed",
                  "key": "accessedAt",
                  "kind": "relativeTime"
                },
                {
                  "label": "exit",
                  "key": "exitCode"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Cache key"
        },
        "visible": {
          "$state": "/cacheKeyStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "Facts",
            "props": {
              "entry": {
                "$state": "/cacheKey/latestEntry"
              },
              "commandKey": "command",
              "fields": [
                {
                  "label": "hash",
                  "key": "hash",
                  "kind": "shorthash16"
                },
                {
                  "label": "exit",
                  "key": "exitCode"
                },
                {
                  "label": "duration",
                  "key": "durationMs",
                  "kind": "duration"
                },
                {
                  "label": "size",
                  "key": "sizeBytes",
                  "kind": "bytes"
                },
                {
                  "label": "created",
                  "key": "createdAt",
                  "kind": "relativeTime"
                }
              ]
            }
          },
          {
            "type": "Empty",
            "props": {
              "title": "No cached entry yet",
              "hint": "run this task once to populate its cache key"
            },
            "visible": {
              "$state": "/cacheKey/latestEntry",
              "eq": null
            }
          },
          {
            "type": "Text",
            "props": {
              "text": {
                "$state": "/cacheKey/note"
              },
              "tone": "faint",
              "class": "mt-3"
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": {
            "$computed": "text",
            "args": {
              "tpl": "Recent runs ({n})",
              "n": {
                "$computed": "agg",
                "args": {
                  "arr": {
                    "$state": "/detail/recent"
                  },
                  "op": "count"
                }
              }
            }
          },
          "noPad": true
        },
        "visible": {
          "$state": "/detailStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "DataTable",
            "props": {
              "rows": {
                "$computed": "withTaskRef",
                "args": {
                  "arr": {
                    "$state": "/detail/recent"
                  }
                }
              },
              "rowHref": "/runs/{runId}?task={_taskRef}",
              "emptyTitle": "No runs yet",
              "columns": [
                {
                  "key": "startedAt",
                  "label": "When",
                  "kind": "relativeTime",
                  "baseTone": "faint"
                },
                {
                  "key": "status",
                  "label": "Status",
                  "kind": "status"
                },
                {
                  "key": "durationMs",
                  "label": "Duration",
                  "align": "right",
                  "kind": "duration"
                },
                {
                  "key": "cpuMs",
                  "label": "CPU",
                  "align": "right",
                  "kind": "duration",
                  "baseTone": "faint"
                },
                {
                  "key": "cpuMs",
                  "label": "CPU %",
                  "align": "right",
                  "kind": "cpuPct"
                },
                {
                  "key": "peakRssBytes",
                  "label": "Peak RSS",
                  "align": "right",
                  "kind": "bytes",
                  "baseTone": "faint"
                },
                {
                  "key": "hash",
                  "label": "Hash",
                  "align": "right",
                  "kind": "shorthash",
                  "len": 10
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
