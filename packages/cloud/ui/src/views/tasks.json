{
  "data": {
    "history": "history",
    "catalog": "catalogTasks"
  },
  "spec": {
    "type": "Page",
    "props": {
      "title": "Tasks",
      "subtitle": "The workspace's task catalog joined with run history — never-run tasks included when the serve is colocated."
    },
    "children": [
      {
        "type": "Card",
        "props": {
          "noPad": true
        },
        "children": [
          {
            "type": "DataTable",
            "props": {
              "rows": {
                "$computed": "joinTasks",
                "args": {
                  "history": {
                    "$state": "/history"
                  },
                  "catalog": {
                    "$state": "/catalog"
                  }
                }
              },
              "status": {
                "$state": "/historyStatus"
              },
              "filter": true,
              "filterFrom": [
                "id",
                "_kind"
              ],
              "filterPlaceholder": "filter by project#task…",
              "initialSort": {
                "key": "totalDurationMs",
                "desc": true
              },
              "rowHref": "/tasks/{id}",
              "emptyTitle": "No task history yet",
              "emptyCmd": "vx run <task>",
              "columns": [
                {
                  "key": "id",
                  "label": "Task",
                  "sortable": true,
                  "kind": "dots",
                  "dots": [
                    {
                      "field": "failureMode",
                      "map": "failureMode"
                    },
                    {
                      "field": "project",
                      "map": "palette"
                    }
                  ]
                },
                {
                  "key": "_kind",
                  "label": "Kind",
                  "baseTone": "faint"
                },
                {
                  "key": "runs",
                  "label": "Runs",
                  "align": "right",
                  "sortable": true
                },
                {
                  "key": "successRate",
                  "label": "Success",
                  "align": "right",
                  "sortable": true,
                  "kind": "percent0",
                  "tone": {
                    "lt": 0.9,
                    "tone": "danger"
                  }
                },
                {
                  "key": "hitRate",
                  "label": "Hit",
                  "align": "right",
                  "sortable": true,
                  "kind": "percent0",
                  "baseTone": "cache"
                },
                {
                  "key": "avgDurationMs",
                  "label": "Avg",
                  "align": "right",
                  "sortable": true,
                  "kind": "duration"
                },
                {
                  "key": "p50DurationMs",
                  "label": "p50",
                  "align": "right",
                  "sortable": true,
                  "kind": "duration"
                },
                {
                  "key": "p99DurationMs",
                  "label": "p99",
                  "align": "right",
                  "sortable": true,
                  "kind": "duration"
                },
                {
                  "key": "totalDurationMs",
                  "label": "Total time",
                  "align": "right",
                  "sortable": true,
                  "kind": "bar",
                  "format": "duration",
                  "colorFrom": "project"
                },
                {
                  "key": "lastSeenAt",
                  "label": "Last",
                  "align": "right",
                  "sortable": true,
                  "kind": "relativeTime",
                  "baseTone": "faint"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
