{
  "data": {
    "compare": "compare",
    "compareRows": "compareRows"
  },
  "spec": {
    "type": "Page",
    "props": {
      "backHref": "/runs",
      "backLabel": "runs",
      "title": {
        "$computed": "text",
        "args": {
          "tpl": "Compare {id}",
          "id": { "$state": "/params/id" }
        }
      },
      "subtitle": "vs the immediately-previous invocation",
      "mono": true
    },
    "children": [
      {
        "type": "Text",
        "props": { "text": "Loading…", "tone": "faint" },
        "visible": { "$state": "/compareStatus", "eq": "loading" }
      },
      {
        "type": "Empty",
        "props": { "title": "Run not found" },
        "visible": { "$state": "/compareStatus", "eq": "missing" }
      },
      {
        "type": "Empty",
        "props": {
          "title": "No previous run to compare against",
          "hint": "This is the earliest recorded invocation of these tasks."
        },
        "visible": { "$state": "/compare/found", "eq": false }
      },
      {
        "type": "Grid",
        "props": { "variant": "metrics-4" },
        "visible": { "$state": "/compare/found", "eq": true },
        "children": [
          {
            "type": "Metric",
            "props": {
              "label": "This run",
              "value": {
                "$computed": "fmtDuration",
                "args": { "ms": { "$state": "/compare/summary/aTotalMs" } }
              },
              "sub": "total task time"
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Previous run",
              "value": {
                "$computed": "fmtDuration",
                "args": { "ms": { "$state": "/compare/summary/bTotalMs" } }
              },
              "sub": "total task time"
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Delta",
              "value": {
                "$computed": "fmtSignedDuration",
                "args": { "ms": { "$state": "/compare/summary/totalDeltaMs" } }
              },
              "tone": {
                "$computed": "gt",
                "args": {
                  "v": { "$state": "/compare/summary/totalDeltaMs" },
                  "n": 0,
                  "then": "bad",
                  "else": "good"
                }
              },
              "sub": "this − previous · negative = faster"
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Tasks changed",
              "value": {
                "$computed": "fmtNumber",
                "args": { "n": { "$state": "/compare/summary/tasksChanged" } }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{a} only here · {b} only prev",
                  "a": { "$state": "/compare/summary/tasksOnlyInA" },
                  "b": { "$state": "/compare/summary/tasksOnlyInB" }
                }
              }
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Task diff",
          "actionText": "A = this run · B = previous",
          "noPad": true
        },
        "visible": { "$state": "/compareRowsStatus", "eq": "ok" },
        "children": [
          {
            "type": "DataTable",
            "props": {
              "rows": { "$state": "/compareRows" },
              "rowTaskRef": {},
              "filter": true,
              "filterFrom": ["taskId", "deltaKind"],
              "filterPlaceholder": "filter tasks…",
              "emptyTitle": "No tasks to compare",
              "columns": [
                { "key": "task", "label": "Task", "kind": "projtask" },
                {
                  "key": "aStatus",
                  "label": "A status",
                  "kind": "status",
                  "statusKey": "aStatus",
                  "cacheHitKey": "aCacheHit"
                },
                {
                  "key": "aDurationMs",
                  "label": "A dur",
                  "align": "right",
                  "kind": "duration"
                },
                {
                  "key": "bStatus",
                  "label": "B status",
                  "kind": "status",
                  "statusKey": "bStatus",
                  "cacheHitKey": "bCacheHit",
                  "baseTone": "faint"
                },
                {
                  "key": "bDurationMs",
                  "label": "B dur",
                  "align": "right",
                  "kind": "duration",
                  "baseTone": "faint"
                },
                {
                  "key": "deltaMs",
                  "label": "Δ duration",
                  "align": "right",
                  "sortable": true,
                  "kind": "deltaBar",
                  "baseKey": "baseMs",
                  "labelKey": "deltaLabel",
                  "neutralKey": "_sameKey",
                  "format": "signedDuration"
                },
                {
                  "key": "keyChanged",
                  "label": "Key",
                  "kind": "dots",
                  "dots": [{ "field": "keyChanged", "map": "keyChanged" }]
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
