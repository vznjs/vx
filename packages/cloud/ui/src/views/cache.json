{
  "refresh": 30000,
  "data": {
    "stats": "cacheStats",
    "savings": "cacheSavings",
    "breakdown": "cacheBreakdown",
    "storage": "storage",
    "entries": "cacheEntries"
  },
  "spec": {
    "type": "Page",
    "props": {
      "title": "Cache"
    },
    "children": [
      {
        "type": "Callout",
        "props": {
          "text": "Cache-entry inventory (entries, heat, storage) lives in the workspace's local cache.db \u2014 start vx-cloud serve inside the repo to see it. This serve shows pushed run analytics only, so the hit metrics below are real.",
          "tone": "muted"
        },
        "visible": {
          "$state": "/capsCacheMissing",
          "eq": true
        }
      },
      {
        "type": "Grid",
        "props": {
          "variant": "metrics-6"
        },
        "visible": {
          "$state": "/statsStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "Metric",
            "visible": {
              "$state": "/capsCacheMissing",
              "not": true
            },
            "props": {
              "label": "Entries",
              "value": {
                "$computed": "fmtNumber",
                "args": {
                  "n": {
                    "$state": "/stats/entryCount"
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "visible": {
              "$state": "/capsCacheMissing",
              "not": true
            },
            "props": {
              "label": "Total size",
              "value": {
                "$computed": "fmtBytes",
                "args": {
                  "b": {
                    "$state": "/stats/totalBytes"
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Hit rate (24h)",
              "value": {
                "$computed": "fmtPercent0",
                "args": {
                  "n": {
                    "$state": "/stats/hitRate24h"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{n} hits",
                  "n": {
                    "$state": "/stats/hitCountLast24h"
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Local hits (24h)",
              "value": {
                "$computed": "fmtNumber",
                "args": {
                  "n": {
                    "$state": "/stats/hitLocalCountLast24h"
                  }
                }
              },
              "sub": "restored from disk",
              "tone": "good"
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Remote hits (24h)",
              "value": {
                "$computed": "fmtNumber",
                "args": {
                  "n": {
                    "$state": "/stats/hitRemoteCountLast24h"
                  }
                }
              },
              "sub": "pulled from remote",
              "tone": "accent"
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Time saved (all-time)",
              "value": {
                "$computed": "fmtDuration",
                "args": {
                  "ms": {
                    "$state": "/savings/estimatedTimeSavedTotalMs"
                  }
                }
              },
              "tone": "good"
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Hit source (last 24h)",
          "actionText": "local vs remote"
        },
        "visible": {
          "$state": "/statsStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "DataTable",
            "props": {
              "rows": {
                "$computed": "hitSplitRows",
                "args": {
                  "local": {
                    "$state": "/stats/hitLocalCountLast24h"
                  },
                  "remote": {
                    "$state": "/stats/hitRemoteCountLast24h"
                  }
                }
              },
              "emptyTitle": "No cache hits in the last 24h",
              "columns": [
                {
                  "key": "source",
                  "label": "Source"
                },
                {
                  "key": "count",
                  "label": "Hits",
                  "align": "right",
                  "kind": "number"
                },
                {
                  "key": "_frac",
                  "label": "Share",
                  "align": "right",
                  "kind": "bar",
                  "format": "percent",
                  "colorKey": "_color"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Grid",
        "props": {
          "variant": "main-320"
        },
        "visible": {
          "$state": "/capsCacheMissing",
          "not": true
        },
        "children": [
          {
            "type": "Card",
            "props": {
              "title": "Storage by project"
            },
            "children": [
              {
                "type": "Treemap",
                "props": {
                  "rows": {
                    "$state": "/breakdown"
                  },
                  "status": {
                    "$state": "/breakdownStatus"
                  },
                  "labelKey": "project",
                  "valueKey": "totalBytes",
                  "valueFormat": "bytes",
                  "height": 240
                }
              }
            ]
          },
          {
            "type": "Card",
            "props": {
              "title": "By project",
              "noPad": true
            },
            "children": [
              {
                "type": "RankList",
                "props": {
                  "items": {
                    "$state": "/breakdown"
                  },
                  "status": {
                    "$state": "/breakdownStatus"
                  },
                  "labelKey": "project",
                  "valueKey": "totalBytes",
                  "valueFormat": "bytes",
                  "metaKey": "entries",
                  "metaSuffix": "\u00d7",
                  "barFrom": "totalBytes",
                  "colorFrom": "project",
                  "dots": [
                    {
                      "field": "project",
                      "map": "ident"
                    }
                  ],
                  "emptyTitle": "No data"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Storage growth (last 30 days)"
        },
        "visible": {
          "$state": "/capsCacheMissing",
          "not": true
        },
        "children": [
          {
            "type": "LineChart",
            "props": {
              "rows": {
                "$state": "/storage"
              },
              "status": {
                "$state": "/storageStatus"
              },
              "xKey": "t",
              "xFormat": "date",
              "yFormat": "bytes",
              "height": 240,
              "series": [
                {
                  "name": "bytes added",
                  "yKey": "bytesAdded",
                  "strokeClass": "stroke-accent-2",
                  "areaClass": "fill-accent-2/10"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Grid",
        "props": {
          "variant": "metrics-4"
        },
        "visible": {
          "$state": "/capsCacheMissing",
          "not": true
        },
        "children": [
          {
            "type": "Metric",
            "props": {
              "label": "Cold entries",
              "value": {
                "$computed": "fmtNumber",
                "args": {
                  "n": {
                    "$computed": "countCold",
                    "args": {
                      "arr": {
                        "$state": "/entries"
                      }
                    }
                  }
                }
              },
              "sub": "written, never re-hit",
              "tone": "warn"
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Reclaimable",
              "value": {
                "$computed": "coldBytes",
                "args": {
                  "arr": {
                    "$state": "/entries"
                  }
                }
              },
              "sub": "size of cold entries",
              "tone": "warn"
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Entries",
          "noPad": true
        },
        "children": [
          {
            "type": "DataTable",
            "props": {
              "rows": {
                "$computed": "coldEntries",
                "args": {
                  "arr": {
                    "$state": "/entries"
                  }
                }
              },
              "filter": true,
              "filterFrom": [
                "project",
                "task",
                "hash",
                "_heat"
              ],
              "filterPlaceholder": "filter by task, hash, or cold/stale/warm\u2026",
              "initialSort": {
                "key": "sizeBytes",
                "desc": true
              },
              "rowHref": "/cache/{hash}",
              "emptyTitle": "No matching entries",
              "columns": [
                {
                  "key": "_heat",
                  "label": "Heat",
                  "kind": "dots",
                  "dots": [
                    {
                      "field": "_heatToken",
                      "map": "heat"
                    }
                  ]
                },
                {
                  "key": "task",
                  "label": "Task",
                  "kind": "projtask"
                },
                {
                  "key": "_taskId",
                  "label": "",
                  "kind": "link",
                  "href": "/tasks/{_taskId}",
                  "linkLabel": "task \u2192"
                },
                {
                  "key": "hash",
                  "label": "Hash",
                  "kind": "shorthash",
                  "len": 12
                },
                {
                  "key": "sizeBytes",
                  "label": "Size",
                  "align": "right",
                  "kind": "bytes",
                  "sortable": true
                },
                {
                  "key": "durationMs",
                  "label": "Duration",
                  "align": "right",
                  "kind": "duration",
                  "sortable": true
                },
                {
                  "key": "createdAt",
                  "label": "Age",
                  "align": "right",
                  "kind": "relativeTime",
                  "baseTone": "faint",
                  "sortable": true
                },
                {
                  "key": "accessedAt",
                  "label": "Last hit",
                  "align": "right",
                  "kind": "relativeTime",
                  "baseTone": "faint",
                  "sortable": true
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Text",
        "props": {
          "text": "Cold = written but never restored since creation (accessed \u2248 created). These cache keys never paid off \u2014 review inputs or prune with `vx cache prune`.",
          "tone": "faint",
          "class": "px-1"
        }
      }
    ]
  }
}
