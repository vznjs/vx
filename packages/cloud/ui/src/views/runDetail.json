{
  "refresh": 5000,
  "data": {
    "run": "run",
    "runWhy": "runWhy",
    "invocation": "invocationDetail",
    "artifacts": "artifacts",
    "selectedTask": "runSelectedTask"
  },
  "spec": {
    "type": "Page",
    "props": {
      "backHref": "/runs",
      "backLabel": "runs",
      "title": {
        "$computed": "text",
        "args": {
          "tpl": "Run {id}",
          "id": {
            "$state": "/params/id"
          }
        }
      },
      "mono": true
    },
    "children": [
      {
        "type": "Text",
        "props": {
          "text": "Loading…",
          "tone": "faint"
        },
        "visible": {
          "$state": "/runStatus",
          "eq": "loading"
        }
      },
      {
        "type": "Empty",
        "props": {
          "title": "Run not found"
        },
        "visible": {
          "$state": "/runStatus",
          "eq": "missing"
        }
      },
      {
        "type": "Card",
        "props": {
          "title": "Invocation"
        },
        "visible": {
          "$state": "/invocationStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "Facts",
            "props": {
              "entry": {
                "$computed": "invocationFacts",
                "args": {
                  "inv": {
                    "$state": "/invocation"
                  }
                }
              },
              "commandKey": "command",
              "fields": [
                { "label": "branch", "key": "branch", "mono": true },
                { "label": "commit", "key": "commit", "kind": "text", "mono": true },
                { "label": "worktree", "key": "worktree" },
                { "label": "ci", "key": "ci" },
                { "label": "tags", "key": "tags", "mono": true },
                { "label": "cache", "key": "cachePolicy", "mono": true },
                { "label": "workers", "key": "concurrency" },
                { "label": "vx", "key": "vx", "mono": true }
              ]
            }
          }
        ]
      },
      {
        "type": "Grid",
        "props": {
          "variant": "metrics-5"
        },
        "visible": {
          "$state": "/runStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "Metric",
            "props": {
              "label": "Tasks",
              "value": {
                "$computed": "fmtNumber",
                "args": {
                  "n": {
                    "$computed": "agg",
                    "args": {
                      "arr": {
                        "$state": "/run/tasks"
                      },
                      "op": "count"
                    }
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{a} ok · {b} fail · {c} hits",
                  "a": {
                    "$computed": "countWhere",
                    "args": {
                      "arr": {
                        "$state": "/run/tasks"
                      },
                      "field": "status",
                      "eq": "success"
                    }
                  },
                  "b": {
                    "$computed": "countWhere",
                    "args": {
                      "arr": {
                        "$state": "/run/tasks"
                      },
                      "field": "status",
                      "eq": "failed"
                    }
                  },
                  "c": {
                    "$computed": "countWhere",
                    "args": {
                      "arr": {
                        "$state": "/run/tasks"
                      },
                      "field": "cacheHit",
                      "eq": true
                    }
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Wall time",
              "value": {
                "$computed": "fmtDuration",
                "args": {
                  "ms": {
                    "$computed": "span",
                    "args": {
                      "arr": {
                        "$state": "/run/tasks"
                      },
                      "start": "startedAt",
                      "end": "endedAt"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Total task time",
              "value": {
                "$computed": "aggFmt",
                "args": {
                  "arr": {
                    "$state": "/run/tasks"
                  },
                  "field": "durationMs",
                  "op": "sum",
                  "fmt": "duration"
                }
              },
              "sub": "sum across all tasks"
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "CPU time",
              "value": {
                "$computed": "aggFmt",
                "args": {
                  "arr": {
                    "$state": "/run/tasks"
                  },
                  "field": "cpuMs",
                  "op": "sum",
                  "fmt": "duration"
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Outcome",
              "value": {
                "$computed": "gt",
                "args": {
                  "v": {
                    "$computed": "countWhere",
                    "args": {
                      "arr": {
                        "$state": "/run/tasks"
                      },
                      "field": "status",
                      "eq": "failed"
                    }
                  },
                  "n": 0,
                  "then": "failed",
                  "else": "success"
                }
              },
              "tone": {
                "$computed": "gt",
                "args": {
                  "v": {
                    "$computed": "countWhere",
                    "args": {
                      "arr": {
                        "$state": "/run/tasks"
                      },
                      "field": "status",
                      "eq": "failed"
                    }
                  },
                  "n": 0,
                  "then": "bad",
                  "else": "good"
                }
              }
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Run",
          "actionText": "Graph = dependency structure · Flame = by actual time · click to inspect"
        },
        "visible": {
          "$state": "/runStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "RunViz",
            "props": {
              "rows": {
                "$state": "/run/tasks"
              }
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": {
            "$computed": "text",
            "args": {
              "tpl": "{p}#{t}",
              "p": { "$state": "/selectedTask/project" },
              "t": { "$state": "/selectedTask/task" }
            }
          }
        },
        "visible": { "$state": "/selectedTask" },
        "children": [
          {
            "type": "Facts",
            "props": {
              "entry": { "$state": "/selectedTask" },
              "fields": [
                { "label": "Status", "key": "status", "kind": "text" },
                { "label": "Started", "key": "startedAt", "kind": "dateTime" },
                { "label": "Ended", "key": "endedAt", "kind": "dateTime" },
                { "label": "Duration", "key": "durationMs", "kind": "duration" },
                { "label": "CPU", "key": "cpuMs", "kind": "duration" },
                { "label": "Peak RSS", "key": "peakRssBytes", "kind": "bytes" },
                { "label": "Exit", "key": "exitCode", "kind": "text" },
                { "label": "Hash", "key": "hash", "kind": "shorthash16" }
              ]
            }
          },
          {
            "type": "ArtifactDownload",
            "props": {
              "hash": { "$state": "/selectedTask/hash" },
              "artifacts": { "$state": "/artifacts" }
            }
          },
          {
            "type": "Text",
            "props": { "text": "Logs", "size": "xs", "tone": "muted" }
          },
          {
            "type": "TaskLogs",
            "props": {
              "runId": { "$state": "/params/id" },
              "project": { "$state": "/selectedTask/project" },
              "task": { "$state": "/selectedTask/task" }
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": {
            "$computed": "text",
            "args": {
              "tpl": "Tasks ({n})",
              "n": {
                "$computed": "agg",
                "args": {
                  "arr": {
                    "$state": "/run/tasks"
                  },
                  "op": "count"
                }
              }
            }
          },
          "noPad": true
        },
        "visible": {
          "$state": "/runStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "DataTable",
            "props": {
              "rows": {
                "$state": "/run/tasks"
              },
              "rowTaskRef": {},
              "emptyTitle": "No tasks",
              "columns": [
                {
                  "key": "task",
                  "label": "Task",
                  "kind": "projtask"
                },
                {
                  "key": "project",
                  "label": "Project",
                  "kind": "link",
                  "href": "/projects/{project}",
                  "linkLabel": "{project}"
                },
                {
                  "key": "status",
                  "label": "Status",
                  "kind": "status"
                },
                {
                  "key": "durationMs",
                  "label": "Duration",
                  "align": "right",
                  "kind": "duration"
                },
                {
                  "key": "cpuMs",
                  "label": "CPU",
                  "align": "right",
                  "kind": "duration",
                  "baseTone": "faint"
                },
                {
                  "key": "cpuMs",
                  "label": "CPU %",
                  "align": "right",
                  "kind": "cpuPct"
                },
                {
                  "key": "peakRssBytes",
                  "label": "Peak RSS",
                  "align": "right",
                  "kind": "bytes",
                  "baseTone": "faint"
                },
                {
                  "key": "cacheHit",
                  "label": "Cache",
                  "align": "right",
                  "kind": "cache"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Why did this re-run?",
          "actionText": "only tasks that executed — cache hits are excluded",
          "noPad": true
        },
        "visible": {
          "$state": "/runWhyStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "DataTable",
            "props": {
              "rows": {
                "$state": "/runWhy"
              },
              "emptyTitle": "Nothing re-ran — every task was a cache hit",
              "filter": true,
              "filterFrom": ["taskId", "reason"],
              "filterPlaceholder": "filter by task or reason…",
              "columns": [
                {
                  "key": "task",
                  "label": "Task",
                  "kind": "projtask"
                },
                {
                  "key": "reason",
                  "label": "Reason"
                }
              ]
            }
          },
          {
            "type": "Text",
            "props": {
              "text": "Per-file / env / dependency detail (which exact input changed) lives in the workspace's local cache.db — run vx why in the repo to see it. This serve shows the re-run verdict per task.",
              "tone": "faint",
              "class": "px-4 py-3"
            }
          }
        ]
      }
    ]
  }
}
