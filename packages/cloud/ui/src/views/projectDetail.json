{
  "data": {
    "summary": "projectSummary",
    "tasks": "projectTasks",
    "catalog": "catalogProject",
    "trend": "projectTrend"
  },
  "spec": {
    "type": "Page",
    "props": {
      "backHref": "/projects",
      "backLabel": "projects",
      "dotColor": {
        "$computed": "palette",
        "args": {
          "key": {
            "$state": "/params/name"
          }
        }
      },
      "title": {
        "$state": "/params/name"
      },
      "mono": true
    },
    "children": [
      {
        "type": "Grid",
        "props": {
          "variant": "metrics-5"
        },
        "visible": {
          "$state": "/summaryStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "Metric",
            "props": {
              "label": "Total runs",
              "value": {
                "$computed": "fmtNumber",
                "args": {
                  "n": {
                    "$state": "/summary/runs"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{n} tasks",
                  "n": {
                    "$state": "/summary/taskCount"
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Total time",
              "value": {
                "$computed": "fmtDuration",
                "args": {
                  "ms": {
                    "$state": "/summary/totalDurationMs"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "avg {a}",
                  "a": {
                    "$computed": "fmtDuration",
                    "args": {
                      "ms": {
                        "$state": "/summary/avgDurationMs"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Time saved",
              "value": {
                "$computed": "fmtDuration",
                "args": {
                  "ms": {
                    "$state": "/summary/estimatedTimeSavedMs"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{n} hits",
                  "n": {
                    "$state": "/summary/hits"
                  }
                }
              },
              "tone": "good"
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Hit rate",
              "value": {
                "$computed": "fmtPercent0",
                "args": {
                  "n": {
                    "$state": "/summary/hitRate"
                  }
                }
              },
              "tone": {
                "$computed": "gt",
                "args": {
                  "v": {
                    "$state": "/summary/hitRate"
                  },
                  "n": 0.5,
                  "then": "good",
                  "else": "default"
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Cache",
              "value": {
                "$computed": "fmtBytes",
                "args": {
                  "b": {
                    "$state": "/summary/cacheBytes"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{n} entries",
                  "n": {
                    "$state": "/summary/cacheEntries"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "Grid",
        "props": {
          "variant": "metrics-4"
        },
        "visible": {
          "$state": "/trend/hasData",
          "eq": true
        },
        "children": [
          {
            "type": "Metric",
            "props": {
              "label": "Avg exec (this 7d)",
              "value": {
                "$computed": "fmtDuration",
                "args": {
                  "ms": {
                    "$state": "/trend/current/avgDurationMs"
                  }
                }
              },
              "sub": {
                "$state": "/trend/_avgLabel"
              },
              "tone": {
                "$state": "/trend/_avgTone"
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Failure rate (this 7d)",
              "value": {
                "$computed": "fmtPercent0",
                "args": {
                  "n": {
                    "$state": "/trend/current/failureRate"
                  }
                }
              },
              "sub": {
                "$state": "/trend/_failureLabel"
              },
              "tone": {
                "$state": "/trend/_failureTone"
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Runs (this 7d)",
              "value": {
                "$computed": "fmtNumber",
                "args": {
                  "n": {
                    "$state": "/trend/current/runs"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{d} vs prior 7d",
                  "d": {
                    "$state": "/trend/_runsDelta"
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Cache hit rate (this 7d)",
              "value": {
                "$computed": "fmtPercent0",
                "args": {
                  "n": {
                    "$state": "/trend/current/cacheHitRate"
                  }
                }
              },
              "sub": {
                "$state": "/trend/_hitLabel"
              },
              "tone": {
                "$state": "/trend/_hitTone"
              }
            }
          }
        ]
      },
      {
        "type": "Empty",
        "props": {
          "title": "No data for this project"
        },
        "visible": [
          {
            "$state": "/summaryStatus",
            "eq": "missing"
          },
          {
            "$state": "/catalogStatus",
            "eq": "missing"
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Resolved config",
          "actionText": {
            "$computed": "text",
            "args": {
              "tpl": "source: {s} \u00b7 {p}",
              "s": {
                "$state": "/catalog/source"
              },
              "p": {
                "$state": "/catalog/configPath"
              }
            }
          }
        },
        "visible": {
          "$state": "/catalogStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "Text",
            "props": {
              "text": "This project's config file changed since vx lock \u2014 the blocks below show the FROZEN configs. Run vx lock to refreeze.",
              "tone": "warn",
              "class": "mb-3"
            },
            "visible": {
              "$state": "/catalog/stale",
              "eq": true
            }
          },
          {
            "type": "TaskConfigList",
            "props": {
              "config": {
                "$state": "/catalog/config"
              },
              "project": {
                "$state": "/params/name"
              }
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": {
            "$computed": "text",
            "args": {
              "tpl": "Task history ({n})",
              "n": {
                "$computed": "agg",
                "args": {
                  "arr": {
                    "$state": "/tasks"
                  },
                  "op": "count"
                }
              }
            }
          },
          "noPad": true
        },
        "children": [
          {
            "type": "DataTable",
            "props": {
              "rows": {
                "$state": "/tasks"
              },
              "rowHref": "/tasks/{id}",
              "emptyTitle": "No tasks recorded",
              "columns": [
                {
                  "key": "task",
                  "label": "Task",
                  "kind": "projtask"
                },
                {
                  "key": "runs",
                  "label": "Runs",
                  "align": "right"
                },
                {
                  "key": "successRate",
                  "label": "Success",
                  "align": "right",
                  "kind": "percent0",
                  "tone": {
                    "lt": 0.9,
                    "tone": "danger"
                  }
                },
                {
                  "key": "hitRate",
                  "label": "Hit",
                  "align": "right",
                  "kind": "percent0",
                  "baseTone": "cache"
                },
                {
                  "key": "avgDurationMs",
                  "label": "Avg",
                  "align": "right",
                  "kind": "duration"
                },
                {
                  "key": "p99DurationMs",
                  "label": "p99",
                  "align": "right",
                  "kind": "duration"
                },
                {
                  "key": "totalDurationMs",
                  "label": "Total",
                  "align": "right",
                  "kind": "bar",
                  "format": "duration",
                  "colorFrom": "project"
                },
                {
                  "key": "lastSeenAt",
                  "label": "Last",
                  "align": "right",
                  "kind": "relativeTime",
                  "baseTone": "faint"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}