{
  "data": {
    "summary": "projectSummary",
    "tasks": "projectTasks"
  },
  "spec": {
    "type": "Page",
    "props": {
      "backHref": "/projects",
      "backLabel": "projects",
      "dotColor": {
        "$computed": "palette",
        "args": {
          "key": {
            "$state": "/params/name"
          }
        }
      },
      "title": {
        "$state": "/params/name"
      },
      "mono": true
    },
    "children": [
      {
        "type": "Grid",
        "props": {
          "variant": "metrics-5"
        },
        "visible": {
          "$state": "/summaryStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "Metric",
            "props": {
              "label": "Total runs",
              "value": {
                "$computed": "fmtNumber",
                "args": {
                  "n": {
                    "$state": "/summary/runs"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{n} tasks",
                  "n": {
                    "$state": "/summary/taskCount"
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Total time",
              "value": {
                "$computed": "fmtDuration",
                "args": {
                  "ms": {
                    "$state": "/summary/totalDurationMs"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "avg {a}",
                  "a": {
                    "$computed": "fmtDuration",
                    "args": {
                      "ms": {
                        "$state": "/summary/avgDurationMs"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Time saved",
              "value": {
                "$computed": "fmtDuration",
                "args": {
                  "ms": {
                    "$state": "/summary/estimatedTimeSavedMs"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{n} hits",
                  "n": {
                    "$state": "/summary/hits"
                  }
                }
              },
              "tone": "good"
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Hit rate",
              "value": {
                "$computed": "fmtPercent0",
                "args": {
                  "n": {
                    "$state": "/summary/hitRate"
                  }
                }
              },
              "tone": {
                "$computed": "gt",
                "args": {
                  "v": {
                    "$state": "/summary/hitRate"
                  },
                  "n": 0.5,
                  "then": "good",
                  "else": "default"
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Cache",
              "value": {
                "$computed": "fmtBytes",
                "args": {
                  "b": {
                    "$state": "/summary/cacheBytes"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{n} entries",
                  "n": {
                    "$state": "/summary/cacheEntries"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "Empty",
        "props": {
          "title": "No data for this project"
        },
        "visible": {
          "$state": "/summaryStatus",
          "eq": "missing"
        }
      },
      {
        "type": "Card",
        "props": {
          "title": {
            "$computed": "text",
            "args": {
              "tpl": "Tasks ({n})",
              "n": {
                "$computed": "agg",
                "args": {
                  "arr": {
                    "$state": "/tasks"
                  },
                  "op": "count"
                }
              }
            }
          },
          "noPad": true
        },
        "children": [
          {
            "type": "DataTable",
            "props": {
              "rows": {
                "$state": "/tasks"
              },
              "rowHref": "/tasks/{id}",
              "emptyTitle": "No tasks recorded",
              "columns": [
                {
                  "key": "task",
                  "label": "Task",
                  "kind": "projtask"
                },
                {
                  "key": "runs",
                  "label": "Runs",
                  "align": "right"
                },
                {
                  "key": "successRate",
                  "label": "Success",
                  "align": "right",
                  "kind": "percent0",
                  "tone": {
                    "lt": 0.9,
                    "tone": "danger"
                  }
                },
                {
                  "key": "hitRate",
                  "label": "Hit",
                  "align": "right",
                  "kind": "percent0",
                  "baseTone": "cache"
                },
                {
                  "key": "avgDurationMs",
                  "label": "Avg",
                  "align": "right",
                  "kind": "duration"
                },
                {
                  "key": "p99DurationMs",
                  "label": "p99",
                  "align": "right",
                  "kind": "duration"
                },
                {
                  "key": "totalDurationMs",
                  "label": "Total",
                  "align": "right",
                  "kind": "bar",
                  "format": "duration",
                  "colorFrom": "project"
                },
                {
                  "key": "lastSeenAt",
                  "label": "Last",
                  "align": "right",
                  "kind": "relativeTime",
                  "baseTone": "faint"
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
