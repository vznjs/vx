{
  "data": {
    "summary": "projectSummary",
    "tasks": "projectTasks",
    "catalog": "catalogProject",
    "trend": "projectTrend",
    "failTrend": "projectFailureTrend",
    "rankings": "projectRankings",
    "taskTrends": "projectTaskTrends",
    "branchFails": "projectBranchFailures",
    "recent": "projectRecent"
  },
  "spec": {
    "type": "Page",
    "props": {
      "backHref": "/projects",
      "backLabel": "projects",
      "dotColor": {
        "$computed": "palette",
        "args": {
          "key": {
            "$state": "/params/name"
          }
        }
      },
      "title": {
        "$state": "/params/name"
      },
      "mono": true,
      "pinProject": {
        "$state": "/params/name"
      }
    },
    "children": [
      {
        "type": "TimeframeSelect"
      },
      {
        "type": "Grid",
        "props": {
          "variant": "metrics-5"
        },
        "visible": {
          "$state": "/summaryStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "Metric",
            "props": {
              "label": "Total runs",
              "value": {
                "$computed": "fmtNumber",
                "args": {
                  "n": {
                    "$state": "/summary/runs"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{n} tasks",
                  "n": {
                    "$state": "/summary/taskCount"
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Total time",
              "value": {
                "$computed": "fmtDuration",
                "args": {
                  "ms": {
                    "$state": "/summary/totalDurationMs"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "avg {a}",
                  "a": {
                    "$computed": "fmtDuration",
                    "args": {
                      "ms": {
                        "$state": "/summary/avgDurationMs"
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Time saved",
              "value": {
                "$computed": "fmtDuration",
                "args": {
                  "ms": {
                    "$state": "/summary/estimatedTimeSavedMs"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{n} hits",
                  "n": {
                    "$state": "/summary/hits"
                  }
                }
              },
              "tone": "good"
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Hit rate",
              "value": {
                "$computed": "fmtPercent0",
                "args": {
                  "n": {
                    "$state": "/summary/hitRate"
                  }
                }
              },
              "tone": {
                "$computed": "gt",
                "args": {
                  "v": {
                    "$state": "/summary/hitRate"
                  },
                  "n": 0.5,
                  "then": "good",
                  "else": "default"
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Cache",
              "value": {
                "$computed": "fmtBytes",
                "args": {
                  "b": {
                    "$state": "/summary/cacheBytes"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{n} entries",
                  "n": {
                    "$state": "/summary/cacheEntries"
                  }
                }
              }
            }
          }
        ]
      },
      {
        "type": "Grid",
        "props": {
          "variant": "metrics-4"
        },
        "visible": {
          "$state": "/trend/hasData",
          "eq": true
        },
        "children": [
          {
            "type": "Metric",
            "props": {
              "label": "Avg exec",
              "value": {
                "$computed": "fmtDuration",
                "args": {
                  "ms": {
                    "$state": "/trend/current/avgDurationMs"
                  }
                }
              },
              "sub": {
                "$state": "/trend/_avgLabel"
              },
              "tone": {
                "$state": "/trend/_avgTone"
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Failure rate",
              "value": {
                "$computed": "fmtPercent0",
                "args": {
                  "n": {
                    "$state": "/trend/current/failureRate"
                  }
                }
              },
              "sub": {
                "$state": "/trend/_failureLabel"
              },
              "tone": {
                "$state": "/trend/_failureTone"
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Runs",
              "value": {
                "$computed": "fmtNumber",
                "args": {
                  "n": {
                    "$state": "/trend/current/runs"
                  }
                }
              },
              "sub": {
                "$computed": "text",
                "args": {
                  "tpl": "{d} vs prior window",
                  "d": {
                    "$state": "/trend/_runsDelta"
                  }
                }
              }
            }
          },
          {
            "type": "Metric",
            "props": {
              "label": "Cache hit rate",
              "value": {
                "$computed": "fmtPercent0",
                "args": {
                  "n": {
                    "$state": "/trend/current/cacheHitRate"
                  }
                }
              },
              "sub": {
                "$state": "/trend/_hitLabel"
              },
              "tone": {
                "$state": "/trend/_hitTone"
              }
            }
          }
        ]
      },
      {
        "type": "Empty",
        "props": {
          "title": "No data for this project"
        },
        "visible": [
          {
            "$state": "/summaryStatus",
            "eq": "missing"
          },
          {
            "$state": "/catalogStatus",
            "eq": "missing"
          }
        ]
      },
      {
        "type": "Grid",
        "props": {
          "variant": "main-320"
        },
        "children": [
          {
            "type": "Card",
            "props": {
              "title": "Failures & runs over time",
              "actionText": "runs · hits · failures per bucket"
            },
            "children": [
              {
                "type": "LineChart",
                "props": {
                  "rows": {
                    "$state": "/failTrend"
                  },
                  "status": {
                    "$state": "/failTrendStatus"
                  },
                  "xKey": "t",
                  "xFormat": "date",
                  "yFormat": "count",
                  "height": 300,
                  "series": [
                    {
                      "name": "runs",
                      "yKey": "runs",
                      "strokeClass": "stroke-accent",
                      "areaClass": "fill-accent/10"
                    },
                    {
                      "name": "hits",
                      "yKey": "hits",
                      "strokeClass": "stroke-cache-local"
                    },
                    {
                      "name": "failures",
                      "yKey": "failures",
                      "strokeClass": "stroke-danger"
                    }
                  ]
                }
              }
            ]
          },
          {
            "type": "Card",
            "props": {
              "title": "How this project ranks",
              "actionText": {
                "$computed": "text",
                "args": {
                  "tpl": "vs {n} projects",
                  "n": {
                    "$state": "/rankings/total"
                  }
                }
              },
              "noPad": true
            },
            "visible": {
              "$state": "/rankingsStatus",
              "eq": "ok"
            },
            "children": [
              {
                "type": "Text",
                "props": {
                  "text": "By failure rate",
                  "tone": "faint",
                  "mono": true,
                  "class": "px-4 pt-3 pb-1"
                }
              },
              {
                "type": "RankList",
                "props": {
                  "items": {
                    "$state": "/rankings/byFailRate"
                  },
                  "labelKey": "project",
                  "valueKey": "_value",
                  "valueFormat": "percent0",
                  "subKey": "_rankLabel",
                  "highlightKey": "_me",
                  "rowHref": "/projects/{project}",
                  "emptyTitle": "No projects"
                }
              },
              {
                "type": "Text",
                "props": {
                  "text": "By avg exec time",
                  "tone": "faint",
                  "mono": true,
                  "class": "px-4 pt-3 pb-1 border-t border-border"
                }
              },
              {
                "type": "RankList",
                "props": {
                  "items": {
                    "$state": "/rankings/byAvg"
                  },
                  "labelKey": "project",
                  "valueKey": "_value",
                  "valueFormat": "duration",
                  "subKey": "_rankLabel",
                  "highlightKey": "_me",
                  "rowHref": "/projects/{project}",
                  "emptyTitle": "No projects"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Task duration trends",
          "actionText": "avg exec per bucket over the window · spot outliers & spikes",
          "noPad": true
        },
        "visible": {
          "$state": "/taskTrendsStatus",
          "neq": "missing"
        },
        "children": [
          {
            "type": "SparkList",
            "props": {
              "items": {
                "$state": "/taskTrends"
              },
              "status": {
                "$state": "/taskTrendsStatus"
              },
              "labelKey": "task",
              "seriesKey": "series",
              "valueKey": "_latest",
              "valueFormat": "duration",
              "trendKey": "_trend",
              "dots": [
                {
                  "field": "_dir",
                  "map": "delta"
                }
              ],
              "rowHref": "/tasks/{_taskRef}",
              "emptyTitle": "No executed task durations in this window"
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Where failures were first noticed — across branches",
          "actionText": "the branch each task first started failing on",
          "noPad": true
        },
        "visible": {
          "$state": "/branchFailsStatus",
          "neq": "missing"
        },
        "children": [
          {
            "type": "DataTable",
            "props": {
              "rows": {
                "$state": "/branchFails"
              },
              "status": {
                "$state": "/branchFailsStatus"
              },
              "rowHref": "/tasks/{_taskRef}",
              "emptyTitle": "No failures in this window 🎉",
              "emptyHint": "No task in this project has failed in the selected timeframe.",
              "columns": [
                {
                  "key": "task",
                  "label": "Task",
                  "kind": "mono",
                  "baseTone": "danger"
                },
                {
                  "key": "firstBranch",
                  "label": "First branch",
                  "kind": "mono",
                  "baseTone": "danger"
                },
                {
                  "key": "firstFailedAt",
                  "label": "First noticed",
                  "align": "right",
                  "kind": "relativeTime"
                },
                {
                  "key": "firstCommit",
                  "label": "Commit",
                  "kind": "shorthash"
                },
                {
                  "key": "branchesFailing",
                  "label": "Branches",
                  "align": "right",
                  "tone": {
                    "gt": 1,
                    "tone": "danger"
                  }
                },
                {
                  "key": "_branchList",
                  "label": "On",
                  "kind": "mono",
                  "baseTone": "faint"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": {
            "$computed": "text",
            "args": {
              "tpl": "Tasks — lifetime + Δ vs prior window ({n})",
              "n": {
                "$computed": "agg",
                "args": {
                  "arr": {
                    "$state": "/tasks"
                  },
                  "op": "count"
                }
              }
            }
          },
          "noPad": true
        },
        "children": [
          {
            "type": "DataTable",
            "props": {
              "rows": {
                "$state": "/tasks"
              },
              "status": {
                "$state": "/tasksStatus"
              },
              "rowHref": "/tasks/{id}",
              "emptyTitle": "No tasks recorded",
              "columns": [
                {
                  "key": "task",
                  "label": "Task",
                  "kind": "projtask"
                },
                {
                  "key": "runs",
                  "label": "Runs",
                  "align": "right"
                },
                {
                  "key": "successRate",
                  "label": "Success",
                  "align": "right",
                  "kind": "percent0",
                  "tone": {
                    "lt": 0.9,
                    "tone": "danger"
                  }
                },
                {
                  "key": "hitRate",
                  "label": "Hit",
                  "align": "right",
                  "kind": "percent0",
                  "baseTone": "cache"
                },
                {
                  "key": "avgDurationMs",
                  "label": "Avg",
                  "align": "right",
                  "kind": "duration"
                },
                {
                  "key": "p99DurationMs",
                  "label": "p99",
                  "align": "right",
                  "kind": "duration"
                },
                {
                  "key": "_deltaLabel",
                  "label": "Δavg",
                  "align": "right",
                  "kind": "dots",
                  "dots": [
                    {
                      "field": "_deltaDir",
                      "map": "delta"
                    }
                  ]
                },
                {
                  "key": "lastSeenAt",
                  "label": "Last",
                  "align": "right",
                  "kind": "relativeTime",
                  "baseTone": "faint"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Recent executions",
          "actionText": "row → the run with logs open · debug each execution",
          "noPad": true
        },
        "children": [
          {
            "type": "DataTable",
            "props": {
              "rows": {
                "$state": "/recent"
              },
              "status": {
                "$state": "/recentStatus"
              },
              "rowHref": "/runs/{runId}?task={_taskRef}",
              "emptyTitle": "No executions recorded",
              "columns": [
                {
                  "key": "startedAt",
                  "label": "When",
                  "align": "right",
                  "kind": "relativeTime",
                  "baseTone": "faint"
                },
                {
                  "key": "task",
                  "label": "Task",
                  "kind": "mono"
                },
                {
                  "key": "status",
                  "label": "Status",
                  "kind": "status"
                },
                {
                  "key": "durationMs",
                  "label": "Duration",
                  "align": "right",
                  "kind": "duration"
                },
                {
                  "key": "hash",
                  "label": "Cache key",
                  "kind": "shorthash"
                }
              ]
            }
          }
        ]
      },
      {
        "type": "Card",
        "props": {
          "title": "Resolved config",
          "actionText": {
            "$computed": "text",
            "args": {
              "tpl": "source: {s} · {p}",
              "s": {
                "$state": "/catalog/source"
              },
              "p": {
                "$state": "/catalog/configPath"
              }
            }
          }
        },
        "visible": {
          "$state": "/catalogStatus",
          "eq": "ok"
        },
        "children": [
          {
            "type": "Text",
            "props": {
              "text": "This project's config file changed since vx lock — the blocks below show the FROZEN configs. Run vx lock to refreeze.",
              "tone": "warn",
              "class": "mb-3"
            },
            "visible": {
              "$state": "/catalog/stale",
              "eq": true
            }
          },
          {
            "type": "TaskConfigList",
            "props": {
              "config": {
                "$state": "/catalog/config"
              },
              "project": {
                "$state": "/params/name"
              }
            }
          }
        ]
      }
    ]
  }
}
