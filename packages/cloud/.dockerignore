# Build context is the REPO ROOT (`docker build -f packages/cloud/Dockerfile .`),
# so these patterns prune the root tree handed to the daemon. Keep it lean:
# the build stage needs source + lockfile + the dashboard SOURCE
# (packages/cloud/ui/src) — it builds the SPA dist itself before compiling.

# Installed deps + their symlinks — `bun install` reproduces them in-image.
node_modules
**/node_modules

# VCS + local tooling.
.git
.github
.claude
.vscode
.idea

# vx's own caches + run metadata (also keeps a stale cache.db out of the image).
.vx
.nx
.turbo
.nxt

# Editor / OS / profiling noise.
*.log
*.tsbuildinfo
*.cpuprofile
*.heapsnapshot
.DS_Store
.env
.env.local
coverage

# Tests + fixtures are not needed to compile the binary.
tests
**/tests
bench

# The docs site app and its generated content are irrelevant to the image.
apps/docs

# The dashboard SPA's node_modules are reinstalled in-image by `bun install`;
# the dist is BUILT in the image (see the Dockerfile `bun run build` step), not
# copied from the context — so nothing under ui/dist needs whitelisting.
packages/cloud/ui/node_modules
