# Build context is the REPO ROOT (`docker build -f packages/cloud/Dockerfile .`),
# so these patterns prune the root tree handed to the daemon. Keep it lean:
# the build stage only needs source + lockfile + the committed
# packages/cloud/ui/dist (which ui-asset.ts embeds via `with { type: 'file' }`).

# Installed deps + their symlinks — `bun install` reproduces them in-image.
node_modules
**/node_modules

# VCS + local tooling.
.git
.github
.claude
.vscode
.idea

# vx's own caches + run metadata (also keeps a stale cache.db out of the image).
.vx
.nx
.turbo
.nxt

# Editor / OS / profiling noise.
*.log
*.tsbuildinfo
*.cpuprofile
*.heapsnapshot
.DS_Store
.env
.env.local
coverage

# Tests + fixtures are not needed to compile the binary.
tests
**/tests
bench

# The docs site app and its generated content are irrelevant to the image.
apps/docs

# The dashboard SPA's node_modules are not needed — the COMMITTED
# packages/cloud/ui/dist is what the binary embeds.
# NB: packages/cloud/ui/dist/index.html IS needed and is whitelisted below.
packages/cloud/ui/node_modules

# Re-include the committed single-file dashboard the binary embeds.
!packages/cloud/ui/dist
!packages/cloud/ui/dist/index.html
