// The relay on Cloudflare Workers (src/worker.ts): what the README's Deploy
// to Cloudflare button reads, and `bunx wrangler deploy` from this directory.
// Each run is one Durable Object, held in its own storage.
{
  "name": "vx-dte-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  // The relay's URL until a domain is added.
  "workers_dev": true,
  // Who may take part, space separated, `issuer:owner/repo:workflow`: this
  // repository's CI. A deploy sets it from here, since wrangler replaces a
  // dashboard var on every deploy; an empty one made every run's object
  // refuse to start (2026-10-22). A fork names its own.
  "vars": {
    "ALLOW": "https://token.actions.githubusercontent.com:vznjs/vx:ci.yml https://token.actions.githubusercontent.com:vznjs/vx:vx-agent.yml",
  },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayRun" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayRun"] }],
}
