{
  "name": "@vzn/vx-dte-relay",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "description": "The reference relay for @vzn/vx-dte: carries messages between a vx run's orchestrator and its CI agents, admitting only CI OIDC tokens of the same pipeline.",
  "keywords": [
    "vx",
    "distributed",
    "ci",
    "relay"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "vx-dte-relay": "./src/bin.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "index.ts",
    "src",
    "PROTOCOL.md",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@vzn/vx": "workspace:*"
  }
}
