{
  "name": "@nxt/cli",
  "version": "0.0.0",
  "description": "Command-line interface for nxt.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "nxt": "./dist/bin.js"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@nxt/config": "workspace:*",
    "@nxt/core": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
