// vx-history-server on Cloudflare Workers (src/worker.ts): `bunx wrangler
// deploy` from this directory. The timings live in D1.
{
  "name": "vx-history-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // ALLOW: who may take part, issuer:owner/repo:workflow entries
  // separated by spaces (README.md § CI tokens); empty, every request is
  // refused with "set ALLOW". AUDIENCE: the aud a
  // CI token names, unset the Worker's own origin. TIMING_DAYS: days a
  // task's timings outlive its last report (default 30).
  "vars": { "ALLOW": "" },
  "d1_databases": [{ "binding": "DB", "database_name": "vx-history" }],
}
