{
  "name": "@vzn/vx-schedule-history",
  "version": "0.0.0",
  "description": "History-based scheduling for vx — a `schedule` plugin that orders ready tasks by their expected remaining critical path, learned from the local run history.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@vzn/vx": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@vzn/vx": "*"
  }
}
