// vx-cache-server on Cloudflare Workers (src/worker.ts): `bunx wrangler
// deploy` from this directory. Blobs live in R2, the rest in D1.
{
  "name": "vx-cache-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // TRUST: the CI OIDC trust rules, a JSON list (README.md § CI tokens);
  // empty, every request is refused with "set TRUST". AUDIENCE: the aud a
  // CI token names, unset the Worker's own origin.
  "vars": { "TRUST": "" },
  // Daily eviction (src/evict.ts): TRUSTED_DAYS, BRANCH_DAYS and TIMING_DAYS
  // vars set how long each keeps (default 30, 7, 30). Free plan: 5 crons.
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "vx-cache" }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "vx-cache" }],
}
