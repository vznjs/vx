// vx-cache-server on Cloudflare Workers (src/worker.ts): `bunx wrangler
// deploy` from this directory. Artifacts live in R2, and nothing else.
{
  "name": "vx-cache-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // TRUST: the CI OIDC trust rules, a JSON list (README.md § CI tokens);
  // empty, every request is refused with "set TRUST". AUDIENCE: the aud a
  // CI token names, unset the Worker's own origin. MAX_CHECK_KEYS,
  // MAX_BATCH_ARTIFACTS and MAX_UPLOAD_BYTES set the limits (PROTOCOL.md).
  "vars": { "TRUST": "" },
  // Expiry is the bucket's lifecycle rules (README.md § Expiry).
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "vx-cache" }],
}
