// vx-cache-server on Cloudflare Workers (src/worker.ts): `bunx wrangler
// deploy` from this directory. Artifacts live in R2, and nothing else.
{
  "name": "vx-cache-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // ALLOW: who may take part, issuer:owner/repo:workflow entries
  // separated by spaces (README.md § CI tokens); empty, every request is
  // refused with "set ALLOW". AUDIENCE: the aud a
  // CI token names, unset the Worker's own origin. MAX_CHECK_HASHES
  // and MAX_UPLOAD_BYTES set the limits, a string or a number (PROTOCOL.md).
  "vars": { "ALLOW": "" },
  // Expiry is the bucket's lifecycle rules (README.md § Expiry).
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "vx-cache" }],
}
