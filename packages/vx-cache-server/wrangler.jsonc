// vx-cache-server on Cloudflare Workers (src/worker.ts): `bunx wrangler
// deploy` from this directory. Blobs live in R2, the rest in D1.
{
  "name": "vx-cache-server",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Who may read and write: read:<sha256> / write:<sha256>, space separated,
  // each the SHA-256 of a token. Hashes, not tokens: no secret. Empty, every
  // static token is refused with "set TOKENS". TRUST: CI OIDC trust rules,
  // a JSON list (README.md § CI tokens); AUDIENCE: the aud a CI token
  // names, unset the Worker's own origin.
  "vars": { "TOKENS": "", "TRUST": "" },
  // Daily eviction (src/evict.ts): TRUSTED_DAYS, BRANCH_DAYS and RUN_DAYS
  // vars set how long each keeps (default 30, 7, 90). Free plan: 5 crons.
  "triggers": { "crons": ["17 3 * * *"] },
  "d1_databases": [{ "binding": "DB", "database_name": "vx-cache" }],
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "vx-cache" }],
}
