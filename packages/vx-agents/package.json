{
  "name": "@vzn/vx-agents",
  "version": "0.0.0",
  "description": "Distributed execution for vx — a synchronizer plus persistent workers that keep a checkout, an install and a local cache between runs.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@vzn/vx": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@vzn/vx": "*"
  },
  "bin": {
    "vx-sync": "./bin/vx-sync.ts",
    "vx-agent": "./bin/vx-agent.ts"
  }
}
