{
  "$schema": "../../node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "*.tsbuildinfo",
    ".mcp.json",
    ".vscode",
    ".idea",
    ".claude",
    "docs/api.md",
    "docs/turbo-nx-support.md",
    "tests/contract/turbo-nx",
    "tests/contract/vx-lock.json",
    "tests/contract/cli-surface.json",
    "tests/contract/discovery.json"
  ]
}
