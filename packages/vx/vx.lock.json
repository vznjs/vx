    "release.stamp": {
      "description": "stamp VX_RELEASE_VERSION into package.json, the manifest the binary inlines",
      "exec": {
        "command": "bun scripts/release.ts stamp",
        "env": {
          "passThrough": [
            "VX_RELEASE_VERSION"
          ]
        },
        "sandbox": {
          "allow": {
            "read": [
              "."
            ],
            "write": [
              "package.json"
            ]
          }
        }
      }
    },
    "release.npm": {
      "description": "make sure npm can publish with provenance (>= 11.5.1, sigstore intact)",
      "exec": {
        "command": "bun scripts/release.ts npm",
        "sandbox": {
          "allow": {
            "read": [
              "."
            ],
            "write": [
              "dist/npm-cli/",
              "~/.npm/"
            ],
            "network": [
              "registry.npmjs.org"
            ]
          }
        }
      }
    },
    "release.prove.linux": {
      "description": "the linux binaries launch (re-signed only if macOS refuses) and report VX_RELEASE_VERSION",
      "exec": {
        "command": "bun scripts/release.ts prove linux",
        "env": {
          "passThrough": [
            "VX_RELEASE_VERSION"
          ]
        },
        "sandbox": {
          "allow": {
            "read": [
              "."
            ]
          }
        }
      }
    },
    "release.assemble.linux": {
      "description": "assemble the linux npm packages under dist/npm (scripts/build-npm.ts)",
      "exec": {
        "command": "bun scripts/release.ts assemble linux",
        "env": {
          "passThrough": [
            "VX_RELEASE_VERSION"
          ]
        },
        "sandbox": {
          "allow": {
            "read": [
              ".",
              "../*",
              "../../README.md",
              "../../LICENSE",
              "../../skills/"
            ],
            "write": [
              "dist/npm/"
            ]
          }
        }
      }
    },
    "release.publish.linux": {
      "description": "npm publish the linux packages under dist/npm, skipping any already on the registry",
      "exec": {
        "command": "bun scripts/release.ts publish linux",
        "env": {
          "passThrough": [
            "VX_RELEASE_VERSION",
            "GITHUB_ACTIONS",
            "ACTIONS_ID_TOKEN_REQUEST_URL",
            "ACTIONS_ID_TOKEN_REQUEST_TOKEN",
            "GITHUB_WORKFLOW_REF",
            "GITHUB_REPOSITORY",
            "GITHUB_REPOSITORY_ID",
            "GITHUB_REPOSITORY_OWNER_ID",
            "GITHUB_SERVER_URL",
            "GITHUB_EVENT_NAME",
            "GITHUB_REF",
            "GITHUB_SHA",
            "GITHUB_RUN_ID",
            "GITHUB_RUN_ATTEMPT",
            "RUNNER_ENVIRONMENT"
          ],
          "secret": [
            "ACTIONS_ID_TOKEN_REQUEST_TOKEN"
          ]
        },
        "sandbox": {
          "allow": {
            "read": [
              "."
            ],
            "write": [
              "~/.npm/"
            ],
            "network": [
              "registry.npmjs.org",
              "*.actions.githubusercontent.com",
              "fulcio.sigstore.dev",
              "rekor.sigstore.dev",
              "tuf-repo-cdn.sigstore.dev"
            ],
            "machLookup": [
              "com.apple.SystemConfiguration.DNSConfiguration"
            ]
          }
        }
      }
    },
    "release.prove.darwin": {
      "description": "the darwin binaries launch (re-signed only if macOS refuses) and report VX_RELEASE_VERSION",
      "exec": {
        "command": "bun scripts/release.ts prove darwin",
        "env": {
          "passThrough": [
            "VX_RELEASE_VERSION"
          ]
        },
        "sandbox": {
          "allow": {
            "read": [
              "."
            ],
            "write": [
              "dist/vx-darwin-x64",
              "dist/vx-darwin-arm64",
              "dist/vx-darwin-x64.cstemp",
              "dist/vx-darwin-arm64.cstemp"
            ],
            "machLookup": [
              "com.apple.trustd.agent"
            ]
          },
          "ignore": {
            "systemInfo": [
              "hw.optional.bmi1",
              "hw.optional.avx2_0"
            ]
          }
        }
      }
    },
    "release.assemble.darwin": {
      "description": "assemble the darwin npm packages under dist/npm (scripts/build-npm.ts)",
