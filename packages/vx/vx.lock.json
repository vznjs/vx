      ],
      "exec": {
        "command": "bun build --compile --no-compile-autoload-dotenv --compile-autoload-package-json --minify --bytecode --target=bun-darwin-x64 src/bin.ts --outfile dist/vx-darwin-x64",
        "sandbox": {
          "allow": {
            "systemInfo": [
              "vfs.disk-space"
            ],
            "read": [
              "."
            ],
            "write": [
              "dist/vx-darwin-x64",
              "~/.bun/install/cache/",
              ".*.tmp/**"
            ],
            "network": [
              "registry.npmjs.org"
            ]
          },
          "ignore": {
            "write": [
              "*.bun-build"
            ]
          }
        }
      },
      "cache": {
        "inputs": {
          "files": [
            "**/*",
            "!dist/**",
            "package.json"
          ],
          "runtime": [
            "bun --version"
          ]
        },
        "outputs": {
          "files": [
            "dist/vx-darwin-x64"
          ]
        }
      }
    },
    "build.bun.darwin-arm64": {
      "description": "compile standalone binary (darwin arm64)",
      "dependsOn": [
