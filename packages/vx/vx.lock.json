      ],
      "exec": {
        "command": "bun build --compile --no-compile-autoload-dotenv --compile-autoload-package-json --minify --bytecode --target=bun-darwin-arm64 src/bin.ts --outfile dist/vx-darwin-arm64",
        "sandbox": {
          "allow": {
            "systemInfo": [
              "vfs.disk-space"
            ],
            "read": [
              "."
            ],
            "write": [
              "dist/vx-darwin-arm64",
              "~/.bun/install/cache/",
              ".*.tmp/**"
            ],
            "network": [
              "registry.npmjs.org"
            ]
          },
          "ignore": {
            "write": [
