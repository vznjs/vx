{
  "tasks": {
    "test.bun.shard-1": {
      "description": "bun test, shard 1 of 12 (dealt by scripts/test-shard.ts)",
      "dependsOn": [
        "install"
      ],
      "exec": {
        "command": "bun test --only-failures $(bun scripts/test-shard.ts 1 12)",
        "env": {
          "passThrough": [
            "VX_REQUIRE_SANDBOX",
            "VX_REQUIRE_WATCH_EVENTS",
            "VX_REQUIRE_NONROOT"
          ],
          "define": {
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "FORCE_COLOR": "0",
            "VX_CACHE_DIR": ".vx/cache"
          }
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*",
              "../../README.md",
              "../../skills/"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ],
            "machLookup": [
              "com.apple.FSEvents"
            ]
          }
        }
      },
      "cache": {
        "inputs": {
          "files": [
            "**/*",
            "!dist/**",
            "package.json"
          ],
          "workspaceFiles": [
            "README.md",
            "skills/**"
          ]
        },
        "outputs": {
          "files": []
        }
      }
    },
