{
  "name": "@vzn/vx",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Task orchestration you own: correct, sandboxed, extensible, with a content-addressed build cache.",
  "homepage": "https://vznjs.github.io/vx/",
  "keywords": [
    "vx",
    "monorepo",
    "task-runner",
    "build-cache",
    "build-system",
    "cache",
    "turborepo",
    "nx",
    "bun",
    "workspaces",
    "ci",
    "task-orchestration",
    "turborepo-alternative",
    "nx-alternative",
    "remote-cache",
    "sandbox",
    "incremental-build",
    "mcp",
    "pnpm"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./config": {
      "types": "./src/config.ts",
      "import": "./src/config.ts"
    }
  },
  "bin": {
    "vx": "./src/bin.ts"
  },
  "files": [
    "npm-launcher.cjs",
    "npm-launcher.sh",
    "index.ts",
    "config",
    "src",
    "schemas",
    "skills",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.76"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
