{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vx last --format json",
  "description": "`vx last [RUNID] [--failed]` prints a run; `--list` prints an array of invocations, newest first; `--log <task>` prints that task's output; `--stats` prints per-task history numbers; `--sql` prints the rows a read-only query over the history selects.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation", "tasks"],
      "properties": {
        "invocation": { "$ref": "#/$defs/invocation" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } }
      }
    },
    { "type": "array", "items": { "$ref": "#/$defs/invocation" } },
    { "$ref": "#/$defs/log" },
    { "$ref": "#/$defs/stats" },
    { "$ref": "#/$defs/rows" }
  ],
  "$defs": {
    "rows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows"],
      "properties": {
        "rows": {
          "type": "array",
          "description": "`--sql`: one object per row, keyed by the query's column names",
          "items": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number", "null"] }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "branch", "stats"],
      "properties": {
        "window": { "type": "integer", "description": "the newest runs the numbers cover" },
        "branch": {
          "type": ["string", "null"],
          "description": "the branch p50 forecasts from: --branch, VX_RUN_BRANCH, git's, then CI's"
        },
        "stats": { "type": "array", "items": { "$ref": "#/$defs/taskStats" } }
      }
    },
    "taskStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "runs",
        "p50DurationMs",
        "p99DurationMs",
        "successRate",
        "hitRate",
        "failureMode",
        "maxPeakRssBytes",
        "maxCpuParallelism"
      ],
      "properties": {
        "taskId": { "type": "string" },
        "runs": { "type": "integer", "description": "executed runs in the window, skips aside" },
        "p50DurationMs": {
          "type": ["number", "null"],
          "description": "the forecast a run shows: median of the last 5 timings on branch, else on any branch; null when none"
        },
        "p99DurationMs": { "type": ["number", "null"] },
        "successRate": { "type": "number", "description": "0 to 1" },
        "hitRate": { "type": "number", "description": "0 to 1" },
        "failureMode": { "enum": ["stable", "flaky-recoverable", "flaky-fatal"] },
        "maxPeakRssBytes": { "type": ["integer", "null"] },
        "maxCpuParallelism": {
          "type": ["number", "null"],
          "description": "cpu time over wall time; 2.0 is two cores busy"
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "taskId", "status", "source", "output"],
      "properties": {
        "runId": { "type": "string" },
        "taskId": { "type": "string" },
        "status": { "type": "string" },
        "source": {
          "enum": ["failure", "cache", null],
          "description": "the kept failure output, the cache entry's log, or none kept"
        },
        "output": { "type": "string", "description": "plain text; '' when source is null" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "command",
        "requestedTasks",
        "cachePolicy",
        "concurrency",
        "flow",
        "startedAt",
        "endedAt",
        "totalDurationMs",
        "taskCount",
        "failedCount",
        "hitCount",
        "hitLocalCount",
        "hitRemoteCount",
        "upToDateCount",
        "restoredLocalCount",
        "restoredRemoteCount",
        "exitOk",
        "commitSha",
        "branch",
        "dirty",
        "ci",
        "ciProvider",
        "host",
        "os",
        "arch",
        "vxVersion"
      ],
      "properties": {
        "runId": { "type": "string" },
        "command": { "type": "string" },
        "requestedTasks": { "type": "array", "items": { "type": "string" } },
        "cachePolicy": { "type": "string" },
        "concurrency": { "type": "integer" },
        "flow": { "enum": ["focused", "broad", null] },
        "startedAt": { "type": "integer", "description": "epoch ms" },
        "endedAt": { "type": "integer", "description": "epoch ms" },
        "totalDurationMs": { "type": "number" },
        "taskCount": { "type": "integer" },
        "failedCount": { "type": "integer" },
        "hitCount": { "type": "integer" },
        "hitLocalCount": { "type": "integer" },
        "hitRemoteCount": { "type": "integer" },
        "upToDateCount": {
          "type": "integer",
          "description": "hits that restored nothing: the disk already matched"
        },
        "restoredLocalCount": {
          "type": "integer",
          "description": "hits that restored outputs from the local cache"
        },
        "restoredRemoteCount": {
          "type": "integer",
          "description": "hits that restored outputs from the remote cache"
        },
        "exitOk": { "type": "boolean" },
        "commitSha": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "dirty": { "type": ["boolean", "null"] },
        "ci": { "type": "boolean" },
        "ciProvider": { "type": ["string", "null"] },
        "host": { "type": ["string", "null"] },
        "os": { "type": ["string", "null"] },
        "arch": { "type": ["string", "null"] },
        "vxVersion": { "type": "string" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "project",
        "task",
        "status",
        "exitCode",
        "durationMs",
        "startedAt",
        "endedAt",
        "cacheHit",
        "restored",
        "cached",
        "hash",
        "cpuMs",
        "peakRssBytes",
        "peakCores",
        "avgRssBytes",
        "placement",
        "wallclockStartNs",
        "wallclockEndNs",
        "blockedBy",
        "timedOut",
        "sandboxViolations",
        "notReady",
        "remoteError",
        "forwarded"
      ],
      "properties": {
        "runId": { "type": ["string", "null"] },
        "project": { "type": "string" },
        "task": { "type": "string" },
        "status": { "type": "string" },
        "exitCode": { "type": "integer" },
        "durationMs": { "type": "number" },
        "startedAt": { "type": "integer", "description": "epoch ms" },
        "endedAt": { "type": "integer", "description": "epoch ms" },
        "cacheHit": {
          "type": ["boolean", "null"],
          "description": "true when the task's outputs came from the cache instead of running"
        },
        "restored": {
          "type": ["boolean", "null"],
          "description": "on a hit: true when outputs were restored, false when up-to-date"
        },
        "cached": {
          "type": ["boolean", "null"],
          "description": "whether the task declares a cache (false prints no-cache); not whether this run hit it"
        },
        "hash": { "type": "string" },
        "cpuMs": { "type": ["number", "null"] },
        "peakRssBytes": { "type": ["integer", "null"] },
        "peakCores": {
          "type": ["number", "null"],
          "description": "most cores one sampling interval burned; null when nothing sampled"
        },
        "avgRssBytes": {
          "type": ["integer", "null"],
          "description": "mean resident memory over the samples; null when nothing sampled"
        },
        "placement": {
          "type": ["string", "null"],
          "description": "where an executor ran it (small#1); null when here"
        },
        "wallclockStartNs": {
          "type": ["string", "null"],
          "description": "decimal nanoseconds from the run's start"
        },
        "wallclockEndNs": { "type": ["string", "null"] },
        "blockedBy": { "type": ["string", "null"] },
        "timedOut": { "type": ["boolean", "null"] },
        "sandboxViolations": { "type": ["integer", "null"] },
        "notReady": { "enum": ["timeout", "exited", "spawn", null] },
        "remoteError": {
          "type": ["string", "null"],
          "description": "each failed remote read or write of the key, `; `-joined"
        },
        "forwarded": { "type": "boolean" },
        "output": {
          "type": "string",
          "description": "on a failed row: its output, plain text, bounded (first 8 KiB, last 56 KiB), secrets masked; '' when none was recorded"
        },
        "locations": {
          "type": "array",
          "description": "on a failed row: the existing files its output names, in order of first appearance; a file it also names with a line drops its bare mention",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file"],
            "properties": {
              "file": { "type": "string", "description": "absolute" },
              "line": { "type": "integer" },
              "col": { "type": "integer" }
            }
          }
        },
        "fixedIn": {
          "type": "string",
          "description": "on a failed row: the first later run where this task passed (ran or hit); absent while it has not"
        }
      }
    }
  }
}
