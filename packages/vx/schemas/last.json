{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vx last --format json",
  "description": "`vx last [RUNID] [--failed]` prints a run; `--list` prints an array of invocations, newest first; `--log <task>` prints that task's output; `--stats` prints per-task history numbers; `--sql` prints the rows a read-only query over the history selects; `--live` prints the run in progress (with `--follow`, each of its events after it, one per line).",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation", "tasks"],
      "properties": {
        "invocation": { "$ref": "#/$defs/invocation" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } },
        "warnings": {
          "type": "array",
          "description": "what the run warned of, plain text; absent when it warned of nothing",
          "items": { "type": "string" }
        },
        "steps": {
          "type": "array",
          "description": "vx's own steps the run did not wait on (vx:prefetch); absent when it had none or they are no longer kept",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "durationMs", "ok"],
            "properties": {
              "id": { "type": "string" },
              "durationMs": { "type": "number" },
              "ok": { "type": "boolean" }
            }
          }
        }
      }
    },
    { "type": "array", "items": { "$ref": "#/$defs/invocation" } },
    { "$ref": "#/$defs/log" },
    { "$ref": "#/$defs/stats" },
    { "$ref": "#/$defs/rows" },
    { "$ref": "#/$defs/live" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "live": {
      "type": "object",
      "additionalProperties": false,
      "required": ["live", "tasks", "warnings"],
      "properties": {
        "live": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runId", "command", "pid", "startedAt", "elapsedMs"],
          "properties": {
            "runId": { "type": "string" },
            "command": { "type": "string" },
            "pid": { "type": "integer" },
            "startedAt": { "type": "integer", "description": "epoch ms" },
            "elapsedMs": { "type": "integer" }
          }
        },
        "tasks": {
          "type": "array",
          "description": "`--live`: running first, then ended, then waiting; groups left out",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["taskId", "status", "startedAt", "durationMs"],
            "properties": {
              "taskId": { "type": "string" },
              "status": {
                "type": "string",
                "description": "running, waiting, or the status it ended with"
              },
              "startedAt": { "type": ["integer", "null"] },
              "durationMs": { "type": ["number", "null"] }
            }
          }
        },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "event": {
      "description": "`--live --follow`: each line after the snapshot, one run event, in order; the last is run:done",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "info"],
          "properties": {
            "kind": {
              "const": "run:start"
            },
            "info": {
              "type": "object",
              "additionalProperties": false,
              "required": ["total"],
              "properties": {
                "total": {
                  "type": "integer"
                },
                "concurrency": {
                  "type": "integer"
                },
                "requestedCount": {
                  "type": "integer"
                },
                "startedAtMs": {
                  "type": "integer",
                  "description": "epoch ms"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "task"],
          "properties": {
            "kind": {
              "const": "task:start"
            },
            "task": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "project",
                "task",
                "isGroup",
                "requested",
                "surfaced",
                "persistent"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "project": {
                  "type": "string"
                },
                "task": {
                  "type": "string"
                },
                "isGroup": {
                  "const": false,
                  "description": "groups are left out"
                },
                "requested": {
                  "type": "boolean",
                  "description": "asked for on the command line, not pulled in"
                },
                "surfaced": {
                  "type": "boolean"
                },
                "persistent": {
                  "type": "boolean"
                },
                "command": {
                  "type": "string",
                  "description": "secrets masked"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "taskId", "chunk"],
          "properties": {
            "kind": {
              "enum": ["task:stdout", "task:stderr"]
            },
            "taskId": {
              "type": "string"
            },
            "chunk": {
              "type": "string",
              "description": "output as the task wrote it, secrets masked"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "outcome"],
          "properties": {
            "kind": {
              "const": "task:complete"
            },
            "outcome": {
              "type": "object",
              "additionalProperties": false,
              "required": ["taskId", "status", "exitCode", "durationMs"],
              "properties": {
                "taskId": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "success",
                    "cache-hit",
                    "cache-hit-remote",
                    "failed",
                    "skipped",
                    "aborted"
                  ]
                },
                "exitCode": {
                  "type": "integer"
                },
                "durationMs": {
                  "type": "number"
                },
                "noCache": {
                  "const": true,
                  "description": "ran without cache: true: never consulted the cache, not a miss"
                },
                "restoreFailed": {
                  "const": true,
                  "description": "a hit whose restore threw: neither a hit nor a miss"
                },
                "storedDurationMs": {
                  "type": "number",
                  "description": "on a hit: the run time the entry was stored with, the work the hit skipped"
                },
                "storedCpuMs": {
                  "type": "number"
                },
                "storedPeakRssBytes": {
                  "type": "number"
                },
                "hash": {
                  "type": "string"
                },
                "cpuMs": {
                  "type": "number"
                },
                "peakRssBytes": {
                  "type": "number"
                },
                "admissionHeldMs": {
                  "type": "number",
                  "description": "how long an admit plugin held it with a worker free"
                },
                "queuedMs": {
                  "type": "number",
                  "description": "how long it waited, ready, for a worker"
                },
                "inputFiles": {
                  "type": "integer",
                  "description": "how many files the key read"
                },
                "inputChanges": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["count", "first"],
                  "properties": {
                    "count": {
                      "type": "integer",
                      "description": "how many key parts changed, appeared or went since its last saved entry; 0: the same key, its entry gone"
                    },
                    "first": {
                      "type": "array",
                      "description": "the first of them, by kind then name",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["kind", "name", "change"],
                        "properties": {
                          "kind": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "change": {
                            "enum": ["changed", "added", "removed"]
                          }
                        }
                      }
                    }
                  },
                  "description": "a miss: what its key changed since its last saved entry"
                },
                "artifactBytes": {
                  "type": "number",
                  "description": "the artifact's compressed size, a hit's or a measured save's"
                },
                "fetchMs": {
                  "type": "number",
                  "description": "a remote hit's download and ingest"
                },
                "saveMs": {
                  "type": "number",
                  "description": "a measured save's own time"
                },
                "timedOut": {
                  "const": true,
                  "description": "its exec.timeout killed it"
                },
                "notReady": {
                  "enum": ["timeout", "exited", "spawn"],
                  "description": "a persistent task that never became ready, and why"
                },
                "inputMoved": {
                  "type": "string",
                  "description": "the input that changed while the command ran"
                },
                "blockedBy": {
                  "type": "string",
                  "description": "a skipped task: the failed task at the root of the block; absent for a fail-fast skip"
                },
                "otherPlatform": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["needs", "host"],
                  "properties": {
                    "needs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "host": {
                      "type": "string"
                    }
                  },
                  "description": "a skipped task whose exec.platforms leave out this machine"
                },
                "restored": {
                  "type": "boolean",
                  "description": "on a hit: true when outputs were restored, false when up to date"
                },
                "sandboxViolations": {
                  "type": "integer"
                },
                "sandboxViolationLines": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "wallclockStartNs": {
                  "type": "string",
                  "description": "decimal nanoseconds from the run's start"
                },
                "wallclockEndNs": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "measure"],
          "properties": {
            "kind": {
              "const": "task:measure"
            },
            "measure": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "def", "durationMs"],
              "properties": {
                "id": {
                  "type": "string",
                  "description": "<plugin>#<name>"
                },
                "def": {
                  "type": "string"
                },
                "durationMs": {
                  "type": "number"
                },
                "cores": {
                  "type": "number"
                }
              },
              "description": "what a plugin timed that is no task of the graph"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "line"],
          "properties": {
            "kind": {
              "const": "run:status"
            },
            "line": {
              "type": "string"
            },
            "warn": {
              "const": true,
              "description": "a warning"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": {
              "const": "step:start"
            },
            "id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "durationMs", "ok"],
          "properties": {
            "kind": {
              "const": "step:end"
            },
            "id": {
              "type": "string"
            },
            "durationMs": {
              "type": "number"
            },
            "ok": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["run:end", "run:stop", "run:done"]
            }
          }
        }
      ]
    },
    "rows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows"],
      "properties": {
        "rows": {
          "type": "array",
          "description": "`--sql`: one object per row, keyed by the query's column names",
          "items": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number", "null"] }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "branch", "stats"],
      "properties": {
        "window": { "type": "integer", "description": "the newest runs the numbers cover" },
        "branch": {
          "type": ["string", "null"],
          "description": "the branch p50 forecasts from: --branch, VX_RUN_BRANCH, git's, then CI's"
        },
        "stats": { "type": "array", "items": { "$ref": "#/$defs/taskStats" } }
      }
    },
    "taskStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "runs",
        "p50DurationMs",
        "p99DurationMs",
        "successRate",
        "hitRate",
        "failureMode",
        "maxPeakRssBytes",
        "maxCpuParallelism"
      ],
      "properties": {
        "taskId": { "type": "string" },
        "runs": { "type": "integer", "description": "executed runs in the window, skips aside" },
        "p50DurationMs": {
          "type": ["number", "null"],
          "description": "the forecast a run shows: median of the last 5 timings on branch, else on any branch; null when none"
        },
        "p99DurationMs": { "type": ["number", "null"] },
        "successRate": { "type": "number", "description": "0 to 1" },
        "hitRate": { "type": "number", "description": "0 to 1" },
        "failureMode": { "enum": ["stable", "flaky-recoverable", "flaky-fatal"] },
        "maxPeakRssBytes": { "type": ["integer", "null"] },
        "maxCpuParallelism": {
          "type": ["number", "null"],
          "description": "cpu time over wall time; 2.0 is two cores busy"
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "taskId", "status", "source", "output"],
      "properties": {
        "runId": { "type": "string" },
        "taskId": { "type": "string" },
        "status": { "type": "string" },
        "source": {
          "enum": ["failure", "cache", null],
          "description": "the kept failure output, the cache entry's log, or none kept"
        },
        "output": { "type": "string", "description": "plain text; '' when source is null" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "command",
        "requestedTasks",
        "cachePolicy",
        "concurrency",
        "flow",
        "startedAt",
        "endedAt",
        "totalDurationMs",
        "taskCount",
        "failedCount",
        "hitCount",
        "hitLocalCount",
        "hitRemoteCount",
        "upToDateCount",
        "restoredLocalCount",
        "restoredRemoteCount",
        "exitOk",
        "commitSha",
        "branch",
        "dirty",
        "ci",
        "ciProvider",
        "host",
        "os",
        "arch",
        "vxVersion"
      ],
      "properties": {
        "runId": { "type": "string" },
        "command": { "type": "string" },
        "requestedTasks": { "type": "array", "items": { "type": "string" } },
        "cachePolicy": { "type": "string" },
        "concurrency": { "type": "integer" },
        "flow": { "enum": ["focused", "broad", null] },
        "startedAt": { "type": "integer", "description": "epoch ms" },
        "endedAt": { "type": "integer", "description": "epoch ms" },
        "totalDurationMs": { "type": "number" },
        "taskCount": { "type": "integer" },
        "failedCount": { "type": "integer" },
        "hitCount": { "type": "integer" },
        "hitLocalCount": { "type": "integer" },
        "hitRemoteCount": { "type": "integer" },
        "upToDateCount": {
          "type": "integer",
          "description": "hits that restored nothing: the disk already matched"
        },
        "restoredLocalCount": {
          "type": "integer",
          "description": "hits that restored outputs from the local cache"
        },
        "restoredRemoteCount": {
          "type": "integer",
          "description": "hits that restored outputs from the remote cache"
        },
        "exitOk": { "type": "boolean" },
        "commitSha": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "dirty": { "type": ["boolean", "null"] },
        "ci": { "type": "boolean" },
        "ciProvider": { "type": ["string", "null"] },
        "host": { "type": ["string", "null"] },
        "os": { "type": ["string", "null"] },
        "arch": { "type": ["string", "null"] },
        "vxVersion": { "type": "string" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "project",
        "task",
        "status",
        "exitCode",
        "durationMs",
        "startedAt",
        "endedAt",
        "cacheHit",
        "restored",
        "cached",
        "hash",
        "cpuMs",
        "peakRssBytes",
        "peakCores",
        "avgRssBytes",
        "queuedMs",
        "placement",
        "outputBytes",
        "blocks",
        "wallclockStartNs",
        "wallclockEndNs",
        "blockedBy",
        "timedOut",
        "sandboxViolations",
        "notReady",
        "remoteError",
        "forwarded",
        "attempts"
      ],
      "properties": {
        "runId": { "type": ["string", "null"] },
        "project": { "type": "string" },
        "task": { "type": "string" },
        "status": { "type": "string" },
        "exitCode": {
          "type": "integer",
          "description": "a skipped task records 0 when an exec.platforms skip is its root, 1 behind a failure or fail-fast"
        },
        "durationMs": { "type": "number" },
        "startedAt": { "type": "integer", "description": "epoch ms" },
        "endedAt": { "type": "integer", "description": "epoch ms" },
        "cacheHit": {
          "type": ["boolean", "null"],
          "description": "true when the task's outputs came from the cache instead of running"
        },
        "restored": {
          "type": ["boolean", "null"],
          "description": "on a hit: true when outputs were restored, false when up-to-date"
        },
        "cached": {
          "type": ["boolean", "null"],
          "description": "whether the task declares a cache (false prints no-cache); not whether this run hit it"
        },
        "hash": { "type": "string" },
        "cpuMs": { "type": ["number", "null"] },
        "peakRssBytes": { "type": ["integer", "null"] },
        "peakCores": {
          "type": ["number", "null"],
          "description": "most cores one sampling interval burned; null when nothing sampled"
        },
        "avgRssBytes": {
          "type": ["integer", "null"],
          "description": "mean resident memory over the samples; null when nothing sampled"
        },
        "queuedMs": {
          "type": ["integer", "null"],
          "description": "milliseconds it waited, ready, for a slot; null when it never queued"
        },
        "placement": {
          "type": ["string", "null"],
          "description": "where an executor ran it (small#1); null when here"
        },
        "outputBytes": {
          "type": ["integer", "null"],
          "description": "bytes of its outputs: what its save stored, or its hit restored"
        },
        "blocks": {
          "type": ["integer", "null"],
          "description": "how many tasks were downstream of it"
        },
        "wallclockStartNs": {
          "type": ["string", "null"],
          "description": "decimal nanoseconds from the run's start"
        },
        "wallclockEndNs": { "type": ["string", "null"] },
        "blockedBy": { "type": ["string", "null"] },
        "timedOut": { "type": ["boolean", "null"] },
        "sandboxViolations": { "type": ["integer", "null"] },
        "notReady": { "enum": ["timeout", "exited", "spawn", null] },
        "remoteError": {
          "type": ["string", "null"],
          "description": "each failed remote read or write of the key, `; `-joined"
        },
        "forwarded": { "type": "boolean" },
        "inputMoved": {
          "type": "string",
          "description": "on a row failed by inputStability.severity 'error': the input that changed during the run"
        },
        "attempts": {
          "type": ["integer", "null"],
          "description": "the attempts a retried task took (more than one); null when it ran once"
        },
        "output": {
          "type": "string",
          "description": "on a failed row: its output, plain text, bounded (first 8 KiB, last 56 KiB), secrets masked; '' when none was recorded"
        },
        "dir": {
          "type": "string",
          "description": "on a failed row: its project's directory from the workspace root, '.' for the root; the relative paths in its output start there"
        },
        "locations": {
          "type": "array",
          "description": "on a failed row: the existing files its output names, in order of first appearance; a file it also names with a line drops its bare mention",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file"],
            "properties": {
              "file": { "type": "string", "description": "absolute" },
              "line": { "type": "integer" },
              "col": { "type": "integer" }
            }
          }
        },
        "sandboxFix": {
          "type": "object",
          "description": "on a sandboxed failed row: the exec.sandbox.allow entries that would have granted its denials",
          "additionalProperties": false,
          "properties": {
            "read": { "type": "array", "items": { "type": "string" } },
            "write": { "type": "array", "items": { "type": "string" } },
            "network": { "type": "array", "items": { "type": "string" } },
            "systemInfo": { "type": "array", "items": { "type": "string" } },
            "withheld": {
              "type": "array",
              "description": "credential paths it denied and left out of the grants",
              "items": { "type": "string" }
            },
            "inputs": {
              "type": "array",
              "description": "a cached task's reads of its project no inputs.files glob matches",
              "items": { "type": "string" }
            },
            "workspaceFiles": {
              "type": "array",
              "description": "a cached task's reads elsewhere in the workspace no inputs.workspaceFiles glob matches",
              "items": { "type": "string" }
            }
          }
        },
        "fixedIn": {
          "type": "string",
          "description": "on a failed row: the first later run where this task passed (ran or hit); absent while it has not"
        }
      }
    }
  }
}
