{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vx last --format json",
  "description": "`vx last [RUNID] [--failed]` prints a run; `--list` prints an array of invocations, newest first; `--log <task>` prints that task's output.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation", "tasks"],
      "properties": {
        "invocation": { "$ref": "#/$defs/invocation" },
        "tasks": { "type": "array", "items": { "$ref": "#/$defs/task" } }
      }
    },
    { "type": "array", "items": { "$ref": "#/$defs/invocation" } },
    { "$ref": "#/$defs/log" }
  ],
  "$defs": {
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "taskId", "status", "source", "output"],
      "properties": {
        "runId": { "type": "string" },
        "taskId": { "type": "string" },
        "status": { "type": "string" },
        "source": {
          "enum": ["failure", "cache", null],
          "description": "the kept failure output, the cache entry's log, or none kept"
        },
        "output": { "type": "string", "description": "plain text; '' when source is null" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "command",
        "requestedTasks",
        "cachePolicy",
        "concurrency",
        "flow",
        "startedAt",
        "endedAt",
        "totalDurationMs",
        "taskCount",
        "failedCount",
        "hitCount",
        "hitLocalCount",
        "hitRemoteCount",
        "upToDateCount",
        "restoredLocalCount",
        "restoredRemoteCount",
        "exitOk",
        "commitSha",
        "branch",
        "dirty",
        "ci",
        "ciProvider",
        "host",
        "os",
        "arch",
        "vxVersion",
        "tags"
      ],
      "properties": {
        "runId": { "type": "string" },
        "command": { "type": "string" },
        "requestedTasks": { "type": "array", "items": { "type": "string" } },
        "cachePolicy": { "type": "string" },
        "concurrency": { "type": "integer" },
        "flow": { "enum": ["focused", "broad", null] },
        "startedAt": { "type": "integer", "description": "epoch ms" },
        "endedAt": { "type": "integer", "description": "epoch ms" },
        "totalDurationMs": { "type": "number" },
        "taskCount": { "type": "integer" },
        "failedCount": { "type": "integer" },
        "hitCount": { "type": "integer" },
        "hitLocalCount": { "type": "integer" },
        "hitRemoteCount": { "type": "integer" },
        "upToDateCount": {
          "type": "integer",
          "description": "hits that restored nothing: the disk already matched"
        },
        "restoredLocalCount": {
          "type": "integer",
          "description": "hits that restored outputs from the local cache"
        },
        "restoredRemoteCount": {
          "type": "integer",
          "description": "hits that restored outputs from the remote cache"
        },
        "exitOk": { "type": "boolean" },
        "commitSha": { "type": ["string", "null"] },
        "branch": { "type": ["string", "null"] },
        "dirty": { "type": ["boolean", "null"] },
        "ci": { "type": "boolean" },
        "ciProvider": { "type": ["string", "null"] },
        "host": { "type": ["string", "null"] },
        "os": { "type": ["string", "null"] },
        "arch": { "type": ["string", "null"] },
        "vxVersion": { "type": "string" },
        "tags": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "project",
        "task",
        "status",
        "exitCode",
        "durationMs",
        "startedAt",
        "endedAt",
        "cacheHit",
        "restored",
        "cached",
        "hash",
        "cpuMs",
        "peakRssBytes",
        "wallclockStartNs",
        "wallclockEndNs",
        "blockedBy",
        "timedOut",
        "sandboxViolations",
        "notReady",
        "forwarded"
      ],
      "properties": {
        "runId": { "type": ["string", "null"] },
        "project": { "type": "string" },
        "task": { "type": "string" },
        "status": { "type": "string" },
        "exitCode": { "type": "integer" },
        "durationMs": { "type": "number" },
        "startedAt": { "type": "integer", "description": "epoch ms" },
        "endedAt": { "type": "integer", "description": "epoch ms" },
        "cacheHit": { "type": ["boolean", "null"] },
        "restored": {
          "type": ["boolean", "null"],
          "description": "on a hit: true when outputs were restored, false when up-to-date"
        },
        "cached": { "type": ["boolean", "null"] },
        "hash": { "type": "string" },
        "cpuMs": { "type": ["number", "null"] },
        "peakRssBytes": { "type": ["integer", "null"] },
        "wallclockStartNs": {
          "type": ["string", "null"],
          "description": "decimal nanoseconds from the run's start"
        },
        "wallclockEndNs": { "type": ["string", "null"] },
        "blockedBy": { "type": ["string", "null"] },
        "timedOut": { "type": ["boolean", "null"] },
        "sandboxViolations": { "type": ["integer", "null"] },
        "notReady": { "enum": ["timeout", "exited", "spawn", null] },
        "forwarded": { "type": "boolean" },
        "output": {
          "type": "string",
          "description": "on a failed row: its output, plain text, bounded (first 8 KiB, last 56 KiB), secrets masked; '' when none was recorded"
        },
        "locations": {
          "type": "array",
          "description": "on a failed row: the existing files its output names, in order of first appearance",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file"],
            "properties": {
              "file": { "type": "string", "description": "absolute" },
              "line": { "type": "integer" },
              "col": { "type": "integer" }
            }
          }
        }
      }
    }
  }
}
