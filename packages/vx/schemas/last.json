{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vx last --format json",
  "description": "`vx last [RUNID] [--failed]` prints a run; `--list` prints an array of invocations, newest first; `--log <task>` prints that task's output; `--stats` prints per-task history numbers; `--sql` prints the rows a read-only query over the history selects; `--live` prints the run in progress (with `--follow`, each of its events after it, one per line).",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocation", "tasks"],
      "properties": {
        "invocation": { "$ref": "#/$defs/invocation", "description": "the run as a whole" },
        "tasks": {
          "type": "array",
          "description": "one row per task it ran, hit or skipped",
          "items": { "$ref": "#/$defs/task" }
        },
        "warnings": {
          "type": "array",
          "description": "what the run warned of, plain text; absent when it warned of nothing",
          "items": { "type": "string" }
        },
        "steps": {
          "type": "array",
          "description": "vx's own steps the run did not wait on (vx:prefetch); absent when it had none or they are no longer kept",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "durationMs", "ok"],
            "properties": {
              "id": { "type": "string", "description": "the step's name, like vx:prefetch" },
              "durationMs": { "type": "number", "description": "how long it took" },
              "ok": { "type": "boolean", "description": "false when it failed" }
            }
          }
        }
      }
    },
    { "type": "array", "items": { "$ref": "#/$defs/invocation" } },
    { "$ref": "#/$defs/log" },
    { "$ref": "#/$defs/stats" },
    { "$ref": "#/$defs/rows" },
    { "$ref": "#/$defs/live" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "live": {
      "type": "object",
      "additionalProperties": false,
      "required": ["live", "tasks", "warnings"],
      "properties": {
        "live": {
          "type": "object",
          "description": "the run in progress",
          "additionalProperties": false,
          "required": ["runId", "command", "pid", "startedAt", "elapsedMs"],
          "properties": {
            "runId": { "type": "string", "description": "the run id" },
            "command": { "type": "string", "description": "the command line that started it" },
            "pid": { "type": "integer", "description": "the run's process id" },
            "startedAt": { "type": "integer", "description": "epoch ms" },
            "elapsedMs": { "type": "integer", "description": "how long it has run" }
          }
        },
        "tasks": {
          "type": "array",
          "description": "`--live`: running first, then ended, then waiting; groups left out",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["taskId", "status", "startedAt", "durationMs"],
            "properties": {
              "taskId": { "type": "string", "description": "project#task" },
              "status": {
                "type": "string",
                "description": "running, waiting, or the status it ended with"
              },
              "startedAt": {
                "type": ["integer", "null"],
                "description": "epoch ms; null while waiting"
              },
              "durationMs": { "type": ["number", "null"], "description": "null until it ends" }
            }
          }
        },
        "warnings": {
          "type": "array",
          "description": "what the run warned of so far, plain text",
          "items": { "type": "string" }
        }
      }
    },
    "event": {
      "description": "`--live --follow`: each line after the snapshot, one run event, in order; the last is run:done",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "info"],
          "properties": {
            "kind": { "const": "run:start", "description": "the run started" },
            "info": {
              "type": "object",
              "description": "what the run will do",
              "additionalProperties": false,
              "required": ["total"],
              "properties": {
                "total": { "type": "integer", "description": "how many tasks it will reach" },
                "concurrency": { "type": "integer", "description": "its worker count" },
                "requestedCount": {
                  "type": "integer",
                  "description": "the tasks asked for on the command line"
                },
                "startedAtMs": { "type": "integer", "description": "epoch ms" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "task"],
          "properties": {
            "kind": { "const": "task:start", "description": "a task started" },
            "task": {
              "type": "object",
              "description": "the task",
              "additionalProperties": false,
              "required": [
                "id",
                "project",
                "task",
                "isGroup",
                "requested",
                "surfaced",
                "persistent"
              ],
              "properties": {
                "id": { "type": "string", "description": "project#task" },
                "project": { "type": "string", "description": "the project name" },
                "task": { "type": "string", "description": "the task name" },
                "isGroup": { "const": false, "description": "groups are left out" },
                "requested": {
                  "type": "boolean",
                  "description": "asked for on the command line, not pulled in"
                },
                "surfaced": {
                  "type": "boolean",
                  "description": "shown as if requested: a direct dependency of a requested group"
                },
                "persistent": {
                  "type": "boolean",
                  "description": "a long-running task, like a dev server"
                },
                "command": { "type": "string", "description": "secrets masked" }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "taskId", "chunk"],
          "properties": {
            "kind": {
              "enum": ["task:stdout", "task:stderr"],
              "description": "a task wrote output"
            },
            "taskId": { "type": "string", "description": "project#task" },
            "chunk": {
              "type": "string",
              "description": "output as the task wrote it, secrets masked"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "outcome"],
          "properties": {
            "kind": { "const": "task:complete", "description": "a task ended" },
            "outcome": {
              "type": "object",
              "description": "how it ended",
              "additionalProperties": false,
              "required": ["taskId", "status", "exitCode", "durationMs"],
              "properties": {
                "taskId": { "type": "string", "description": "project#task" },
                "status": {
                  "enum": [
                    "success",
                    "cache-hit",
                    "cache-hit-remote",
                    "failed",
                    "skipped",
                    "aborted"
                  ],
                  "description": "how it ended; cache-hit-remote is a hit from the remote cache"
                },
                "exitCode": {
                  "type": "integer",
                  "description": "the command's exit code; 0 on a hit"
                },
                "durationMs": { "type": "number", "description": "how long it took this run" },
                "noCache": {
                  "const": true,
                  "description": "ran without cache: true: never consulted the cache, not a miss"
                },
                "restoreFailed": {
                  "const": true,
                  "description": "a hit whose restore threw: neither a hit nor a miss"
                },
                "outputsMissing": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "the declared output globs an exit 0 left matching no file: why the task failed"
                },
                "storedDurationMs": {
                  "type": "number",
                  "description": "on a hit: the run time the entry was stored with, the work the hit skipped"
                },
                "storedCpuMs": {
                  "type": "number",
                  "description": "on a hit: the CPU time the entry was stored with"
                },
                "storedPeakRssBytes": {
                  "type": "number",
                  "description": "on a hit: the peak memory the entry was stored with"
                },
                "hash": { "type": "string", "description": "its cache key" },
                "cpuMs": { "type": "number", "description": "CPU time its command used" },
                "peakRssBytes": {
                  "type": "number",
                  "description": "peak resident memory of its command"
                },
                "admissionHeldMs": {
                  "type": "number",
                  "description": "how long an admit plugin held it with a worker free"
                },
                "queuedMs": {
                  "type": "number",
                  "description": "how long it waited, ready, for a worker"
                },
                "inputFiles": { "type": "integer", "description": "how many files the key read" },
                "inputChanges": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["count", "first"],
                  "properties": {
                    "count": {
                      "type": "integer",
                      "description": "how many key parts changed, appeared or went since its last saved entry; 0: the same key, its entry gone"
                    },
                    "first": {
                      "type": "array",
                      "description": "the first of them, by kind then name",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["kind", "name", "change"],
                        "properties": {
                          "kind": {
                            "type": "string",
                            "description": "files, env, runtime, upstream, …"
                          },
                          "name": {
                            "type": "string",
                            "description": "the part: a file, a variable, a command, a task"
                          },
                          "change": {
                            "enum": ["changed", "added", "removed"],
                            "description": "changed, added or removed"
                          }
                        }
                      }
                    }
                  },
                  "description": "a miss: what its key changed since its last saved entry"
                },
                "artifactBytes": {
                  "type": "number",
                  "description": "the artifact's compressed size, a hit's or a measured save's"
                },
                "fetchMs": {
                  "type": "number",
                  "description": "a remote hit's download and ingest"
                },
                "saveMs": { "type": "number", "description": "a measured save's own time" },
                "timedOut": { "const": true, "description": "its exec.timeout killed it" },
                "notReady": {
                  "enum": ["timeout", "exited", "spawn"],
                  "description": "a persistent task that never became ready, and why"
                },
                "inputMoved": {
                  "type": "string",
                  "description": "the input that changed while the command ran"
                },
                "blockedBy": {
                  "type": "string",
                  "description": "a skipped task: the failed task at the root of the block; absent for a fail-fast skip"
                },
                "otherPlatform": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["needs", "host"],
                  "properties": {
                    "needs": {
                      "type": "array",
                      "description": "the platforms its exec.platforms lists, like darwin-arm64",
                      "items": { "type": "string" }
                    },
                    "host": { "type": "string", "description": "this machine's platform" }
                  },
                  "description": "a skipped task whose exec.platforms leave out this machine"
                },
                "restored": {
                  "type": "boolean",
                  "description": "on a hit: true when outputs were restored, false when up to date"
                },
                "sandboxViolations": {
                  "type": "integer",
                  "description": "how many accesses its sandbox denied"
                },
                "sandboxViolationLines": {
                  "type": "array",
                  "description": "those denials, one line each",
                  "items": { "type": "string" }
                },
                "wallclockStartNs": {
                  "type": "string",
                  "description": "decimal nanoseconds from the run's start"
                },
                "wallclockEndNs": {
                  "type": "string",
                  "description": "decimal nanoseconds from the run's start"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "measure"],
          "properties": {
            "kind": { "const": "task:measure", "description": "a plugin timed something" },
            "measure": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "def", "durationMs"],
              "properties": {
                "id": { "type": "string", "description": "<plugin>#<name>" },
                "def": {
                  "type": "string",
                  "description": "a hash of what it measures; a new one starts its history over"
                },
                "durationMs": { "type": "number", "description": "how long it took" },
                "cores": { "type": "number", "description": "the cores it kept busy" }
              },
              "description": "what a plugin timed that is no task of the graph"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "line"],
          "properties": {
            "kind": { "const": "run:status", "description": "the run's status line changed" },
            "line": { "type": "string", "description": "the status line, plain text" },
            "warn": { "const": true, "description": "a warning" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id"],
          "properties": {
            "kind": { "const": "step:start", "description": "one of vx's own steps started" },
            "id": { "type": "string", "description": "the step's name, like vx:prefetch" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "id", "durationMs", "ok"],
          "properties": {
            "kind": { "const": "step:end", "description": "one of vx's own steps ended" },
            "id": { "type": "string", "description": "the step's name, like vx:prefetch" },
            "durationMs": { "type": "number", "description": "how long it took" },
            "ok": { "type": "boolean", "description": "false when it failed" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["run:end", "run:stop", "run:done"],
              "description": "run:stop: the run began to stop early; run:end: every task ended; run:done: the last event"
            }
          }
        }
      ]
    },
    "rows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rows"],
      "properties": {
        "rows": {
          "type": "array",
          "description": "`--sql`: one object per row, keyed by the query's column names",
          "items": {
            "type": "object",
            "additionalProperties": { "type": ["string", "number", "null"] }
          }
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "branch", "stats"],
      "properties": {
        "window": { "type": "integer", "description": "the newest runs the numbers cover" },
        "branch": {
          "type": ["string", "null"],
          "description": "the branch p50 forecasts from: --branch, VX_RUN_BRANCH, git's, then CI's"
        },
        "stats": {
          "type": "array",
          "description": "one row per task",
          "items": { "$ref": "#/$defs/taskStats" }
        }
      }
    },
    "taskStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taskId",
        "runs",
        "p50DurationMs",
        "p99DurationMs",
        "successRate",
        "hitRate",
        "failureMode",
        "maxPeakRssBytes",
        "maxCpuParallelism"
      ],
      "properties": {
        "taskId": { "type": "string", "description": "project#task" },
        "runs": { "type": "integer", "description": "executed runs in the window, skips aside" },
        "p50DurationMs": {
          "type": ["number", "null"],
          "description": "the forecast a run shows: median of the last 5 timings on branch, else on any branch; null when none"
        },
        "p99DurationMs": {
          "type": ["number", "null"],
          "description": "99th percentile of its executed durations; null when none"
        },
        "successRate": { "type": "number", "description": "0 to 1" },
        "hitRate": { "type": "number", "description": "0 to 1" },
        "failureMode": {
          "enum": ["stable", "flaky-recoverable", "flaky-fatal"],
          "description": "stable; flaky-recoverable: a key that passed also failed, under 1 in 5 runs; flaky-fatal: as often or more"
        },
        "maxPeakRssBytes": {
          "type": ["integer", "null"],
          "description": "the most resident memory one run used; null when nothing sampled"
        },
        "maxCpuParallelism": {
          "type": ["number", "null"],
          "description": "cpu time over wall time; 2.0 is two cores busy"
        }
      }
    },
    "log": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "taskId", "status", "source", "output"],
      "properties": {
        "runId": { "type": "string", "description": "the run the output is from" },
        "taskId": { "type": "string", "description": "project#task" },
        "status": {
          "type": "string",
          "description": "success, cache-hit, cache-hit-remote, failed, skipped or aborted"
        },
        "source": {
          "enum": ["failure", "cache", null],
          "description": "the kept failure output, the cache entry's log, or none kept"
        },
        "output": { "type": "string", "description": "plain text; '' when source is null" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "command",
        "requestedTasks",
        "cachePolicy",
        "concurrency",
        "flow",
        "startedAt",
        "endedAt",
        "totalDurationMs",
        "taskCount",
        "failedCount",
        "hitCount",
        "hitLocalCount",
        "hitRemoteCount",
        "upToDateCount",
        "restoredLocalCount",
        "restoredRemoteCount",
        "abortedCount",
        "exitOk",
        "commitSha",
        "branch",
        "dirty",
        "ci",
        "ciProvider",
        "host",
        "os",
        "arch",
        "vxVersion"
      ],
      "properties": {
        "runId": { "type": "string", "description": "the run id" },
        "command": { "type": "string", "description": "the command line that started it" },
        "requestedTasks": {
          "type": "array",
          "description": "the tasks asked for",
          "items": { "type": "string" }
        },
        "cachePolicy": {
          "type": "string",
          "description": "the cache policy it ran under, like local:rw,remote:r"
        },
        "concurrency": { "type": "integer", "description": "its worker count" },
        "flow": {
          "enum": ["focused", "broad", null],
          "description": "focused: the requested task in a frame; broad: one row per task; null on older history"
        },
        "startedAt": { "type": "integer", "description": "epoch ms" },
        "endedAt": { "type": "integer", "description": "epoch ms" },
        "totalDurationMs": { "type": "number", "description": "wall time of the run" },
        "taskCount": { "type": "integer", "description": "tasks it reached" },
        "failedCount": { "type": "integer", "description": "tasks that failed" },
        "hitCount": { "type": "integer", "description": "cache hits, local and remote" },
        "hitLocalCount": { "type": "integer", "description": "hits from the local cache" },
        "hitRemoteCount": { "type": "integer", "description": "hits from the remote cache" },
        "upToDateCount": {
          "type": "integer",
          "description": "hits that restored nothing: the disk already matched"
        },
        "restoredLocalCount": {
          "type": "integer",
          "description": "hits that restored outputs from the local cache"
        },
        "restoredRemoteCount": {
          "type": "integer",
          "description": "hits that restored outputs from the remote cache"
        },
        "abortedCount": {
          "type": "integer",
          "description": "tasks a stop or --fail-fast killed once started: counted by the footer, with no row in tasks"
        },
        "exitOk": { "type": "boolean", "description": "the run exited 0" },
        "commitSha": {
          "type": ["string", "null"],
          "description": "HEAD when it ran; null outside git"
        },
        "branch": {
          "type": ["string", "null"],
          "description": "the branch it ran on; null when none"
        },
        "dirty": {
          "type": ["boolean", "null"],
          "description": "the work tree had changes; null outside git"
        },
        "ci": { "type": "boolean", "description": "it ran on CI" },
        "ciProvider": {
          "type": ["string", "null"],
          "description": "which CI, like github; null when none"
        },
        "host": {
          "type": ["string", "null"],
          "description": "the machine name; null when unknown"
        },
        "os": {
          "type": ["string", "null"],
          "description": "the OS, like linux; null when unknown"
        },
        "arch": {
          "type": ["string", "null"],
          "description": "the CPU architecture, like x64; null when unknown"
        },
        "vxVersion": { "type": "string", "description": "the vx that ran it" }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "project",
        "task",
        "status",
        "exitCode",
        "durationMs",
        "startedAt",
        "endedAt",
        "cacheHit",
        "restored",
        "cached",
        "hash",
        "cpuMs",
        "peakRssBytes",
        "peakCores",
        "avgRssBytes",
        "queuedMs",
        "placement",
        "outputBytes",
        "blocks",
        "wallclockStartNs",
        "wallclockEndNs",
        "blockedBy",
        "timedOut",
        "sandboxViolations",
        "notReady",
        "remoteError",
        "forwarded",
        "attempts"
      ],
      "properties": {
        "runId": {
          "type": ["string", "null"],
          "description": "the run; null on history older than run ids"
        },
        "project": { "type": "string", "description": "the project name" },
        "task": { "type": "string", "description": "the task name" },
        "status": {
          "type": "string",
          "description": "success, cache-hit, cache-hit-remote, failed, skipped or aborted"
        },
        "exitCode": {
          "type": "integer",
          "description": "a skipped task records 0 when an exec.platforms skip is its root, 1 behind a failure or fail-fast"
        },
        "durationMs": { "type": "number", "description": "how long it took this run" },
        "startedAt": { "type": "integer", "description": "epoch ms" },
        "endedAt": { "type": "integer", "description": "epoch ms" },
        "cacheHit": {
          "type": ["boolean", "null"],
          "description": "true when the task's outputs came from the cache instead of running"
        },
        "restored": {
          "type": ["boolean", "null"],
          "description": "on a hit: true when outputs were restored, false when up-to-date"
        },
        "cached": {
          "type": ["boolean", "null"],
          "description": "whether the task declares a cache (false prints no-cache); not whether this run hit it"
        },
        "hash": { "type": "string", "description": "its cache key; empty when it had none" },
        "cpuMs": {
          "type": ["number", "null"],
          "description": "CPU time its command used; null when not measured"
        },
        "peakRssBytes": {
          "type": ["integer", "null"],
          "description": "peak resident memory of its command; null when not measured"
        },
        "peakCores": {
          "type": ["number", "null"],
          "description": "most cores one sampling interval burned; null when nothing sampled"
        },
        "avgRssBytes": {
          "type": ["integer", "null"],
          "description": "mean resident memory over the samples; null when nothing sampled"
        },
        "queuedMs": {
          "type": ["integer", "null"],
          "description": "milliseconds it waited, ready, for a slot; null when it never queued"
        },
        "placement": {
          "type": ["string", "null"],
          "description": "where an executor ran it (small#1); null when here"
        },
        "outputBytes": {
          "type": ["integer", "null"],
          "description": "bytes of its outputs: what its save stored, or its hit restored"
        },
        "blocks": {
          "type": ["integer", "null"],
          "description": "how many tasks were downstream of it"
        },
        "wallclockStartNs": {
          "type": ["string", "null"],
          "description": "decimal nanoseconds from the run's start"
        },
        "wallclockEndNs": {
          "type": ["string", "null"],
          "description": "decimal nanoseconds from the run's start"
        },
        "blockedBy": {
          "type": ["string", "null"],
          "description": "the project#task its skip traces to; null when none"
        },
        "timedOut": {
          "type": ["boolean", "null"],
          "description": "its exec.timeout killed it; null when not recorded"
        },
        "sandboxViolations": {
          "type": ["integer", "null"],
          "description": "how many accesses its sandbox denied; null when not recorded"
        },
        "notReady": {
          "enum": ["timeout", "exited", "spawn", null],
          "description": "a persistent task that never became ready: timeout, exited or spawn; null otherwise"
        },
        "remoteError": {
          "type": ["string", "null"],
          "description": "each failed remote read or write of the key, `; `-joined"
        },
        "forwarded": { "type": "boolean", "description": "it ran with the args after --" },
        "inputMoved": {
          "type": "string",
          "description": "on a row failed by inputStability.severity 'error': the input that changed during the run"
        },
        "attempts": {
          "type": ["integer", "null"],
          "description": "the attempts a retried task took (more than one); null when it ran once"
        },
        "output": {
          "type": "string",
          "description": "on a failed row: its output, plain text, bounded (first 8 KiB, last 56 KiB), secrets masked; '' when none was recorded"
        },
        "dir": {
          "type": "string",
          "description": "on a failed row: its project's directory from the workspace root, '.' for the root; the relative paths in its output start there"
        },
        "locations": {
          "type": "array",
          "description": "on a failed row: the existing files its output names, in order of first appearance; a file it also names with a line drops its bare mention",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file"],
            "properties": {
              "file": { "type": "string", "description": "absolute" },
              "line": { "type": "integer", "description": "the line its output names" },
              "col": { "type": "integer", "description": "the column its output names" }
            }
          }
        },
        "sandboxFix": {
          "type": "object",
          "description": "on a sandboxed failed row: the exec.sandbox.allow entries that would have granted its denials",
          "additionalProperties": false,
          "properties": {
            "read": {
              "type": "array",
              "description": "paths to add to exec.sandbox.allow.read",
              "items": { "type": "string" }
            },
            "write": {
              "type": "array",
              "description": "paths to add to exec.sandbox.allow.write",
              "items": { "type": "string" }
            },
            "network": {
              "type": "array",
              "description": "hosts to add to exec.sandbox.allow.network",
              "items": { "type": "string" }
            },
            "systemInfo": {
              "type": "array",
              "description": "sysctl names to add to exec.sandbox.allow.systemInfo (macOS)",
              "items": { "type": "string" }
            },
            "withheld": {
              "type": "array",
              "description": "credential paths it denied and left out of the grants",
              "items": { "type": "string" }
            },
            "inputs": {
              "type": "array",
              "description": "a cached task's reads of its project no inputs.files glob matches",
              "items": { "type": "string" }
            },
            "workspaceFiles": {
              "type": "array",
              "description": "a cached task's reads elsewhere in the workspace no inputs.workspaceFiles glob matches",
              "items": { "type": "string" }
            }
          }
        },
        "fixedIn": {
          "type": "string",
          "description": "on a failed row: the first later run where this task passed (ran or hit); absent while it has not"
        }
      }
    }
  }
}
