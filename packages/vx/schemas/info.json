{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vx info --format json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vx",
    "vxPath",
    "handedOffFrom",
    "bun",
    "bunSupported",
    "git",
    "gitStatusCache",
    "workspaceRoot",
    "projects",
    "tasks",
    "plugins",
    "workers",
    "memory",
    "cacheDir",
    "cacheDirBytes",
    "cacheStore",
    "cacheStoreBytes",
    "cacheVersion",
    "schemaVersion",
    "cacheEntries",
    "cacheBytes",
    "cacheIndexError",
    "settings",
    "orphans",
    "runs24h",
    "hits24h",
    "restored24h",
    "flakyTasks",
    "lockfile",
    "lockError",
    "sandbox"
  ],
  "properties": {
    "vx": { "type": "string" },
    "vxPath": { "type": "string" },
    "handedOffFrom": { "type": ["string", "null"] },
    "bun": { "type": "string" },
    "bunSupported": { "type": "boolean" },
    "git": { "type": ["string", "null"] },
    "gitStatusCache": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["fsmonitor", "untrackedCache"],
      "properties": { "fsmonitor": { "type": "boolean" }, "untrackedCache": { "type": "boolean" } }
    },
    "workspaceRoot": { "type": "string" },
    "projects": { "type": "integer" },
    "tasks": { "type": "integer" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "seams"],
        "properties": {
          "name": { "type": "string" },
          "seams": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "source", "cores", "cpuQuota"],
      "properties": {
        "count": { "type": "integer" },
        "source": { "enum": ["env", "workspace", "cgroup", "cores"] },
        "cores": { "type": "integer" },
        "cpuQuota": { "type": ["number", "null"] }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usableBytes", "totalBytes", "cgroupLimitBytes"],
      "properties": {
        "usableBytes": { "type": "integer" },
        "totalBytes": { "type": "integer" },
        "cgroupLimitBytes": { "type": ["integer", "null"] }
      }
    },
    "cacheDir": { "type": "string" },
    "cacheDirBytes": { "type": "integer" },
    "cacheStore": { "type": ["string", "null"] },
    "cacheStoreBytes": { "type": ["integer", "null"] },
    "cacheVersion": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "cacheEntries": { "type": "integer" },
    "cacheBytes": { "type": "integer" },
    "cacheIndexError": {
      "type": ["string", "null"],
      "description": "Why the cache index cannot be read, with the fix; null when it reads. While set, the counts it holds read 0."
    },
    "settings": {
      "type": "object",
      "description": "every setting (docs/schema.md § Settings) by path, as a run with no flags takes it: its variable as written, else .vx/workspace's value, else null with source default",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "source"],
        "properties": {
          "value": { "type": ["string", "number", "boolean", "null"] },
          "source": { "enum": ["env", "workspace", "default"] },
          "refused": {
            "type": "string",
            "description": "why a run refuses the variable's value; absent when a run takes it"
          }
        }
      }
    },
    "orphans": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts", "bytes"],
      "properties": { "artifacts": { "type": "integer" }, "bytes": { "type": "integer" } }
    },
    "runs24h": { "type": "integer" },
    "hits24h": { "type": "integer" },
    "restored24h": {
      "type": "integer",
      "description": "of hits24h, the hits that restored outputs; the rest were up to date"
    },
    "flakyTasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "project", "task", "keys", "passes", "failures"],
        "properties": {
          "taskId": { "type": "string" },
          "project": { "type": "string" },
          "task": { "type": "string" },
          "keys": { "type": "integer" },
          "passes": { "type": "integer" },
          "failures": { "type": "integer" }
        }
      }
    },
    "lockfile": { "type": "boolean" },
    "lockError": {
      "type": ["string", "null"],
      "description": "Why a run refuses the lock that is there (run `vx lock`); null when a run reads it or there is none."
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "reason", "declared", "untraced"],
      "properties": {
        "available": { "type": "boolean" },
        "reason": { "type": "string" },
        "declared": { "type": "integer" },
        "untraced": { "type": ["string", "null"] }
      }
    }
  }
}
