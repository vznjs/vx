{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vx why --format json",
  "description": "A task's run against its previous run. On history older than run ids, `why` and `diff` are null and `explanation` carries the latest cache entry.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "runId", "why", "diff", "roots", "writers"],
      "properties": {
        "taskId": { "type": "string", "description": "project#task" },
        "runId": { "type": "string", "description": "the run explained: --run, else the latest" },
        "why": {
          "$ref": "#/$defs/why",
          "description": "the task's row in that run against the run before it"
        },
        "diff": {
          "$ref": "#/$defs/diff",
          "description": "which parts of its key moved since its previous run"
        },
        "roots": {
          "type": "array",
          "description": "The tasks under moved upstreams whose own key components moved in this run, each with the chain from the asked task down to it.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["chain", "entries"],
            "properties": {
              "chain": {
                "type": "array",
                "description": "project#task ids from the asked task down to the root",
                "items": { "type": "string" }
              },
              "entries": {
                "type": "array",
                "description": "the root's own key parts that moved",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "name", "change", "before", "after"],
                  "properties": {
                    "kind": { "type": "string", "description": "files, env, runtime, upstream, …" },
                    "name": {
                      "type": "string",
                      "description": "the part: a file, a variable, a command, a task"
                    },
                    "change": {
                      "enum": ["added", "removed", "changed"],
                      "description": "added, removed or changed since the previous run"
                    },
                    "before": {
                      "type": ["string", "null"],
                      "description": "the part's hash in the previous run; null when added"
                    },
                    "after": {
                      "type": ["string", "null"],
                      "description": "the part's hash in this run; null when removed"
                    }
                  }
                }
              }
            }
          }
        },
        "writers": {
          "type": "array",
          "description": "For each moved input file of the task or a root cause, the recorded tasks running when the file last changed: a task writing a file another key reads re-keys it every run.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["taskId", "file", "writers"],
            "properties": {
              "taskId": {
                "type": "string",
                "description": "the task whose input moved: project#task"
              },
              "file": { "type": "string", "description": "the moved input, workspace-relative" },
              "writers": {
                "type": "array",
                "description": "project#task ids running when it last changed",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "why", "diff", "explanation"],
      "properties": {
        "taskId": { "type": "string", "description": "project#task" },
        "why": { "type": "null", "description": "null: the history predates run ids" },
        "diff": { "type": "null", "description": "null: the history predates run ids" },
        "explanation": {
          "$ref": "#/$defs/explanation",
          "description": "the task's latest cache entry"
        }
      }
    }
  ],
  "$defs": {
    "why": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "taskId", "found", "thisRun", "previousRun", "hashChanged", "note"],
      "properties": {
        "runId": { "type": "string", "description": "the run asked about" },
        "taskId": { "type": "string", "description": "project#task" },
        "found": { "const": true, "description": "always true: the task has a row in the run" },
        "thisRun": {
          "type": "object",
          "description": "the task's row in this run",
          "additionalProperties": false,
          "required": ["hash", "status", "cacheHit", "restored", "cached", "startedAt"],
          "properties": {
            "hash": {
              "type": "string",
              "description": "empty for a task that never ran (skipped)"
            },
            "status": {
              "type": "string",
              "description": "success, cache-hit, cache-hit-remote, failed, skipped or aborted"
            },
            "cacheHit": {
              "type": ["boolean", "null"],
              "description": "true when its outputs came from the cache; null when there was no cache outcome"
            },
            "restored": {
              "type": ["boolean", "null"],
              "description": "on a hit: true when outputs were restored, false when up-to-date"
            },
            "cached": {
              "type": ["boolean", "null"],
              "description": "whether the task declares a cache; not whether this run hit it"
            },
            "startedAt": { "type": "integer", "description": "epoch ms" }
          }
        },
        "previousRun": {
          "type": ["object", "null"],
          "description": "null on the task's first recorded run",
          "additionalProperties": false,
          "required": ["hash", "status", "cacheHit", "restored", "startedAt"],
          "properties": {
            "hash": { "type": "string", "description": "its cache key then" },
            "status": {
              "type": "string",
              "description": "success, cache-hit, cache-hit-remote, failed, skipped or aborted"
            },
            "cacheHit": {
              "type": ["boolean", "null"],
              "description": "true when its outputs came from the cache; null when there was no cache outcome"
            },
            "restored": {
              "type": ["boolean", "null"],
              "description": "on a hit: true when outputs were restored, false when up-to-date"
            },
            "startedAt": { "type": "integer", "description": "epoch ms" }
          }
        },
        "hashChanged": {
          "type": ["boolean", "null"],
          "description": "null when either run has no key"
        },
        "note": { "type": "string", "description": "the verdict, plain text; may change" }
      }
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "taskId",
        "found",
        "previousRunId",
        "entries",
        "unchangedCount",
        "note"
      ],
      "properties": {
        "runId": { "type": "string", "description": "the run asked about" },
        "taskId": { "type": "string", "description": "project#task" },
        "found": { "type": "boolean", "description": "false when the task has no row in that run" },
        "previousRunId": {
          "type": ["string", "null"],
          "description": "the run compared against; null when there is none"
        },
        "entries": {
          "type": "array",
          "description": "each key part that changed, appeared or went; unchanged ones are only counted",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "name", "change", "before", "after"],
            "properties": {
              "kind": { "type": "string", "description": "files, env, runtime, upstream, …" },
              "name": {
                "type": "string",
                "description": "the part: a file, a variable, a command, a task"
              },
              "change": {
                "enum": ["added", "removed", "changed"],
                "description": "added, removed or changed since the previous run"
              },
              "before": {
                "type": ["string", "null"],
                "description": "the part's hash in the previous run; null when added"
              },
              "after": {
                "type": ["string", "null"],
                "description": "the part's hash in this run; null when removed"
              }
            }
          }
        },
        "unchangedCount": { "type": "integer", "description": "key parts that did not move" },
        "note": { "type": "string", "description": "the verdict, plain text; may change" }
      }
    },
    "explanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "project", "task", "latestEntry", "note"],
      "properties": {
        "taskId": { "type": "string", "description": "project#task" },
        "project": { "type": "string", "description": "the project name" },
        "task": { "type": "string", "description": "the task name" },
        "latestEntry": {
          "type": ["object", "null"],
          "description": "its newest cache entry; null when it has none",
          "additionalProperties": false,
          "required": ["hash", "command", "exitCode", "durationMs", "sizeBytes", "createdAt"],
          "properties": {
            "hash": { "type": "string", "description": "the cache key" },
            "command": { "type": "string", "description": "the command that made it" },
            "exitCode": { "type": "integer", "description": "the command's exit code" },
            "durationMs": { "type": "number", "description": "how long the command ran" },
            "sizeBytes": { "type": "integer", "description": "the entry's size on disk" },
            "createdAt": { "type": "integer", "description": "epoch ms" }
          }
        },
        "note": { "type": "string", "description": "plain text; may change" }
      }
    }
  }
}
