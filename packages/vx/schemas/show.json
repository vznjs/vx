{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "vx show --format json",
  "description": "`vx show` lists projects; `vx show <project>` prints one project's resolved config; `vx show <project>#<task>` one task's; `vx show <task>` that task in every project declaring it. A secret value is masked.",
  "oneOf": [
    { "type": "array", "items": { "$ref": "#/$defs/listRow" } },
    { "$ref": "#/$defs/project" },
    { "$ref": "#/$defs/task" },
    {
      "type": "array",
      "minItems": 1,
      "description": "`vx show <task>`; when no project in scope declares it, `[]`, which the list branch holds",
      "items": { "$ref": "#/$defs/task" }
    }
  ],
  "$defs": {
    "listRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dir", "tags", "tasks"],
      "properties": {
        "name": { "type": "string" },
        "dir": {
          "type": "string",
          "description": "relative to the workspace root, POSIX separators"
        },
        "tags": { "$ref": "#/$defs/stringList" },
        "tasks": { "type": "array", "items": { "type": "string" } }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dir", "config"],
      "properties": {
        "name": { "type": "string" },
        "dir": { "type": "string" },
        "config": {
          "type": ["object", "null"],
          "description": "null when the project has no vx config and no plugin gave it one",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "tags": { "$ref": "#/$defs/stringList" },
            "tasks": { "type": "object", "additionalProperties": { "$ref": "#/$defs/taskConfig" } }
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dir", "task", "config"],
      "properties": {
        "name": { "type": "string" },
        "dir": { "type": "string" },
        "task": { "type": "string" },
        "config": { "$ref": "#/$defs/taskConfig" }
      }
    },
    "stringList": { "type": "array", "items": { "type": "string" } },
    "taskConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": { "type": "string" },
        "dependsOn": { "$ref": "#/$defs/stringList" },
        "exec": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": { "type": "string" },
            "remote": { "enum": [true, false, "only"] },
            "timeout": { "type": "string", "description": "a duration as written, like '30s'" },
            "retries": { "type": "integer" },
            "env": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "passThrough": { "$ref": "#/$defs/stringList" },
                "define": { "type": "object", "additionalProperties": { "type": "string" } },
                "secret": { "$ref": "#/$defs/stringList" }
              }
            },
            "persistent": {
              "type": "object",
              "additionalProperties": false,
              "properties": { "readyWhen": { "type": "string" } }
            },
            "interactive": { "type": "boolean" },
            "platforms": {
              "type": "array",
              "items": { "enum": ["linux-x64", "linux-arm64", "darwin-x64", "darwin-arm64"] }
            },
            "sandbox": {
              "type": "object",
              "description": "as declared; its fields are the `exec.sandbox` section of the config schema"
            }
          }
        },
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["files"],
          "properties": {
            "files": { "$ref": "#/$defs/stringList" },
            "workspaceFiles": { "$ref": "#/$defs/stringList" },
            "env": { "$ref": "#/$defs/stringList" },
            "tasks": { "$ref": "#/$defs/stringList" },
            "runtime": { "$ref": "#/$defs/stringList" },
            "workspaceRuntime": { "$ref": "#/$defs/stringList" }
          }
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outputs"],
          "properties": {
            "outputs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["files"],
              "properties": {
                "files": { "$ref": "#/$defs/stringList" },
                "workspaceFiles": { "$ref": "#/$defs/stringList" },
                "clean": { "type": "boolean" }
              }
            },
            "inputStability": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "strategy": { "enum": ["immutable", "mutable", "unchecked"] },
                "severity": { "enum": ["warn", "error"] }
              }
            }
          }
        }
      }
    }
  }
}
