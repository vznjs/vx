            "VX_NX_MODULES",
            "VX_REQUIRE_NX",
            "VX_REQUIRE_REFTABLE",
            "VX_REQUIRE_NONROOT"
          ],
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0",
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "FORCE_COLOR": "0",
            "VX_CACHE_DIR": ".vx/cache"
          }
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space",
              "net.link.addr"
            ],
            "localBinding": true
          },
          "ignore": {
            "network": [
              "no-such-host.invalid:80"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "src/**",
          "tests/**",
          "package.json"
        ],
        "env": [
          "VX_NX_MODULES",
          "VX_REQUIRE_NX",
          "VX_REQUIRE_REFTABLE",
          "VX_REQUIRE_NONROOT"
        ]
      },
      "cache": {
        "outputs": {
          "files": []
        }
      }
    },
    "test.shard-4": {
      "description": "bun test, shard 4 of 4",
      "exec": {
        "command": "bun test --only-failures --shard=4/4 --timings=tests/timings.json",
        "env": {
          "passThrough": [
            "VX_NX_MODULES",
            "VX_REQUIRE_NX",
            "VX_REQUIRE_REFTABLE",
            "VX_REQUIRE_NONROOT"
          ],
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0",
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "FORCE_COLOR": "0",
            "VX_CACHE_DIR": ".vx/cache"
          }
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space",
              "net.link.addr"
            ],
            "localBinding": true
          },
          "ignore": {
            "network": [
              "no-such-host.invalid:80"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "src/**",
          "tests/**",
          "package.json"
        ],
        "env": [
          "VX_NX_MODULES",
          "VX_REQUIRE_NX",
          "VX_REQUIRE_REFTABLE",
          "VX_REQUIRE_NONROOT"
        ]
      },
      "cache": {
        "outputs": {
          "files": []
        }
      }
    },
    "test.live": {
      "description": "bun test, the live Nx files, against the install in .nx-live",
      "exec": {
        "command": "bun test --only-failures ./tests/*-live.test.ts",
        "env": {
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0",
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "FORCE_COLOR": "0",
            "VX_CACHE_DIR": ".vx/cache",
            "VX_NX_MODULES": ".nx-live",
            "VX_REQUIRE_NX": "1"
          }
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space",
              "net.link.addr"
            ],
            "localBinding": true
          },
          "ignore": {
            "network": [
              "no-such-host.invalid:80"
            ]
          }
        }
      },
      "dependsOn": [
        "install",
        "nx.install"
      ]
    },
    "nx.install": {
      "description": "bun add nx@22 into .nx-live",
      "exec": {
        "command": "mkdir -p .nx-live && cd .nx-live && { [ -f package.json ] || echo '{\"private\":true}' > package.json; } && bun add nx@22 @nx/js@22 typescript@5 && echo installed",
        "persistent": {
          "readyWhen": "^installed$"
        },
        "timeout": "5m"
      }
    }
  }
}
