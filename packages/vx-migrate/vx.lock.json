{
  "tasks": {
    "install": {
      "dependsOn": [
        "^build"
      ]
    },
    "build": {
      "description": "nothing to build — consumed as source",
      "dependsOn": [
        "^build"
      ],
      "inputs": {
        "files": [
          "src/**",
          "package.json"
        ]
      }
    },
    "ci": {
      "dependsOn": [
        "lint",
        "test",
        "test.live"
      ]
    },
    "lint": {
      "dependsOn": [
        "lint.oxlint",
        "lint.oxfmt"
      ]
    },
    "lint.oxlint": {
      "description": "oxlint with tsgolint-backed type-aware checks",
      "exec": {
        "command": "oxlint --type-aware --type-check",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "src/**",
          "tests/**",
          "package.json",
          ".oxlintrc.json",
          "tsconfig.json"
        ]
      },
      "cache": {
        "outputs": {
          "files": []
        }
      }
    },
    "lint.oxfmt": {
      "description": "oxfmt --check (no rewrite; CI-safe)",
      "exec": {
        "command": "oxfmt --check .",
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "**/*",
          "package.json"
        ]
      },
      "cache": {
        "outputs": {
          "files": []
        }
      }
    },
    "test": {
      "dependsOn": [
        "test.shard-*"
      ]
    },
    "test.shard-1": {
      "description": "bun test, shard 1 of 4",
      "exec": {
        "command": "bun test --only-failures --shard=1/4 --timings=tests/timings.json",
        "env": {
          "passThrough": [
            "VX_NX_MODULES",
            "VX_REQUIRE_NX",
            "VX_REQUIRE_REFTABLE",
            "VX_REQUIRE_NONROOT"
          ],
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0",
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "FORCE_COLOR": "0",
            "VX_CACHE_DIR": ".vx/cache"
          }
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space",
              "net.link.addr"
            ],
            "localBinding": true
          },
          "ignore": {
            "network": [
              "no-such-host.invalid:80"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "src/**",
          "tests/**",
          "package.json"
        ],
        "env": [
          "VX_NX_MODULES",
          "VX_REQUIRE_NX",
          "VX_REQUIRE_REFTABLE",
          "VX_REQUIRE_NONROOT"
        ]
      },
      "cache": {
        "outputs": {
          "files": []
        }
      }
    },
    "test.shard-2": {
      "description": "bun test, shard 2 of 4",
      "exec": {
        "command": "bun test --only-failures --shard=2/4 --timings=tests/timings.json",
        "env": {
          "passThrough": [
            "VX_NX_MODULES",
            "VX_REQUIRE_NX",
            "VX_REQUIRE_REFTABLE",
            "VX_REQUIRE_NONROOT"
          ],
          "define": {
            "BUN_RUNTIME_TRANSPILER_CACHE_PATH": "0",
            "GIT_CONFIG_GLOBAL": "/dev/null",
            "GIT_CONFIG_NOSYSTEM": "1",
            "FORCE_COLOR": "0",
            "VX_CACHE_DIR": ".vx/cache"
          }
        },
        "sandbox": {
          "allow": {
            "read": [
              "**/*"
            ],
            "systemInfo": [
              "vfs.disk-space",
              "net.link.addr"
            ],
            "localBinding": true
          },
          "ignore": {
            "network": [
              "no-such-host.invalid:80"
            ]
          }
        }
      },
      "dependsOn": [
        "install"
      ],
      "inputs": {
        "files": [
          "src/**",
          "tests/**",
          "package.json"
        ],
        "env": [
          "VX_NX_MODULES",
          "VX_REQUIRE_NX",
          "VX_REQUIRE_REFTABLE",
          "VX_REQUIRE_NONROOT"
        ]
      },
      "cache": {
        "outputs": {
          "files": []
        }
      }
    },
