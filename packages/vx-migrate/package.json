{
  "name": "@vzn/vx-migrate",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Adopt @vzn/vx from Turborepo or Nx: run a Turbo repo unchanged, migrate either to vx.config.ts, and keep your Turbo or Nx remote cache",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "vx-migrate": "./src/bin.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@vzn/vx": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@vzn/vx": "*"
  }
}
