{
  "name": "@vzn/vx-migrate",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Adopt @vzn/vx from Turborepo, Nx, wireit, lage or plain workspace scripts: run the repo unchanged, migrate it to vx.config.ts, and keep your Turbo or Nx remote cache",
  "keywords": [
    "vx",
    "vx-plugin",
    "monorepo",
    "turborepo",
    "nx",
    "wireit",
    "lage",
    "migration",
    "remote-cache"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "vx-migrate": "./src/bin.ts",
    "nx-exec": "./src/nx-exec.cjs",
    "nx-env": "./src/nx-env.cjs",
    "lage-worker": "./src/lage-worker.cjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@vzn/vx": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@vzn/vx": "*"
  }
}
