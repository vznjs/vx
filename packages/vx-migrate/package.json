{
  "name": "@vzn/vx-migrate",
  "version": "0.0.0",
  "description": "Adopt vx from Turbo or Nx: `bunx @vzn/vx-migrate` writes one vx.config.ts per package from turbo.json or an exported Nx project graph, through core's migration seam.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "vx-migrate": "./src/bin.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "index.ts",
    "src",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4"
  },
  "dependencies": {
    "@vzn/vx-turbo": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@vzn/vx": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@vzn/vx": "*"
  }
}
