{
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/vite.config.ts"
    ],
    "sharedGlobals": []
  },
  "plugins": [
    { "plugin": "@nx/vitest", "options": { "testTargetName": "test", "ciTargetName": "test-ci" } }
  ]
}
