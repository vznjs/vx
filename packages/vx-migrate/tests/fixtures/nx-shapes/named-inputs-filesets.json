            },
            "dts": {
              "command": "tsc --emitDeclarationOnly -p libs/b",
              "cache": true,
              "outputs": ["{projectRoot}/dist/**/*.d.ts"]
            }
          }
        }
      },
      "c": {
        "name": "c",
        "data": {
          "root": "libs/c",
          "targets": {
            "build": {
              "command": "tsc -b libs/c",
              "cache": true,
              "outputs": ["{projectRoot}/dist"]
            }
          }
        }
      }
    },
    "dependencies": { "a": [{ "source": "a", "target": "b", "type": "static" }], "b": [], "c": [] }
