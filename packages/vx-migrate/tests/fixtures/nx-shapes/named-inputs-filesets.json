              "outputs": ["{options.outputPath}", "!{options.outputPath}/stats.html"]
            },
            "typecheck": {
              "command": "tsc --noEmit -p libs/a/tsconfig.lib.json",
              "cache": true,
              "inputs": [{ "input": "production", "projects": ["b", "c"] }, "production"],
              "outputs": []
            },
            "bundle-report": {
              "command": "node scripts/report.js",
              "cache": false,
              "outputs": ["{projectRoot}/report/**/*.html"]
            },
            "dts": {
              "command": "tsc --emitDeclarationOnly",
              "cache": true,
              "inputs": [
                "production",
                { "dependentTasksOutputFiles": "**/*.d.ts", "transitive": true }
              ],
              "outputs": ["{projectRoot}/dist/**/*.d.ts"],
              "dependsOn": ["^dts"]
            }
          }
        }
      },
      "b": {
        "name": "b",
        "data": {
          "root": "libs/b",
          "targets": {
            "build": {
              "command": "tsc -b libs/b",
