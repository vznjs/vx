{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "import"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "warn",
    "unicorn/no-useless-spread": "off",
    "typescript/unbound-method": "off"
  },
  "ignorePatterns": ["node_modules", "dist"]
}
