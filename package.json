{
  "name": "vzn-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for @vzn/run — an open, extensible task runner.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.10",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && pnpm -r exec rm -rf dist",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.9",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
