{
  "name": "@vzn/run",
  "version": "0.0.0",
  "description": "An open, extensible monorepo task runner.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "vzn": "./src/bin.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "dependencies": {
    "ignore": "^7.0.4"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
