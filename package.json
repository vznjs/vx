{
  "name": "@vzn/monorepo",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Workspace root for @vzn/vx and its plugin packages.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@vzn/vx": "workspace:*",
    "@vzn/vx-github": "workspace:*",
    "@vzn/vx-lockfile": "workspace:*",
    "@vzn/vx-mcp": "workspace:*",
    "@vzn/vx-otel": "workspace:*",
    "@vzn/vx-reapi": "workspace:*",
    "@vzn/vx-schedule-history": "workspace:*",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001"
  }
}
