{
  "name": "@vzn/vx",
  "version": "0.0.0",
  "description": "An open, extensible monorepo task runner.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "vx": "./src/bin.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "vx": "bun src/bin.ts",
    "lint": "bun src/bin.ts run lint",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "bun src/bin.ts run format",
    "format:check": "bun src/bin.ts run format-check",
    "test": "bun src/bin.ts run test",
    "test:watch": "bun test --watch",
    "ci": "bun src/bin.ts run ci"
  },
  "dependencies": {
    "ignore": "^7.0.4",
    "package-manager-detector": "^1.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
