{
  "name": "@vzn/run",
  "version": "0.0.0",
  "description": "An open, extensible monorepo task runner.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "vzn": "./src/bin.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src/",
    "test:watch": "bun test --watch src/",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "ignore": "^7.0.4",
    "jiti": "^2.4.2",
    "tinyglobby": "^0.2.10",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
