{
  "name": "@vzn/monorepo",
  "version": "0.0.0",
  "description": "Workspace root for @vzn/vx and its plugin packages.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.4"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@vzn/vx": "workspace:*",
    "@vzn/vx-github": "workspace:*",
    "@vzn/vx-mcp": "workspace:*",
    "@vzn/vx-otel": "workspace:*",
    "@vzn/vx-reapi": "workspace:*",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0"
  },
  "scripts": {
    "docs:generate": "cd packages/vx-docs && bun scripts/import-docs.ts",
    "site:check": "bun packages/vx-bench/update-site.ts --check"
  }
}
