{
  "name": "@vzn/vx",
  "version": "0.0.0",
  "description": "An open, extensible monorepo task runner.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "vx": "./src/bin.ts"
  },
  "scripts": {
    "postinstall": "bun run scripts/link-self.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3"
  },
  "workspaces": [
    ".",
    "apps/*",
    "packages/*",
    "packages/cloud/ui"
  ],
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "^0.0.56"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/bun": "^1.3.14",
    "devframe": "^0.5.4",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
