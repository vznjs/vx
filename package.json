{
  "name": "@vzn/monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "vzn monorepo — @vzn/run (CLI/cache) + @vzn/dashboard (analytics UI).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "bun test packages/*/src/"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1"
  }
}
