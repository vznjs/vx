{
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "exec": {
        "command": "bun build src/main.js --outfile dist/app.js"
      },
      "inputs": {
        "files": [
          "src/**",
          "package.json"
        ]
      },
      "outputs": {
        "files": [
          "dist/**"
        ]
      },
      "cache": true
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "exec": {
        "command": "sh tests/main.sh"
      },
      "inputs": {
        "files": [
          "tests/**",
          "package.json"
        ]
      },
      "outputs": {
        "files": []
      },
      "cache": true
    },
    "ci": {
      "dependsOn": [
        "build",
        "test"
      ]
    }
  }
}
