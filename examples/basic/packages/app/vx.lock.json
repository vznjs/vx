{
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "exec": {
        "command": "mkdir -p dist && cat ../lib/dist/*.js src/main.js > dist/app.js"
      },
      "cache": {
        "inputs": {
          "files": [
            "src/**"
          ]
        },
        "outputs": {
          "files": [
            "dist/**"
          ]
        }
      }
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "exec": {
        "command": "sh tests/main.sh"
      },
      "cache": {
        "inputs": {
          "files": [
            "tests/**"
          ]
        },
        "outputs": {
          "files": []
        }
      }
    },
    "ci": {
      "dependsOn": [
        "build",
        "test"
      ]
    }
  }
}
