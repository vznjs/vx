{
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "exec": {
        "command": "mkdir -p dist && cat ../lib/dist/*.js src/main.js > dist/app.js"
      },
      "inputs": {
        "files": [
          "src/**",
          "package.json"
        ]
      },
      "outputs": {
          "files": [
            "dist/**"
          ]
        },
      "cache": true
    },
    "test": {
      "dependsOn": [
        "build"
      ],
      "exec": {
        "command": "sh tests/main.sh"
      },
      "inputs": {
        "files": [
          "tests/**",
          "package.json"
        ]
      },
      "outputs": {
          "files": []
        },
      "cache": true
    },
    "ci": {
      "dependsOn": [
        "build",
        "test"
      ]
    }
  }
}
