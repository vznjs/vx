{
  "tasks": {
    "build": {
      "exec": {
        "command": "mkdir -p dist && cp src/*.js dist/"
      },
      "cache": {
        "inputs": {
          "files": [
            "src/**",
            "package.json"
          ]
        },
        "outputs": {
          "files": [
            "dist/**"
          ]
        }
      }
    }
  }
}
