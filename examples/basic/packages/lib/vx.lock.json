{
  "tasks": {
    "build": {
      "exec": {
        "command": "mkdir -p dist && cp src/*.js dist/"
      },
      "inputs": {
        "files": [
          "src/**",
          "package.json"
        ]
      },
      "cache": {
        "outputs": {
          "files": [
            "dist/**"
          ]
        }
      }
    }
  }
}
