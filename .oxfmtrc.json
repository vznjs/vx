{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "packages/vx-docs",
    "dist",
    "coverage",
    "*.tsbuildinfo",
    "pnpm-lock.yaml",
    ".vx/lock.json",
    ".mcp.json",
    ".vscode",
    ".idea",
    ".claude"
  ]
}
