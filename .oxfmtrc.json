{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "arrowParens": "always",
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "private/vx-docs",
    "dist",
    "coverage",
    "*.tsbuildinfo",
    "pnpm-lock.yaml",
    "**/.vx/projects.lock.jsonl",
    "**/.vx/dependencies.lock",
    "**/vx.lock.json",
    "packages/vx/tests/contract/lock.jsonl",
    ".mcp.json",
    ".vscode",
    ".idea",
    ".claude"
  ]
}
